-- handles actions for counters:
-- player resource & skill, and stardate glory



function onDestroy()
  updateSave()
end


function updateSave()
  self.script_state = val
end


function onLoad(savedData)

  val = tonumber(savedData) or 0
  minVal = 0
  maxVal = 999
  Wait.time(function()

    local counterType = (self.getName():find("Dilithium") and not self.getName():find("Inert")) and "Dilithium" or
                        self.getName():find("Latinum") and "Latinum" or
                        (self.getName():find("Glory") and not self.getName():find("Stardate")) and "Glory" or
                        (self.getName():find("Glory") and self.getName():find("Stardate")) and "Stardate Glory" or
                        (self.getName():find("Research Counter") or self.getName():find("Influence Counter") or self.getName():find("Military Counter")) and "Focus"

    -- check to see if stardate glory counter is in play
    local pos = self.getPosition()

    if counterType == "Dilithium" then
      initCounterDilithium(self)
    elseif counterType == "Latinum" then
      initCounterLatinum(self)
    elseif counterType == "Glory" then
      initCounterPlayerGlory(self)
    -- elseif counterType == "Stardate Glory" and pos.y > 0 then
    --   Global.call("showStardateGloryCounter")
    elseif counterType == "Focus" then
      initCounterFocus(self)
      maxVal = 15
    end

  end, 0.50)
end


function initCounterDilithium(buttonObj)
  -- handles creation of player dilithium resource counters

  local counterSize = "160"
  local color = buttonObj.getName():find("Red") and "#EA1A1B" or "#1E87FF"
  local textColor = "#FFFFFF"
  local fontSize = (val < 10 and "130") or
                   ((val > 9 and val < 100) and "120") or
                   (val > 99 and "110")

  local rotation = "0 180 270"
  local position = "-80 0 5"
  local xmlTable = {
    {
      tag = "Button",
      attributes = {
        id            = "dilithiumCounter",
        width         = counterSize,
        height        = counterSize,
        rotation      = rotation,
        position      = position,
        scale         = ".5 .5 .5",
        color         = color,
        text          = tostring(val),
        font          = "fontTradeGothic",
        fontSize      = fontSize,
        fontStyle     = "Bold",
        textColor     = textColor,
        onClick       = "doAddOrSubtract",
        textAlignment = "LowerCenter",
        rectAlignment = "MiddleCenter",
      }
    }
  }
  self.UI.setXmlTable(xmlTable)
end


