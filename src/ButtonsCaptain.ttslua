        local listStr = string.format(
          "[%s]*[-] %dx %s",
          Color.fromString(playerColor):toHex(),
          v,
          altText
        )
        broadcastToAll(listStr, "White")
      end
    end
  end
end


function searchSpaceDock(buttonObj, clickerColor, _)
  -- handles on click search of player area's space dock

  buttonObj.Container.search(clickerColor)
end


function discardHand(buttonObj, _, _)
  -- handles the discard of all cards from a player's handzone

  animateButton(buttonObj)

  local playerColor = buttonObj.getGMNotes()

  -- briefly disable then re-enable on screen XML discard hand button if it's active
  local XmlIsActive = self.UI.getAttribute("discard_hand_" .. string.lower(playerColor), "active")
  if XmlIsActive then
    UI.hide("discard_hand_" .. string.lower(playerColor))
    Wait.time(function()

      UI.show("discard_hand_" .. string.lower(playerColor))

    end, 1)
  end

  -- discard all hand objects
  local isBot = checkPlayerColorIsBot(playerColor)
  local rotDiscard = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 }
  if isBot then rotDiscard = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 } end
  local posDiscard = playerColor == "Blue" and { -44.57, 1.50, -21.00 } or { 44.57, 1.50, 21.00 }
  local handZone = getObjectbyNameAndNotes("Handzone", playerColor)

  for _, handZoneObj in pairs(handZone.getObjects()) do
    if handZoneObj.type == "Card" then
      -- need to clear hand zone first, then can move smooth
      local posCard = handZoneObj.getPosition()
      posCard.x = playerColor == "Blue" and -50 or 50
      handZoneObj.setRotation(rotDiscard)
      handZoneObj.setPosition(posCard)
      handZoneObj.setPositionSmooth(posDiscard, false, true)
    end
  end

  -- broadcast
  local playerStr = getPlayerStr(playerColor)
  local broadcastStr = string.format("%s has discarded their hand.", playerStr)
  broadcastToAll(broadcastStr, "White")
end


function pullActionToken(buttonObj, _, _)
  animateButton(buttonObj)
  local posDrop = buttonObj.getPosition()
  local playerColor = buttonObj.getGMNotes()
  local rotToken = playerColor == "Blue" and {0.00, 120.00, 0.00} or { 0.00, 300.00, 180.00 }
  local bagTokens = getObjectbyNameAndNotes("Action Token Bag", playerColor)
  posDrop.y = 6.00
  local token = bagTokens.takeObject({ rotation= rotToken })
  token.setPosition(posDrop)
  token.addTag("destruct_on_end_turn")
  local playerStr = getPlayerStr(playerColor)
  local broadcastStr = string.format("%s has generated +1 Extra Action Token.", playerStr)
  broadcastToAll(broadcastStr, "White")
end


function refreshDrawDeck(buttonObj, _, altClick)

  -- wrapper function to handle the refresh draw deck button functionality

  animateButton(buttonObj)

  local playerColor = buttonObj.getName():find("Blue") and "Blue" or "Red"
  local isBot = checkPlayerColorIsBot(playerColor)

  -- find card or deck in discard, return out if none found
  local discardObj = getDiscardObject(playerColor)
  if discardObj == nil then
    broadcastToAll("Discard is currently empty!" , "Orange")
    return
  end

  -- manipulate the found discardObj (move to draw deck pad, shuffle, rename if deck, etc)
  refreshDiscardObject(discardObj, playerColor, isBot)

  -- return out here if isBot or altClick, before code that enlists & draws up to hand size
  if altClick or isBot then return end

  -- determine the maximum hand count for given playerColor
  local maxHandCount = getMaxHand(playerColor)
  local initialHandCount = Player[playerColor].getHandObjects()
  local currentHandCount = #initialHandCount

  log("maxHandCount: " .. maxHandCount)
  log("initialHandCount: " .. #initialHandCount)
  log("currentHandCount: " .. currentHandCount)

  local remainingToDraw = math.max(0, maxHandCount - currentHandCount)

  if remainingToDraw <= 0 then return end

  local reservesZone = getObjectbyNameAndNotes("Zone Reserves", playerColor)
  local devZone = getObjectbyNameAndNotes("Zone Development", playerColor)
  local handZone = getObjectbyNameAndNotes("Handzone", playerColor)

  -- always enlist 1 from Reserves if available, else Development
  local reserveObj = getReserveObject(reservesZone)

  if reserveObj ~= nil then
    enlistReserveCard(reserveObj, handZone, playerColor)
    remainingToDraw = remainingToDraw - 1
  else
    enlistDevelopmentCard(devZone, playerColor, remainingToDraw, maxHandCount)
    return
  end

  if remainingToDraw <= 0 then return end

  -- attempt to deal from refreshed deck
  remainingToDraw = drawFromRefreshedDeck(discardObj, remainingToDraw, playerColor)

  -- all done? all done.
  if remainingToDraw <= 0 then return end

  -- recursive fallback to Reserves or Development
  continueDrawing(remainingToDraw, reservesZone, devZone, handZone, playerColor, maxHandCount)
end


function getMaxHand(playerColor)
  -- handles detection of current captain & conditions to determine and return max hand size

  local maxHand = 5 -- default is usually 5 - REVISIT add special hand size cases below

  local dutyCheckZone = getObjectbyNameAndNotes("Zone Duty Officer", playerColor)
  local deployCheckZones = {
    getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
  }

  -- check deploy zones for hand size increasing cards
  for i = 1, 2 do
    for _, zoneObj in pairs(deployCheckZones[i].getObjects()) do
      if zoneObj.getName() == "Guardian Of Forever" then
        maxHand = maxHand + 1
      end
    end
  end

  -- check duty officer zone for hand size increasing cards
  for _, zoneObj in pairs(dutyCheckZone.getObjects()) do
    if zoneObj.type == "Card" then

      -- +1 duty officer cards
      if zoneObj.getName() == "Arne Darvin" or zoneObj.getName() == "T'Pel" or
      zoneObj.getName() == "Talok" or zoneObj.getName() == "Joret Dal" then
        maxHand = maxHand + 1
      end

      -- +2 duty officer cards
      if zoneObj.getName() == "Garak" then
        maxHand = maxHand + 2
      end

      -- handle dr kovich (+ hand size based on focus count)
      if zoneObj.getName() == "Doctor Kovich" then
        local counters = {
          getObjectbyName("Influence Counter " .. playerColor),
          getObjectbyName("Military Counter " .. playerColor),
          getObjectbyName("Research Counter " .. playerColor),
        }
        for i = 1, 3 do
          if counters[i].getVar("val") > 4 then
            maxHand = maxHand + 1
          end
        end
      end
    end
  end
  return maxHand
end


function getDiscardObject(playerColor)
  -- handles detection & return of deck or card object in playerColor discard zone

  local discardCheckZone = getObjectbyNameAndNotes("Zone Discard", playerColor)
  for _, zoneObj in pairs(discardCheckZone.getObjects()) do
    if zoneObj.type == "Card" or zoneObj.type == "Deck" then
      return zoneObj
    end
  end
  return nil
end


function refreshDiscardObject(discardObj, playerColor, isBot)
  -- handles placement of discardObj to draw deck pad, and shuffle/naming if deck

  local rotDrawDeck = playerColor == "Blue" and { 0.00, 270.00, 180.00 } or { 0.00, 90.00, 180.00 }
  if isBot then rotDrawDeck = playerColor == "Blue" and { 0.00, 90.00, 180.00 } or { 0.00, 270.00, 180.00 } end
  local posDrawDeck = playerColor == "Blue" and { -44.50, 1.20, 7.00 } or { 44.50, 1.20, -7.00 }

  if discardObj.type == "Deck" then
    local captainName = getCaptainName(playerColor)
    local deckName = string.format("%sDraw Deck", captainName ~= "None" and captainName .. " " or "")
    discardObj.setName(deckName)
    discardObj.shuffle()
  end

  discardObj.setRotation(rotDrawDeck)
  discardObj.setPositionSmooth(posDrawDeck, false, true)
end


function getReserveObject(reservesZone)
  -- handles the detection of current reserves deck

  for _, reserveObj in pairs(reservesZone.getObjects()) do
    if reserveObj.type == "Deck" and #reserveObj.getObjects() > 0 then
      return reserveObj
    elseif reserveObj.type == "Card" then
      return reserveObj
    end
  end
  return nil
end


function enlistReserveCard(reserveObj, handZone, playerColor)
  -- handles the functionality related to enlisting a reserves card

  local card = reserveObj
  local cardName = card.getName()
  if reserveObj.type == "Deck" then
    card = reserveObj.takeObject()
    cardName = card.getName()
  end

  card.setRotation({0, playerColor == "Blue" and 270 or 90, 0})
  card.setPositionSmooth(handZone.getPosition())

  -- broadcast reserves enlistment
  -- broadcasts without card name toAll
  -- broadcasts with cardName toColor
  local playerStr = getPlayerStr(playerColor)
  local broadcastStr = string.format("%s has cycled their deck, and Enlists a Reserve.", playerStr)
  broadcastToAll(broadcastStr, "White")

  if Player[playerColor].seated then
    broadcastStr = string.format("Enlisted Reserve Card: %s", cardName)
    Wait.time(function()

      broadcastToColor(broadcastStr, playerColor, "White")

    end, 0.5)
  end
  return card
end


function enlistDevelopmentCard(devZone, playerColor, remainingToDraw, maxHandCount)
  -- handles functionality related to enlisting a development card

  -- if development deck is found, open up a search window & broadcast
  local playerStr = getPlayerStr(playerColor)
  for _, devObj in pairs(devZone.getObjects()) do
    if devObj.type == "Deck" then
      devObj.Container.search(playerColor)

      local broadcastStr = string.format("%s has cycled their deck, and may Enlist a Development.", playerStr)
      broadcastToAll(broadcastStr, "White")

      if Player[playerColor].seated then
        Wait.time(function()

          broadcastStr = string.format("%s: Pull selected Development Card from deck, remember to pay Development cost, and add Development Card to hand.", playerStr)
          broadcastToColor(broadcastStr, playerColor, "White")

        end, 1)
        Wait.time(function()

          broadcastStr = string.format("%s: Afterwards, manually draw %d more cards, up to your hand size of %d.", playerStr, remainingToDraw - 1, maxHandCount)
          broadcastToColor(broadcastStr, playerColor, "White")

        end, 2)
      end
      return true

    elseif devObj.type == "Card" then
      local broadcastStr = string.format("%s has cycled their deck, and may Enlist their last Development.", playerStr)
      broadcastToAll(broadcastStr, "White")

      Wait.time(function()

        broadcastStr = string.format("%s: Pull selected Development Card from deck, remember to pay Development cost, and add Development Card to hand.", playerStr)
        broadcastToColor(broadcastStr, playerColor, "White")
      end, 1)
      Wait.time(function()

        broadcastStr = string.format("%s: Afterwards, manually draw %d more cards, up to your hand size of %d.", playerStr, remainingToDraw - 1, maxHandCount)
        broadcastToColor(broadcastStr, playerColor, "White")

      end, 2)
      return true
    end
  end

  return false
end


function drawFromRefreshedDeck(drawDeck, remainingToDraw, playerColor)
  -- handles a draw up to remaining count from draw deck

  local drawDeckCount = 0
  if drawDeck.type == "Deck" then
    drawDeckCount = #drawDeck.getObjects()
  elseif drawDeck.type == "Card" then
    drawDeckCount = 1
  end
  if drawDeckCount <= 0 then return remainingToDraw end

  local toDraw = math.min(remainingToDraw, drawDeckCount)
  drawDeck.deal(toDraw, playerColor)

  return remainingToDraw - toDraw
end


function continueDrawing(remainingToDraw, reservesZone, devZone, handZone, playerColor, maxHandCount)
  -- handles the recursive draw off reserves/development if required

  if remainingToDraw <= 0 then return end

  local reserveObj = getReserveObject(reservesZone)
  if reserveObj ~= nil then
    enlistReserveCard(reserveObj, handZone, playerColor)
    remainingToDraw = remainingToDraw - 1

    Wait.time(function()
      continueDrawing(remainingToDraw, reservesZone, devZone, handZone, playerColor, maxHandCount)
    end, 0.25)

    return
  end

  -- No more reserves -- handle development zone
  if enlistDevelopmentCard(devZone, playerColor, remainingToDraw, maxHandCount) then
    return
  end

  -- Still nothing? Broadcast error
  local playerStr = getPlayerStr(playerColor)
  local broadcastStr = string.format("%s: No more cards to draw from Reserves or Developments!", playerStr)
  if Player[playerColor].seated then broadcastToColor(broadcastStr, playerColor, "Orange") end
end


