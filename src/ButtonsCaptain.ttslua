-- handles functionality related to captain area non counter, non beambag/log buttons
-- report buttons, discard hand, space dock, +1 action
-- counter stuff is instead in Counters.ttlsua (and injected onto the object scope)
-- beam bag & log stuff is instead in BeamedBags.ttslua




function initButtonReportResupplyCleanup(buttonObj)
  local playerColor = buttonObj.getGMNotes()
  local buttonType = buttonObj.getName("Resupply") and "Resupply" or "Clean-Up"
  local tooltip = string.format("Clicking this button will report all currently in play %s Step cards for the %s player.\n\nRight clicking will momentarily highlight %s Step cards in play without broadcasting.", buttonType, playerColor, buttonType)
  buttonObj.clearButtons()
  buttonObj.createButton({
    click_function = "reportResupplyCleanup",
    function_owner = self,
    label          = "",
    position       = { 0, 0.36, -0.01 },
    width          = 865,
    height         = 435,
    scale          = { 2.3, 2.3, 2.3 },
    color          = { 1, 1, 1, .3 },
    hover_color    = { 1, 1, 1, .6 },
    tooltip        = tooltip,
  })
end


function initButtonReportCurrentTraits(buttonObj)
  local playerColor = buttonObj.getGMNotes()
  local buttonName = buttonObj.getName()
  local buttonType = (buttonName:find("Skills") and "Skills") or
                     (buttonName:find("Suits") and "Suits") or
                     (buttonName:find("Species") and "Species") or
                     (buttonName:find("Regular") and "Regular") or
                     (buttonName:find("Other") and "Other") or "None"
  local typeStr = (buttonType == "Skills" and "Skill Icons") or
                  (buttonType == "Suits" and "Card Suits") or
                  string.format("'%s' Traits", buttonType)
  local tooltip = string.format("Clicking this button will report all currently in play %s for the %s player.", typeStr, playerColor)
  buttonObj.clearButtons()
  buttonObj.createButton({
    click_function = "reportTraits",
    function_owner = self,
    label          = "",
    position       = { 0, 0.36, -0.01 },
    width          = 865,
    height         = 435,
    scale          = { 2.3, 2.3, 2.3 },
    color          = { 1, 1, 1, .3 },
    hover_color    = { 1, 1, 1, .6 },
    tooltip        = tooltip,
  })
end


