    hover_color    = { 1, 1, 1, .6 },
    tooltip        = "Shuffle discard pile, refresh draw deck.\n\nLeft Click: Automatically draw back up to hand size, including automatic Enlisting.\n\nRight click: Refresh the discard pile into a draw deck, without drawing back up to Hand Size.\n(Good for cases where you're cycling the deck while drawing 1 to a few cards during your turn. [b]Enlist manually in this case[/b]).",
  })
end



function reportResupplyCleanup(buttonObj, _, altClick)
  -- handles report of currently in play Resupply cards
  -- alt click will simply highlight, not broadcast
  -- "in play" meaning card within ship deploy, location deploy, captain, or duty officer zones

  local playerColor = buttonObj.getGMNotes()
  local buttonType = buttonObj.getName():find("Resupply") and "Resupply" or "Clean-Up"
  local buttonTag = buttonType == "Resupply" and "resupply" or "cleanup"

  -- animate button
  animateButton(buttonObj)

  -- check in play areas
  local checkZones = {
    getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
    getObjectbyNameAndNotes("Zone Captain", playerColor),
    getObjectbyNameAndNotes("Zone Duty Officer", playerColor),
  }
  if buttonType == "Clean-Up" then
    table.insert(checkZones, getObjectbyNameAndNotes("Zone In Play", playerColor))
  end

  -- gather resupply cards, highlight for 5 seconds
  local foundCards = {}
  for i = 1, #checkZones do
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      if zoneObj.hasTag(buttonTag) then
        table.insert(foundCards, zoneObj)

        -- briefly highlight found current type card, 5 seconds
        if zoneObj then
          zoneObj.highlightOn(playerColor)
        end
        Wait.time(function()

          if zoneObj then
            zoneObj.highlightOff()
          end

         end, 5)
      end
    end
  end

  -- broadcast if not right clicked (altClick will only highlight)
  if not altClick and #foundCards > 0 then
    local playerStr = getPlayerStr(playerColor)
    local headlineStr = string.format("%s - Current in play %s Step Cards:", playerStr, buttonType)
    local bulletStr = string.format("[%s]* [-]", Color.fromString(playerColor):toHex())
    broadcastToAll(headlineStr, "White")
    Wait.time(function()

      for i = 1, #foundCards do
        local cardName = foundCards[i].getName()
        local listStr = string.format("%s %s", bulletStr, cardName)
        broadcastToAll(listStr, "White")
      end

    end, 0.5)
  end
end


function reportTraits(buttonObj, _, _)
  -- wrapper that handles the report of any in play cards for skill icons, suits, and traits

  animateButton(buttonObj)

  local playerColor = buttonObj.getGMNotes()
  local buttonName = buttonObj.getName()
  local buttonType = (buttonName:find("Skills") and "Skills") or
                     (buttonName:find("Suits") and "Suits") or
                     (buttonName:find("Species") and "Species") or
                     (buttonName:find("Regular") and "Regular") or
                     (buttonName:find("Other") and "Other") or "None"
  if buttonType == "Skills" then
    reportCurrentSkills(playerColor)
  elseif buttonType == "Suits" then
    reportCurrentSuits(playerColor)
  elseif buttonType == "Species" or buttonType == "Regular" or buttonType == "Other" then
    reportCurrentTraits(playerColor, buttonType)
  end
end


function reportCurrentSkills(playerColor)
  -- handles the reporting of current skill icon count for playerColor

  local inPlaySkillIcons = {
    influence = 0,
    military  = 0,
    research  = 0,
    wildcard  = 0,
  }
  local inPlaySkillCards = {
    influence = {},
    military  = {},
    research = {},
    wildcard = {},
  }
  local nivarTraits = {
    vulcan     = 0,
    ambassador = 0,
    romulan    = 0,
  }
  local checkZones = {
    getObjectbyNameAndNotes("Zone Captain", playerColor),
    getObjectbyNameAndNotes("Zone In Play", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
    getObjectbyNameAndNotes("Zone Duty Officer", playerColor),
  }

  for i = 1, #checkZones do
    -- check i zone for in play skill icons
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      for k, _ in pairs(inPlaySkillIcons) do
        if zoneObj.hasTag("skill_" .. k) then
          inPlaySkillIcons[k] = inPlaySkillIcons[k] + 1
          table.insert(inPlaySkillCards[k], zoneObj.getName() .. ": 1")
        elseif zoneObj.hasTag("skill_x2_" .. k) then
          inPlaySkillIcons[k] = inPlaySkillIcons[k] + 2
          table.insert(inPlaySkillCards[k], zoneObj.getName() .. ": 2")
        elseif zoneObj.hasTag("skill_x3_" .. k) then
          inPlaySkillIcons[k] = inPlaySkillIcons[k] + 3
          table.insert(inPlaySkillCards[k], zoneObj.getName() .. ": 3")
        end
      end

      -- check i zone for in play ni'var match traits
      for k, _ in pairs(nivarTraits) do
        if zoneObj.hasTag("trait_" .. k) then
          nivarTraits[k] = nivarTraits[k] + 1
        end
      end
    end
  end

  -- check beam bags
  local checkBeamBagObjs = {}
  for _, obj in pairs(getObjects()) do
    if obj.getName() == "Beamed Cards" and obj.getGMNotes() == playerColor then
      table.insert(checkBeamBagObjs, obj)
    end
  end

  local beamedSkillIcons = {
    influence = 0,
    military  = 0,
    research  = 0,
    wildcard  = 0,
  }

  if #checkBeamBagObjs > 0 then
    for i = 1, #checkBeamBagObjs do
      local checkBag = checkBeamBagObjs[i]

      for _, bagObj in pairs(checkBag.getObjects()) do
        for k, _ in pairs(beamedSkillIcons) do
          for _, tag in pairs(bagObj.tags) do
            if tag == "skill_" .. k then
              beamedSkillIcons[k] = beamedSkillIcons[k] + 1
              table.insert(inPlaySkillCards[k], bagObj.name .. ": 1")
            end

            if tag == "skill_x2_" .. k then
              beamedSkillIcons[k] = beamedSkillIcons[k] + 2
              table.insert(inPlaySkillCards[k], bagObj.name .. ": 2")
            end

            if tag == "skill_x3_" .. k then
              beamedSkillIcons[k] = beamedSkillIcons[k] + 3
              table.insert(inPlaySkillCards[k], bagObj.name .. ": 3")
            end
          end
        end
      end
    end
  end

  -- make total count, including handling all the special cases
  local skillIcons = {
    influence = 0,
    military  = 0,
    research  = 0,
    wildcard  = 0,
  }

  for k, v in pairs(skillIcons) do
    skillIcons[k] = inPlaySkillIcons[k] + beamedSkillIcons[k]
  end

  -- check if ni'var is currently in play
  local nivarInPlay = false
  for i = 1, #checkZones do
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      if zoneObj.getName() == "Ni'var" then
        nivarInPlay = true
        break
      end

      if nivarInPlay then
        break
      end
    end
  end

  if nivarInPlay then
    if nivarTraits["vulcan"] > 0 then
      skillIcons["research"] = skillIcons["research"] + nivarTraits["vulcan"]
      table.insert(inPlaySkillCards["research"], "Ni'var: " .. nivarTraits["vulcan"])
    end

    if nivarTraits["ambassador"] > 0 then
      skillIcons["influence"] = skillIcons["influence"] + nivarTraits["ambassador"]
      table.insert(inPlaySkillCards["influence"], "Ni'var: " .. nivarTraits["ambassador"])
    end

    if nivarTraits["romulan"] > 0 then
      skillIcons["military"] = skillIcons["military"] + nivarTraits["romulan"]
      table.insert(inPlaySkillCards["military"], "Ni'var: " .. nivarTraits["romulan"])
    end
  end

  -- check if keyla detmer (burnham deck) is currently in DO slot
  local checkZoneDO = getObjectbyNameAndNotes("Zone Duty Officer", playerColor)

  for _, zoneObj in pairs(checkZoneDO.getObjects()) do
    if zoneObj.getName() == "Keyla Detmer" or zoneObj.getName() == "T'Pau" then
      skillIcons["wildcard"] = skillIcons["wildcard"] + 2
      table.insert(inPlaySkillCards["wildcard"], zoneObj.getName() .. ": 2")
    end
    if zoneObj.getName() == "LT. Detmer" or zoneObj.getName() == "T'Pau" then
      skillIcons["wildcard"] = skillIcons["wildcard"] + 1
      table.insert(inPlaySkillCards["wildcard"], "Lt Detmer: 1")
    end
  end

  -- put the broadcast together
  local traitsFound = false
  for k, v in pairs(skillIcons) do
    if v > 0 then
      traitsFound = true
    end
  end

  local function rgbToHex(color)
    local r = math.floor(color[1] * 255)
    local g = math.floor(color[2] * 255)
    local b = math.floor(color[3] * 255)

    return string.format("%02X%02X%02X", r, g, b)
  end

  if traitsFound then
    local playerStr = getPlayerStr(playerColor)
    local headlineStr = string.format("%s - Current In-Play Skill Icons:", playerStr)
    broadcastToAll(headlineStr, "White")

    local reportColors = {
      influence = { 212/255, 209/255, 41/255 },
      military = { 193/255, 30/255, 30/255 },
      research = { 21/255, 151/255, 196/255 },
      wildcard = { 128/255, 0, 128/255 },
    }

    for k, v in pairs(skillIcons) do
      if v > 0 then
        local altText = k:sub(1, 1):upper() .. k:sub(2)
        local reportColor = reportColors[k]

        if beamedSkillIcons[k] > 0 then
          local broadcastStr = string.format(
            "[%s]*[-] [%s]%dx [-][%s]%s[-] - (%d Beamed, %d Not Beamed)",
            Color.fromString(playerColor):toHex(),
            Color.fromString("White"):toHex(),
            v,
            rgbToHex(reportColor),
            altText,
            beamedSkillIcons[k],
            inPlaySkillIcons[k]
          )
          broadcastToAll(broadcastStr, "White")
        else
          local broadcastStr = string.format(
            "[%s]*[-] [%s]%dx [-][%s]%s[-] - %d (Not Beamed)",
            Color.fromString(playerColor):toHex(),
            Color.fromString("White"):toHex(),
            v,
            rgbToHex(reportColor),
            altText,
            v
          )
          broadcastToAll(broadcastStr, "White")
        end

        -- show contributing card names
        for _, line in ipairs(inPlaySkillCards[k]) do
          local broadcastStr = string.format(
            "    [%s]*[-] %s",
            rgbToHex(reportColor),
            line
          )
          broadcastToAll(broadcastStr, "White")
        end
      end
    end
  end
end


function reportCurrentSuits(playerColor)
  -- handles the reporting of current card suit count for playerColor

  local cardSuits = {
    ally      = 0,
    captain   = 0,
    cargo     = 0,
    directive = 0,
    encounter = 0,
    incident  = 0,
    mission   = 0,
    location  = 0,
    person    = 0,
    ship      = 0,
  }
  local checkZones = {
    getObjectbyNameAndNotes("Zone Captain", playerColor),
    getObjectbyNameAndNotes("Zone In Play", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
    getObjectbyNameAndNotes("Zone Duty Officer", playerColor),
  }

  -- check zones
  for i = 1, #checkZones do
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      for k, _ in pairs(cardSuits) do
        if zoneObj.hasTag("suit_" .. k) then
          cardSuits[k] = cardSuits[k] + 1
        end
      end
    end
  end

  -- put the broadcast together
  local traitsFound = false
  for k, v in pairs(cardSuits) do
    if v > 0 then
      traitsFound = true
    end
  end

  if traitsFound then
    local playerStr = getPlayerStr(playerColor)
    local headlineStr = string.format("%s - Current In-Play Card Suits:", playerStr)
    broadcastToAll(headlineStr, "White")

    for k, v in pairs(cardSuits) do
      if v > 0 then
        local altText = k:sub(1, 1):upper() .. k:sub(2)
        local listStr = string.format(
          "[%s]*[-] %dx %s",
          Color.fromString(playerColor):toHex(),
          v,
          altText
        )
        broadcastToAll(listStr, "White")
      end
    end
  end
end


function reportCurrentTraits(playerColor, buttonType)
  -- handles the reporting of current trait count for playerColor

  local traitMaps = {
    Species = {
      alien        = 0,
      aenar        = 0,
      andorian     = 0,
      android      = 0,
      bajoran      = 0,
      betazoid     = 0,
      borg         = 0,
      breen        = 0,
      cardassian   = 0,
      changeling   = 0,
      ferengi      = 0,
      human        = 0,
      jemhadar     = 0,
      kazon        = 0,
      kelpian      = 0,
      klingon      = 0,
      orion        = 0,
      pakled       = 0,
      reman        = 0,
      romulan      = 0,
      synthetic    = 0,
      tellarite    = 0,
      transcendent = 0,
      trill        = 0,
      vaunakat     = 0,
      vorta        = 0,
      vulcan       = 0,
      xb           = 0,
      xindi        = 0,
    },
    Regular = {
      ambassador    = 0,
      ancient       = 0,
      anomaly       = 0,
      augment       = 0,
      beverage      = 0,
      business      = 0,
      cloak         = 0,
      communication = 0,
      creature      = 0,
      crossover     = 0,
      doctor        = 0,
      dominion      = 0,
      engineer      = 0,
      helmet        = 0,
      hologram      = 0,
      imperial      = 0,
      maquis        = 0,
      mindcontrol   = 0,
      nx01          = 0,
      ops           = 0,
      pathofsurak   = 0,
      pilot         = 0,
      scientist     = 0,
      security      = 0,
      shady         = 0,
      spy           = 0,
      starbase      = 0,
      starfleet     = 0,
      telepath      = 0,
      timetravel    = 0,
      weapon        = 0,
    },
    Other = {
      attack      = 0,
      lowerdecker = 0,
      ongoing     = 0,
      surprise    = 0,
      wildcard    = 0,
    },
  }

  local traitCounts = traitMaps[buttonType]

  if not traitCounts then
    return
  end

  local checkZones = {
    getObjectbyNameAndNotes("Zone Captain", playerColor),
    getObjectbyNameAndNotes("Zone In Play", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
    getObjectbyNameAndNotes("Zone Duty Officer", playerColor),
  }

  -- check zones
  for i = 1, #checkZones do
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      for k, _ in pairs(traitCounts) do
        if zoneObj.hasTag("trait_" .. k) then
          traitCounts[k] = traitCounts[k] + 1
        end
      end
    end
  end

  -- put the broadcast together
  local traitsFound = false
  for k, v in pairs(traitCounts) do
    if v > 0 then
      traitsFound = true
    end
  end

  if traitsFound then
    local playerStr = getPlayerStr(playerColor)
    local headlineStr = string.format(
      "%s - Current In-Play %s Traits:",
      playerStr,
      buttonType
    )
    broadcastToAll(headlineStr, "White")

    for k, v in pairs(traitCounts) do
      if v > 0 then
        local altText = k:sub(1, 1):upper() .. k:sub(2)
        local listStr = string.format(
          "[%s]*[-] %dx %s",
          Color.fromString(playerColor):toHex(),
          v,
          altText
        )
        broadcastToAll(listStr, "White")
      end
    end
  end
end


function searchSpaceDock(buttonObj, clickerColor, _)
  -- handles on click search of player area's space dock

  buttonObj.Container.search(clickerColor)
end


function discardHand(buttonObj, _, _)
  -- handles the discard of all cards from a player's handzone

  animateButton(buttonObj)

  local playerColor = buttonObj.getGMNotes()

  -- briefly disable then re-enable on screen XML discard hand button if it's active
  local XmlIsActive = self.UI.getAttribute("discard_hand_" .. string.lower(playerColor), "active")
  if XmlIsActive then
    UI.hide("discard_hand_" .. string.lower(playerColor))
    Wait.time(function()

      UI.show("discard_hand_" .. string.lower(playerColor))

    end, 1)
  end

  -- discard all hand objects
  local isBot = checkPlayerColorIsBot(playerColor)
  local rotDiscard = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 }
  if isBot then rotDiscard = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 } end
  local posDiscard = playerColor == "Blue" and { -44.57, 1.50, -21.00 } or { 44.57, 1.50, 21.00 }
  local handZone = getObjectbyNameAndNotes("Handzone", playerColor)

  for _, handZoneObj in pairs(handZone.getObjects()) do
    if handZoneObj.type == "Card" then
      -- need to clear hand zone first, then can move smooth
      local posCard = handZoneObj.getPosition()
      posCard.x = playerColor == "Blue" and -50 or 50
      handZoneObj.setRotation(rotDiscard)
      handZoneObj.setPosition(posCard)
      handZoneObj.setPositionSmooth(posDiscard, false, true)
    end
  end

  -- broadcast
  local playerStr = getPlayerStr(playerColor)
  local broadcastStr = string.format("%s has discarded their hand.", playerStr)
  broadcastToAll(broadcastStr, "White")
end


function pullActionToken(buttonObj, _, _)
  animateButton(buttonObj)
  local posDrop = buttonObj.getPosition()
  local playerColor = buttonObj.getGMNotes()
  local rotToken = playerColor == "Blue" and {0.00, 120.00, 0.00} or { 0.00, 300.00, 180.00 }
  local bagTokens = getObjectbyNameAndNotes("Action Token Bag", playerColor)
  posDrop.y = 6.00
  local token = bagTokens.takeObject({ rotation= rotToken })
  token.setPosition(posDrop)
  token.addTag("destruct_on_end_turn")
  local playerStr = getPlayerStr(playerColor)
  local broadcastStr = string.format("%s has generated +1 Extra Action Token.", playerStr)
  broadcastToAll(broadcastStr, "White")
end


function refreshDrawDeck(buttonObj, _, altClick, dealCount)

  -- wrapper function to handle the refresh draw deck button functionality

  animateButton(buttonObj)

  local playerColor = buttonObj.getName():find("Blue") and "Blue" or "Red"
  local isBot = checkPlayerColorIsBot(playerColor)

  -- determine the maximum hand count for given playerColor
  local maxHandCount = getMaxHand(playerColor)
  local initialHandCount = Player[playerColor].getHandObjects()
  local currentHandCount = #initialHandCount

  local remainingToDraw = dealCount ~= nil
    and dealCount
    or math.max(0, maxHandCount - currentHandCount)

  if remainingToDraw <= 0 and not isBot then return end

  -- find card or deck in draw deck
  local drawDeckZone = getObjectbyNameAndNotes("Zone Draw Deck", playerColor)
  local drawDeckObj

  if drawDeckZone ~= nil then
    for _, zoneObj in pairs(drawDeckZone.getObjects()) do
      if zoneObj.tag == "Card" or zoneObj.tag == "Deck" then
        drawDeckObj = zoneObj
        break
      end
    end
  end

  -- bots never draw to hand
  -- only refresh the discard when the draw deck is empty
  if isBot then
    if drawDeckObj ~= nil then return end

    local discardObj = getDiscardObject(playerColor)
    if discardObj == nil then return end

    refreshDiscardObject(discardObj, playerColor, isBot)
    return
  end

  -- first attempt to deal from the existing draw deck
  local drewFromDrawDeck = false

  if drawDeckObj ~= nil then
    local previousRemaining = remainingToDraw

    remainingToDraw = drawFromRefreshedDeck(
      drawDeckObj,
      remainingToDraw,
      playerColor
    )

    if remainingToDraw < previousRemaining then
      drewFromDrawDeck = true
    end

    if remainingToDraw <= 0 then return end
  end

    local function continueDraw()

    -- return out here if altClick
    if altClick then
      local discardObj = getDiscardObject(playerColor)
      if discardObj == nil then return end

      refreshDiscardObject(discardObj, playerColor, isBot)
      return
    end

    -- find card or deck in discard, return out if none found
    local discardObj = getDiscardObject(playerColor)
    if discardObj == nil then return end

    -- manipulate the found discardObj
    refreshDiscardObject(discardObj, playerColor, isBot)

    local reservesZone = getObjectbyNameAndNotes("Zone Reserves", playerColor)
    local devZone = getObjectbyNameAndNotes("Zone Development", playerColor)
    local handZone = getObjectbyNameAndNotes("Handzone", playerColor)

    -- try to enlist 1 Reserve as part of the draw
    local reserveObj = getReserveObject(reservesZone)

    if reserveObj == nil then
      enlistDevelopmentCard(devZone, playerColor, remainingToDraw, maxHandCount)
      return
    end

    enlistReserveCard(reserveObj, handZone, playerColor)
    remainingToDraw = remainingToDraw - 1

    if remainingToDraw <= 0 then return end

    -- attempt to deal remaining cards from refreshed deck
    remainingToDraw = drawFromRefreshedDeck(
      discardObj,
      remainingToDraw,
      playerColor
    )

    if remainingToDraw <= 0 then return end

    -- refreshed deck did not contain enough cards; enlist Development
    enlistDevelopmentCard(devZone, playerColor, remainingToDraw, maxHandCount)
  end

  -- wait before refreshing the discard if cards were drawn from the existing deck
  if drewFromDrawDeck then
    Wait.time(continueDraw, 0.5)
  else
    continueDraw()
  end
end


function getMaxHand(playerColor, captainName)
  -- handles detection of current captain & conditions to determine and return max hand size

  local maxHand = 5 -- default is usually 5 - REVISIT add special hand size cases below

  -- handle rebner only having 3
  if captainName == "Rebner" or getCaptainName(playerColor) == "Rebner" then maxHand = 3 end

  local dutyCheckZone = getObjectbyNameAndNotes("Zone Duty Officer", playerColor)
  local deployCheckZones = {
    getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
  }

  -- check deploy zones for hand size increasing cards
  for i = 1, 2 do
    for _, zoneObj in pairs(deployCheckZones[i].getObjects()) do
      if zoneObj.getName() == "Guardian Of Forever" then
        maxHand = maxHand + 1
      end
      if zoneObj.getName() == "Ceti Alpha V" then
        maxHand = maxHand + 1
      end
    end
  end

  -- check duty officer zone for hand size increasing cards
  for _, zoneObj in pairs(dutyCheckZone.getObjects()) do
    if zoneObj.type == "Card" then

      -- +1 duty officer cards
      if zoneObj.getName() == "Arne Darvin" or zoneObj.getName() == "T'Pel" or
      zoneObj.getName() == "Talok" or zoneObj.getName() == "Joret Dal" or zoneObj.getName() == "Inert Dilithium" or 
      zoneObj.getName() == "Barry Waddle" or zoneObj.getName() == "William Boimler, Lt. JG" then
        maxHand = maxHand + 1
      end

      -- +2 duty officer cards
      if zoneObj.getName() == "Garak" or zoneObj.getName() == "Thelev" then
        maxHand = maxHand + 2
      end

      -- handle dr kovich (+ hand size based on focus count)
      if zoneObj.getName() == "Doctor Kovich" then
        local counters = {
          getObjectbyName("Influence Counter " .. playerColor),
          getObjectbyName("Military Counter " .. playerColor),
          getObjectbyName("Research Counter " .. playerColor),
        }
        for i = 1, 3 do
          if counters[i].getVar("val") > 4 then
            maxHand = maxHand + 1
          end
        end
      end

      -- handle agent daniels (+ hand size based on focus count)
      if zoneObj.getName() == "Agent Daniels" then
        local counters = {
          getObjectbyName("Influence Counter " .. playerColor),
          getObjectbyName("Military Counter " .. playerColor),
          getObjectbyName("Research Counter " .. playerColor),
        }
        for i = 1, 3 do
          if counters[i].getVar("val") > 5 then
            maxHand = maxHand + 1
          end
        end
      end

      -- handle minister kuvak (+ hand size based on non vulcan locations in play, max 3)
      if zoneObj.getName() == "Minister Kuvak" then
        local nonVulcanLocationCount = 0
        local checkZones = {
          getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
          getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
        }
        for i = 1, 2 do
          for _, checkZoneObj in pairs(checkZones[i].getObjects()) do
            if checkZoneObj.hasTag("suit_location") and not checkZoneObj.hasTag("trait_vulcan") then
              nonVulcanLocationCount = nonVulcanLocationCount + 1
            end
          end
        end
        if nonVulcanLocationCount > 3 then nonVulcanLocationCount = 3 end
        if nonVulcanLocationCount > 0 then
          maxHand = maxHand + nonVulcanLocationCount
        end
      end

    end
  end
  return maxHand
end


function getDiscardObject(playerColor)
  -- handles detection & return of deck or card object in playerColor discard zone

  local discardCheckZone = getObjectbyNameAndNotes("Zone Discard", playerColor)
  for _, zoneObj in pairs(discardCheckZone.getObjects()) do
    if zoneObj.type == "Card" or zoneObj.type == "Deck" then
      return zoneObj
    end
  end
  return nil
end


function refreshDiscardObject(discardObj, playerColor, isBot)
  -- handles placement of discardObj to draw deck pad, and shuffle/naming if deck

  local rotDrawDeck = playerColor == "Blue" and { 0.00, 270.00, 180.00 } or { 0.00, 90.00, 180.00 }
  if isBot then rotDrawDeck = playerColor == "Blue" and { 0.00, 90.00, 180.00 } or { 0.00, 270.00, 180.00 } end
  local posDrawDeck = playerColor == "Blue" and { -44.50, 1.20, 7.00 } or { 44.50, 1.20, -7.00 }

  if discardObj.type == "Deck" then
    local captainName = getCaptainName(playerColor)
    local deckName = string.format("%sDraw Deck", captainName ~= "None" and captainName .. " " or "")
    discardObj.setName(deckName)
    discardObj.shuffle()
  end

  discardObj.setRotation(rotDrawDeck)
  discardObj.setPositionSmooth(posDrawDeck, false, true)
end


function getReserveObject(reservesZone)
  -- handles the detection of current reserves deck

  for _, reserveObj in pairs(reservesZone.getObjects()) do
    if reserveObj.type == "Deck" and #reserveObj.getObjects() > 0 then
      return reserveObj
    elseif reserveObj.type == "Card" then
      return reserveObj
    end
  end
  return nil
end


function enlistReserveCard(reserveObj, handZone, playerColor)
  -- handles the functionality related to enlisting a reserves card

  local card = reserveObj
  local cardName = card.getName()
  if reserveObj.type == "Deck" then
    card = reserveObj.takeObject()
    cardName = card.getName()
  end

  card.setRotation({0, playerColor == "Blue" and 270 or 90, 0})
  card.setPositionSmooth(handZone.getPosition())

  -- broadcast reserves enlistment
  -- broadcasts without card name toAll
  -- broadcasts with cardName toColor
  local playerStr = getPlayerStr(playerColor)
  local broadcastStr = string.format("%s has cycled their deck, and Enlists a Reserve.", playerStr)
  broadcastToAll(broadcastStr, "White")

  if Player[playerColor].seated then
    broadcastStr = string.format("Enlisted Reserve Card: %s", cardName)
    Wait.time(function()

      broadcastToColor(broadcastStr, playerColor, "White")

    end, 0.5)
  end
  return card
end


function enlistDevelopmentCard(devZone, playerColor, remainingToDraw, maxHandCount)
  -- handles functionality related to enlisting a development card

  -- if development deck is found, open up a search window & broadcast
  local playerStr = getPlayerStr(playerColor)
  for _, devObj in pairs(devZone.getObjects()) do
    if devObj.type == "Deck" then
      devObj.Container.search(playerColor)

      local broadcastStr = string.format("%s has cycled their deck, and may Enlist a Development.", playerStr)
      broadcastToAll(broadcastStr, "White")

      if Player[playerColor].seated then
        Wait.time(function()

          broadcastStr = string.format("%s: Pull selected Development Card from deck, remember to pay Development cost, and add Development Card to hand.", playerStr)
          broadcastToColor(broadcastStr, playerColor, "White")

        end, 1)
        Wait.time(function()

          broadcastStr = string.format("%s: Afterwards, manually draw %d more cards, up to your hand size of %d.", playerStr, remainingToDraw - 1, maxHandCount)
          broadcastToColor(broadcastStr, playerColor, "White")

        end, 2)
      end
      return true

    elseif devObj.type == "Card" then
      local broadcastStr = string.format("%s has cycled their deck, and may Enlist their last Development.", playerStr)
      broadcastToAll(broadcastStr, "White")

      Wait.time(function()

        broadcastStr = string.format("%s: Pull selected Development Card from deck, remember to pay Development cost, and add Development Card to hand.", playerStr)
        broadcastToColor(broadcastStr, playerColor, "White")
      end, 1)
      Wait.time(function()

        broadcastStr = string.format("%s: Afterwards, manually draw %d more cards, up to your hand size of %d.", playerStr, remainingToDraw - 1, maxHandCount)
        broadcastToColor(broadcastStr, playerColor, "White")

      end, 2)
      return true
    end
  end

  return false
end


function drawFromRefreshedDeck(drawDeck, remainingToDraw, playerColor)
  -- handles a draw up to remaining count from draw deck

  local drawDeckCount = 0
  if drawDeck.type == "Deck" then
    drawDeckCount = #drawDeck.getObjects()
  elseif drawDeck.type == "Card" then
    drawDeckCount = 1
  end
  if drawDeckCount <= 0 then return remainingToDraw end

  local toDraw = math.min(remainingToDraw, drawDeckCount)
  drawDeck.deal(toDraw, playerColor)

  return remainingToDraw - toDraw
end


function continueDrawing(remainingToDraw, reservesZone, devZone, handZone, playerColor, maxHandCount)
  -- handles the recursive draw off reserves/development if required

  if remainingToDraw <= 0 then return end

  local reserveObj = getReserveObject(reservesZone)
  if reserveObj ~= nil then
    enlistReserveCard(reserveObj, handZone, playerColor)
    remainingToDraw = remainingToDraw - 1

    Wait.time(function()
      continueDrawing(remainingToDraw, reservesZone, devZone, handZone, playerColor, maxHandCount)
    end, 0.25)

    return
  end

  -- No more reserves -- handle development zone
  if enlistDevelopmentCard(devZone, playerColor, remainingToDraw, maxHandCount) then
    return
  end

  -- Still nothing? Broadcast error
  local playerStr = getPlayerStr(playerColor)
  local broadcastStr = string.format("%s: No more cards to draw from Reserves or Developments!", playerStr)
  if Player[playerColor].seated then broadcastToColor(broadcastStr, playerColor, "Orange") end
end


function handleTurnResupplyBroadcast(playerColor)
  -- handle broadcast of resupply cards onPlayerTurn

  local checkZones = {
    getObjectbyNameAndNotes("Zone Duty Officer", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
    getObjectbyNameAndNotes("Zone Captain", playerColor),
  }
  local matchCards = {}
  for i = 1, #checkZones do
    for _, object in pairs(checkZones[i].getObjects()) do
      if object.hasTag('resupply') then
        object.highlightOn(playerColor)
        table.insert(matchCards, object)
        Wait.time(function() object.highlightOff() end, 5)
      end
    end
  end

  -- broadcast if resupply cards found
  if #matchCards > 0 then
    local playerStr = getPlayerStr(playerColor)
    local headlineStr = string.format("[%s]Reminder[-] - Current in play Resupply Step Cards for %s:", Color.fromString(playerColor):toHex(), playerStr)
    broadcastToAll(headlineStr, "White")
    Wait.time(function()

      for i = 1, #matchCards do
        broadcastToAll(matchCards[i].getName(), "White")
      end

    end, 0.5)
  end
end


function refreshPlayerArea(playerColor)
  -- handles cleanup of a player area on turn end

  -- check for stardate card in zones, announce reminder and return out if one is located
  local stardateCheckZone = getObjectbyNameAndNotes("Zone Stardate Player", playerColor)
  local isBot = checkPlayerColorIsBot(playerColor)
  for _, object in pairs(stardateCheckZone.getObjects()) do
    if string.find(object.getName(), "Stardate") then
      local playerStr = getPlayerStr(playerColor)
      local broadcastStr = string.format("%s: Stardate Card found in player area. Resolve and remove Stardate card at the beginning of Clean-Up Step.", playerStr)
      broadcastToAll(broadcastStr, "Orange")
      return
    end
  end

  -- refresh action tokens
  local actionTokens = {}
  for _, object in pairs(getObjects()) do
    if object.getName() == "Action Token" and object.getGMNotes() == playerColor then
      table.insert(actionTokens, object)
    end
  end
  local rotActionTokens = playerColor == "Blue" and { 0.00, 120.00, 180.00 } or { 0.00, 300.00, 180.00 }
  local posActionTokens = playerColor == "Blue" and { { -34.25, 0.80, 22.50 }, { -34.25, 0.80, 20.50 }, { -34.25, 0.80, 18.50 } } or
                                                    { { 34.25, 0.80, -22.50 }, { 34.25, 0.80, -20.50 }, { 34.25, 0.80, -18.50 } }
  if #actionTokens > 0 then
    for i = 1, #actionTokens do
      if actionTokens[i] ~= nil then
        actionTokens[i].setRotation(rotActionTokens)
        actionTokens[i].setPositionSmooth(posActionTokens[i], false, true)
      end
    end
  end

  -- discard staging area cards
  local checkZone = getObjectbyNameAndNotes("Zone In Play", playerColor)
  local rotDiscard = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 }
  if isBot then rotDiscard = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 } end
  local posDiscard = playerColor == "Blue" and { -44.57, 2.00, -21.00 } or { 44.57, 2.00, 21.00 }
  for _, zoneObj in pairs(checkZone.getObjects()) do
    if zoneObj.tag == "Card" or zoneObj.tag == "Deck" then
      zoneObj.setRotation(rotDiscard)
      zoneObj.setPositionSmooth(posDiscard, false, true)
    end
  end

  -- refresh exhausted cards
  local checkZones = {
    getObjectbyNameAndNotes("Zone Captain", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
    getObjectbyNameAndNotes("Zone Duty Officer", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
  }
  local rotRefresh = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 }
  for i = 1, #checkZones do
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      if zoneObj.tag == "Card" then
        zoneObj.setRotationSmooth(rotRefresh, false, true)
      end
    end
  end

  -- destroy any summoned action tokens
  local tokenCount  = 0
  for _, object in pairs(getObjects()) do
    if object.hasTag('refresh_destruct_' .. string.lower(playerColor)) then
      object.destruct()
      tokenCount  = tokenCount + 1
    end
  end
  if tokenCount > 0 then
    local playerStr = getPlayerStr(playerColor)
    local broadcastStr = string.format("%s - Extra Action Token%s %s been destroyed.", playerStr, tokenCount > 1 and "s" or "", tokenCount > 1 and "have" or "has")
    broadcastToAll(broadcastStr, "White")
  end
  -- -- remove on turn end cloaking
  -- local zone_1 = playerarea_color == "Blue" and getObjectFromGUID("2c336e") or getObjectFromGUID("77d0cb")
  -- local zone_2 = playerarea_color == "Blue" and getObjectFromGUID("fc7f21") or getObjectFromGUID("5103b2")
  -- local zones  = {zone_1, zone_2}
  -- for i = 1, 2 do
  --     for _, object in pairs(zones[i].getObjects()) do
  --         local desc = object.getDescription()
  --         local cloaked_via = desc:sub(1, 11) == "Cloaked via"
  --         if cloaked_via then
  --             object.setDescription("")
  --             object.highlightOff()
  --             object.removeTag('trait_cloak')
  --             -- change ship color back to playerarea_color
  --             for _, obj in pairs(getObjects()) do
  --                 if (obj.getName() == object.getName()) and obj.hasTag('snap_ship') then
  --                     obj.highlightOff()
  --                     obj.highlightOn(playerarea_color)
  --                 end
  --             end
  --         end
  --     end
  -- end
end


function onObjectDrop(_, droppedObject)
  if not droppedObject then
    return
  end

  if not droppedObject.hasTag("goalToken") then
    return
  end

  local posGoalTokens = {
    -- 1 through 3 = advanced side, 4 = basic side
    -- values are blue, x, z will need to be * -1 for red
    ["Burnham"]  = { { -38.70, 1.05, 20.07 }, { -38.70, 1.05, 16.30 }, { -38.99, 1.05, 12.55 }, { -38.64, 1.05, 18.85 } },
    ["Koloth"]   = { { -38.64, 1.05, 20.01 }, { -38.94, 1.05, 16.26 }, { -38.69, 1.05, 12.51 }, { -38.68, 1.05, 18.89 } },
    ["Picard"]   = { { -38.70, 1.05, 19.99 }, { -38.70, 1.05, 16.24 }, { -38.68, 1.05, 12.47 }, { -38.63, 1.05, 18.93 } },
    ["Sela"]     = { { -38.68, 1.05, 20.02 }, { -38.68, 1.05, 16.27 }, { -38.68, 1.05, 12.51 }, { -38.66, 1.05, 18.88 } },
    ["Shran"]    = { { -38.67, 1.05, 20.02 }, { -38.67, 1.05, 16.26 }, { -38.67, 1.05, 12.51 }, { -38.64, 1.05, 18.89 } },
    ["Sisko"]    = { { -38.71, 1.05, 20.00 }, { -38.98, 1.05, 16.24 }, { -38.70, 1.05, 12.49 }, { -38.70, 1.05, 18.87 } },
    ["Archer"]   = { { -38.50, 1.05, 20.31 }, { -38.50, 1.05, 16.45 }, { -38.50, 1.05, 12.60 }, { -38.71, 1.05, 18.84 } },
    ["Georgiou"] = { { -38.45, 1.05, 20.29 }, { -38.45, 1.05, 16.43 }, { -38.45, 1.05, 12.58 }, { -38.66, 1.05, 18.86 } },
    ["Khan"]     = { { -38.54, 1.05, 19.81 }, { -38.54, 1.05, 16.11 }, { -38.83, 1.05, 12.41 } },
    ["Kirk"]     = { { -38.76, 1.05, 19.73 }, { -38.48, 1.05, 16.14 }, { -38.48, 1.05, 12.58 }, { -38.71, 1.05, 18.86 } },
    ["Rebner"]   = { { -38.49, 1.05, 19.23 }, { -38.49, 1.05, 15.84 }, { -38.49, 1.05, 12.40 }, { -38.70, 1.05, 18.17 } },
    ["Soval"]    = { { -38.50, 1.05, 18.48 }, { -38.50, 1.05, 15.22 }, { -38.50, 1.05, 11.96 }, { -38.70, 1.05, 18.82 } },
    ["Freeman"]  = { { -38.48, 1.05, 19.48 }, { -38.48, 1.05, 15.88 }, { -38.46, 1.05, 12.31 }, { -38.67, 1.05, 18.84 } },
    ["Pike"]     = { { -38.44, 1.05, 19.28 }, { -38.44, 1.05, 15.87 }, { -38.44, 1.05, 12.46 }, { -38.63, 1.05, 18.35 } },
    ["Riker"]    = { { -38.52, 1.05, 18.88 }, { -38.51, 1.05, 15.57 }, { -38.49, 1.05, 12.26 }, { -38.70, 1.05, 18.83 } },
  }

  local goalNames = {
    ["Burnham"]  = {
      "Investigate The Burn",
      "Reunite The Federation",
      "Dealing With The Emerald Chain"
    },
    ["Koloth"]   = {
      "Expanding The Empire",
      "Romulan Weapons Trade Agreement",
      "Sabotage"
    },
    ["Picard"]   = {
      "Peace Negotiations",
      "Arbiter Of Succession",
      "Seek Out New Life"
    },
    ["Sela"]     = {
      "Romulan Might",
      "The Reunification Plot",
      "The Duras Plot"
    },
    ["Shran"]    = {
      "Securing Andoria's Borders",
      "Founding The Federation",
      "Andorian Mining Consortium"
    },
    ["Sisko"]    = {
      "A Call To Arms",
      "Bajor's Application To The Federation",
      "Contacting The Dominion"
    },
    ["Archer"]   = {
      "History With Every Light-Year",
      "Coalition Of Planets",
      "Temporal Cold War"
    },
    ["Georgiou"] = {
      "Call In The Reinforcements",
      "Hardly A Negotiation",
      "Gazing At The Stars"
    },
    ["Khan"]     = {
      "I've Hurt You",
      "I Shall Leave You As You Left Me",
      "Marooned For All Eternity! Buried Alive!"
    },
    ["Kirk"]     = {
      "Where No Man Has Gone Before",
      "The Undiscovered Country",
      "Search For Spock"
    },
    ["Rebner"]   = {
      "Things That Make Us Smart",
      "Things That Make Us Strong",
      "Things That Make Us Fast",
    },
    ["Soval"]    = {
      "My Mind To Your Mind",
      "Cooperation With Starfleet",
      "The Needs Of The Many"
    },
    ["Freeman"]  = {
      "Project Swing By",
      "Beta Shift",
      "Calling All Your Friends"
    },
    ["Pike"]     = {
      "Weight Of The Future",
      "Boy Scout",
      "To Explore"
    },
    ["Riker"]    = {
      "Battling The Pakled",
      "Spirit Of Starfleet",
      "Messages From Old Friends"
    }
  }

  local captainCardZone
  local captainName
  local boardSide

  local tokenPos = droppedObject.getPosition()
  local tokenPlayerColor

  if tokenPos.x < 0 and tokenPos.z > 0 then
    tokenPlayerColor = "Blue"
  elseif tokenPos.x > 0 and tokenPos.z < 0 then
    tokenPlayerColor = "Red"
  else
    return
  end

  captainCardZone = getObjectbyNameAndNotes("Zone Captain Card", tokenPlayerColor)

  if not captainCardZone then
    return
  end

  for _, zoneObj in pairs(captainCardZone.getObjects()) do
    local objectName = zoneObj.getName()
    local basicSuffix = " Crew Board Basic"
    local advancedSuffix = " Crew Board Advanced"

    if objectName == "Khan Crew Board" then
      captainName = "Khan"
      boardSide = "Advanced"
      break
    elseif objectName:sub(-#basicSuffix) == basicSuffix then
      captainName = objectName:sub(1, #objectName - #basicSuffix)
      boardSide = "Basic"
      break
    elseif objectName:sub(-#advancedSuffix) == advancedSuffix then
      captainName = objectName:sub(1, #objectName - #advancedSuffix)
      boardSide = "Advanced"
      break
    end
  end

  if not captainName or not boardSide then
    return
  end

  local checkStart
  local checkEnd

  if boardSide == "Advanced" then
    checkStart = 1
    checkEnd = 3
  else
    checkStart = 4
    checkEnd = 4
  end

  local captainPositions = posGoalTokens[captainName]

  if not captainPositions then
    return
  end

  Wait.time(function()

    local dropPos = droppedObject.getPosition()
    local tolerance = 0.15

    for i = checkStart, checkEnd do
      local targetPos = captainPositions[i]
      if targetPos then
        local targetX = targetPos[1]
        local targetZ = targetPos[3]

        if tokenPlayerColor == "Red" then
          targetX = targetX * -1
          targetZ = targetZ * -1
        end

        if math.abs(dropPos.x - targetX) <= tolerance
            and math.abs(dropPos.z - targetZ) <= tolerance then

          local goalList = goalNames[captainName]

          if not goalList then
            return
          end

          local goalIndex = boardSide == "Advanced" and i or 1
          local goalName = goalList[goalIndex]

          if not goalName then
            return
          end

          local playerStr = getPlayerStr(tokenPlayerColor)
          local broadcastStr = string.format("%s has marked their Captain Goal as Completed: %s", playerStr, goalName)
          broadcastToAll(broadcastStr, "White")

          return
        end
      end
    end

  end, 0.5)
end