    hover_color    = { 1, 1, 1, .6 },
    tooltip        = "Shuffle discard pile, refresh draw deck.\n\nLeft Click: Automatically draw back up to hand size, including automatic Enlisting.\n\nRight click: Refresh the discard pile into a draw deck, without drawing back up to Hand Size.\n(Good for cases where you're cycling the deck while drawing 1 to a few cards during your turn. [b]Enlist manually in this case[/b]).",
  })
end



function reportResupplyCleanup(buttonObj, _, altClick)
  -- handles report of currently in play Resupply cards
  -- alt click will simply highlight, not broadcast
  -- "in play" meaning card within ship deploy, location deploy, captain, or duty officer zones

  local playerColor = buttonObj.getGMNotes()
  local buttonType = buttonObj.getName():find("Resupply") and "Resupply" or "Clean-Up"
  local buttonTag = buttonType == "Resupply" and "resupply" or "cleanup"

  -- animate button
  animateButton(buttonObj)

  -- check in play areas
  local checkZones = {
    getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
    getObjectbyNameAndNotes("Zone Captain", playerColor),
    getObjectbyNameAndNotes("Zone Duty Officer", playerColor),
  }
  if buttonType == "Clean-Up" then
    table.insert(checkZones, getObjectbyNameAndNotes("Zone In Play", playerColor))
  end

  -- gather resupply cards, highlight for 5 seconds
  local foundCards = {}
  for i = 1, #checkZones do
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      if zoneObj.hasTag(buttonTag) then
        table.insert(foundCards, zoneObj)

        -- briefly highlight found current type card, 5 seconds
        if zoneObj then
          zoneObj.highlightOn(playerColor)
        end
        Wait.time(function()

          if zoneObj then
            zoneObj.highlightOff()
          end

         end, 5)
      end
    end
  end

  -- broadcast if not right clicked (altClick will only highlight)
  if not altClick and #foundCards > 0 then
    local playerStr = getPlayerStr(playerColor)
    local headlineStr = string.format("%s - Current in play %s Step Cards:", playerStr, buttonType)
    local bulletStr = string.format("[%s]* [-]", Color.fromString(playerColor):toHex())
    broadcastToAll(headlineStr, "White")
    Wait.time(function()

      for i = 1, #foundCards do
        local cardName = foundCards[i].getName()
        local listStr = string.format("%s %s", bulletStr, cardName)
        broadcastToAll(listStr, "White")
      end

    end, 0.5)
  end
end


function reportTraits(buttonObj, _, _)
  -- wrapper that handles the report of any in play cards for skill icons, suits, and traits

  animateButton(buttonObj)

  local playerColor = buttonObj.getGMNotes()
  local buttonName = buttonObj.getName()
  local buttonType = (buttonName:find("Skills") and "Skills") or
                     (buttonName:find("Suits") and "Suits") or
                     (buttonName:find("Species") and "Species") or
                     (buttonName:find("Regular") and "Regular") or
                     (buttonName:find("Other") and "Other") or "None"
  if buttonType == "Skills" then
    reportCurrentSkills(playerColor)
  elseif buttonType == "Suits" then
    reportCurrentSuits(playerColor)
  elseif buttonType == "Species" or buttonType == "Regular" or buttonType == "Other" then
    reportCurrentTraits(playerColor, buttonType)
  end
end


function reportCurrentSkills(playerColor)
  -- handles the reporting of current skill icon count for playerColor

  local inPlaySkillIcons = {
    influence = 0,
    military  = 0,
    research  = 0,
    wildcard  = 0,
  }
  local inPlaySkillCards = {
    influence = {},
    military  = {},
    research = {},
    wildcard = {},
  }
  local nivarTraits = {
    vulcan     = 0,
    ambassador = 0,
    romulan    = 0,
  }
  local checkZones = {
    getObjectbyNameAndNotes("Zone Captain", playerColor),
    getObjectbyNameAndNotes("Zone In Play", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
    getObjectbyNameAndNotes("Zone Duty Officer", playerColor),
  }

  for i = 1, #checkZones do
    -- check i zone for in play skill icons
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      for k, _ in pairs(inPlaySkillIcons) do
        if zoneObj.hasTag("skill_" .. k) then
          inPlaySkillIcons[k] = inPlaySkillIcons[k] + 1
          table.insert(inPlaySkillCards[k], zoneObj.getName() .. ": 1")
        elseif zoneObj.hasTag("skill_x2_" .. k) then
          inPlaySkillIcons[k] = inPlaySkillIcons[k] + 2
          table.insert(inPlaySkillCards[k], zoneObj.getName() .. ": 2")
        elseif zoneObj.hasTag("skill_x3_" .. k) then
          inPlaySkillIcons[k] = inPlaySkillIcons[k] + 3
          table.insert(inPlaySkillCards[k], zoneObj.getName() .. ": 3")
        end
      end

      -- check i zone for in play ni'var match traits
      for k, _ in pairs(nivarTraits) do
        if zoneObj.hasTag("trait_" .. k) then
          nivarTraits[k] = nivarTraits[k] + 1
        end
      end
    end
  end

  -- check beam bags
  local checkBeamBagObjs = {}
  for _, obj in pairs(getObjects()) do
    if obj.getName() == "Beamed Cards" and obj.getGMNotes() == playerColor then
      table.insert(checkBeamBagObjs, obj)
    end
  end

  local beamedSkillIcons = {
    influence = 0,
    military  = 0,
    research  = 0,
    wildcard  = 0,
  }

  if #checkBeamBagObjs > 0 then
    for i = 1, #checkBeamBagObjs do
      local checkBag = checkBeamBagObjs[i]

      for _, bagObj in pairs(checkBag.getObjects()) do
        for k, _ in pairs(beamedSkillIcons) do
          for _, tag in pairs(bagObj.tags) do
            if tag == "skill_" .. k then
              beamedSkillIcons[k] = beamedSkillIcons[k] + 1
              table.insert(inPlaySkillCards[k], bagObj.name .. ": 1")
            end

            if tag == "skill_x2_" .. k then
              beamedSkillIcons[k] = beamedSkillIcons[k] + 2
              table.insert(inPlaySkillCards[k], bagObj.name .. ": 2")
            end

            if tag == "skill_x3_" .. k then
              beamedSkillIcons[k] = beamedSkillIcons[k] + 3
              table.insert(inPlaySkillCards[k], bagObj.name .. ": 3")
            end
          end
        end
      end
    end
  end

  -- make total count, including handling all the special cases
  local skillIcons = {
    influence = 0,
    military  = 0,
    research  = 0,
    wildcard  = 0,
  }

  for k, v in pairs(skillIcons) do
    skillIcons[k] = inPlaySkillIcons[k] + beamedSkillIcons[k]
  end

  -- check if ni'var is currently in play
  local nivarInPlay = false
  for i = 1, #checkZones do
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      if zoneObj.getName() == "Ni'var" then
        nivarInPlay = true
        break
      end

      if nivarInPlay then
        break
      end
    end
  end

  if nivarInPlay then
    if nivarTraits["vulcan"] > 0 then
      skillIcons["research"] = skillIcons["research"] + nivarTraits["vulcan"]
      table.insert(inPlaySkillCards["research"], "Ni'var: " .. nivarTraits["vulcan"])
    end

    if nivarTraits["ambassador"] > 0 then
      skillIcons["influence"] = skillIcons["influence"] + nivarTraits["ambassador"]
      table.insert(inPlaySkillCards["influence"], "Ni'var: " .. nivarTraits["ambassador"])
    end

    if nivarTraits["romulan"] > 0 then
      skillIcons["military"] = skillIcons["military"] + nivarTraits["romulan"]
      table.insert(inPlaySkillCards["military"], "Ni'var: " .. nivarTraits["romulan"])
    end
  end

  -- check if keyla detmer (burnham deck) is currently in DO slot
  local checkZoneDO = getObjectbyNameAndNotes("Zone Duty Officer", playerColor)

  for _, zoneObj in pairs(checkZoneDO.getObjects()) do
    if zoneObj.getName() == "Keyla Detmer" then
      skillIcons["wildcard"] = skillIcons["wildcard"] + 2
      table.insert(inPlaySkillCards["wildcard"], "Keyla Detmer: 2")
    end
  end

  -- put the broadcast together
  local traitsFound = false
  for k, v in pairs(skillIcons) do
    if v > 0 then
      traitsFound = true
    end
  end

  local function rgbToHex(color)
    local r = math.floor(color[1] * 255)
    local g = math.floor(color[2] * 255)
    local b = math.floor(color[3] * 255)

    return string.format("%02X%02X%02X", r, g, b)
  end

  if traitsFound then
    local playerStr = getPlayerStr(playerColor)
    local headlineStr = string.format("%s - Current In-Play Skill Icons:", playerStr)
    broadcastToAll(headlineStr, "White")

    local reportColors = {
      influence = { 212/255, 209/255, 41/255 },
      military = { 193/255, 30/255, 30/255 },
      research = { 21/255, 151/255, 196/255 },
      wildcard = { 128/255, 0, 128/255 },
    }

    for k, v in pairs(skillIcons) do
      if v > 0 then
        local altText = k:sub(1, 1):upper() .. k:sub(2)
        local reportColor = reportColors[k]

        if beamedSkillIcons[k] > 0 then
          local broadcastStr = string.format(
            "[%s]*[-] [%s]%dx [-][%s]%s[-] - (%d Beamed, %d Not Beamed)",
            Color.fromString(playerColor):toHex(),
            Color.fromString("White"):toHex(),
            v,
            rgbToHex(reportColor),
            altText,
            beamedSkillIcons[k],
            inPlaySkillIcons[k]
          )
          broadcastToAll(broadcastStr, "White")
        else
          local broadcastStr = string.format(
            "[%s]*[-] [%s]%dx [-][%s]%s[-] - %d (Not Beamed)",
            Color.fromString(playerColor):toHex(),
            Color.fromString("White"):toHex(),
            v,
            rgbToHex(reportColor),
            altText,
            v
          )
          broadcastToAll(broadcastStr, "White")
        end

        -- show contributing card names
        for _, line in ipairs(inPlaySkillCards[k]) do
          local broadcastStr = string.format(
            "    [%s]*[-] %s",
            rgbToHex(reportColor),
            line
          )
          broadcastToAll(broadcastStr, "White")
        end
      end
    end
  end
end


function reportCurrentSuits(playerColor)
  -- handles the reporting of current card suit count for playerColor

  local cardSuits = {
    ally      = 0,
    captain   = 0,
    cargo     = 0,
    directive = 0,
    encounter = 0,
    incident  = 0,
    mission   = 0,
    location  = 0,
    person    = 0,
    ship      = 0,
  }
  local checkZones = {
    getObjectbyNameAndNotes("Zone Captain", playerColor),
    getObjectbyNameAndNotes("Zone In Play", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
    getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
    getObjectbyNameAndNotes("Zone Duty Officer", playerColor),
  }

  -- check zones
  for i = 1, #checkZones do
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      for k, _ in pairs(cardSuits) do
        if zoneObj.hasTag("suit_" .. k) then
          cardSuits[k] = cardSuits[k] + 1
        end
      end
    end
  end

  -- put the broadcast together
  local traitsFound = false
  for k, v in pairs(cardSuits) do
    if v > 0 then
      traitsFound = true
    end
  end

  if traitsFound then
    local playerStr = getPlayerStr(playerColor)
    local headlineStr = string.format("%s - Current In-Play Card Suits:", playerStr)
    broadcastToAll(headlineStr, "White")

    for k, v in pairs(cardSuits) do
      if v > 0 then
        local altText = k:sub(1, 1):upper() .. k:sub(2)
        local listStr = string.format(
          "[%s]*[-] %dx %s",
          Color.fromString(playerColor):toHex(),
          v,
          altText
        )
        broadcastToAll(listStr, "White")
      end
    end
  end
end


