        { 13, 4 },
        { 15, 5},
      }
    },

    Riker = {
      influence = {
        { 4, 1 },
        { 9, 3 },
        { 13, 4 },
        { 15, 5 },
      },
      military = {
        { 1, 1 },
        { 6, 2 },
        { 10, 3 },
        { 14, 4 },
        { 15, 6},
      },
