        { 4, 1 },
        { 9, 3 },
        { 12, 4 },
        { 15, 5 }
      }
    },

    Shran = {
      influence = {
        { 1, 1 },
        { 6, 2 },
        { 9, 3 },
        { 12, 4 },
        { 14, 5 },
        { 15, 6 }
      },
      military = {
        { 2, 1 },
        { 7, 2 },
        { 10, 3 },
        { 14, 5 },
        { 15, 6 }
      },
      research = {
        { 4, 1 },
        { 9, 3 },
        { 12, 4 },
        { 15, 5 }
      }
    },

    Sisko = {
      influence = {
        { 1, 1 },
        { 6, 2 },
        { 9, 3 },
        { 12, 4 },
        { 14, 5 },
        { 15, 6 }
      },
      military = {
        { 3, 1 },
        { 8, 2 },
        { 12, 4 },
        { 14, 5 },
        { 15, 6 }
      },
      research = {
        { 2, 1 },
        { 7, 2 },
        { 10, 3 },
        { 14, 5 },
        { 15, 7 }
      }
    },

    Archer = {
      influence = {
        { 2, 1 },
