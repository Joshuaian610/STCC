function closeBlueUI()
  UI.setAttribute("blue_andorian_panel", "active", "false")
  UI.setAttribute("blue_klingon_panel", "active", "false")
  UI.setAttribute("blue_romulan_panel", "active", "false")
  UI.setAttribute("blue_starfleet_panel", "active", "false")
  UI.setAttribute("blue_khan_panel", "active", "false")
  UI.setAttribute("blue_pakled_panel", "active", "false")
  UI.setAttribute("blue_vulcan_panel", "active", "false")
  UI.setAttribute("ui_hide_blue", "active", "false")
  UI.setAttribute("ui_show_blue", "active", "false")
  UI.hide("bot_controls")
end


