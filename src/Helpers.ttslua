function showBlueUI()
  -- handles the showing of the on screen Blue Player XML UI Panel

  local captainName = getCaptainName("Blue")

  if captainName == "Burnham" or captainName == "Picard" or captainName == "Sisko" or
     captainName == "Georgiou" or captainName == "Archer" or captainName == "Kirk" or
     captainName == "Riker" or captainName == "Pike" or captainName == "Freeman" then
    UI.setAttribute("blue_starfleet_panel", "active", "true")
  elseif captainName == "Shran" then
    UI.setAttribute("blue_andorian_panel", "active", "true")
  elseif captainName == "Sela" then
    UI.setAttribute("blue_romulan_panel", "active", "true")
  elseif captainName == "Koloth" then
    UI.setAttribute("blue_klingon_panel", "active", "true")
  elseif captainName == "Khan" then
    UI.setAttribute("blue_khan_panel", "active", "true")
  elseif captainName == "Rebner" then
    UI.setAttribute("blue_pakled_panel", "active", "true")
  elseif captainName == "Soval" then
    UI.setAttribute("blue_vulcan_panel", "active", "true")
  end

  UI.setAttribute("ui_show_blue", "active", "false")
  UI.setAttribute("ui_hide_blue", "active", "true", "Blue")

  if checkIsBot() then
    UI.show("bot_controls")
  end
end


function showRedUI()
  -- handles the showing of the on screen Red Player XML UI Panel

  local captainName = getCaptainName("Red")

  if captainName == "Burnham" or captainName == "Picard" or captainName == "Sisko" or
     captainName == "Georgiou" or captainName == "Archer" or captainName == "Kirk" or
     captainName == "Riker" or captainName == "Pike" or captainName == "Freeman" then
    UI.setAttribute("red_starfleet_panel", "active", "true")
  elseif captainName == "Shran" then
    UI.setAttribute("red_andorian_panel", "active", "true")
  elseif captainName == "Sela" then
    UI.setAttribute("red_romulan_panel", "active", "true")
  elseif captainName == "Koloth" then
    UI.setAttribute("red_klingon_panel", "active", "true")
  elseif captainName == "Khan" then
    UI.setAttribute("red_khan_panel", "active", "true")
  elseif captainName == "Rebner" then
    UI.setAttribute("red_pakled_panel", "active", "true")
  elseif captainName == "Soval" then
    UI.setAttribute("red_vulcan_panel", "active", "true")
  end

  UI.setAttribute("ui_show_red", "active", "false")
  UI.setAttribute("ui_hide_red", "active", "true", "Red")

  if checkIsBot() then
    UI.show("bot_controls")
  end
end