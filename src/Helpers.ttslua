        { 14, 5 },
        { 15, 7 }
      },
      military = {
        { 4, 1 },
        { 9, 3 },
        { 13, 4 },
        { 15, 5 }
      },
      research = {
        { 1, 1 },
        { 6, 2 },
        { 9, 3 },
        { 12, 4 },
        { 14, 5 },
        { 15, 6 }
      }
    },

    Sela = {
      influence = {
        { 4, 1 },
        { 9, 3 },
        { 13, 4 },
        { 15, 5 }
      },
      military = {
        { 4, 1 },
        { 9, 3 },
        { 13, 4 },
        { 15, 5 }
      },
