
function getObjectbyName(objName)
  for _, object in pairs(getObjects()) do
    if object.getName() == objName then
      return object
    end
  end
  return nil
end


function getObjectbyNameAndNotes(objName, objNotes)
  for _, object in pairs(getObjects()) do
    if object.getName() == objName and object.getGMNotes() == objNotes then
      return object
    end
  end
  return nil
end


function getObjectbyNameAndTag(objName, objTag)
  for _, object in pairs(getObjects()) do
    if object.getName() == objName and object.hasTag(objTag) then
      return object
    end
  end
  return nil
end


function getObjectFromBagbyName(objName, bag, objRot, objPos, moveSmooth)
  local returnObj = nil
  for _, bagObj in pairs(bag.getObjects()) do
    if bagObj.name == objName then
      local takeObj = bag.takeObject({ guid = bagObj.guid, rotation = objRot })
      returnObj = takeObj
      if moveSmooth then
        takeObj.setPositionSmooth(objPos, false, true)
      else
        takeObj.setPosition(objPos)
      end
    end
  end
  return returnObj
end


function getObjectbyNameAndType(objName, objType)
  local returnObj = nil
  for _, object in pairs(getObjects()) do
    if object.getName() == objName and object.type == objType then  
      returnObj = object
    end
  end
  return returnObj
end


function getPlayerStr(playerColor)
  -- handles the creation of playerStr for broadcasts
  if playerColor == nil then return "Player" end
  local playerColorIsBot = checkPlayerColorIsBot(playerColor)
  local captainName = getCaptainName(playerColor)
  local playerStr = (Player[playerColor].steam_name ~= nil and not playerColorIsBot) and
                    string.format(
                      "[%s]%s%s[-]",
                      Color.fromString(playerColor):toHex(),
                      Player[playerColor].steam_name,
                      captainName ~= "None" and " ("..captainName..")" or ""
                    ) or
                    string.format(
                      "[%s]%s[-]",
                      Color.fromString(playerColor):toHex(),
                      playerColorIsBot and (captainName .. " Bot") or (playerColor .. " Player")
                    )
  return playerStr
end


function getPlayerColor(cardObj)
  -- handles the detection of which side a card is currently on, returns playerColor
    local playerColor = nil
    local blueZones = {
      getObjectbyNameAndNotes("Zone Deploy Ship", "Blue"),
      getObjectbyNameAndNotes("Zone Deploy Location", "Blue"),
    }
    local redZones = {
      getObjectbyNameAndNotes("Zone Deploy Ship", "Red"),
      getObjectbyNameAndNotes("Zone Deploy Location", "Red"),
    }
    for i = 1, 2 do
      for _, zoneObj in pairs(blueZones[i].getObjects()) do
        if cardObj == zoneObj then
          playerColor = "Blue"
        end
      end
      for _, zoneObj in pairs(redZones[i].getObjects()) do
        if cardObj == zoneObj then
          playerColor = "Red"
        end
      end
    end
    return playerColor
end


function getCaptainName(playerColor)
  -- checks and returns currently seated captain name at playerColor
  local captainCheckZone = getObjectbyNameAndNotes("Zone Captain Card", playerColor)
  local padCaptain = getObjectbyName("Pad Crew Board " .. playerColor)
  local captainBoardName = "None"
  for _, zoneObj in pairs(captainCheckZone.getObjects()) do
    if zoneObj.getName():find("Crew Board") and zoneObj ~= padCaptain then
      captainBoardName = zoneObj.getName()
    end
  end
  local splitName = {}
  if captainBoardName ~= "None" then
    for str in string.gmatch(captainBoardName,  "%S+") do
      table.insert(splitName, str)
    end
    captainBoardName = splitName[1]
  end
  return captainBoardName
end


function checkPlayerColorIsBot(playerColor)
  -- checks and returns if a specified playerColor is currently in solo bot mode
  -- captain board pad's gmnotes specifies enabled (this color is a bot) or disabled (this color is human)
  local playerColorIsBot = false
  local padCaptain = playerColor and getObjectbyName("Pad Crew Board " .. playerColor) or nil
  if padCaptain ~= nil then
    if padCaptain.getGMNotes() == "enabled" then
      playerColorIsBot = true
    end
  end

  return playerColorIsBot
end


function checkIsAdvanced(playerColor)
  -- checks a particular playerColor to see if an advanced board is in position there
  local checkZone = getObjectbyNameAndNotes("Zone Captain Card", playerColor)
  local isAdvanced = false
  for _, zoneObj in pairs(checkZone.getObjects()) do
    if zoneObj.getName():find("Advanced") then isAdvanced = true end
  end
  return isAdvanced
end


function checkIsBot()
  -- checks and returns if there is currently a solo bot in play
  local isBot = false
  if checkPlayerColorIsBot("Blue") or checkPlayerColorIsBot("Red") then
    isBot = true
  end
  return isBot
end


function checkIsCadet()
  -- handles check if current game mode is Cadet bot, checks stardate pad GMNotes

  local padStardate = getObjectbyName("Pad Stardate")
  local isCadet = false
  if padStardate.getGMNotes() == "Cadet" then isCadet = true end
  return isCadet
end


function animateButton(buttonObj)
  local downFactor = .30
  if string.find(buttonObj.getName(), "Button Market Resource") then
    downFactor = .19
  end
  local pos = buttonObj.getPosition()
  pos.y = pos.y - downFactor
  buttonObj.clearButtons()
  buttonObj.setPosition(pos)
  pos.y = pos.y + downFactor
  if buttonObj.getName():find("Button Refresh Draw Deck") then
    buttonObj.setPositionSmooth(pos, false, true)
  end
  Wait.time(function()

    if buttonObj.getName():find("Button Control Location") then
      initButtonControlNZLocation(buttonObj)

    elseif buttonObj.getName() == "Button Pull Action Token" then
      initButtonPullActionToken(buttonObj)

    elseif buttonObj.getName() == "Button Report Resupply" or
           buttonObj.getName() == "Button Report Cleanup" then
      initButtonReportResupplyCleanup(buttonObj)
    elseif buttonObj.getName():find("Button Report") and (buttonObj.getName() ~= "Button Report Resupply" and buttonObj.getName() ~= "Button Report Cleanup") then
      initButtonReportCurrentTraits(buttonObj)
    elseif buttonObj.getName() == "Button Discard Hand" then
      initButtonDiscardHand(buttonObj)
    elseif buttonObj.getName() == "Button Take Incident" then
      initButtonTakeIncident(buttonObj)
    end

  end, .2)

  Wait.time(function()
    -- refresh button requires extended refresh timing
    if buttonObj.getName():find("Button Refresh Draw Deck") then
      buttonObj.setPositionSmooth(pos, false, true)
      initButtonRefreshDrawDeck(buttonObj)
    end

  end, 5)
end