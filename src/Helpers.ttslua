      }
    },
  }

  -- if khan, determine special multipliers
  if captainName == "Khan" then
    local khanColor
    for _, zone in pairs(captainBoard.getZones()) do
      if zone.getGMNotes():find("Blue") then khanColor = "Blue" break end
      if zone.getGMNotes():find("Red") then khanColor = "Red" break end
    end

    local khanInExile = getKhanInExile()
    local isBot = checkPlayerColorIsBot(khanColor)

    if khanInExile then
      if isBot then
        influenceMultiplier = 1
        militaryMultiplier = 1
        researchMultiplier = 1
      else
        influenceMultiplier = 0
        militaryMultiplier = 0
        researchMultiplier = 0
      end
    elseif isBot and not khanInExile then
      influenceMultiplier = 3
      militaryMultiplier = 3
      researchMultiplier = 3
    else
      local traitCount = 0
      local checkZone = getObjectbyNameAndNotes("Zone Captain Card", khanColor)

      for _, zoneObj in pairs(checkZone.getObjects()) do
        if zoneObj.getName():find("Trait Tracker") and zoneObj.is_face_down then
          traitCount = traitCount + 1
        end
      end

      if traitCount == 12 then
        influenceMultiplier = 3
        militaryMultiplier = 3
        researchMultiplier = 3
      else
        influenceMultiplier = 1
        militaryMultiplier = 1
        researchMultiplier = 1
      end
    end

    return influenceMultiplier, militaryMultiplier, researchMultiplier
  end

  local captainData = captainMultipliers[captainName]

  if captainData then
    influenceMultiplier = getMultiplier(influenceCount, captainData.influence)
    militaryMultiplier = getMultiplier(militaryCount, captainData.military)
    researchMultiplier = getMultiplier(researchCount, captainData.research)

    if boardSide == "Advanced" then
      influenceMultiplier = influenceMultiplier - 1
      militaryMultiplier = militaryMultiplier - 1
      researchMultiplier = researchMultiplier - 1

      if influenceMultiplier > 0 then influenceMultiplier = 0 end
      if militaryMultiplier > 0 then militaryMultiplier = 0 end
      if researchMultiplier > 0 then researchMultiplier = 0 end
    end
  end

  return influenceMultiplier, militaryMultiplier, researchMultiplier
end


function checkPlayerColorIsBot(playerColor)
  -- checks and returns if a specified playerColor is currently in solo bot mode
  -- captain board pad's gmnotes specifies enabled (this color is a bot) or disabled (this color is human)
  local playerColorIsBot = false
  local padCaptain = playerColor and getObjectbyName("Pad Crew Board " .. playerColor) or nil
  if padCaptain ~= nil then
    if padCaptain.getGMNotes() == "enabled" then
      playerColorIsBot = true
    end
  end

  return playerColorIsBot
end


function checkIsAdvanced(playerColor)
  -- checks a particular playerColor to see if an advanced board is in position there
  local checkZone = getObjectbyNameAndNotes("Zone Captain Card", playerColor)
  local isAdvanced = false
  for _, zoneObj in pairs(checkZone.getObjects()) do
    if zoneObj.getName():find("Advanced") then isAdvanced = true end
  end
  return isAdvanced
end


function checkIsBot()
  -- checks and returns if there is currently a solo bot in play
  local isBot = false
  if checkPlayerColorIsBot("Blue") or checkPlayerColorIsBot("Red") then
    isBot = true
  end
  return isBot
end


function checkIsCadet()
  -- handles check if current game mode is Cadet bot, checks stardate pad GMNotes

  local padStardate = getObjectbyName("Pad Stardate")
  local isCadet = false
  if padStardate.getGMNotes() == "Cadet" then isCadet = true end
  return isCadet
end


function animateButton(buttonObj)
  local downFactor = .30
  if string.find(buttonObj.getName(), "Button Market Resource") then
    downFactor = .19
  end
  local pos = buttonObj.getPosition()
  pos.y = pos.y - downFactor
  buttonObj.clearButtons()
  buttonObj.setPosition(pos)
  pos.y = pos.y + downFactor
  if not buttonObj.getName():find("Button Refresh Draw Deck") then
    buttonObj.setPositionSmooth(pos, false, true)
  end
  Wait.time(function()

    if buttonObj.getName():find("Button Control Location") then
      initButtonControlNZLocation(buttonObj)

    elseif buttonObj.getName() == "Button Pull Action Token" then
      initButtonPullActionToken(buttonObj)

    elseif buttonObj.getName() == "Button Report Resupply" or
           buttonObj.getName() == "Button Report Cleanup" then
      initButtonReportResupplyCleanup(buttonObj)

    elseif buttonObj.getName():find("Button Report") and (buttonObj.getName() ~= "Button Report Resupply" and buttonObj.getName() ~= "Button Report Cleanup") then
      initButtonReportCurrentTraits(buttonObj)

    elseif buttonObj.getName() == "Button Discard Hand" then
      initButtonDiscardHand(buttonObj)

    elseif buttonObj.getName() == "Button Take Incident" then
      initButtonTakeIncident(buttonObj)

    elseif buttonObj.getName():find("Button Junk Market") then
      initButtonJunkCard(buttonObj)

    elseif buttonObj.getName():find("Button Take Market") then
      initButtonTakeCard(buttonObj)

    elseif buttonObj.getName():find("Button Deck Gain Market") or
           buttonObj.getName():find("Button Discard Gain Market") then
      initButtonGainCard(buttonObj)

    elseif buttonObj.getName():find("Button Market Resource") then
      initButtonAddResource(buttonObj)

    elseif buttonObj.getName():find("Calculate Score Button") then
      initButtonCalculateScore(buttonObj)

    end

  end, .2)

  Wait.time(function()
    -- refresh button requires extended refresh timing
    if buttonObj.getName():find("Button Refresh Draw Deck") then
      buttonObj.setPositionSmooth(pos, false, true)
      initButtonRefreshDrawDeck(buttonObj)
    end

  end, 5)
end



