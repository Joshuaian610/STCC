function checkPicard(checkZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)
  -- Picard: score 1 for every ally card owned

  local allyCount = 0
  -- check zones for ally trait
  for i = 1, 8 do
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      if zoneObj.type == "Card" and zoneObj.hasTag('suit_ally') then
        allyCount = allyCount + 1
      end
      if zoneObj.type == "Deck" then
        for _, deckObj in pairs(zoneObj.getObjects()) do
            local deckObjTags = deckObj.tags
          for j = 1, #deckObjTags do
            if deckObjTags[j] == "suit_ally" then
              allyCount = allyCount + 1
            end
          end
        end
      end
    end
  end

  -- check bags for ally trait
  for _, bagObj in pairs(bagCaptainsLog.getObjects()) do
    local bagObjTags = bagObj.tags
    for i = 1, #bagObjTags do
      if bagObjTags[i] == "suit_ally" then
        allyCount = allyCount + 1
      end
    end
  end
  for i = 1, #beamBags do
    for _, bagObj in pairs(beamBags[i].getObjects()) do
      local bagObjTags = bagObj.tags
      for j = 1, #bagObjTags do
        if bagObjTags[j] == "suit_ally" then
          allyCount = allyCount + 1
        end
      end
    end
  end

  if isBot then
    allyCount = 5
  end
  if allyCount > 0 then
    table.insert(endgameCardList, {["Jean-Luc Picard"] = allyCount})
    notebookStr = notebookStr .. "\nJean-Luc Picard: " .. allyCount
  end

  return endgameCardList, notebookStr
end


