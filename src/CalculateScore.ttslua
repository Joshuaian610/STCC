function checkSela(checkZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)
  -- Sela: score 1 for every non romulan/reman attack card

  local attackCount = 0
  -- check zones for attack trait
  for i = 1, #checkZones do
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      if zoneObj.type == "Card" and zoneObj.hasTag('trait_attack') and
      (zoneObj.hasTag('trait_romulan') == false and zoneObj.hasTag('trait_reman') == false) then
        attackCount = attackCount + 1
      end
      if zoneObj.type == "Deck" then
        for _, deckObj in pairs(zoneObj.getObjects()) do
          local deckObjTags = deckObj.tags
          for j = 1, #deckObjTags do
            if deckObjTags[j] == "trait_attack" then
              local romulanOrRemusFound = false
              for _, tag in pairs(deckObjTags) do
                if tag == "trait_romulan" or tag == "trait_reman" then
                  romulanOrRemusFound = true
                end
              end
              if not romulanOrRemusFound then attackCount = attackCount + 1 end
            end
          end
        end
      end
    end
  end

  -- check bags for attack trait
  for _, bagObj in pairs(bagCaptainsLog.getObjects()) do
    local bagObjTags = bagObj.tags
    for i = 1, #bagObjTags do
      if bagObjTags[i] == "trait_attack" then
        local romulanOrRemusFound = false
        for _, tag in pairs(bagObjTags) do
          if tag == "trait_romulan" or tag == "trait_reman" then
            romulanOrRemusFound = true
          end
        end
        if not romulanOrRemusFound then attackCount = attackCount + 1 end
      end
    end
  end
  for i = 1, #beamBags do
    for _, bagObj in pairs(beamBags[i].getObjects()) do
      local bagObjTags = bagObj.tags
      for j = 1, #bagObjTags do
        if bagObjTags[j] == "trait_attack" then
          local romulanOrRemusFound = false
          for _, tag in pairs(bagObjTags) do
            if tag == "trait_romulan" or tag == "trait_reman" then
              romulanOrRemusFound = true
            end
          end
          if not romulanOrRemusFound then attackCount = attackCount + 1 end
        end
      end
    end
  end
  if isBot then attackCount = 5 end
  if attackCount > 0 then
    table.insert(endgameCardList, {["Sela"] = attackCount})
    notebookStr = notebookStr .. "\nSela: " .. attackCount
  end

  return endgameCardList, notebookStr
end


function checkRebner(checkZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)
  -- Rebner: score 1 for every 2 non Helmet cargo cards

  local cargoCount = 0

  -- check zones for cargo trait
  for i = 1, #checkZones do
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      if zoneObj.type == "Card" and zoneObj.hasTag('suit_cargo') and not zoneObj.hasTag('trait_helmet') then
        cargoCount = cargoCount + 1
      end
      if zoneObj.type == "Deck" then
        for _, deckObj in pairs(zoneObj.getObjects()) do
          local deckObjTags = deckObj.tags
          local helmetFound = false
          for _, tag in pairs(deckObjTags) do
            if tag == "trait_helmet" then
              helmetFound = true
            end
          end
          if not helmetFound then
            for j = 1, #deckObjTags do
              if deckObjTags[j] == "suit_cargo" then
                cargoCount = cargoCount + 1
              end
            end
          end
        end
      end
    end
  end

  -- check bags for cargo trait
  for _, bagObj in pairs(bagCaptainsLog.getObjects()) do
    local bagObjTags = bagObj.tags
    local helmetFound = false
    for _, tag in pairs(bagObjTags) do
      if tag == "trait_helmet" then
        helmetFound = true
      end
    end
    if not helmetFound then
      for i = 1, #bagObjTags do
        if bagObjTags[i] == "suit_cargo" then
          cargoCount = cargoCount + 1
        end
      end
    end
  end

  for i = 1, #beamBags do
    for _, bagObj in pairs(beamBags[i].getObjects()) do
      local bagObjTags = bagObj.tags
      local helmetFound = false
      for _, tag in pairs(bagObjTags) do
        if tag == "trait_helmet" then
          helmetFound = true
        end
      end
      if not helmetFound then
        for j = 1, #bagObjTags do
          if bagObjTags[j] == "suit_cargo" then
            cargoCount = cargoCount + 1
          end
        end
      end
    end
  end

  local rebnerScore = math.floor(cargoCount / 2)
  if isBot then rebnerScore = 5 end

  if rebnerScore > 0 then
    table.insert(endgameCardList, {["Rebner"] = rebnerScore})
    notebookStr = notebookStr .. "\nRebner: " .. rebnerScore
  end

  return endgameCardList, notebookStr
end


function checkGeorgiou(inPlayCheckZones, beamBags, isBot, endgameCardList, notebookStr)
  -- Georgiou: score 1 for every 3 cards in play

  local cardCount = 0
  -- check zones for cards
  for i = 1, #inPlayCheckZones do
    for _, zoneObj in pairs(inPlayCheckZones[i].getObjects()) do
      if zoneObj.type == "Card" then
        cardCount = cardCount + 1
      end
      if zoneObj.type == "Deck" then
        for _, deckObj in pairs(zoneObj.getObjects()) do
          cardCount = cardCount + 1
        end
      end
    end
  end

  -- check beam bags for cards
  for i = 1, #beamBags do
    for _, bagObj in pairs(beamBags[i].getObjects()) do
      cardCount = cardCount + 1
    end
  end

  local georgiouScore = math.floor(cardCount / 3)
  if isBot then georgiouScore = 5 end

  if georgiouScore > 0 then
    table.insert(endgameCardList, {["Philippa Georgiou"] = georgiouScore})
    notebookStr = notebookStr .. "\nPhilippa Georgiou: " .. georgiouScore
  end

  return endgameCardList, notebookStr
end


function checkArcher(inPlayCheckZones, beamBags, isBot, endgameCardList, notebookStr)
  -- Archer: score 1 for every 3 unique traits you have in play

  local traitList = {}
  -- check zones for traits
  for i = 1, #inPlayCheckZones do
    for _, zoneObj in pairs(inPlayCheckZones[i].getObjects()) do
      if zoneObj.type == "Card" then
        for _, tag in pairs(zoneObj.tags) do
          if tag:sub(1, 6) == "trait_" then
            traitList[tag] = true
          end
        end
      end
      if zoneObj.type == "Deck" then
        for _, deckObj in pairs(zoneObj.getObjects()) do
          for _, tag in pairs(deckObj.tags) do
            if tag:sub(1, 6) == "trait_" then
              traitList[tag] = true
            end
          end
        end
      end
    end
  end

  -- check beam bags for traits
  for i = 1, #beamBags do
    for _, bagObj in pairs(beamBags[i].getObjects()) do
      for _, tag in pairs(bagObj.tags) do
        if tag:sub(1, 6) == "trait_" then
          traitList[tag] = true
        end
      end
    end
  end

  local traitCount = 0
  for _ in pairs(traitList) do
    traitCount = traitCount + 1
  end

  local archerScore = math.floor(traitCount / 3)

  if isBot then archerScore = 5 end

  if archerScore > 0 then
    table.insert(endgameCardList, {["Jonathan Archer"] = archerScore})
    notebookStr = notebookStr .. "\nJonathan Archer: " .. archerScore
  end

  return endgameCardList, notebookStr
end


function checkSoval(inPlayCheckZones, beamBags, isBot, endgameCardList, notebookStr)
  -- Soval: score 1 for every in play person without vulcan

  local personCount = 0
  -- check zones for person trait
  for i = 1, #inPlayCheckZones do
    for _, zoneObj in pairs(inPlayCheckZones[i].getObjects()) do
      if zoneObj.type == "Card" and zoneObj.hasTag('suit_person') and
      zoneObj.hasTag('trait_vulcan') == false then
        personCount = personCount + 1
      end
      if zoneObj.type == "Deck" then
        for _, deckObj in pairs(zoneObj.getObjects()) do
          local deckObjTags = deckObj.tags
          local vulcanFound = false
          for _, tag in pairs(deckObjTags) do
            if tag == "trait_vulcan" then
              vulcanFound = true
            end
          end
          if not vulcanFound then
            for j = 1, #deckObjTags do
              if deckObjTags[j] == "suit_person" then
                personCount = personCount + 1
              end
            end
          end
        end
      end
    end
  end

  -- check beam bags for person trait
  for i = 1, #beamBags do
    for _, bagObj in pairs(beamBags[i].getObjects()) do
      local bagObjTags = bagObj.tags
      local vulcanFound = false
      for _, tag in pairs(bagObjTags) do
        if tag == "trait_vulcan" then
          vulcanFound = true
        end
      end
      if not vulcanFound then
        for j = 1, #bagObjTags do
          if bagObjTags[j] == "suit_person" then
            personCount = personCount + 1
          end
        end
      end
    end
  end

  local sovalScore = personCount
  if isBot then sovalScore = 5 end
  if sovalScore > 0 then
    table.insert(endgameCardList, {["Soval"] = sovalScore})
    notebookStr = notebookStr .. "\nSoval: " .. sovalScore
  end

  return endgameCardList, notebookStr
end


function checkKirk(isBot, playerColor, endgameCardList, notebookStr)
  -- Kirk: score 1 for every second step on lowest skill counter

  if isBot then
    table.insert(endgameCardList, {["Kirk"] = 5})
    notebookStr = notebookStr .. "\nKirk: 5"

  elseif not isBot then
    local influenceCount = getObjectbyName("Influence Counter " .. playerColor).getVar("val")
    local militaryCount = getObjectbyName("Military Counter " .. playerColor).getVar("val")
    local researchCount = getObjectbyName("Research Counter " .. playerColor).getVar("val")

    local lowestSkill = math.min(influenceCount, militaryCount, researchCount)
    local kirkScore = math.floor(lowestSkill / 2)

    if kirkScore > 0 then
      table.insert(endgameCardList, {["Kirk"] = kirkScore})
      notebookStr = notebookStr .. "\nKirk: " .. kirkScore
    end
  end

  return endgameCardList, notebookStr
end


function checkWrathfulKhan(checkZones, bagCaptainsLog, beamBags, isBot, playerColor, endgameCardList, notebookStr)
  -- Wrathful Khan: score 1 for every focus card, or 3 for every focus if all traits marked (isBot should return out)

  if isBot then
    return endgameCardList, notebookStr
  end

  local focusCount = 0
  -- check zones for focus cards
  for i = 1, #checkZones do
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      if zoneObj.type == "Card" then
        local gmNotes = zoneObj.getGMNotes()
        if gmNotes == "dip_multi" or gmNotes == "mil_multi" or gmNotes == "sci_multi" then
          focusCount = focusCount + 1
        end
      end
      if zoneObj.type == "Deck" then
        for _, deckObj in pairs(zoneObj.getObjects()) do
          local gmNotes = deckObj.gm_notes
          if gmNotes == "dip_multi" or gmNotes == "mil_multi" or gmNotes == "sci_multi" then
            focusCount = focusCount + 1
          end
        end
      end
    end
  end

  -- check Captain's Log for focus cards
  for _, bagObj in pairs(bagCaptainsLog.getObjects()) do
    local gmNotes = bagObj.gm_notes
    if gmNotes == "dip_multi" or gmNotes == "mil_multi" or gmNotes == "sci_multi" then
      focusCount = focusCount + 1
    end
  end

  -- check beam bags for focus cards
  for i = 1, #beamBags do
    for _, bagObj in pairs(beamBags[i].getObjects()) do
      local gmNotes = bagObj.gm_notes
      if gmNotes == "dip_multi" or gmNotes == "mil_multi" or gmNotes == "sci_multi" then
        focusCount = focusCount + 1
      end
    end
  end

  -- check if all 12 traits are marked
  local traitZone = getObjectbyNameAndNotes("Zone Captain Card", playerColor)
  local markedTraitCount = 0
  for _, zoneObj in pairs(traitZone.getObjects()) do
    if zoneObj.getName():find("Trait Token") then
      if zoneObj.is_face_down then
        markedTraitCount = markedTraitCount + 1
      end
    end
  end

  local khanScore = focusCount
  if markedTraitCount == 12 then
    khanScore = focusCount * 3
  end

  if khanScore > 0 then
    table.insert(endgameCardList, {["Wrathful Khan"] = khanScore})
    notebookStr = notebookStr .. "\nWrathful Khan: " .. khanScore
  end

  return endgameCardList, notebookStr
end


function checkFreeman(bagCaptainsLog, isBot, endgameCardList, notebookStr)
