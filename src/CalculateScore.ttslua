function checkWeytahn(deployCheckZones, isBot, playerColor, endgameCardList, notebookStr)
  -- Weytahn: score 4 if 2 or more away teams are here

  local cardInPlay = false
  local cardObj
  for i = 1, #deployCheckZones do
    for _, zoneObj in pairs(deployCheckZones[i].getObjects()) do
      if zoneObj.getName() == "Weytahn" then
        cardInPlay = true
        cardObj = zoneObj
      end
    end
  end

  if cardInPlay then
    if not isBot then
      local tokenCount = 0
      local tokenTag = "away_" .. string.lower(playerColor)
      local cardPos = cardObj.getPosition()
      local cardScale = cardObj.getScale()

      local hits     = Physics.cast({
        origin       = cardPos + Vector( 0, 1, 0 ),
        direction    = Vector( 0, 1, 0 ),
        type         = 3,
        size         = Vector( 7 * cardScale.x, 1, 5 * cardScale.z ),
        max_distance = 2
      })

      for _, hit in pairs(hits) do
        local obj = hit.hit_object

        if obj.hasTag(tokenTag) then
          local tokenObjects = obj.getObjects()

          if #tokenObjects > 0 then
            tokenCount = tokenCount + #tokenObjects
          else
            tokenCount = tokenCount + 1
          end
        end
      end

      if tokenCount >= 2 then
        table.insert(endgameCardList, {["Weytahn"] = 4})
        notebookStr = notebookStr .. "\nWeytahn: 4"
      end
    elseif isBot then
      table.insert(endgameCardList, {["Weytahn"] = 5})
      notebookStr = notebookStr .. "\nWeytahn: 5"
    end
  end

  return endgameCardList, notebookStr
end


function checkColdStation(deployCheckZones, beamBags, playerColor, isBot, endgameCardList, notebookStr)
  -- Cold Station 12: Score 1 for every Augment beamed here

  -- get card position, use to determine beam bag
  local posCard = {}
  local cardInPlay = false
  for _, object in pairs(getObjects()) do
    if object.getName() == "Cold Station 12" then
      posCard = object.getPosition()
      for i = 1, #deployCheckZones do
        for _, zoneObj in pairs(deployCheckZones[i].getObjects()) do
          if zoneObj.getName() == "Cold Station 12" then
            cardInPlay = true
          end
        end
      end
    end
  end

  if cardInPlay then

    local beamBag = getAssociatedBeamBag(posCard, beamBags, playerColor)
    local augmentCount = 0
    if beamBag ~= nil then
      for _, bagObj in pairs(beamBag.getObjects()) do
        local bagObjTags = bagObj.tags
        for i = 1, #bagObjTags do
          if bagObjTags[i] == "suit_augment" then
            augmentCount = augmentCount + 1
          end
        end
      end
    end
    if isBot then augmentCount = 5 end
    if augmentCount > 0 then
      table.insert(endgameCardList, {["Cold Station 12"] = augmentCount})
      notebookStr = notebookStr .. "\nCold Station 12: " .. augmentCount
    end
  end

  return endgameCardList, notebookStr
end


function checkAzatiPrime(checkZones, deployCheckZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)
  -- Azati Prime: score 1 for each owned Xindi

