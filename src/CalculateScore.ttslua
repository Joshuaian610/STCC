-- ships

function checkUSSFederation(deployCheckZones, checkZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)
  -- U.S.S. Federation: score 1 for every card with military/influence focus (_multi in GMNotes)

  local cardInPlay = false
  for _, object in pairs(getObjects()) do
    if object.getName() == "U.S.S. Federation" then
      for i = 1, #deployCheckZones do
        for _, zoneObj in pairs(deployCheckZones[i].getObjects()) do
          if zoneObj.getName() == "U.S.S. Federation" then
            cardInPlay = true
          end
        end
      end
    end
  end

  if cardInPlay then

    local focusCount = 0
    -- check owned card zones for influence/military focus cards
    for i = 1, #checkZones do
      for _, zoneObj in pairs(checkZones[i].getObjects()) do
        if zoneObj.type == "Card" then
          if zoneObj.getGMNotes() == "dip_multi" or zoneObj.getGMNotes() == "mil_multi" then
            focusCount = focusCount + 1
          end
        elseif zoneObj.type == "Deck" then
          for _, deckObj in pairs(zoneObj.getObjects()) do
            if deckObj.gm_notes == "dip_multi" or deckObj.gm_notes == "mil_multi" then
              focusCount = focusCount + 1
            end
          end
        end
      end
    end

    -- check bags for focus cards
    for _, bagObj in pairs(bagCaptainsLog.getObjects()) do
      if bagObj.gm_notes == "dip_multi" or bagObj.gm_notes == "mil_multi" then
        focusCount = focusCount + 1
      end
    end
    for i = 1, #beamBags do
      for _, bagObj in pairs(beamBags[i].getObjects()) do
        if bagObj.gm_notes == "dip_multi" or bagObj.gm_notes == "mil_multi" then
          focusCount = focusCount + 1
        end
      end
    end
    if isBot then focusCount = 5 end
    if focusCount > 0 then
      table.insert(endgameCardList, {["U.S.S. Federation"] = focusCount})
      notebookStr = notebookStr .. "\nU.S.S. Federation: " .. focusCount
    end
  end

  return endgameCardList, notebookStr
end




-- encounters
function checkRedAngel(checkZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)
  -- Red Angel: Score 1 per owned Anomaly

  local cardInPlay = false

  for i = 1, #checkZones do
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      if zoneObj.getName() == "Red Angel" then
        cardInPlay = true
      end
    end
  end

  if cardInPlay then
    local anomalyCount = 0

    for i = 1, #checkZones do
      for _, zoneObj in pairs(checkZones[i].getObjects()) do
        if zoneObj.type == "Card" and zoneObj.hasTag("trait_anomaly") then
          anomalyCount = anomalyCount + 1
        end

        if zoneObj.type == "Deck" or zoneObj.type == "Bag" then
          local deckObjTags = zoneObj.tags

          for j = 1, #deckObjTags do
            if deckObjTags[j] == "trait_anomaly" then
              anomalyCount = anomalyCount + 1
            end
          end
        end
      end
    end

    for _, bagObj in pairs(bagCaptainsLog.getObjects()) do
      if bagObj.hasTag("trait_anomaly") then
        anomalyCount = anomalyCount + 1
      end

      if bagObj.type == "Deck" or bagObj.type == "Bag" then
        local bagObjTags = bagObj.tags

        for j = 1, #bagObjTags do
          if bagObjTags[j] == "trait_anomaly" then
            anomalyCount = anomalyCount + 1
          end
        end
      end
    end

    for i = 1, #beamBags do
      for _, bagObj in pairs(beamBags[i].getObjects()) do
        if bagObj.hasTag("trait_anomaly") then
          anomalyCount = anomalyCount + 1
        end

        if bagObj.type == "Deck" or bagObj.type == "Bag" then
          local bagObjTags = bagObj.tags

          for j = 1, #bagObjTags do
            if bagObjTags[j] == "trait_anomaly" then
              anomalyCount = anomalyCount + 1
            end
          end
        end
      end
    end

    local redAngelScore = anomalyCount

    if isBot then
      redAngelScore = 5
    end

    if redAngelScore > 0 then
      table.insert(endgameCardList, {["Red Angel"] = redAngelScore})
      notebookStr = notebookStr .. "\nRed Angel: " .. redAngelScore
    end
  end

  return endgameCardList, notebookStr
end




function getVPCount()
  -- gets count of VP from cards, focus or straight score
  -- returns lists of cards by category and playerColor

  local cardListBlue, cardListRed = getOwnedCards()
  local vpCardListBlue = {}
  local vpCardListRed = {}
  local influenceFocusCardListBlue = {}
  local influenceFocusCardListRed = {}
  local militaryFocusCardListBlue = {}
  local militaryFocusCardListRed = {}
  local researchFocusCardListBlue = {}
  local researchFocusCardListRed = {}
  local notebookStrVPBlue = ""
  local notebookStrVPRed = ""
  local notebookStrInfluenceBlue = ""
  local notebookStrInfluenceRed = ""
  local notebookStrMilitaryBlue = ""
  local notebookStrMilitaryRed = ""
  local notebookStrResearchBlue = ""
  local notebookStrResearchRed = ""
  local playerColors = { "Blue", "Red" }

  for i = 1, #playerColors do

    local playerColor = playerColors[i]

    local captainName = getCaptainName(playerColor)

    local influenceMultiplier = 0
    local militaryMultiplier = 0
    local researchMultiplier = 0

    local influenceCount = captainName == "Khan" and 0 or getObjectbyName("Influence Counter " .. playerColor).getVar("val")
    local militaryCount = captainName == "Khan" and 0 or getObjectbyName("Military Counter " .. playerColor).getVar("val")
    local researchCount = captainName == "Khan" and 0 or getObjectbyName("Research Counter " .. playerColor).getVar("val")

    local vpCardList = i == 1 and vpCardListBlue or vpCardListRed
    local influenceFocusCardList = i == 1 and influenceFocusCardListBlue or influenceFocusCardListRed
    local militaryFocusCardList = i == 1 and militaryFocusCardListBlue or militaryFocusCardListRed
    local researchFocusCardList = i == 1 and researchFocusCardListBlue or researchFocusCardListRed
    influenceMultiplier, militaryMultiplier, researchMultiplier = getTrackMultipliers(
      captainName, influenceCount, militaryCount, researchCount
    )

    local notebookStrVP = i == 1 and notebookStrVPBlue or notebookStrVPRed
    local notebookStrInfluence = i == 1 and notebookStrInfluenceBlue or notebookStrInfluenceRed
    local notebookStrMilitary = i == 1 and notebookStrMilitaryBlue or notebookStrMilitaryRed
    local notebookStrResearch = i == 1 and notebookStrResearchBlue or notebookStrResearchRed

    local notebookStrColor = i == 1 and "1E87FF" or "DB1B18"

    local checkZones = {
      getObjectbyNameAndNotes("Handzone", playerColor),
      getObjectbyNameAndNotes("Zone Captain", playerColor),
      getObjectbyNameAndNotes("Zone Draw Deck", playerColor),
      getObjectbyNameAndNotes("Zone Discard", playerColor),
      getObjectbyNameAndNotes("Zone In Play", playerColor),
      getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
      getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
      getObjectbyNameAndNotes("Zone Duty Officer", playerColor),
    }

    -- check zones, get VP & focus card list = score pairs
    for j = 1, #checkZones do
      for _, zoneObj in pairs(checkZones[j].getObjects()) do
        if zoneObj.type == "Card" then
          local cardName = zoneObj.getName()
          local vpCount = tonumber(zoneObj.getGMNotes():match("VP=(-?%d+)"))

          if vpCount then
            table.insert(vpCardList, {[cardName] = vpCount})
            notebookStrVP = notebookStrVP .. "\n" .. cardName .. ": " .. vpCount
          end

          if zoneObj.getGMNotes() == "dip_multi" and influenceMultiplier > 0 then
            table.insert(influenceFocusCardList, {[cardName] = influenceMultiplier})
            notebookStrInfluence = notebookStrInfluence .. "\n" .. cardName .. ": " .. influenceMultiplier
          end

          if zoneObj.getGMNotes() == "mil_multi" and militaryMultiplier > 0 then
            table.insert(militaryFocusCardList, {[cardName] = militaryMultiplier})
            notebookStrMilitary = notebookStrMilitary .. "\n" .. cardName .. ": " .. militaryMultiplier
          end

          if zoneObj.getGMNotes() == "sci_multi" and researchMultiplier > 0 then
            table.insert(researchFocusCardList, {[cardName] = researchMultiplier})
            notebookStrResearch = notebookStrResearch .. "\n" .. cardName .. ": " .. researchMultiplier
          end

        end
        if zoneObj.type == "Deck" then
          for _, deckObj in pairs(zoneObj.getObjects()) do
            local cardName = deckObj.name
            local vpCount = tonumber(deckObj.gm_notes:match("VP=(-?%d+)"))

            if vpCount then
              table.insert(vpCardList, {[cardName] = vpCount})
              notebookStrVP = notebookStrVP .. "\n" .. cardName .. ": " .. vpCount
            end

            if deckObj.gm_notes == "dip_multi" and influenceMultiplier > 0 then
              table.insert(influenceFocusCardList, {[cardName] = influenceMultiplier})
              notebookStrInfluence = notebookStrInfluence .. "\n" .. cardName .. ": " .. influenceMultiplier
            end

            if deckObj.gm_notes == "mil_multi" and militaryMultiplier > 0 then
              table.insert(militaryFocusCardList, {[cardName] = militaryMultiplier})
              notebookStrMilitary = notebookStrMilitary .. "\n" .. cardName .. ": " .. militaryMultiplier
            end

            if deckObj.gm_notes == "sci_multi" and researchMultiplier > 0 then
              table.insert(researchFocusCardList, {[cardName] = researchMultiplier})
              notebookStrResearch = notebookStrResearch .. "\n" .. cardName .. ": " .. researchMultiplier
            end
          end
        end
      end
    end

    -- check bags for VP or focus cards
    local bagCaptainsLog = getObjectbyNameAndNotes("Captain's Log", playerColor)
    for _, bagObj in pairs(bagCaptainsLog.getObjects()) do
      local cardName = bagObj.name
      local vpCount = tonumber(bagObj.gm_notes:match("VP=(-?%d+)"))

      if vpCount then
        table.insert(vpCardList, {[cardName] = vpCount})
        notebookStrVP = notebookStrVP .. "\n" .. cardName .. ": " .. vpCount
      end

      if bagObj.gm_notes == "dip_multi" and influenceMultiplier > 0 then
        table.insert(influenceFocusCardList, {[cardName] = influenceMultiplier})
        notebookStrInfluence = notebookStrInfluence .. "\n" .. cardName .. ": " .. influenceMultiplier
      end

      if bagObj.gm_notes == "mil_multi" and militaryMultiplier > 0 then
        table.insert(militaryFocusCardList, {[cardName] = militaryMultiplier})
        notebookStrMilitary = notebookStrMilitary .. "\n" .. cardName .. ": " .. militaryMultiplier
      end

      if bagObj.gm_notes == "sci_multi" and researchMultiplier > 0 then
        table.insert(researchFocusCardList, {[cardName] = researchMultiplier})
        notebookStrResearch = notebookStrResearch .. "\n" .. cardName .. ": " .. researchMultiplier
      end
    end

    local beamBags = {}
    for _, object in pairs(getObjects()) do
      if object.getName() == "Beamed Cards" and object.getGMNotes() == playerColor then
        table.insert(beamBags, object)
      end
    end
    for j = 1, #beamBags do
      for _, bagObj in pairs(beamBags[j].getObjects()) do
        local cardName = bagObj.name
        local vpCount = tonumber(bagObj.gm_notes:match("VP=(-?%d+)"))

        if vpCount then
          table.insert(vpCardList, {[cardName] = vpCount})
          notebookStrVP = notebookStrVP .. "\n" .. cardName .. ": " .. vpCount
        end

        if bagObj.gm_notes == "dip_multi" and influenceMultiplier > 0 then
          table.insert(influenceFocusCardList, {[cardName] = influenceMultiplier})
          notebookStrInfluence = notebookStrInfluence .. "\n" .. cardName .. ": " .. influenceMultiplier
        end

        if bagObj.gm_notes == "mil_multi" and militaryMultiplier > 0 then
          table.insert(militaryFocusCardList, {[cardName] = militaryMultiplier})
          notebookStrMilitary = notebookStrMilitary .. "\n" .. cardName .. ": " .. militaryMultiplier
        end

        if bagObj.gm_notes == "sci_multi" and researchMultiplier > 0 then
          table.insert(researchFocusCardList, {[cardName] = researchMultiplier})
          notebookStrResearch = notebookStrResearch .. "\n" .. cardName .. ": " .. researchMultiplier
        end
      end
    end

    -- assign gathered data back to respective color vars
    if i == 1 then
      notebookStrVPBlue = notebookStrVP
      notebookStrInfluenceBlue = notebookStrInfluence
      notebookStrMilitaryBlue = notebookStrMilitary
      notebookStrResearchBlue = notebookStrResearch

      vpCardListBlue = vpCardList
      influenceFocusCardListBlue = influenceFocusCardList
      militaryFocusCardListBlue = militaryFocusCardList
      researchFocusCardListBlue = researchFocusCardList
    elseif i == 2 then
      notebookStrVPRed = notebookStrVP
      notebookStrInfluenceRed = notebookStrInfluence
      notebookStrMilitaryRed = notebookStrMilitary
      notebookStrResearchRed = notebookStrResearch

      vpCardListRed = vpCardList
      influenceFocusCardListRed = influenceFocusCardList
      militaryFocusCardListRed = militaryFocusCardList
      researchFocusCardListRed = researchFocusCardList
    end
  end

  return vpCardListBlue, influenceFocusCardListBlue, militaryFocusCardListBlue, researchFocusCardListBlue, notebookStrVPBlue, notebookStrInfluenceBlue, notebookStrMilitaryBlue, notebookStrResearchBlue,
         vpCardListRed, influenceFocusCardListRed, militaryFocusCardListRed, researchFocusCardListRed, notebookStrVPRed, notebookStrInfluenceRed, notebookStrMilitaryRed, notebookStrResearchRed
end


function calculateScore(buttonObj, _, _)
  -- takes in all generated data and reports the score to both pad and notebook

  animateButton(buttonObj)

  -- prime notebook for action
  local tabs = Notes.getNotebookTabs()
  local blueColor = "1E87FF"
  local redColor = "DB1B18"
  local notebookStr = "Current Score Breakdown as it stands:"

  -- glory count
  local gloryCountBlue = getObjectbyName("Glory Counter Blue").getVar("val")
  local gloryCountRed = getObjectbyName("Glory Counter Red").getVar("val")
  notebookStr = string.format("%s\n\n[%s]Blue[-] Glory Score: %s\n[%s]Red[-] Glory Score: %s", notebookStr, blueColor, gloryCountBlue, redColor, gloryCountRed)


  -- neutral location count
  local blueNZCount, redNZCount = getNZCount()
  notebookStr = string.format("%s\n\n\n[%s]Blue[-] Neutral Zone Score: %s\n[%s]Red[-] Neutral Zone Score: %s", notebookStr, blueColor, blueNZCount, redColor, redNZCount)


  -- endgame scoring cards
  local endgameCardListBlue, notebookStrEndgameBlue, endgameCardListRed, notebookStrEndgameRed = getEndgameCount()
  local blueEndgameScore = 0
  local redEndgameScore = 0

  -- compile endgame score counts from card lists
  if #endgameCardListBlue > 0 then
    for _, item in pairs(endgameCardListBlue) do
      for _, scoreCount in pairs(item) do
        blueEndgameScore = blueEndgameScore + scoreCount
      end
    end
  end
  if #endgameCardListRed > 0 then
    for _, item in pairs(endgameCardListRed) do
      for _, scoreCount in pairs(item) do
        redEndgameScore = redEndgameScore + scoreCount
      end
    end
  end

  -- build notebookStr for endgame score counts
  notebookStr = string.format("%s\n\n\n[%s]Blue[-] End Game Cards Score: %s:", notebookStr, blueColor, blueEndgameScore)
  notebookStr = string.format("%s\n[%s]Red[-] End Game Cards Score: %s:", notebookStr, redColor, redEndgameScore)

  -- build notebookStr for breakdowns of endgame score cards
  if blueEndgameScore > 0 then
    notebookStr = string.format("%s\n\n[%s]Blue[-] End Game Cards Breakdown: %s", notebookStr, blueColor, notebookStrEndgameBlue)
  end
  if redEndgameScore > 0 then
    notebookStr = string.format("%s\n\n[%s]Red[-] End Game Cards Breakdown: %s", notebookStr, redColor, notebookStrEndgameRed)
  end


  -- VP scoring cards
  local vpCardListBlue, influenceFocusCardListBlue, militaryFocusCardListBlue, researchFocusCardListBlue, notebookStrVPBlue, notebookStrInfluenceBlue, notebookStrMilitaryBlue, notebookStrResearchBlue,
  vpCardListRed, influenceFocusCardListRed, militaryFocusCardListRed, researchFocusCardListRed, notebookStrVPRed, notebookStrInfluenceRed, notebookStrMilitaryRed, notebookStrResearchRed = getVPCount()

  local blueVPScore = 0
  local redVPScore = 0

  -- compile VP score counts from card lists
  for _, item in pairs(vpCardListBlue) do
    for _, scoreCount in pairs(item) do
      blueVPScore = blueVPScore + scoreCount
    end
  end
  for _, item in pairs(vpCardListRed) do
    for _, scoreCount in pairs(item) do
      redVPScore = redVPScore + scoreCount
    end
  end

  -- build notebookStr for VP score counts
  notebookStr = string.format("%s\n\n\n[%s]Blue[-] Card Victory Points Score: %s", notebookStr, blueColor, blueVPScore)
  notebookStr = string.format("%s\n[%s]Red[-] Card Victory Points Score: %s", notebookStr, redColor, redVPScore)

  -- build notebookStr for breakdown of VP score cards
  if blueVPScore > 0 then
    notebookStr = string.format("%s\n\n[%s]Blue[-] Card Victory Points Breakdown: %s", notebookStr, blueColor, notebookStrVPBlue)
  end
  if redVPScore > 0 then
    notebookStr = string.format("%s\n\n[%s]Red[-] Card Victory Points Breakdown: %s", notebookStr, redColor, notebookStrVPRed)
  end

  notebookStr = notebookStr .. "\n"


  -- focus multiplier cards
  local influenceColor = "D4D129"
  local militaryColor = "C11E1E"
  local researchColor = "1597C4"

  local blueCompletedGoals, redCompletedGoals = getCompletedGoals()
  local goalCompletedBlue = next(blueCompletedGoals) ~= nil
  local goalCompletedRed = next(redCompletedGoals) ~= nil

  local blueInfluenceScore = 0
  local blueMilitaryScore = 0
  local blueResearchScore = 0
  local redInfluenceScore = 0
  local redMilitaryScore = 0
  local redResearchScore = 0

  for _, v in pairs(influenceFocusCardListBlue) do
    for _, scoreCount in pairs(v) do
      blueInfluenceScore = blueInfluenceScore + scoreCount
    end
  end
  for _, v in pairs(militaryFocusCardListBlue) do
    for _, scoreCount in pairs(v) do
      blueMilitaryScore = blueMilitaryScore + scoreCount
    end
  end
  for _, v in pairs(researchFocusCardListBlue) do
    for _, scoreCount in pairs(v) do
      blueResearchScore = blueResearchScore + scoreCount
    end
  end

  for _, v in pairs(influenceFocusCardListRed) do
    for _, scoreCount in pairs(v) do
      redInfluenceScore = redInfluenceScore + scoreCount
    end
  end
  for _, v in pairs(militaryFocusCardListRed) do
    for _, scoreCount in pairs(v) do
      redMilitaryScore = redMilitaryScore + scoreCount
    end
  end
  for _, v in pairs(researchFocusCardListRed) do
    for _, scoreCount in pairs(v) do
      redResearchScore = redResearchScore + scoreCount
    end
  end


  if goalCompletedBlue or checkPlayerColorIsBot("Blue") and getCaptainName("Blue") ~= "Khan" then
    if blueResearchScore > 0 then
      notebookStr = string.format("%s\n\n[%s]Blue[-] [%s]Research[-] Focus Cards Score: %s", notebookStr, blueColor, researchColor, blueResearchScore)
      notebookStr = string.format("%s\n[%s]Blue[-] [%s]Research[-] Focus Cards Breakdown: %s", notebookStr, blueColor, researchColor, notebookStrResearchBlue)
    end
    if blueInfluenceScore > 0 then
      notebookStr = string.format("%s\n\n[%s]Blue[-] [%s]Influence[-] Focus Cards Score: %s", notebookStr, blueColor, influenceColor, blueInfluenceScore)
      notebookStr = string.format("%s\n[%s]Blue[-] [%s]Influence[-] Focus Cards Breakdown: %s", notebookStr, blueColor, influenceColor, notebookStrInfluenceBlue)
    end
    if blueMilitaryScore > 0 then
      notebookStr = string.format("%s\n\n[%s]Blue[-] [%s]Military[-] Focus Cards Score: %s", notebookStr, blueColor, militaryColor, blueMilitaryScore)
      notebookStr = string.format("%s\n[%s]Blue[-] [%s]Military[-] Focus Cards Breakdown: %s", notebookStr, blueColor, militaryColor, notebookStrMilitaryBlue)
    end
    notebookStr = notebookStr .. "\n"

  elseif not goalCompletedBlue and not checkPlayerColorIsBot("Blue") and getCaptainName("Blue") ~= "Khan" then
    notebookStr = string.format("%s\n[%s]Blue[-] Focus Cards Score: 0 (No Captain Goals Completed)", notebookStr, blueColor)
    blueInfluenceScore = 0
    blueMilitaryScore = 0
    blueResearchScore = 0

  elseif getCaptainName("Blue") == "Khan" then
    notebookStr = string.format("%s\n[%s]Blue[-] Focus Cards Score Under Wrathful Khan", notebookStr, blueColor)
    blueInfluenceScore = 0
    blueMilitaryScore = 0
    blueResearchScore = 0
  end

  if goalCompletedRed or checkPlayerColorIsBot("Red") and getCaptainName("Red") ~= "Khan" then
    if redResearchScore > 0 then
      notebookStr = string.format("%s\n\n[%s]Red[-] [%s]Research[-] Focus Cards Score: %s", notebookStr, redColor, researchColor, redResearchScore)
      notebookStr = string.format("%s\n[%s]Red[-] [%s]Research[-] Focus Cards Breakdown: %s", notebookStr, redColor, researchColor, notebookStrResearchRed)
    end
    if redInfluenceScore > 0 then
      notebookStr = string.format("%s\n\n[%s]Red[-] [%s]Influence[-] Focus Cards Score: %s", notebookStr, redColor, influenceColor, redInfluenceScore)
      notebookStr = string.format("%s\n[%s]Red[-] [%s]Influence[-] Focus Cards Breakdown: %s", notebookStr, redColor, influenceColor, notebookStrInfluenceRed)
    end
    if redMilitaryScore > 0 then
      notebookStr = string.format("%s\n\n[%s]Red[-] [%s]Military[-] Focus Cards Score: %s", notebookStr, redColor, militaryColor, redMilitaryScore)
      notebookStr = string.format("%s\n[%s]Red[-] [%s]Military[-] Focus Cards Breakdown: %s", notebookStr, redColor, militaryColor, notebookStrMilitaryRed)
    end
    notebookStr = notebookStr .. "\n"

  elseif not goalCompletedRed and not checkPlayerColorIsBot("Red") and getCaptainName("Red") ~= "Khan" then
    notebookStr = string.format("%s\n[%s]Red[-] Focus Cards Score: 0 (No Captain Goals Completed)", notebookStr, redColor)
    redInfluenceScore = 0
    redMilitaryScore = 0
    redResearchScore = 0

  elseif getCaptainName("Red") == "Khan" then
    notebookStr = string.format("%s\n[%s]Red[-] Focus Cards Score Under Wrathful Khan", notebookStr, redColor)
    redInfluenceScore = 0
    redMilitaryScore = 0
    redResearchScore = 0
  end
  notebookStr = notebookStr .. "\n"

  -- advanced mission stuff
  local blueAdvancedGoalScore = 0
  local redAdvancedGoalScore = 0
  local blueAdvancedGoalBreakdown = ""
  local redAdvancedGoalBreakdown = ""
  local blueAdvTooltip = "Goal"
  local redAdvTooltip = "Goal"

  if goalCompletedBlue then
    for goalName, scoreCount in pairs(blueCompletedGoals) do
      blueAdvancedGoalScore = blueAdvancedGoalScore + scoreCount

      if blueAdvancedGoalBreakdown == "" then
        blueAdvancedGoalBreakdown = string.format("%s: %s", goalName, scoreCount)
      else
        blueAdvancedGoalBreakdown = string.format("%s\n%s: %s", blueAdvancedGoalBreakdown, goalName, scoreCount)
      end
    end

    notebookStr = string.format("%s\n[%s]Blue[-] Goal Score: %s", notebookStr, blueColor, blueAdvancedGoalScore)
    notebookStr = string.format("%s\n[%s]Blue[-] Goal Breakdown: %s", notebookStr, blueColor, blueAdvancedGoalBreakdown)
  end

  if goalCompletedRed then
    for goalName, scoreCount in pairs(redCompletedGoals) do
      redAdvancedGoalScore = redAdvancedGoalScore + scoreCount

      if redAdvancedGoalBreakdown == "" then
        redAdvancedGoalBreakdown = string.format("%s: %s", goalName, scoreCount)
      else
        redAdvancedGoalBreakdown = string.format("%s\n%s: %s", redAdvancedGoalBreakdown, goalName, scoreCount)
      end
    end

    notebookStr = string.format("%s\n[%s]Red[-] Goal Score: %s", notebookStr, redColor, redAdvancedGoalScore)
    notebookStr = string.format("%s\n[%s]Red[-] Goal Breakdown: %s", notebookStr, redColor, redAdvancedGoalBreakdown)
  end


  -- SCORE PAD BUTTON CREATION
  local bluePad = getObjectbyName("Score Sheet Blue")
  local redPad = getObjectbyName("Score Sheet Red")
  local blueStr = "Blue"
  local redStr = "Red"
  local scorePads = { bluePad, redPad }
  local playerColors = { blueStr, redStr }
  local blueLuaColor = { 31/255, 136/255, 255/255 }
  local redLuaColor = { 219/255, 26/255, 24/255 }

  for i = 1, #playerColors do

    scorePads[i].clearButtons()

    -- create score text field buttons on every slot (reversed in color)
    local leftColor           = i == 1 and blueLuaColor              or redLuaColor
    local rightColor          = i == 1 and redLuaColor               or blueLuaColor

    local leftStr             = i == 1 and blueStr                   or redStr
    local rightStr            = i == 1 and redStr                    or blueStr

    local leftGloryCount      = i == 1 and gloryCountBlue             or gloryCountRed
    local rightGloryCount     = i == 1 and gloryCountRed              or gloryCountBlue

    local leftAwayCount       = i == 1 and blueNZCount                or redNZCount
    local rightAwayCount      = i == 1 and redNZCount                 or blueNZCount

    local leftEndgameCount    = i == 1 and blueEndgameScore            or redEndgameScore
    local rightEndgameCount   = i == 1 and redEndgameScore             or blueEndgameScore

    local leftVPCount         = i == 1 and blueVPScore                 or redVPScore
    local rightVPCount        = i == 1 and redVPScore                  or blueVPScore

    local leftResearchCount   = i == 1 and blueResearchScore           or redResearchScore
    local rightResearchCount  = i == 1 and redResearchScore            or blueResearchScore

    local leftInfluenceCount  = i == 1 and blueInfluenceScore          or redInfluenceScore
    local rightInfluenceCount = i == 1 and redInfluenceScore           or blueInfluenceScore

    local leftMilitaryCount   = i == 1 and blueMilitaryScore            or redMilitaryScore
    local rightMilitaryCount  = i == 1 and redMilitaryScore             or blueMilitaryScore

    local leftGoalCount       = i == 1 and blueAdvancedGoalScore        or redAdvancedGoalScore
    local rightGoalCount      = i == 1 and redAdvancedGoalScore         or blueAdvancedGoalScore

    local leftAdvTooltip      = i == 1 and blueAdvTooltip               or redAdvTooltip
    local rightAdvTooltip     = i == 1 and redAdvTooltip                or blueAdvTooltip

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = leftGloryCount,
      position       = { 0.06, 0.21, -0.65 },
      width          = 180,
      height         = 180,
      font_size      = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = leftColor,
      font_color     = { 1, 1, 1, 1 },
      tooltip        = "Current " .. leftStr .. " Glory points.",
    })

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = rightGloryCount,
      position       = { 0.55, 0.21, -0.65 },
      width          = 180,
      height         = 180,
      font_size      = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = rightColor,
      font_color     = { 1, 1, 1, 1 },
      tooltip        = "Current " .. rightStr .. " Glory points.",
    })

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = leftAwayCount,
      position       = { 0.06, 0.21, -0.45 },
      width          = 180,
      height         = 180,
      font_size      = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = leftColor,
      font_color     = { 1, 1, 1, 1 },
      tooltip        = "Current " .. leftStr .. " Neutral Zone token points.",
    })

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = rightAwayCount,
      position       = { 0.55, 0.21, -0.45 },
      width          = 180,
      height         = 180,
      font_size      = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = rightColor,
      font_color     = { 1, 1, 1, 1 },
      tooltip        = "Current " .. rightStr .. " Neutral Zone token points.",
    })

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = leftEndgameCount,
      position       = { 0.06, 0.21, -0.25 },
      width          = 180,
      height         = 180,
      font_size      = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = leftColor,
      font_color     = { 1, 1, 1, 1 },
      tooltip        = "Current " .. leftStr .. " Endgame Scoring points.",
    })

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = rightEndgameCount,
      position       = { 0.55, 0.21, -0.25 },
      width          = 180,
      height         = 180,
      font_size      = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = rightColor,
      font_color     = { 1, 1, 1, 1 },
      tooltip        = "Current " .. rightStr .. " Endgame Scoring points.",
    })

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = leftVPCount,
      position       = { 0.06, 0.21, -0.05 },
      width          = 180,
      height         = 180,
      font_size      = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = leftColor,
      font_color     = { 1, 1, 1, 1 },
      tooltip        = "Current " .. leftStr .. " Printed Victory points.",
    })

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = rightVPCount,
      position       = { 0.55, 0.21, -0.05 },
      width          = 180,
      height         = 180,
      font_size      = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = rightColor,
      font_color     = { 1, 1, 1, 1 },
      tooltip        = "Current " .. rightStr .. " Printed Victory points.",
    })

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = leftResearchCount,
      position       = { 0.06, 0.21, 0.15 },
      width          = 180,
      height         = 180,
      font_size      = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = leftColor,
      font_color     = { 1, 1, 1, 1 },
      tooltip        = "Current " .. leftStr .. " Research Multiplier points.",
    })

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = rightResearchCount,
      position       = { 0.55, 0.21, 0.15 },
      width          = 180,
      height         = 180,
      font_size      = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = rightColor,
      font_color     = { 1, 1, 1, 1 },
      tooltip        = "Current " .. rightStr .. " Research Multiplier points.",
    })

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = leftInfluenceCount,
      position       = { 0.06, 0.21, 0.35 },
      width          = 180,
      height         = 180,
      font_size      = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = leftColor,
      font_color     = { 1, 1, 1, 1 },
      tooltip        = "Current " .. leftStr .. " Influence Multiplier points.",
    })

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = rightInfluenceCount,
      position       = { 0.55, 0.21, 0.35 },
      width          = 180,
      height         = 180,
      font_size      = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = rightColor,
      font_color     = { 1, 1, 1, 1 },
      tooltip        = "Current " .. rightStr .. " Influence Multiplier points.",
    })

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = leftMilitaryCount,
      position       = { 0.06, 0.21, 0.55 },
      width          = 180,
      height         = 180,
      font_size       = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = leftColor,
      font_color      = { 1, 1, 1, 1 },
      tooltip         = "Current " .. leftStr .. " Military Multiplier points.",
    })

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = rightMilitaryCount,
      position       = { 0.55, 0.21, 0.55 },
      width          = 180,
      height         = 180,
      font_size       = 100,
      scale           = { 0.5, 0.5, 0.5 },
      color           = rightColor,
      font_color      = { 1, 1, 1, 1 },
      tooltip         = "Current " .. rightStr .. " Military Multiplier points.",
    })

    if leftGoalCount > 0 then
      scorePads[i].createButton({
        click_function = "nullFunc",
        function_owner = self,
        label          = leftGoalCount,
        position       = { 0.06, 0.21, 0.75 },
        width          = 180,
        height         = 180,
        font_size      = 100,
        scale          = { 0.5, 0.5, 0.5 },
        color          = leftColor,
        font_color     = { 1, 1, 1, 1 },
        tooltip        = "Current " .. leftStr .. " " .. leftAdvTooltip .. " points.",
      })
    end

    if rightGoalCount > 0 then
      scorePads[i].createButton({
        click_function = "nullFunc",
        function_owner = self,
        label          = rightGoalCount,
        position       = { 0.55, 0.21, 0.75 },
        width          = 180,
        height         = 180,
        font_size      = 100,
        scale          = { 0.5, 0.5, 0.5 },
        color          = rightColor,
        font_color     = { 1, 1, 1, 1 },
        tooltip        = "Current " .. rightStr .. " " .. rightAdvTooltip .. " points.",
      })
    end

    local leftTotal = leftGloryCount + leftAwayCount + leftEndgameCount + leftVPCount + leftResearchCount + leftInfluenceCount + leftMilitaryCount + leftGoalCount
    local rightTotal = rightGloryCount + rightAwayCount + rightEndgameCount + rightVPCount + rightResearchCount + rightInfluenceCount + rightMilitaryCount + rightGoalCount

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = leftTotal,
      position       = { 0.06, 0.21, 0.92 },
      width          = 260,
      height         = 180,
      font_size      = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = leftColor,
      font_color     = { 1, 1, 1, 1 },
      tooltip        = "Current " .. leftStr .. " Total points.",
    })

    scorePads[i].createButton({
      click_function = "nullFunc",
      function_owner = self,
      label          = rightTotal,
      position       = { 0.55, 0.21, 0.92 },
      width          = 260,
      height         = 180,
      font_size      = 100,
      scale          = { 0.5, 0.5, 0.5 },
      color          = rightColor,
      font_color     = { 1, 1, 1, 1 },
      tooltip        = "Current " .. rightStr .. " Total points.",
    })
  end

  -- set tab with full notebook string
  if blueAdvancedGoalScore > 0 then
    notebookStr = notebookStr .. "\n[" .. blueColor .. "]Blue[-] " .. blueAdvTooltip .. " Score: " .. blueAdvancedGoalScore
  end
  if redAdvancedGoalScore > 0 then
    notebookStr = notebookStr .. "\n[" .. redColor .. "]Red[-] " .. redAdvTooltip .. " Score: " .. redAdvancedGoalScore
  end

  -- finally, build notebook
  for _, tab in pairs(tabs) do
    if tab.color == "Grey" then
      Notes.editNotebookTab({
        index = tab.index,
        title = "Score Breakdown",
        body  = notebookStr,
        color = "Grey"
      })
    end
  end

  broadcastToAll("Table current score updated!", "Green")
end



function getCompletedGoals()
  -- checks current completed captain goals via positional checks on tokens on captain boards
  local posGoalTokens = {
    -- 1 through 3 = advanced side, 4 = basic side
    -- values are blue, x, z will need to be * -1 for red
    ["Burnham"]  = { { -38.70, 1.05, 20.07 }, { -38.70, 1.05, 16.30 }, { -38.99, 1.05, 12.55 }, { -38.64, 1.05, 18.85 } },
    ["Koloth"]   = { { -38.64, 1.05, 20.01 }, { -38.94, 1.05, 16.26 }, { -38.69, 1.05, 12.51 }, { -38.68, 1.05, 18.89 } },
    ["Picard"]   = { { -38.70, 1.05, 19.99 }, { -38.70, 1.05, 16.24 }, { -38.68, 1.05, 12.47 }, { -38.63, 1.05, 18.93 } },
    ["Sela"]     = { { -38.68, 1.05, 20.02 }, { -38.68, 1.05, 16.27 }, { -38.68, 1.05, 12.51 }, { -38.66, 1.05, 18.88 } },
    ["Shran"]    = { { -38.67, 1.05, 20.02 }, { -38.67, 1.05, 16.26 }, { -38.67, 1.05, 12.51 }, { -38.64, 1.05, 18.89 } },
    ["Sisko"]    = { { -38.71, 1.05, 20.00 }, { -38.98, 1.05, 16.24 }, { -38.70, 1.05, 12.49 }, { -38.70, 1.05, 18.87 } },
    ["Archer"]   = { { -38.50, 1.05, 20.31 }, { -38.50, 1.05, 16.45 }, { -38.50, 1.05, 12.60 }, { -38.71, 1.05, 18.84 } },
    ["Georgiou"] = { { -38.45, 1.05, 20.29 }, { -38.45, 1.05, 16.43 }, { -38.45, 1.05, 12.58 }, { -38.66, 1.05, 18.86 } },
    ["Khan"]     = { { -38.54, 1.05, 19.81 }, { -38.54, 1.05, 16.11 }, { -38.83, 1.05, 12.41 } },
    ["Kirk"]     = { { -38.76, 1.05, 19.73 }, { -38.48, 1.05, 16.14 }, { -38.48, 1.05, 12.58 }, { -38.71, 1.05, 18.86 } },
    ["Rebner"]   = { { -38.49, 1.05, 19.23 }, { -38.49, 1.05, 15.84 }, { -38.49, 1.05, 12.40 }, { -38.70, 1.05, 18.17 } },
    ["Soval"]    = { { -38.50, 1.05, 18.48 }, { -38.50, 1.05, 15.22 }, { -38.50, 1.05, 11.96 }, { -38.70, 1.05, 18.82 } },
    ["Freeman"]  = { { -38.48, 1.05, 19.48 }, { -38.48, 1.05, 15.88 }, { -38.46, 1.05, 12.31 }, { -38.67, 1.05, 18.84 } },
    ["Pike"]     = { { -38.44, 1.05, 19.28 }, { -38.44, 1.05, 15.87 }, { -38.44, 1.05, 12.46 }, { -38.63, 1.05, 18.35 } },
    ["Riker"]    = { { -38.52, 1.05, 18.88 }, { -38.51, 1.05, 15.57 }, { -38.49, 1.05, 12.26 }, { -38.70, 1.05, 18.83 } },
  }

  local goalNames = {
    ["Burnham"] = {
      ["Investigate The Burn"]                     = 4,
      ["Reunite The Federation"]                   = 3,
      ["Dealing With The Emerald Chain"]           = 6,
    },
    ["Koloth"] = {
      ["Expanding The Empire"]                     = 3,
      ["Romulan Weapons Trade Agreement"]          = 1,
      ["Sabotage"]                                 = 4,
    },
    ["Picard"] = {
      ["Peace Negotiations"]                       = 5,
      ["Arbiter Of Succession"]                    = 3,
      ["Seek Out New Life"]                        = 2,
    },
    ["Sela"] = {
      ["Romulan Might"]                            = 4,
      ["The Reunification Plot"]                   = 4,
      ["The Duras Plot"]                           = 1,
    },
    ["Shran"] = {
      ["Securing Andoria's Borders"]               = 2,
      ["Founding The Federation"]                  = 4,
      ["Andorian Mining Consortium"]               = 3,
    },
    ["Sisko"] = {
