    ["Riker"] = {
      ["Battling The Pakled"]                      = 3,
      ["Spirit Of Starfleet"]                      = 2,
      ["Messages From Old Friends"]                = 2,
    }
  }

  local goalOrder = {
    ["Burnham"] = {
      "Investigate The Burn",
      "Reunite The Federation",
      "Dealing With The Emerald Chain",
    },
    ["Koloth"] = {
      "Expanding The Empire",
      "Romulan Weapons Trade Agreement",
      "Sabotage",
    },
    ["Picard"] = {
      "Peace Negotiations",
      "Arbiter Of Succession",
      "Seek Out New Life",
    },
    ["Sela"] = {
      "Romulan Might",
      "The Reunification Plot",
      "The Duras Plot",
    },
    ["Shran"] = {
      "Securing Andoria's Borders",
      "Founding The Federation",
      "Andorian Mining Consortium",
    },
    ["Sisko"] = {
      "A Call To Arms",
      "Bajor's Application To The Federation",
      "Contacting The Dominion",
    },
    ["Archer"] = {
      "History With Every Light-Year",
      "Coalition Of Planets",
      "Temporal Cold War",
    },
    ["Georgiou"] = {
      "Call In The Reinforcements",
      "Hardly A Negotiation",
      "Gazing At The Stars",
    },
    ["Khan"] = {
      "I've Hurt You",
      "I Shall Leave You As You Left Me",
      "Marooned For All Eternity! Buried Alive!",
    },
    ["Kirk"] = {
      "Where No Man Has Gone Before",
      "The Undiscovered Country",
      "Search For Spock",
    },
    ["Rebner"] = {
      "Things That Make Us Smart",
      "Things That Make Us Strong",
      "Things That Make Us Fast",
    },
    ["Soval"] = {
      "My Mind To Your Mind",
      "Cooperation With Starfleet",
      "The Needs Of The Many",
    },
    ["Freeman"] = {
      "Project Swing By",
      "Beta Shift",
      "Calling All Your Friends",
    },
    ["Pike"] = {
      "Weight Of The Future",
      "Boy Scout",
      "To Explore",
    },
    ["Riker"] = {
      "Battling The Pakled",
      "Spirit Of Starfleet",
      "Messages From Old Friends",
    }
  }

  local blueCompletedGoals = {}
  local redCompletedGoals = {}
  local blueCaptainName = getCaptainName("Blue")
  local redCaptainName = getCaptainName("Red")
  local blueCheckZone = getObjectbyNameAndNotes("Zone Captain Card", "Blue")
  local redCheckZone = getObjectbyNameAndNotes("Zone Captain Card", "Red")
  local tolerance = 0.20

  local function checkGoals(playerColor, captainName, checkZone, completedGoals)
    if not captainName or not checkZone or not posGoalTokens[captainName] or not goalNames[captainName] then
      return
    end

    local boardType = "Advanced"

    if captainName ~= "Khan" then
      for _, zoneObj in pairs(checkZone.getObjects()) do
        if zoneObj.getName():find("Crew Board") then
          if zoneObj.getName():find("Basic") then
            boardType = "Basic"
          elseif zoneObj.getName():find("Advanced") then
            boardType = "Advanced"
          end
          break
        end
      end
    end

    local tokenObjects = {}

    for _, zoneObj in pairs(checkZone.getObjects()) do
      if zoneObj.getName() == "Completed Goal Tokens" then
        table.insert(tokenObjects, zoneObj)
      end
    end

    local goalIndexes

    if boardType == "Basic" then
      goalIndexes = { 4 }
    else
      goalIndexes = { 1, 2, 3 }
    end

    local goalIndexToName = goalOrder[captainName]

    for _, posIndex in ipairs(goalIndexes) do
      local targetPos = posGoalTokens[captainName][posIndex]

      if targetPos then
        local targetX = targetPos[1]
        local targetZ = targetPos[3]

        if playerColor == "Red" then
          targetX = targetX * -1
          targetZ = targetZ * -1
        end

        for _, tokenObj in pairs(tokenObjects) do
          local tokenPos = tokenObj.getPosition()

          if math.abs(tokenPos.x - targetX) <= tolerance and
             math.abs(tokenPos.z - targetZ) <= tolerance then

            local goalName = goalIndexToName[posIndex == 4 and 1 or posIndex]

            if goalName then
              completedGoals[goalName] = goalNames[captainName][goalName]
            end

            break
          end
        end
      end
    end
  end

  checkGoals("Blue", blueCaptainName, blueCheckZone, blueCompletedGoals)
  checkGoals("Red", redCaptainName, redCheckZone, redCompletedGoals)

  return blueCompletedGoals, redCompletedGoals
end