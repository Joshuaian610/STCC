function checkVulcanKirk(deployCheckZones, isBot, playerColor, endgameCardList, notebookStr)
  -- Vulcan (Kirk): score the highest skill track value

  local cardInPlay = false
  local cardObj
  for i = 1, #deployCheckZones do
    for _, zoneObj in pairs(deployCheckZones[i].getObjects()) do
      if zoneObj.getName() == "Vulcan (Kirk)" then
        cardInPlay = true
        cardObj = zoneObj
      end
    end
  end

  if cardInPlay then

    if isBot then
      table.insert(endgameCardList, {["Kirk (Vulcan)"] = 5})
      notebookStr = notebookStr .. "\nKirk (Vulcan): 5"

    elseif not isBot then
      -- determine highest skill track value (no need for khan check to see if counter exists - it's a kirk card)
      local influenceCount = getObjectbyName("Influence Counter " .. playerColor).getVar("val")
      local militaryCount = getObjectbyName("Military Counter " .. playerColor).getVar("val")
      local researchCount = getObjectbyName("Research Counter " .. playerColor).getVar("val")

      local highestSkill = math.max(influenceCount, militaryCount, researchCount)

      table.insert(endgameCardList, {["Kirk (Vulcan)"] = highestSkill})
      notebookStr = notebookStr .. "\nKirk (Vulcan): " .. highestSkill
    end
  end

  return endgameCardList, notebookStr
end


