-- contains functions related to end game score calculation and reporting



function initButtonCalculateScore(buttonObj)
  buttonObj.clearButtons()
  buttonObj.createButton({
    click_function = "calculateScore",
    function_owner = self,
    label          = "",
    position       = { 0, 0.36, -0.01 },
    width          = 1700,
    height         = 435,
    scale          = { 2.3, 2.3, 2.3 },
    color          = { 1, 1, 1, .3 },
    hover_color    = { 1, 1, 1, .6 },
    tooltip        = "Clicking this button will update player scoring pads and player notebooks with the score as it currently stands. Ensure all cards are in their correct locations, all completed missions are checked off on Captain board, and Skill counters are correct to ensure correct scoring.\n\n *Important: If counting for Su'kal or Kelpians, manually return incidents before scoring.",
  })
end


function getNZCount()
  -- detects situation in neutral zone at end game, determines token counts for either color
  local blueNZCount = 0
  local redNZCount = 0
  local playerColors = { "Blue", "Red" }

  for i = 1, #playerColors do
    local playerColor = playerColors[i]
    local checkZones = {
      getObjectbyNameAndNotes("Zone NZ Player Top", playerColor),
      getObjectbyNameAndNotes("Zone NZ Player Middle", playerColor),
      getObjectbyNameAndNotes("Zone NZ Player Bottom", playerColor),
    }

    for j = 1, 3 do
      for _, zoneObj in pairs(checkZones[j].getObjects()) do
        -- count ships
        if zoneObj.hasTag("snap_ship") then
          if i == 1 then
            blueNZCount = blueNZCount + 1
          elseif i == 2 then
            redNZCount = redNZCount + 1
          end
        end
        -- count away teams
        if i == 1 then
          if zoneObj.hasTag("away_blue") then
            blueNZCount = blueNZCount + 1
          end
        elseif i == 2 then
          if zoneObj.hasTag("away_red") then
            redNZCount = redNZCount + 1
          end
        end
      end
    end
  end

  return blueNZCount, redNZCount
end


function getOwnedCards()
  -- detects and creates a list of owned cards at runtime for both player colors

  local cardListBlue = {}
  local cardListRed = {}
  local playerColors = { "Blue", "Red" }

  for i = 1, #playerColors do
    local playerColor = playerColors[i]
    local cardList = i == 1 and cardListBlue or cardListRed
    local checkZones = {
      getObjectbyNameAndNotes("Handzone", playerColor),
      getObjectbyNameAndNotes("Zone Captain", playerColor),
      getObjectbyNameAndNotes("Zone Draw Deck", playerColor),
      getObjectbyNameAndNotes("Zone Discard", playerColor),
      getObjectbyNameAndNotes("Zone In Play", playerColor),
      getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
      getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
      getObjectbyNameAndNotes("Zone Duty Officer", playerColor),
    }
    local bagCaptainsLog = getObjectbyNameAndNotes("Captain's Log", playerColor)
    local beamBags = {}
    for _, object in pairs(getObjects()) do
      if object.getName() == "Beamed Cards" and object.getGMNotes() == playerColor then
        table.insert(beamBags, object)
      end
    end

    -- detect cards/decks in zones
    for j = 1, #checkZones do
      for _, zoneObj in pairs(checkZones[j].getObjects()) do
        if zoneObj.type == "Card" then
          table.insert(cardList, zoneObj.getName())
        end
        if zoneObj.type == "Deck" then
          for _, deckObj in pairs(zoneObj.getObjects()) do
            table.insert(cardList, deckObj.name)
          end
        end
      end
    end

    -- cards in captain's log, beam bags
    for _, bagObj in pairs(bagCaptainsLog.getObjects()) do
      table.insert(cardList, bagObj.name)
    end
    for j = 1, #beamBags do
      for _, bagObj in pairs(beamBags[j].getObjects()) do
        table.insert(cardList, bagObj.name)
      end
    end
  end
  return cardListBlue, cardListRed
end


function getEndgameCount()
  -- checks scoring conditions of owned cards, formats reporting of endgame score list

  local cardListBlue, cardListRed = getOwnedCards()
  local endgameCardListBlue = {}
  local endgameCardListRed = {}
  local notebookStrBlue = ""
  local notebookStrRed = ""
  local playerColors = { "Blue", "Red" }

  for color = 1, #playerColors do

    local playerColor = playerColors[color]
    local cardList = (playerColor == "Blue" and cardListBlue) or
                     (playerColor == "Red" and cardListRed)
    local endgameCardList = (playerColor == "Blue" and endgameCardListBlue) or
                            (playerColor == "Red" and endgameCardListRed)
    local notebookStr = (playerColor == "Blue" and notebookStrBlue) or
                        (playerColor == "Red" and notebookStrRed)

    local checkZones = {
      getObjectbyNameAndNotes("Handzone", playerColor),
      getObjectbyNameAndNotes("Zone Captain", playerColor),
      getObjectbyNameAndNotes("Zone Draw Deck", playerColor),
      getObjectbyNameAndNotes("Zone Discard", playerColor),
      getObjectbyNameAndNotes("Zone In Play", playerColor),
      getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
      getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
      getObjectbyNameAndNotes("Zone Duty Officer", playerColor),
    }
    local deployCheckZones = {
      getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
      getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
    }
    local inPlayCheckZones = {
      getObjectbyNameAndNotes("Zone Captain", playerColor),
      getObjectbyNameAndNotes("Zone In Play", playerColor),
      getObjectbyNameAndNotes("Zone Deploy Ship", playerColor),
      getObjectbyNameAndNotes("Zone Deploy Location", playerColor),
      getObjectbyNameAndNotes("Zone Duty Officer", playerColor),
    }
    local isBot = checkPlayerColorIsBot(playerColor)
    local bagCaptainsLog = getObjectbyNameAndNotes("Captain's Log", playerColor)
    local beamBags = {}
    for _, object in pairs(getObjects()) do
      if object.getName() == "Beamed Cards" and object.getGMNotes() == playerColor then
        table.insert(beamBags, object)
      end
    end

    for i = 1, #cardList do

      -- LOCATION SPECIAL CONDITIONS

      -- Verex III: score 1 for every owned shady
      if cardList[i] == "Verex III" then
        endgameCardList, notebookStr = checkVerexIII(checkZones, deployCheckZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)

      -- Derna: score 2 for every weapon beamed here
      elseif cardList[i] == "Derna" then
        endgameCardList, notebookStr = checkDerna(deployCheckZones, playerColor, beamBags, isBot, endgameCardList, notebookStr)

      -- Ba'ku: score 1 for every person beamed here
      elseif cardList[i] == "Ba'ku" then
        endgameCardList, notebookStr = checkBaku(deployCheckZones, beamBags, playerColor, isBot, endgameCardList, notebookStr)

      -- Regula I: score 1 for every anomaly owned
      elseif cardList[i] == "Regula I" then
        endgameCardList, notebookStr = checkRegulaI(checkZones, deployCheckZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)

      -- Daystrom institute: score 1 for every synthetic
      elseif cardList[i] == "Daystrom Institute" then
        endgameCardList, notebookStr = checkDaystromInstitute(checkZones, deployCheckZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)

      -- Boreth: score 1 for every non beamed skill icon (inc wildcard) in play
      elseif cardList[i] == "Boreth" then
        endgameCardList, notebookStr = checkBoreth(deployCheckZones, inPlayCheckZones, isBot, endgameCardList, notebookStr)

      -- Theta zeta: score 1 for every 2 dilithium owned
      elseif cardList[i] == "Theta Zeta" then
        endgameCardList, notebookStr = checkThetaZeta(deployCheckZones, isBot, playerColor, endgameCardList, notebookStr)

      -- Coridan: score 1 for every 4 dilithium owned
      elseif cardList[i] == "Coridan" then
        endgameCardList, notebookStr = checkCoridan(deployCheckZones, isBot, playerColor, endgameCardList, notebookStr)

      -- Weytahn: score 4 if 2 or more away teams are here
      elseif cardList[i] == "Weytahn" then
        endgameCardList, notebookStr = checkWeytahn(deployCheckZones, isBot, playerColor, endgameCardList, notebookStr)

      -- Cold Station 12: score 1 for each beamed Augment here
      elseif cardList[i] == "Cold Station 12" then
        endgameCardList, notebookStr = checkColdStation(deployCheckZones, beamBags, playerColor, isBot, endgameCardList, notebookStr)

      -- Azati Prime: score 1 for each owned Xindi
      elseif cardList[i] == "Azati Prime" then
        endgameCardList, notebookStr = checkAzatiPrime(checkZones, deployCheckZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)

      -- Babel One: if 6+ influence, score 1 for each Communication or Ambassador in play
      elseif cardList[i] == "Babel One" then
        endgameCardList, notebookStr = checkBabelOne(inPlayCheckZones, deployCheckZones, playerColor, beamBags, isBot, endgameCardList, notebookStr)

      -- Tellar Prime: score 1 for every controlled location with starbase or starfleet
      elseif cardList[i] == "Tellar Prime" then
        endgameCardList, notebookStr = checkTellarPrime(deployCheckZones, isBot, endgameCardList, notebookStr)

      -- Karzill VI: score 1 for every 4 Glory player has
      elseif cardList[i] == "Karzill VI" then
        endgameCardList, notebookStr = checkKarzillVI(deployCheckZones, isBot, playerColor, endgameCardList, notebookStr)

      -- Mount Seleya: score 1 for every in play Telepath (including captain)
      elseif cardList[i] == "Mount Seleya" then
        endgameCardList, notebookStr = checkMountSeleya(inPlayCheckZones, deployCheckZones, beamBags, isBot, endgameCardList, notebookStr)

      -- Paan Mokar: score 4 if 2+ Away Teams are here
      elseif cardList[i] == "Paan Mokar" then
        endgameCardList, notebookStr = checkPaanMokar(deployCheckZones, isBot, playerColor, endgameCardList, notebookStr)

      -- Vulcan (Kirk): score the highest skill track value
      elseif cardList[i] == "Vulcan (Kirk)" then
        endgameCardList, notebookStr = checkVulcanKirk(deployCheckZones, isBot, playerColor, endgameCardList, notebookStr)

      -- Orion: score 1 for every owned Orion
      elseif cardList[i] == "Orion" then
        endgameCardList, notebookStr = checkOrion(checkZones, deployCheckZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)

      -- Nepenthe: if 9+ research, score 3
      elseif cardList[i] == "Nepenthe" then
        endgameCardList, notebookStr = checkNepenthe(deployCheckZones, playerColor, isBot, endgameCardList, notebookStr)




      -- CAPTAIN SPECIAL CONDITIONS

      -- Picard: score 1 for every ally card owned
      elseif cardList[i] == "Jean-Luc Picard" then
        endgameCardList, notebookStr = checkPicard(checkZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)

      -- Sisko: score 1 for every controlled location in play
      elseif cardList[i] == "Benjamin Sisko" then
        endgameCardList, notebookStr = checkSisko(deployCheckZones, isBot, endgameCardList, notebookStr)

      -- Sela: score 1 for every non romulan/reman attack card
      elseif cardList[i] == "Sela" then
        endgameCardList, notebookStr = checkSela(checkZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)

      -- Rebner: score 1 for every 2 owned non Helmet cargo cards
      elseif cardList[i] == "Rebner" then
        endgameCardList, notebookStr = checkRebner(checkZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)

      -- Georgiou: score 1 for every 3 cards in play
      elseif cardList[i] == "Phillipa Georgiou" then
        endgameCardList, notebookStr = checkGeorgiou(inPlayCheckZones, beamBags, isBot, endgameCardList, notebookStr)

      -- Archer: score 1 for every 3 unique traits you have in play
      elseif cardList[i] == "Jonathan Archer" then
        endgameCardList, notebookStr = checkArcher(inPlayCheckZones, beamBags, isBot, endgameCardList, notebookStr)

      -- Soval: score 1 for every in play person without vulcan
      elseif cardList[i] == "Soval" then
        endgameCardList, notebookStr = checkSoval(inPlayCheckZones, beamBags, isBot, endgameCardList, notebookStr)

      -- Kirk: score 1 for every second step on lowest skill counter
      elseif cardList[i] == "James T. Kirk" then
        endgameCardList, notebookStr = checkKirk(isBot, playerColor, endgameCardList, notebookStr)

      -- Wrathful Khan (needs check that captain card is face down): score 1 for every focus card, or 3 for every focus if all traits marked (isBot should return out)
      elseif cardList[i] == "Khan Noonien Singh" then
        local khanCard = getObjectbyName("Khan Noonien Singh")
        if khanCard.is_face_down then
          endgameCardList, notebookStr = checkWrathfulKhan(checkZones, bagCaptainsLog, beamBags, isBot, playerColor, endgameCardList, notebookStr)
        end

      -- Freeman: score 1 for every 2 cards in captains log
      elseif cardList[i] == "Carol Freeman" then
        endgameCardList, notebookStr = checkFreeman(bagCaptainsLog, isBot, endgameCardList, notebookStr)




      -- PERSON SPECIAL CONDITIONS

      -- The Living Witness: Score 4
      elseif cardList[i] == "The Living Witness" then
        endgameCardList, notebookStr = checkLivingWitness(checkZones, isBot, endgameCardList, notebookStr)



      -- CARGO SPECIAL CONDITIONS

      -- Genesis Device: score the points from completed missions again
      elseif cardList[i] == "Genesis Device" then
        endgameCardList, notebookStr = checkGenesisDevice()



      -- SHIP SPECIAL CONDITIONS

      -- U.S.S. Federation: score 1 for every card with military/influence focus (_multi in GMNotes)
      elseif cardList[i] == "U.S.S. Federation" then
        endgameCardList, notebookStr = checkUSSFederation(deployCheckZones, checkZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)




      -- ENCOUNTER SPECIAL CONDITIONS

      -- Red Angel: score 1 for every owned Anomaly
      elseif cardList[i] == "Red Angel" then
        endgameCardList, notebookStr = checkRedAngel(checkZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)

      end
    end

    if playerColor == "Blue" then
      endgameCardListBlue = endgameCardList
      notebookStrBlue = notebookStr
    else
      endgameCardListRed = endgameCardList
      notebookStrRed = notebookStr
    end
  end

  return endgameCardListBlue, notebookStrBlue, endgameCardListRed, notebookStrRed
end


function getAssociatedBeamBag(posCard, beamBags, playerColor)

  -- handles the detection and return of a beam bag at the same slot as a card object

  local beamBag

  -- check X position to narrow down potential bag suspects to rows

  local possibleBags = {}
  local posCardX = posCard.x * (playerColor == "Red" and -1 or 1)

  if posCardX > 37.50 and posCardX < 39.50 or
  posCardX > -39.50 and posCardX < -37.50 then
    for i = 8, 14 do
      table.insert(possibleBags, beamBags[i])
    end
  elseif posCardX > 29.00 and posCardX < 31.00 or
  posCardX > -31.00 and posCardX < -29.00 then
    for i = 1, 7 do
      table.insert(possibleBags, beamBags[i])
    end
  end

  -- match up the Z positioning

  for i = 1, #possibleBags do
    local posBag = possibleBags[i].getPosition()
    if posCard.z > posBag.z - 1 and posCard.z < posBag.z + 1 then
      beamBag = possibleBags[i]
    end
  end

  return beamBag
end




-- INDIVIDUAL CHECK FUNCS

-- locations
function checkVerexIII(checkZones, deployCheckZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)
  -- Verex III: score 1 for every shady owned

  -- check if in play
  local cardInPlay = false

  for i = 1, #deployCheckZones do
    for _, zoneObj in pairs(deployCheckZones[i].getObjects()) do
      if zoneObj.getName() == "Verex III" then
        cardInPlay = true
        break
      end
    end
    if cardInPlay then
      break
    end
  end

  if cardInPlay then

    local shadyCount = 0

    -- check zones for shady trait
    for i = 1, #checkZones do
      for _, zoneObj in pairs(checkZones[i].getObjects()) do
        if zoneObj.type == "Card" and zoneObj.hasTag('trait_shady') then
          shadyCount = shadyCount + 1
        end
        if zoneObj.type == "Deck" then
          for _, deckObj in pairs(zoneObj.getObjects()) do
            local deckObjTags = deckObj.tags
            for j = 1, #deckObjTags do
              if deckObjTags[j] == "trait_shady" then
                shadyCount = shadyCount + 1
              end
            end
          end
        end
      end
    end

    -- check bags for shady trait
    for _, bagObj in pairs(bagCaptainsLog.getObjects()) do
      local bagObjTags = bagObj.tags
      for i = 1, #bagObjTags do
        if bagObjTags[i] == "trait_shady" then
          shadyCount = shadyCount + 1
        end
      end
    end

    for i = 1, #beamBags do
      for _, bagObj in pairs(beamBags[i].getObjects()) do
        local bagObjTags = bagObj.tags
        for j = 1, #bagObjTags do
          if bagObjTags[j] == "trait_shady" then
            shadyCount = shadyCount + 1
          end
        end
      end
    end

    if isBot then shadyCount = 5 end
    if shadyCount > 0 then
      table.insert(endgameCardList, {["Verex III"] = shadyCount})
      notebookStr = notebookStr .. "\nVerex III: " .. shadyCount
    end
  end

  return endgameCardList, notebookStr
end


function checkDerna(deployCheckZones, playerColor, beamBags, isBot, endgameCardList, notebookStr)
  -- Derna: score 2 for every weapon beamed here
  -- get card position, use to determine beam bag

  local posCard
  local cardInPlay = false

  for _, object in pairs(getObjects()) do
    if object.getName() == "Derna" then
      posCard = object.getPosition()
      for i = 1, #deployCheckZones do
        for _, zoneObj in pairs(deployCheckZones[i].getObjects()) do
          if zoneObj.getName() == "Derna" then
            cardInPlay = true
          end
        end
      end
    end
  end

  if cardInPlay then

    local beamBag = getAssociatedBeamBag(posCard, beamBags, playerColor)
    local weaponCount = 0
    if beamBag ~= nil then
      for _, bagObj in pairs(beamBag.getObjects()) do
        local bagObjTags = bagObj.tags
        for i = 1, #bagObjTags do
          if bagObjTags[i] == "trait_weapon" then
            weaponCount = weaponCount + 1
          end
        end
      end

      if not isBot then
        if weaponCount > 0 then
          table.insert(endgameCardList, {["Derna"] = weaponCount * 2})
          notebookStr = notebookStr .. "\nDerna: " .. weaponCount * 2
        end
      else
        table.insert(endgameCardList, {["Derna"] = 5})
        notebookStr = notebookStr .. "\nDerna: 5"
      end
    end
  end

  return endgameCardList, notebookStr
end


function checkBaku(deployCheckZones, beamBags, playerColor, isBot, endgameCardList, notebookStr)
  -- Ba'ku score 1 for every person beamed here

  -- get card position, use to determine beam bag
  local posCard = {}
  local cardInPlay = false
  for _, object in pairs(getObjects()) do
    if object.getName() == "Ba'ku" then
      posCard = object.getPosition()
      for i = 1, #deployCheckZones do
        for _, zoneObj in pairs(deployCheckZones[i].getObjects()) do
          if zoneObj.getName() == "Ba'ku" then
            cardInPlay = true
          end
        end
      end
    end
  end

  if cardInPlay then

    local beamBag = getAssociatedBeamBag(posCard, beamBags, playerColor)
    local personCount = 0
    if beamBag ~= nil then
      for _, bagObj in pairs(beamBag.getObjects()) do
        local bagObjTags = bagObj.tags
        for i = 1, #bagObjTags do
          if bagObjTags[i] == "suit_person" then
            personCount = personCount + 1
          end
        end
      end
    end
    if isBot then personCount = 5 end
    if personCount > 0 then
      table.insert(endgameCardList, {["Ba'ku"] = personCount})
      notebookStr = notebookStr .. "\nBa'ku: " .. personCount
    end
  end

  return endgameCardList, notebookStr
end


function checkRegulaI(checkZones, deployCheckZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)
  -- Regula I: score 1 for every anomaly owned

  local cardInPlay    = false
  for _, object in pairs(getObjects()) do
    if object.getName() == "Regula I" then
      for i = 1, #deployCheckZones do
        for _, zoneObj in pairs(deployCheckZones[i].getObjects()) do
          if zoneObj.getName() == "Regula I" then
            cardInPlay = true
          end
        end
      end
    end
  end

  if cardInPlay then

    local anomalyCount = 0

    -- check zones for anomaly trait
    for i = 1, #checkZones do
      for _, object in pairs(checkZones[i].getObjects()) do
        if object.type == "Card" and object.hasTag('trait_anomaly') then
          anomalyCount = anomalyCount + 1
        end
        if object.type == "Deck" then
          for _, deckObj in pairs(object.getObjects()) do
            local deckObjTags = deckObj.tags
            for j = 1, #deckObjTags do
              if deckObjTags[j] == "trait_anomaly" then
                anomalyCount = anomalyCount + 1
              end
            end
          end
        end
      end
    end

    -- check bags for anomaly trait
    for _, bagObj in pairs(bagCaptainsLog.getObjects()) do
      local bagObjTags = bagObj.tags
      for i = 1, #bagObjTags do
        if bagObjTags[i] == "trait_anomaly" then
          anomalyCount = anomalyCount + 1
        end
      end
    end

    for i = 1, #beamBags do
      for _, bagObj in pairs(beamBags[i].getObjects()) do
        local bagObjTags = bagObj.tags
        for j = 1, #bagObjTags do
          if bagObjTags[j] == "trait_anomaly" then
            anomalyCount = anomalyCount + 1
          end
        end
      end
    end
    if isBot then
      anomalyCount = 5
    end
    if anomalyCount > 0 then
      table.insert(endgameCardList, {["Regula I"] = anomalyCount})
      notebookStr = notebookStr .. "\nRegula I: " .. anomalyCount
    end
  end

  return endgameCardList, notebookStr
end


function checkDaystromInstitute(checkZones, deployCheckZones, bagCaptainsLog, beamBags, isBot, endgameCardList, notebookStr)
  local cardInPlay    = false
  for _, object in pairs(getObjects()) do
    if object.getName() == "Daystrom Institute" then
      for i = 1, #deployCheckZones do
        for _, zoneObj in pairs(deployCheckZones[i].getObjects()) do
          if zoneObj.getName() == "Daystrom Institute" then
            cardInPlay = true
          end
        end
      end
    end
  end

  if cardInPlay then

    local syntheticCount = 0

    -- check zones for anomaly trait
    for i = 1, #checkZones do
      for _, object in pairs(checkZones[i].getObjects()) do
        if object.type == "Card" and object.hasTag('trait_synthetic') then
          syntheticCount = syntheticCount + 1
        end
        if object.type == "Deck" then
          for _, deckObj in pairs(object.getObjects()) do
            local deckObjTags = deckObj.tags
            for j = 1, #deckObjTags do
              if deckObjTags[j] == "trait_synthetic" then
                syntheticCount = syntheticCount + 1
              end
            end
          end
        end
      end
    end

    -- check bags for synthetic trait
    for _, bagObj in pairs(bagCaptainsLog.getObjects()) do
      local bagObjTags = bagObj.tags
      for i = 1, #bagObjTags do
        if bagObjTags[i] == "trait_synthetic" then
          syntheticCount = syntheticCount + 1
        end
      end
    end

    for i = 1, #beamBags do
      for _, bagObj in pairs(beamBags[i].getObjects()) do
        local bagObjTags = bagObj.tags
        for j = 1, #bagObjTags do
          if bagObjTags[j] == "trait_synthetic" then
            syntheticCount = syntheticCount + 1
          end
        end
      end
    end
    if isBot then
      syntheticCount = 5
    end
    if syntheticCount > 0 then
      table.insert(endgameCardList, {["Daystrom Institute"] = syntheticCount})
      notebookStr = notebookStr .. "\nDaystrom Institute: " .. syntheticCount
    end
  end

  return endgameCardList, notebookStr
end


function checkBoreth(deployCheckZones, inPlayCheckZones, isBot, endgameCardList, notebookStr)
  -- Boreth: score 1 for every non beamed skill icon (inc wildcard) in play

  local cardInPlay = false
  for _, object in pairs(getObjects()) do
    if object.getName() == "Boreth" then
      for i = 1, #deployCheckZones do
        for _, zoneObj in pairs(deployCheckZones[i].getObjects()) do
          if zoneObj.getName() == "Boreth" then
            cardInPlay = true
          end
        end
      end
    end
  end

  if cardInPlay then
    -- check slots: captain, staging, ships, locations, duty officers
    local researchCount = 0
    local influenceCount = 0
    local militaryCount = 0
    local wildCount = 0
    for i = 1, 5 do
      for _, object in pairs(inPlayCheckZones[i].getObjects()) do
        if object.hasTag('skill_science') then
          researchCount = researchCount + 1
        end
        if object.hasTag('skill_diplomacy') then
          influenceCount = influenceCount + 1
        end
        if object.hasTag('skill_military') then
          militaryCount = militaryCount + 1
        end
        if object.hasTag('skill_wildcard') then
          wildCount = wildCount + 1
        end
        if object.hasTag('skill_x2_science') then
          researchCount = researchCount + 2
        end
        if object.hasTag('skill_x2_diplomacy') then
          influenceCount = influenceCount + 2
        end
        if object.hasTag('skill_x2_military') then
          militaryCount = militaryCount + 2
        end
        if object.hasTag('skill_x2_wildcard') then
          wildCount = wildCount + 2
        end
        if object.hasTag('skill_x3_science') then
          researchCount = researchCount + 3
        end
        if object.hasTag('skill_x3_diplomacy') then
          influenceCount = influenceCount + 3
        end
        if object.hasTag('skill_x3_military') then
          militaryCount = militaryCount + 3
        end
        if object.hasTag('skill_x3_wildcard') then
          wildCount = wildCount + 3
        end
      end
    end
    local totalBorethScore = researchCount + influenceCount + militaryCount + wildCount
    if isBot then totalBorethScore = 5 end
    if totalBorethScore > 0 then
      table.insert(endgameCardList, {["Boreth"] = totalBorethScore})
      notebookStr = notebookStr .. "\nBoreth: " .. totalBorethScore
    end
  end

  return endgameCardList, notebookStr
end


