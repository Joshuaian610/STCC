      break
    end
  end

  if cardInPlay then

    local xindiCount = 0

    -- check zones for shady trait
    for i = 1, #checkZones do
      for _, zoneObj in pairs(checkZones[i].getObjects()) do
        if zoneObj.type == "Card" and zoneObj.hasTag('trait_xindi') then
          xindiCount = xindiCount + 1
        end
        if zoneObj.type == "Deck" then
          for _, deckObj in pairs(zoneObj.getObjects()) do
            local deckObjTags = deckObj.tags
            for j = 1, #deckObjTags do
              if deckObjTags[j] == "trait_xindi" then
                xindiCount = xindiCount + 1
              end
            end
          end
        end
      end
    end

    -- check bags for xindi trait
    for _, bagObj in pairs(bagCaptainsLog.getObjects()) do
      local bagObjTags = bagObj.tags
      for i = 1, #bagObjTags do
        if bagObjTags[i] == "trait_xindi" then
          xindiCount = xindiCount + 1
        end
      end
    end

    for i = 1, #beamBags do
      for _, bagObj in pairs(beamBags[i].getObjects()) do
        local bagObjTags = bagObj.tags
        for j = 1, #bagObjTags do
          if bagObjTags[j] == "trait_xindi" then
            xindiCount = xindiCount + 1
          end
        end
      end
    end

    if isBot then xindiCount = 5 end
    if xindiCount > 0 then
      table.insert(endgameCardList, {["Azati Prime"] = xindiCount})
      notebookStr = notebookStr .. "\nAzati Prime: " .. xindiCount
    end
  end

  return endgameCardList, notebookStr
end


function checkBabelOne(inPlayCheckZones, deployCheckZones, playerColor, beamBags, isBot, endgameCardList, notebookStr)
  -- Babel One: if 6+ influence, score 1 for each Communication or Ambassador in play

  -- check if in play
  local cardInPlay = false
  for i = 1, #deployCheckZones do
    for _, zoneObj in pairs(deployCheckZones[i].getObjects()) do
      if zoneObj.getName() == "Babel One" then
        cardInPlay = true
        break
      end
    end
    if cardInPlay then
      break
    end
  end

  if cardInPlay then

    -- first need to check if influence is 6+ if not automatically giving 5 score for bot endgame
    if not isBot then
      local influenceCounter
      if getCaptainName(playerColor) ~= "Khan" then -- counter doesn't exist for khan
        influenceCounter = getObjectbyNameAndNotes("Influence Counter " .. playerColor)
        if influenceCounter.getVar("val") < 6 then -- do nothing at all if under 6 influence
          return endgameCardList, notebookStr
        end
      elseif getCaptainName(playerColor) == "Khan" then -- non bot khan will never have 6 influence
        return endgameCardList, notebookStr
      end
    end

    local scoreCount = 0

    -- check zones for communication or ambassador trait
    for i = 1, #inPlayCheckZones do
      for _, zoneObj in pairs(inPlayCheckZones[i].getObjects()) do
        if zoneObj.type == "Card" and
           (zoneObj.hasTag('trait_communication') or zoneObj.hasTag('trait_ambassador')) then
          scoreCount = scoreCount + 1
        end
        if zoneObj.type == "Deck" then
          for _, deckObj in pairs(zoneObj.getObjects()) do
            local deckObjTags = deckObj.tags
            for j = 1, #deckObjTags do
              if deckObjTags[j] == "trait_communication" or deckObjTags[j] == "trait_ambassador" then
                scoreCount = scoreCount + 1
                break
              end
            end
          end
        end
      end
    end

    -- check bags for communication or ambassador trait
    for i = 1, #beamBags do
      for _, bagObj in pairs(beamBags[i].getObjects()) do
        local bagObjTags = bagObj.tags
        for j = 1, #bagObjTags do
          if bagObjTags[j] == "trait_communication" or bagObjTags[j] == "trait_ambassador" then
            scoreCount = scoreCount + 1
          end
        end
      end
    end

    if isBot then scoreCount = 5 end
    if scoreCount > 0 then
      table.insert(endgameCardList, {["Babel One"] = scoreCount})
      notebookStr = notebookStr .. "\nBabel One: " .. scoreCount
    end
  end

  return endgameCardList, notebookStr
end


