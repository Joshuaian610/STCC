-- handles functionality related to the Stardate & Glory area


function initButtonResolveStardate(buttonObj)
  buttonObj.clearButtons()
  local stardateType = buttonObj.getGMNotes()
  local tooltips = {
    ["wipeMarket"] = "Click this button to perform Stardate Market Wipe, and discard this card.",
    ["wipeBoth"]   = "Click this button to perform Stardate Market and Location Wipe, and discard this card.",
    ["discard"]    = "Click this button to discard this Stardate Card.",
    ["endgame"]    = "Click this button to trigger End Of Game.",
  }
  local tooltip = tooltips[stardateType]
  buttonObj.createButton({
    click_function = "resolveStardate",
    function_owner = self,
    label          = "",
    position       = { 0, 0.36, -0.01 },
    width          = 865,
    height         = 435,
    scale          = { 2.3, 2.3, 2.3 },
    color          = { 1, 1, 1, .3 },
    hover_color    = { 1, 1, 1, .6 },
    tooltip        = tooltip,
  })
end


function refreshGlory()
  -- handles functionality of refreshing the glory to glory area, counter etc per stardate card

  -- animate button click (is needed?)
  -- animateButton(getObjectbyName("Button Refresh Glory"))

  -- first check to make sure drop area isn't already populated
  local checkZone = getObjectbyName("Zone Stardate Glory")
  local gloryFound = false
  for _, zoneObj in pairs(checkZone.getObjects()) do
    if zoneObj.getName() == "Glory Token" then
      gloryFound = true
    end
  end
  if gloryFound then
    broadcastToAll("Refresh Glory Action only works while Stardate card is out of glory.", "Orange")
    return
  end

  -- determine cardName
  local cardName = nil
  for _, object in pairs(getObjectbyName("Zone Stardate").getObjects()) do
    if object.tag == "Deck" then -- if deck, get top card
      local cardsInDeck = object.getObjects()
      cardName = cardsInDeck[#cardsInDeck].name
    elseif object.tag == "Card" then
      cardName = object.getName()
    end
  end

  -- determine glory count to refresh per card name
  local cardGloryCounts = {
    ["2-Player Stardate 1"]                = 5,
    ["2-Player Stardate 2"]                = 7,
    ["2-Player Stardate 3"]                = 7,
    ["2-Player Stardate 4"]                = 6,
    ["2-Player Stardate 5"]                = 5,
    ["Solo Cadet Practice 1"]              = 5,
    ["Solo Cadet Practice 2"]              = 5,
    ["Solo vs. Ensign Bot Stardate 1"]     = 6,
    ["Solo vs. Ensign Bot Stardate 2"]     = 7,
    ["Solo vs. Ensign Bot Stardate 3"]     = 7,
    ["Solo vs. Ensign Bot Stardate 4"]     = 6,
    ["Solo vs. Ensign Bot Stardate 5"]     = 5,
    ["Solo vs. Lieutenant Bot Stardate 1"] = 5,
    ["Solo vs. Lieutenant Bot Stardate 2"] = 7,
    ["Solo vs. Lieutenant Bot Stardate 3"] = 7,
    ["Solo vs. Lieutenant Bot Stardate 4"] = 6,
    ["Solo vs. Lieutenant Bot Stardate 5"] = 5,
    ["Solo vs. Commander Bot Stardate 1"]  = 5,
    ["Solo vs. Commander Bot Stardate 2"]  = 7,
    ["Solo vs. Commander Bot Stardate 3"]  = 7,
    ["Solo vs. Commander Bot Stardate 4"]  = 6,
    ["Solo vs. Commander Bot Stardate 5"]  = 5,
    ["Solo vs. Captain Bot Stardate 1"]    = 5,
    ["Solo vs. Captain Bot Stardate 2"]    = 6,
    ["Solo vs. Captain Bot Stardate 3"]    = 7,
    ["Solo vs. Captain Bot Stardate 4"]    = 6,
    ["Solo vs. Captain Bot Stardate 5"]    = 5,
    ["Solo vs. Admiral Bot Stardate 1"]    = 5,
    ["Solo vs. Admiral Bot Stardate 2"]    = 5,
    ["Solo vs. Admiral Bot Stardate 3"]    = 6,
    ["Solo vs. Admiral Bot Stardate 4"]    = 6,
    ["Solo vs. Admiral Bot Stardate 5"]    = 5,
  }
  local gloryCount = cardGloryCounts[cardName]
  local bagGlory = getObjectbyName("Central Glory Token Bag")
  local posGlory = {
    { -11.00, 0.85, 4.00 },
    { -12.50, 0.85, 4.00 },
    { -14.00, 0.85, 4.00 },
    { -11.00, 0.85, 5.50 },
    { -12.50, 0.85, 5.50 },
    { -14.00, 0.85, 5.50 },
    { -15.50, 0.85, 4.75 },
  }
  if gloryCount then
    for i = 1, gloryCount do
      local tokenGlory = bagGlory.takeObject()
      local rotGlory = { 0.00, 180.00, 180.00 }
      tokenGlory.setRotation(rotGlory)
      tokenGlory.setPositionSmooth(posGlory[i], false, true)
      tokenGlory.interactable = false
    end
    broadcastToAll(gloryCount .. " Glory has been refreshed for: " .. cardName, "Green")

    -- set stardate glory counter to resolve times when the zone doesn't pick up the tokens entering the zone
    Wait.time(function()

      getObjectbyName("Glory Counter Stardate").call("setValue", gloryCount)

    end, 1)
  else
    return
  end
end


function updateStardateGloryCounter()
  -- handles counter update for stardate glory counter as glory enters/leaves zone
  local stardateCheckZone = getObjectbyName("Zone Stardate Glory")
  local gloryCount = 0
  for _, zoneObj in pairs(stardateCheckZone.getObjects()) do
    if zoneObj.getName() == "Glory Token" then
      gloryCount = gloryCount + 1
    end
  end

  -- only update if stardate pad is set with a difficulty, indicating game in progress
  local buttonObj = getObjectbyName("Glory Counter Stardate")
  local padStardate = getObjectbyName("Pad Stardate")
  if padStardate.getGMNotes() ~= "None" then
    Wait.time(function()

     buttonObj.call("setValue", gloryCount)

    end, 0.5)
  end
end


-- **** STARDATE CARD FUNCTIONS ****

function placeButtonResolveStardate(playerColor)
  -- handles pull & placement of stardate resolve button, calls init
  -- determines stardateCardName, then stardateType, then pulls & places resolve button
  -- types: "wipeMarket", "wipeBoth", "endgame", "discard"

  local stardateCard
  local stardateCheckZone = getObjectbyNameAndNotes("Zone Stardate Player", playerColor)
  for _, zoneObj in pairs(stardateCheckZone.getObjects()) do
    if zoneObj.getName():find("Stardate") and zoneObj.type == "Card" then
      stardateCard = zoneObj
    end
  end
  if stardateCard == nil then return end

  local stardateCardName = stardateCard.getName()

  local stardateCardTypes = {
    ["2-Player Stardate 1"]                = "wipeMarket",
    ["2-Player Stardate 2"]                = "wipeMarket",
    ["2-Player Stardate 3"]                = "wipeBoth",
    ["2-Player Stardate 4"]                = "wipeMarket",
    ["2-Player Stardate 5"]                = "endgame",
    ["Solo Cadet Practice 1"]              = "wipeBoth",
    ["Solo Cadet Practice 2"]              = "endgame",
    ["Solo vs. Ensign Bot Stardate 1"]     = "wipeMarket",
    ["Solo vs. Ensign Bot Stardate 2"]     = "discard",
    ["Solo vs. Ensign Bot Stardate 3"]     = "wipeBoth",
    ["Solo vs. Ensign Bot Stardate 4"]     = "discard",
    ["Solo vs. Ensign Bot Stardate 5"]     = "endgame",
    ["Solo vs. Lieutenant Bot Stardate 1"] = "wipeBoth",
    ["Solo vs. Lieutenant Bot Stardate 2"] = "discard",
    ["Solo vs. Lieutenant Bot Stardate 3"] = "wipeBoth",
    ["Solo vs. Lieutenant Bot Stardate 4"] = "discard",
    ["Solo vs. Lieutenant Bot Stardate 5"] = "endgame",
    ["Solo vs. Commander Bot Stardate 1"]  = "wipeMarket",
    ["Solo vs. Commander Bot Stardate 2"]  = "wipeMarket",
    ["Solo vs. Commander Bot Stardate 3"]  = "wipeBoth",
    ["Solo vs. Commander Bot Stardate 4"]  = "discard",
    ["Solo vs. Commander Bot Stardate 5"]  = "endgame",
    ["Solo vs. Captain Bot Stardate 1"]    = "wipeMarket",
    ["Solo vs. Captain Bot Stardate 2"]    = "wipeMarket",
    ["Solo vs. Captain Bot Stardate 3"]    = "wipeBoth",
    ["Solo vs. Captain Bot Stardate 4"]    = "wipeMarket",
    ["Solo vs. Captain Bot Stardate 5"]    = "endgame",
    ["Solo vs. Admiral Bot Stardate 1"]    = "wipeMarket",
    ["Solo vs. Admiral Bot Stardate 2"]    = "wipeMarket",
    ["Solo vs. Admiral Bot Stardate 3"]    = "wipeBoth",
    ["Solo vs. Admiral Bot Stardate 4"]    = "wipeMarket",
    ["Solo vs. Admiral Bot Stardate 5"]    = "endgame",
  }
  local stardateType = stardateCardTypes[stardateCardName]
  local buttonBags = {
    ["wipeMarket"] = getObjectbyName("Bag Resolve Stardate Wipe Market"),
    ["wipeBoth"]   = getObjectbyName("Bag Resolve Stardate Wipe Both"),
    ["discard"]    = getObjectbyName("Bag Resolve Stardate Discard"),
    ["endgame"]    = getObjectbyName("Bag Resolve Stardate Endgame"),
  }
  local bagButton = buttonBags[stardateType]
  local isBot = checkPlayerColorIsBot(playerColor)
  local rotButton = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 }
  if isBot then rotButton = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 } end
  local posButton = playerColor == "Blue" and { -19.75, 0.75, 15.00 } or { 19.75, 0.75, -15.00 }

  local buttonObj = bagButton.takeObject()
  buttonObj.interactable = false
  buttonObj.setLock(true)
  buttonObj.setColorTint(playerColor)
  buttonObj.highlightOn(playerColor)
  buttonObj.setRotation(rotButton)
  buttonObj.setPosition(posButton)

  initButtonResolveStardate(buttonObj)
end


function resolveStardate(buttonObj, _, _)
  -- wrapper function to determine stardateType and call appropriate function to handle resolving player stardate card

  local stardateType = buttonObj.getGMNotes()

  if stardateType == "wipeMarket" then
    stardateWipeMarket()
  elseif stardateType == "wipeBoth" then
    stardateWipeLocation()
    stardateWipeMarket()
  -- stardateType discard will ignore this part
  elseif stardateType == "endgame" then
    stardateTriggerEndgame()
  end

  -- discard stardate card, broadcast

  local posButton = buttonObj.getPosition()
  local playerColor
  if posButton.x > 0 then
    playerColor = "Red"
  elseif posButton.x < 0 then
    playerColor = "Blue"
  end
  if playerColor == nil then return end

  local stardateCardName = getCurrentStardate(playerColor)
  local stardateCard = getObjectbyName(stardateCardName)

  local bagUnusedObjs = getObjectbyName("Unused Object Bag")
  bagUnusedObjs.putObject(stardateCard)

  local broadcastStr = string.format("[%s]%s[-] has been discarded!", Color.fromString("Yellow"):toHex(), stardateCardName)
  broadcastToAll(broadcastStr, "White")

  -- special button animation that destructs buttonObj
  buttonObj.clearButtons()
  local pos = buttonObj.getPosition()
  pos.y = pos.y - .30
  buttonObj.setPosition(pos)
  Wait.time(function() buttonObj.destruct() end, 0.5)
end


function stardateWipeMarket()
  --handles stardate market wipe

  local cardZones = {
    getObjectbyName("Zone Market Current Person"),
    getObjectbyName("Zone Market Current Cargo"),
    getObjectbyName("Zone Market Current Ship"),
    getObjectbyName("Zone Market Current Ally"),
  }
  local deckZones = {
    getObjectbyName("Zone Market Person"),
    getObjectbyName("Zone Market Cargo"),
    getObjectbyName("Zone Market Ship"),
    getObjectbyName("Zone Market Ally"),
  }

  -- will need to junk and replace on all 4 simultaneously,
  local rotJunk = { 0.00, 180.00, 0.00 }
  local posJunk = { -12.50, 1.50, 12.00 }
  for i = 1, 4 do
    for _, cardZoneObj in pairs(cardZones[i].getObjects()) do
      if cardZoneObj.tag == "Card" then
        cardZoneObj.setRotation(rotJunk)
        cardZoneObj.setPositionSmooth(posJunk, false, true)
      end

      -- destruct any resources in zone
      if string.find(cardZoneObj.getName(), "Token") then
        cardZoneObj.destruct()
      end
    end

    local rotReplaceCard = { 0.00, 180.00, 0.00 }
    local posReplaceCard = { -7.50, 1.50, 6.00 }
    if i == 2 then
      posReplaceCard = { -2.50, 1.50, 6.00 }
    elseif i == 3 then
      posReplaceCard = { 2.50, 1.50, 6.00 }
    elseif i == 4 then
      posReplaceCard = { 7.50, 1.50, 6.00 }
    end
    local replaceCard
    for _, deckZoneObj in pairs(deckZones[i].getObjects()) do
      if deckZoneObj.type == "Deck" then
        replaceCard = deckZoneObj.takeObject()
        break
      elseif deckZoneObj.type == "Card" then
        replaceCard = deckZoneObj
        break
      end
    end
    Wait.frames(function()
      if replaceCard ~= nil then
        replaceCard.setRotation(rotReplaceCard)
        replaceCard.setPositionSmooth(posReplaceCard, false, true)
      end
    end)
  end
  local broadcastStr = string.format("The Market has been Wiped according to the [%s]Stardate Card[-]. ", Color.fromString("Yellow"):toHex())
  broadcastToAll(broadcastStr, "White")
end


function stardateWipeLocation()
  -- handles stardate location wipe

  -- will need to check all NZs for ATs or ships present, don't wipe those
  local checkZonesTop = {
    getObjectbyNameAndNotes("Zone NZ Player Top", "Blue"),
    getObjectbyNameAndNotes("Zone NZ Player Top", "Red")
  }
  local checkZonesMiddle = {
    getObjectbyNameAndNotes("Zone NZ Player Middle", "Blue"),
    getObjectbyNameAndNotes("Zone NZ Player Middle", "Red")
  }
  local checkZonesBottom = {
    getObjectbyNameAndNotes("Zone NZ Player Bottom", "Blue"),
    getObjectbyNameAndNotes("Zone NZ Player Bottom", "Red")
  }
  local zoneLocationTop = getObjectbyName("Zone NZ Location Top")
  local zoneLocationMiddle = getObjectbyName("Zone NZ Location Middle")
  local zoneLocationBottom = getObjectbyName("Zone NZ Location Bottom")
  local posLocationTop = { 0.00, 1.50, -7.00 }
  local posLocationMiddle = { 0.00, 1.50, -14.00 }
  local posLocationBottom = { 0.00, 1.50, -21.00 }
  local zoneLocationDeck = getObjectbyName("Zone Advanced Locations")
  local waitTimer = 0

  for i = 1, 3 do

    if i == 1 then
      waitTimer = 0
    elseif i == 2 then
      waitTimer = .5
    elseif i == 3 then
      waitTimer = 1
    end

    Wait.time(function()

      local checkZones
      local zoneLocation
      local posLocation
      local needReplace = true

      if i == 1 then
        checkZones = checkZonesTop
        zoneLocation = zoneLocationTop
        posLocation = posLocationTop
      elseif i == 2 then
        checkZones = checkZonesMiddle
        zoneLocation = zoneLocationMiddle
        posLocation = posLocationMiddle
      elseif i == 3 then
        checkZones = checkZonesBottom
        zoneLocation = zoneLocationBottom
        posLocation = posLocationBottom
      end

      for j = 1, 2 do
        for _, zoneObj in pairs(checkZones[j].getObjects()) do
          if zoneObj.hasTag("snap_ship") or zoneObj.hasTag("away_blue") or zoneObj.hasTag("away_red") then
            needReplace = false
          end
        end
      end

      if needReplace then

        local outgoingCardName
        local replaceCardName
        local replacementFound = false
        local rotLocation = { 0.00, 180.00, 0.00 }

        -- discard outgoing card
        for _, zoneObj in pairs(zoneLocation.getObjects()) do
          if zoneObj.tag == "Card" then
            outgoingCardName = zoneObj.getName()

            -- locations go to unused object bag, not junk
            local bagUnusedObjs = getObjectbyName("Unused Object Bag")
            bagUnusedObjs.putObject(zoneObj)
          end
        end

        -- replace if possible
        for _, zoneObj in pairs(zoneLocationDeck.getObjects()) do
          if zoneObj.tag == "Deck" then
            local replaceCard = zoneObj.takeObject()
            replaceCard.setRotation(rotLocation)
            replaceCard.setPositionSmooth(posLocation, false, true)
            replaceCardName = replaceCard.getName()
            replacementFound = true
            break

          elseif zoneObj.tag == "Card" then
            local replaceCard = zoneObj
            replaceCard.setRotation(rotLocation)
            replaceCard.setPositionSmooth(posLocation, false, true)
            replaceCardName = replaceCard.getName()
            replacementFound = true
            break
          end
        end

        local broadcastStr
        if replacementFound then
          broadcastStr = string.format("[%s]Location[-]: %s has been discarded via [%s]Stardate Card[-], and replaced with %s.", Color.fromString("Green"):toHex(), outgoingCardName, Color.fromString("Yellow"):toHex(), replaceCardName)
          broadcastToAll(broadcastStr, "White")
        else
          broadcastStr = string.format("[%s]Location[-]: %s has been discarded via [%s]Stardate Card[-], there was no replacement Location.", Color.fromString("Green"):toHex(), outgoingCardName, Color.fromString("Yellow"):toHex())
          broadcastToAll(broadcastStr, "White")
        end
      end

    end, waitTimer)
  end
end


function stardateTriggerEndgame()
  -- handles pre end game deployment of score sheets & calculate score buttons

  -- broadcast that end of game has been triggered
  local broadcastStr = string.format("[%s]Final Stardate Card and End of Game[-] have been triggered! Finish remaining rounds, and use the Calcuate Score button under Score Sheets when finished.", Color.fromString("Yellow"):toHex())
  broadcastToAll(broadcastStr, "White")

  local bagUnusedObjs = getObjectbyName("Unused Object Bag")

  -- deploy blue score sheet
  local rotBlueSheet = { 0.00, 270.00, 0.00 }
  local posBlueSheet = { -38.50, 1.70, -27.80 }
  local blueSheet = getObjectFromBagbyName("Score Sheet Blue", bagUnusedObjs, rotBlueSheet, posBlueSheet, true)
  blueSheet.interactable = false
  blueSheet.setLock(true)

  -- deploy blue calculate score button
  local rotBlueButton = { 0.00, 270.00, 0.00 }
  local posBlueButton = { -42.65, 1.70, -27.80 }
  local blueButton = getObjectFromBagbyName("Calculate Score Button Blue", bagUnusedObjs, rotBlueButton, posBlueButton, false)
  blueButton.interactable = false
  blueButton.setLock(true)
  initButtonCalculateScore(blueButton)

  -- deploy red score sheet
  local rotRedSheet = { 0.00, 90.00, 0.00 }
  local posRedSheet = { 38.50, 1.70, 27.80 }
  local redSheet = getObjectFromBagbyName("Score Sheet Red", bagUnusedObjs, rotRedSheet, posRedSheet, true)
  redSheet.interactable = false
  redSheet.setLock(true)

  -- deploy red calculate score button
  local rotRedButton = { 0.00, 90.00, 0.00 }
  local posRedButton = { 42.65, 1.70, 27.80 }
  local redButton = getObjectFromBagbyName("Calculate Score Button Red", bagUnusedObjs, rotRedButton, posRedButton, false)
  redButton.interactable = false
  redButton.setLock(true)
  initButtonCalculateScore(redButton)

  -- get rid of glory stardate counter
  local counter = getObjectbyName("Glory Counter Stardate")
  local posCounter = counter.getPosition()
  posCounter.y = -2
  counter.setPosition(posCounter)
  counter.flip()
end