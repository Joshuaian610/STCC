require("BeamedBags")
require("CalculateScore")
require("ControlBot")
require("ButtonsCaptain")
require("ControlMarket")
require("ControlNZ")
require("Helpers")
require("OnloadSupport")
require("PlayActions")
require("SetupCaptain")
require("SetupMarket")
require("SetupSolo")
require("ShipActions")
require("StardateArea")

math.randomseed(os.time())

function onLoad()
  -- call this for each existing object since TTS doesn't do it
  for _, obj in ipairs(getObjects()) do
    onObjectSpawn(obj)
  end

  -- enable / disable non interactable objects
  local nonInt = true
  makeNonInteractable(nonInt)

  -- if 1 seated player and is White (new load of mod, set to Blue)
  local seatedPlayers = getSeatedPlayers()
  local playerCount = #getSeatedPlayers()
  if playerCount == 1 and seatedPlayers[1] == "White" then
    Player["White"].changeColor("Blue")
  end

  -- manually hide/show blue bot difficulty buttons, create buttons
  local botDifficultyButtonVisibility = false
  buttonSoloDifficultyVisibility(botDifficultyButtonVisibility, "Both")

  -- manually hide/show player area captain selection UI
  local captainSelectButtonVisibility = false
  buttonSelectCaptainVisibility(captainSelectButtonVisibility)

  -- manually hide/show stardate card glory counter (will be under current Main Setup Button)
  local stardateGloryCounterVisibility = false
  gloryStardateCounterVisibility(stardateGloryCounterVisibility)

  -- show & update stardate glory counter onLoad() if game is in progress
  gloryCounterStardateInProgress()

  -- check current turn, if more than 1 players enable turns, set turn to current player
  onLoadEnableTurns()

  -- display XML UI if captain has been selected
  onloadXML()

  -- broadcast welcome message if setup button exists
  broadcastWelcome()
end -- end onLoad()


function onObjectSpawn(obj)
  -- handles on spawn actions

  -- handle beamed bag button/counter refresh
  if obj.getName() == "Beamed Cards" or obj.getName() == "Captain's Log" then
    obj.call("updateButtons")
  end

  -- handle creation of main setup game button
  if obj.getName() == "Button Setup Game" then
    initButtonSetupGame(obj)
  end

  -- handle creation of include promo setup button
  if obj.getName() == "Button Include Promos" and obj.getGMNotes() == "enabled" then
    initButtonDisablePromo(obj)
  elseif obj.getName() == "Button Include Promos" and obj.getGMNotes() == "disabled" then
    initButtonEnablePromo(obj)
  end

  -- handle creation of include second contact setup button
  if obj.getName() == "Button Include Second Contact" and obj.getGMNotes() == "enabled" then
    initButtonDisableSecondContact(obj)
  elseif obj.getName() == "Button Include Second Contact" and obj.getGMNotes() == "disabled" then
    initButtonEnableSecondContact(obj)
  end

  -- handle creation of market selection setup buttons
  if obj.getName() == "Button Market Base Game" and obj.getGMNotes() == "enabled" then
    initButtonDisableMarketBaseGame(obj)
  elseif obj.getName() == "Button Market Base Game" and obj.getGMNotes() == "disabled" then
    initButtonEnableMarketBaseGame(obj)
  end
  if obj.getName() == "Button Market To Boldly Go" and obj.getGMNotes() == "enabled" then
    initButtonDisableMarketTBG(obj)
  elseif obj.getName() == "Button Market To Boldly Go" and obj.getGMNotes() == "disabled" then
    initButtonEnableMarketTBG(obj)
  end
  if obj.getName() == "Button Market Mixed" and obj.getGMNotes() == "enabled" then
    initButtonDisableMarketMixed(obj)
  elseif obj.getName() == "Button Market Mixed" and obj.getGMNotes() == "disabled" then
    initButtonEnableMarketMixed(obj)
  end

  -- if solo VS button in position (lifted), handle creation of solo VS buttons
  if obj.getName():find("Setup For Solo") then
    local posObj = obj.getPosition()
    if posObj.y > 0 then
      initButtonSoloVS(obj)

      -- if solo BS button is enabled, lift and init Solo Difficulty buttons for playerColor
      if obj.getGMNotes() == "enabled" then
        local playerColor = obj.getName():find("Blue") and "Blue" or "Red"
        buttonSoloDifficultyVisibility(true, playerColor)
      end
    end
  end

  -- if captain select buttons in position (lifted), handle creation of captain select buttons
  if obj.hasTag("button_faction_setup") then
    local posObj = obj.getPosition()
    if posObj.y > 0 then
      initButtonCaptainSelect(obj)
    end
  end
  if obj.getName():find("Button Use Basic") then
    local posObj = obj.getPosition()
    if posObj.y > 0 and obj.getGMNotes() == "enabled" then
      initButtonDisableBasic(obj)
    elseif posObj.y > 0 and obj.getGMNotes() == "disabled" then
      initButtonEnableBasic(obj)
    end
  elseif obj.getName():find("Button Use Advanced") then
    local posObj = obj.getPosition()
    if posObj.y > 0 and obj.getGMNotes() == "enabled" then
      initButtonDisableAdvanced(obj)
    elseif posObj.y > 0 and obj.getGMNotes() == "disabled" then
      initButtonEnableAdvanced(obj)
    end
  end

  -- handle creation of NZ Control buttons
  if obj.getName():find("Button Control Location") then
    initButtonControlNZLocation(obj)
  end

  -- handle creation of captain area pull action token buttons
  if obj.getName() == "Button Pull Action Token" then
    initButtonPullActionToken(obj)
  end

  -- handle creation of Report Resupply or Report Cleanup buttons
  if obj.getName() == "Button Report Resupply" or obj.getName() == "Button Report Cleanup" then
    initButtonReportResupplyCleanup(obj)
  end

  -- handle creation of Report Skill Icons, Card Suits, and Traits buttons
  if obj.getName():find("Button Report") and (obj.getName() ~= "Button Report Resupply" and obj.getName() ~= "Button Report Cleanup") then
    initButtonReportCurrentTraits(obj)
  end

  -- handle creation of space dock search buttons
  if obj.getName() == "Space Dock" then
    initButtonSearchSpaceDock(obj)
  end

  -- handle creation of player discard hand buttons
  if obj.getName() == "Button Discard Hand" then
    initButtonDiscardHand(obj)
  end

  -- handle creation of player draw deck refresh buttons
  if obj.getName():find("Button Refresh Draw Deck") then
    initButtonRefreshDrawDeck(obj)
  end

  -- handle creation of take incident market button
  if obj.getName() == "Button Take Incident" then
    initButtonTakeIncident(obj)
  end

  -- handle creation of market junk buttons
  if obj.getName():find("Button Junk Market") then
    initButtonJunkCard(obj)
  end

  -- handle creation of market take buttons
  if obj.getName():find("Button Take Market") then
    initButtonTakeCard(obj)
  end

  -- handle creation of market gain buttons (to deck, and to discard)
  if obj.getName():find("Button Deck Gain Market") or obj.getName():find("Button Discard Gain Market") then
    initButtonGainCard(obj)
  end

  -- handle creation of market add resource / end turn buttons
  if obj.getName():find("Button Market Resource") then
    initButtonAddResource(obj)
  end

  -- handle creation of next bot action button if it exists
  if obj.getName() == "Button Next Bot Action" then
    initButtonNextBotAction(obj)
  end

  -- handle creation of solo get MVP button
  if obj.getName() == "Button Most Value" then
    initButtonGetMVP(obj)
  end

  -- handle creation of resolve stardate buttons
  if obj.getName():find("Button Resolve Stardate") then
    initButtonResolveStardate(obj)
    local color = obj.getColorTint()
    obj.highlightOn(color)
  end

  -- handle creation of calculate score buttons
  if obj.getName():find("Calculate Score Button") then
    initButtonCalculateScore(obj)
  end

  -- handle highlight of ships in world onLoad() or rewind
  if obj.hasTag("snap_ship") and (obj.getGMNotes() == "Blue" or obj.getGMNotes() == "Red") then
    obj.highlightOn(obj.getColorTint())
  end

  -- handle creating correct right click context menu options for cards
  if obj.type == "Card" then
    checkContextActions(obj)
  end
end


function onObjectEnterContainer(container, object)
  if object == nil or container == nil then return end
  -- keep highlighting consistent when away teams stack
  if container.hasTag('away_blue') and object.hasTag('away_blue') then
    container.highlightOn("Blue")
  end
  if container.hasTag('away_red') and object.hasTag('away_red') then
    container.highlightOn("Red")
  end

  -- handle glory token drop increasing related counters
  if container.getName() == "Glory Token Bag" and object.getName() == "Glory Token" then
    local playerColor = container.getGMNotes()
    local counter = getObjectbyName("Glory Counter " .. playerColor)
    local val = counter.getVar("val")
    local newVal = val + 1
    counter.call("setValue", newVal)

  -- handle dilithium token drop increasing related counters
  elseif container.getName():find("Dilithium Counter") and object.getName() == "Dilithium Token" then
    local counter = container
    local val = counter.getVar("val")
    local newVal = val + 1
    counter.call("setValue", newVal)

  -- handle latinum token drop increasing related counters
  elseif container.getName():find("Latinum Counter") and object.getName() == "Latinum Token" then
    local counter = container
    local val = counter.getVar("val")
    local newVal = val + 1
    counter.call("setValue", newVal)
  end

  -- broadcast logging actions
  if container.getName() == "Captain's Log" and object.type == "Card" then
    local playerColor = container.getGMNotes()
    local playerStr = getPlayerStr(playerColor)
    local broadcastStr = string.format("%s has Logged %s.", playerStr, object.getName())
    broadcastToAll(broadcastStr, "White")
  end

  -- broadcast beaming actions
  if container.getName() == "Beamed Cards" and object.type == "Card" then
    local playerColor = container.getGMNotes()
    local playerStr = getPlayerStr(playerColor)
    local broadcastStr = string.format("%s has Beamed %s.", playerStr, object.getName())
    broadcastToAll(broadcastStr, "White")
  end
end


function onPlayerTurn(player, _)
  -- handle broadcast of resupply cards onPlayerTurn
  if player == nil then return end
  local playerColor = player.color
  local isBot = checkPlayerColorIsBot(playerColor)
  if Turns.enable and not isBot then
    handleTurnResupplyBroadcast(playerColor) -- in ButtonsCaptain.ttslua (didn't know where else to put it)
  end
end


function onObjectEnterZone(zone, enterObj)
  -- need to check for stardate glory token entering or leaving zone, update stardate glory counter
  if zone == getObjectbyName("Zone Stardate Glory") and enterObj.getName() == "Glory Token" then
    updateStardateGloryCounter()
  end

  -- if captain discard/draw zone and deck in zone, rename deck
  if zone.getName() == "Zone Discard" and (enterObj.type == "Card" or enterObj.type == "Deck") then
    renameCaptainDeck(zone, "Discard")
  end
  if zone.getName() == "Zone Draw Deck" and (enterObj.type == "Card" or enterObj.type == "Deck") then
    renameCaptainDeck(zone, "Draw")
  end

  -- add card right click context menus when entering handzone
  if (zone.getName() == "Handzone" or zone.getName() == "Zone In Play" or zone.getName():find("Zone Deploy") or zone.getName() == "Zone Duty Officer" or zone.getName() == "Zone Captain") and
      enterObj.type == "Card" then
    loadContextActions(zone, enterObj)
  end
end


function onObjectLeaveZone(zone, leaveObj)
  -- update stardate glory counter
  if zone == getObjectbyName("Zone Stardate Glory") and leaveObj.getName() == "Glory Token" then
    updateStardateGloryCounter()
  end

  -- remove zone specific right click context menu actions
  if (zone.getName() == "Handzone" or zone.getName() == "Zone In Play" or
     (zone.getName() == "Zone Deploy Ship" and not leaveObj.hasTag("suit_captain") or
      zone.getName() == "Zone Deploy Location" or zone.getName() == "Zone Duty Officer") and leaveObj.type == "Card") then
    leaveObj.clearContextMenu()
    loadDefaultContextActions(leaveObj)
  end
end


function onObjectRotate(object, _, _, playerColor, _, _)
  -- handle khan captain card rename on flip
  if object.getName() == "Khan Noonien Singh" or object.getName() == "Wrathful Khan" then
    local actualPlayerColor = getActualPlayerColor(object) or playerColor
    local playerStr = getPlayerStr(actualPlayerColor)
    Wait.time(function()

      local broadcastStr
      if object.is_face_down then
        object.setName("Wrathful Khan")
        broadcastStr = string.format("%s has flipped to Wrathful Khan.", playerStr)
      else
        object.setName("Khan Noonien Singh")
        broadcastStr = string.format("%s has flipped to Khan Noonien Singh.", playerStr)
      end
      if broadcastStr ~= nil then broadcastToAll(broadcastStr, "White") end

    end, 1)
  end

  -- handle khan CA V rename on flip
  if object.getName() == "Ceti Alpha V" or object.getName() == "Devastated Ceti Alpha V" then
    local actualPlayerColor = getActualPlayerColor(object) or playerColor
    local playerStr = getPlayerStr(actualPlayerColor)
    Wait.time(function()

      local broadcastStr
      if object.is_face_down then
        object.setName("Devastated Ceti Alpha V")
        broadcastStr = string.format("%s has flipped to Devastated Ceti Alpha V.", playerStr)
      else
        object.setName("Ceti Alpha V")
        broadcastStr = string.format("%s has flipped to Ceti Alpha V.", playerStr)
      end
      if broadcastStr ~= nil then broadcastToAll(broadcastStr, "White") end

    end, 1)
  end

  -- handle khan trait tracker flip report
  if object.getName():find("Khan Trait Tracker") then
    local actualPlayerColor = getActualPlayerColor(object) or playerColor
    local playerStr = getPlayerStr(actualPlayerColor)
    Wait.time(function()

      local broadcastStr
      local trackerName = object.getName()
      trackerName = trackerName:gsub("Khan Trait Tracker ", "")
      if object.is_face_down then
        broadcastStr = string.format("%s has Marked: %s.", playerStr, trackerName)
        object.setColorTint(actualPlayerColor)
      else
        broadcastStr = string.format("%s has Unmarked: %s.", playerStr, trackerName)
        object.setColorTint("Black")
      end
      if broadcastStr ~= nil then broadcastToAll(broadcastStr, "White") end

    end, 1)
  end
end