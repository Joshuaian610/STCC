-- Star Trek Captain's Chair
-- code by Nonprophet, which is why it sucks


card_action_buttons = true

function onLoad()
    local all_objects = getObjects()
    for _, object in pairs(all_objects) do
        -- non interactable objects
        if object.hasTag('non_int') then
            -- object.interactable = false
        end
    end
    -- hide/show blue bot difficulty buttons, create buttons
    local blue_bot_difficulty_button_visibility = "hide" -- "hide" to hide, "show" to show
    local red_bot_difficulty_button_visibility  = "hide"
    local bot_buttons_blue = {"480492", "1a31d8", "e421a1", "378de4", "6d9c4c", "3b7e7c"}
    local bot_buttons_red  = {"b79b3c", "dae39b", "eea328", "ec27fb", "c96d22", "65a2f2"}
    for i = 1, 6 do
        local blue_button  = getObjectFromGUID(bot_buttons_blue[i])
        local red_button   = getObjectFromGUID(bot_buttons_red[i])
        if blue_button    ~= nil then
            local blue_pos = blue_button.getPosition()
            if blue_bot_difficulty_button_visibility == "hide" then
                blue_pos.y = -2
            else
                blue_pos.y = .95
            end
            if blue_button ~= nil then
                blue_button.setPosition(blue_pos)
            end
        end
        if red_button ~= nil then
            local red_pos = red_button.getPosition()
            if red_bot_difficulty_button_visibility == "hide" then
                red_pos.y = -2
            else
                red_pos.y = .95
            end
            if red_button ~= nil then
                red_button.setPosition(red_pos)
            end
        end
    end
    -- hide/show playerarea refresh buttons
    local playerarea_refresh_button_visibility = "hide"  -- "hide" to hide, "show" to show
    local playerarea_refresh_buttons = {getObjectFromGUID("23bed4"), getObjectFromGUID("1a78a6")}
    for i = 1, 2 do
        if playerarea_refresh_buttons[i] ~= nil then
            local button_pos = playerarea_refresh_buttons[i].getPosition()
            if playerarea_refresh_button_visibility == "hide" then
                button_pos.y = -2
                playerarea_refresh_buttons[i].clearButtons()
            else
                button_pos.y = .95
            end
            playerarea_refresh_buttons[i].setPosition(button_pos)
        end
    end
    -- hide/show player area captain selection UI
    local captain_selection_button_visibility = "show"  -- "hide" to hide, "show" to show
    local captain_selection_buttons = {
        getObjectFromGUID("3268c7"),
        getObjectFromGUID("bf2ae1"),
        getObjectFromGUID("f44dbc"),
        getObjectFromGUID("af2e87"),
        getObjectFromGUID("f9cb73"),
        getObjectFromGUID("64deba"),
        getObjectFromGUID("da0506"),
        getObjectFromGUID("c2b772"),
        getObjectFromGUID("bf8c4c"),
        getObjectFromGUID("b6e8fe"),
        getObjectFromGUID("61f6f2"),
        getObjectFromGUID("a19cdf"),
        getObjectFromGUID("f00a15"),
        getObjectFromGUID("04fd5d"),
        getObjectFromGUID("1e4751"),
        getObjectFromGUID("9e82e7"),
        getObjectFromGUID("0db445"),
        getObjectFromGUID("e7df28"),
        getObjectFromGUID("9855df"),
        getObjectFromGUID("58883d"),
        getObjectFromGUID("d5ea7a"),
        getObjectFromGUID("46ae42"),
        getObjectFromGUID("cd36f0"),
        getObjectFromGUID("03b0b7"),
        getObjectFromGUID("bd5567"),
        getObjectFromGUID("12a321"),
        getObjectFromGUID("298fcb"),
        getObjectFromGUID("a315ce"),
        getObjectFromGUID("4c00de"),
        getObjectFromGUID("f53b37"),
        getObjectFromGUID("05e203"),
        getObjectFromGUID("0bad8b"),
    }
    for i = 1, 32 do
        if captain_selection_buttons[i] ~= nil then
            local button_pos = captain_selection_buttons[i].getPosition()
            if captain_selection_button_visibility == "hide" then
                button_pos.y = -2
            else
                button_pos.y = .95
            end
            captain_selection_buttons[i].setPosition(button_pos)
        end
    end
    -- hide/show stardate card glory counter
    local stardate_glory_counter_visibility = "hide"
    local stardate_glory_counter            = getObjectFromGUID("b7d51f")
    local stardate_glory_counter_pos        = stardate_glory_counter.getPosition()
    if stardate_glory_counter_visibility == "hide" then
        stardate_glory_counter_pos.y = -2
    else
        stardate_glory_counter_pos.y = .85
    end
    stardate_glory_counter.setPosition(stardate_glory_counter_pos)
    -- show stardate glory counter onLoad() if game is in progress
    local stardate_zone = getObjectFromGUID("090f7a")
    local stardate_type = nil
    for _, object in pairs(stardate_zone.getObjects()) do
        if string.find(object.getName(), "2-Player") then
            stardate_type = "two_player"
        elseif string.find(object.getName(), "Cadet") then
            stardate_type = "cadet"
        elseif string.find(object.getName(), "Ensign") or string.find(object.getName(), "Captain") then
            stardate_type = "ensign"
        elseif string.find(object.getName(), "Lieutenant") then
            stardate_type = "lieutenant"
        elseif string.find(object.getName(), "Commander") then
            stardate_type = "commander"
        elseif string.find(object.getName(), "Admiral") then
            stardate_type = "Admiral"
        end
        -- get glory count in zone
        local glory_count = 0
        for _, object in pairs(getObjectFromGUID("338aa7").getObjects()) do
            if object.getName() == "Glory Token" then
                glory_count = glory_count + 1
            end
        end
        if stardate_type ~= nil then -- game is in progress, or, stardate cards no longer in play, either or
            show_stardate_glory_counter({stardate_type=stardate_type})
            stardate_glory_counter.call('set_val', glory_count)
        end
    end
    -- display XML UI if captain has been selected
    local colors = {"Blue", "Red"}
    for i = 1, 2 do
        local playercolor            = colors[i]
        local is_solo                = false
        if getObjectFromGUID(playercolor == "Blue" and "23bed4" or "1a78a6").getGMNotes() == "solo" then is_solo = true end
        local captain_zone           = getObjectFromGUID(playercolor == "Blue" and "75465f" or "75c041")
        local captain_pad            = getObjectFromGUID(playercolor == "Blue" and "997491" or "28a24b")
        for _, object in pairs(captain_zone.getObjects()) do
            if string.find(object.getName(), "Crew Board") and object ~= captain_pad then
                captain_card_name    = object.getName()
            end
        end
        local captain_name           = nil
        local split_name             = {}
        if captain_card_name        ~= nil then
            for str in string.gmatch(captain_card_name,  "%S+") do
                table.insert(split_name, str)
            end
        end
        captain_name = split_name[1]
        Wait.frames(function()
        if captain_name == "Burnham" or captain_name == "Picard" or captain_name == "Sisko" then
            UI.setAttribute(string.lower(playercolor) .. "_starfleet_panel", "active", "true")
            UI.setAttribute(string.lower(playercolor) .. "_hum_glory",       "text",   getObjectFromGUID(playercolor == "Blue" and "d96ce2" or "9a5066").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_hum_latinum",     "text",   getObjectFromGUID(playercolor == "Blue" and "39e892" or "c2bac2").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_hum_dilithium",   "text",   getObjectFromGUID(playercolor == "Blue" and "a3ec59" or "f40879").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_hum_research",    "text",   getObjectFromGUID(playercolor == "Blue" and "8317bd" or "c5021e").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_hum_influence",   "text",   getObjectFromGUID(playercolor == "Blue" and "9b4f79" or "f3c9be").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_hum_military",    "text",   getObjectFromGUID(playercolor == "Blue" and "9a7130" or "5564b6").getVar('val'))
            UI.setAttribute(i == 1 and "ui_hide_blue" or "ui_hide_red", "active", "true")
        elseif captain_name == "Shran" then
            UI.setAttribute(string.lower(playercolor) .. "_andorian_panel",  "active", "true")
            UI.setAttribute(string.lower(playercolor) .. "_and_glory",       "text",   getObjectFromGUID(playercolor == "Blue" and "d96ce2" or "9a5066").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_and_latinum",     "text",   getObjectFromGUID(playercolor == "Blue" and "39e892" or "c2bac2").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_and_dilithium",   "text",   getObjectFromGUID(playercolor == "Blue" and "a3ec59" or "f40879").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_and_research",    "text",   getObjectFromGUID(playercolor == "Blue" and "8317bd" or "c5021e").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_and_influence",   "text",   getObjectFromGUID(playercolor == "Blue" and "9b4f79" or "f3c9be").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_and_military",    "text",   getObjectFromGUID(playercolor == "Blue" and "9a7130" or "5564b6").getVar('val'))
            UI.setAttribute(i == 1 and "ui_hide_blue" or "ui_hide_red", "active", "true")
        elseif captain_name == "Sela" then
            UI.setAttribute(string.lower(playercolor) .. "_romulan_panel",  "active", "true")
            UI.setAttribute(string.lower(playercolor) .. "_rom_glory",      "text",   getObjectFromGUID(playercolor == "Blue" and "d96ce2" or "9a5066").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_rom_latinum",    "text",   getObjectFromGUID(playercolor == "Blue" and "39e892" or "c2bac2").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_rom_dilithium",  "text",   getObjectFromGUID(playercolor == "Blue" and "a3ec59" or "f40879").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_rom_research",   "text",   getObjectFromGUID(playercolor == "Blue" and "8317bd" or "c5021e").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_rom_influence",  "text",   getObjectFromGUID(playercolor == "Blue" and "9b4f79" or "f3c9be").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_rom_military",   "text",   getObjectFromGUID(playercolor == "Blue" and "9a7130" or "5564b6").getVar('val'))
            UI.setAttribute(i == 1 and "ui_hide_blue" or "ui_hide_red", "active", "true")
        elseif captain_name == "Koloth" then
            UI.setAttribute(string.lower(playercolor) .. "_klingon_panel", "active", "true")
            UI.setAttribute(string.lower(playercolor) .. "_kli_glory",     "text",   getObjectFromGUID(playercolor == "Blue" and "d96ce2" or "9a5066").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_kli_latinum",   "text",   getObjectFromGUID(playercolor == "Blue" and "39e892" or "c2bac2").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_kli_dilithium", "text",   getObjectFromGUID(playercolor == "Blue" and "a3ec59" or "f40879").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_kli_research",  "text",   getObjectFromGUID(playercolor == "Blue" and "8317bd" or "c5021e").getVar('val'))
            UI.setAttribute(string.lower(playercolor) .. "_kli_influence", "text",   getObjectFromGUID(playercolor == "Blue" and "9b4f79" or "f3c9be").getVar('val'))
            UI.setAttribute(i == 1 and "ui_hide_blue" or "ui_hide_red", "active", "true")
        end
        end, 1)
        if is_solo then
            UI.setAttribute("bot_controls", "active", "true")
            UI.setAttribute('bot_discard', 'active', 'true')
            UI.setAttribute('bot_discard_x3', 'active', 'true')
            UI.setAttribute('bot_log', 'active', 'true')
            UI.setAttribute('bot_incident', 'active', 'true')
            if getObjectFromGUID("e28824").getGMNotes() == "Control" then
                UI.setAttribute('end_player_turn', 'active', 'true')
            elseif getObjectFromGUID("e28824").getGMNotes() == "Action" then
                UI.setAttribute('bot_next_action_action', 'active', 'true')
            elseif getObjectFromGUID("e28824").getGMNotes() == "Cleanup" then
                UI.setAttribute('bot_next_action_cleanup', 'active', 'true')
            end
        end
    end
    -- broadcast welcome message if setup button exists
    if getObjectFromGUID("75ffc5") ~= nil then
        broadcastToAll("Welcome to Star Trek: Captain's Chair! Use the 'Setup Game' button at the center of the table to get started.", "White")
    end
end -- end onLoad()


function onObjectEnterContainer(container, object)
    -- keep highlighting consistent when away teams stack
    if container.hasTag('away_blue') and object.hasTag('away_blue') then
        container.highlightOn("Blue")
    end
    if container.hasTag('away_red') and object.hasTag('away_red') then
        container.highlightOn("Red")
    end
end -- end onObjectEnterContainer()


function onPlayerTurn(player, previous_player)
    if Turns.enable then
        local current_player = player.color
        local check_zones = current_player == "Blue" and {
            getObjectFromGUID("a9ca57"),
            getObjectFromGUID("2c336e"),
            getObjectFromGUID("fc7f21"),
            getObjectFromGUID("596317"),
        } or
        {
            getObjectFromGUID("818a7e"),
            getObjectFromGUID("77d0cb"),
            getObjectFromGUID("5103b2"),
            getObjectFromGUID("bf1e62"),
        }
        local match_cards = {}
        for i = 1, 4 do
            for _, object in pairs(check_zones[i].getObjects()) do
                if object.hasTag('resupply') then
                    object.highlightOn(current_player)
                    table.insert(match_cards, object)
                    Wait.time(function() object.highlightOff() end, 5)
                end
            end
        end
        if #match_cards > 0 then
            broadcastToAll("Reminder - Current in play Resupply Step Cards for " .. current_player .. " Player.", current_player)
            for i = 1, #match_cards do
                broadcastToAll(match_cards[i].getName(), "White")
            end
        end
    end
end -- end onPlayerTurn()


function animate_button(params)
    local button      = params.button
    local down_factor = .30
    if string.find(button.getName(), "Button Market Resource") then
        down_factor   = .19
    end
    local pos         = button.getPosition()
    pos.y             = pos.y - down_factor
    button.clearButtons()
    button.setPosition(pos)
    pos.y             = pos.y + down_factor
    button.setPositionSmooth(pos, false, false)
    Wait.time(function() button.call('create_button') end, .4)
end -- end animate_button(params)


function show_stardate_glory_counter(args)
    local stardate_type   = args.stardate_type
    local color           = {0, 0, 0, 255}
    local h_color         = {0, 0, 0, .8}
    local f_color         = {1, 1, 1, 1}
    if stardate_type     == "two_player" then
        color             = {119/255, 179/255, 203/255, 255}
        h_color           = {119/255, 179/255, 203/255, .8}
    elseif stardate_type == "cadet" then
        color             = {171/255, 107/255, 142/255, 255}
        h_color           = {171/255, 107/255, 142/255, .8}
    elseif stardate_type == "ensign" or stardate_type == "captain" then
        color             = {229/255, 133/255, 21/255, 255}
        h_color           = {229/255, 133/255, 21/255, .8}
    elseif stardate_type == "lieutenant" then
        color             = {113/255, 170/255, 117/255, 255}
        h_color           = {113/255, 170/255, 117/255, .8}
    elseif stardate_type == "commander" then
        color             = {198/255, 202/255, 165/255, 255}
        h_color           = {198/255, 202/255, 165/255, .8}
    elseif stardate_type == "admiral" then
        color             = {173/255, 29/255, 20/255, 255}
        h_color           = {173/255, 29/255, 20/255, .8}
    end
    local counter         = getObjectFromGUID("b7d51f")
    local counter_pos     = counter.getPosition()
    counter_pos.y         = .85
    counter.setPosition(counter_pos)
    counter.call('create_all', {color=color, h_color=h_color})
end -- end show_stardate_glory_counter()

