      elseif cardObj.hasTag("trait_ship") then
        return "Ship", "Junk the most valuable card in the Market (ignoring any with tokens). Send an Away Team to a neutral [b]unmarked[/b] > Location."
      elseif cardObj.hasTag("trait_directive") then
        return "Directive", "Junk the most valuable card in the Market (ignoring any with tokens). Gain an [b]unmarked[/b] > Person or Cargo or Ship or Ally from the Junk."
