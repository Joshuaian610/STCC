        return "Cargo", "Log the top card of the Bot deck. Send an Away Team to a neutral Xindi or Tellarite Location > Location. Dismiss Duty Officer. Log this card."
      elseif captainName == "Georgiou" then
        return "Cargo", "Log the top card of the Bot deck. Discard the top 2 cards of the Bot deck. Gain a Ship. Deploy the gained Ship; it explores. Log Duty Officer."
      elseif captainName == "Kirk" then
        return "Cargo", "Log the top card of the Bot deck. Gain 1 Research. Gain a Ship. Deploy the gained Ship; it explores."
      elseif captainName == "Khan" then
        return "Cargo", "Gain an Ally > Person or Ship. Log Duty Officer."
      elseif captainName == "Rebner" then
        return "Cargo", string.format("Gain a Military Focus > Person. Gain 1 Military and [%s]you remove an Away Team from a neutral Location[-] where the Bot has 1+ token. Send an Away Team to a neutral Location. Dismiss Duty Officer.", attackColor)
      elseif captainName == "Soval" then
        return "Cargo", "Gain Scientist or Anomaly or Engineer > Ally, including from Junk. Dismiss Duty Officer."
      elseif captainName == "Freeman" then
        return "Cargo", "Discard the top 2 cards of the Bot deck. Gain a Person. If able, resolve a Ship from the Bot Discard pile; otherwise gain 1 Research or 1 Influence or 1 Military, whichever is higher. Log the top card of the Bot deck. Log this card."
      elseif captainName == "Pike" then
        return "Cargo", "Discard the top 3 cards of the Bot deck. Gain a Research Focus or Influence Focus > Ally. Dismiss Duty Officer."
      elseif captainName == "Riker" then
        return "Cargo", "Junk the most valuable card in the Market (ignoring any with tokens). Discard the top 2 cards of the Bot deck. Return an Incident from the Bot Discard pile, if able. Gain 1 Glory."
      end
    end
  end

  if cardObj.hasTag("suit_person") then

    if not hasDuty then
      if captainName == "Burnham" then
        return "Person", "Gain 1 Research. Send an Away Team to a neutral Location. Promote this card to Duty Officer."
      elseif captainName == "Koloth" then
        return "Person", "Discard the top card of the Bot deck. Gain 1 Military / Influence (whichever is lower). Gain a Weapon > Ship. Promote this card to Duty Officer."
      elseif captainName == "Picard" then
        return "Person", "Log the top card of the Bot deck. Gain 1 Research / Influence (whichever is lower). Send an Away Team to a neutral Location. Promote this card to Duty Officer."
      elseif captainName == "Sela" then
        return "Person", "Gain 1 Military. If able, gain a Vulcan > Klingon. Otherwise, if able, dismiss a Ship to gain a Person / Ship. Otherwise, gain a Cargo. Promote this card to Duty Officer."
      elseif captainName == "Shran" then
        return "Person", "Discard the top 2 cards of the Bot deck. Gain 1 Influence / Military (whichever is lower). Send an Away Team to a neutral Location. Promote this card to Duty Officer."
      elseif captainName == "Sisko" then
        return "Person", "Gain 1 Influence. Send an Away Team to a neutral Location. Promote this card to Duty Officer."
      elseif captainName == "Archer" then
        return "Person", "Gain a Xindi or Andorian > Cargo. Promote this card to Duty Officer."
      elseif captainName == "Georgiou" then
        return "Person", "Log the top card of the Bot deck. Gain 1 Research or 1 Military (whichever is lower). Send an Away team to a neutral Location. Promote this card to Duty Officer."
      elseif captainName == "Kirk" then
        return "Person", "Gain 1 Research or 1 Influence or 1 Military (whichever is lower). Send an Away Team to a neutral Location. Promote this card to Duty Officer"
      elseif captainName == "Khan" then
        return "Person", "Gain 1 Glory. Gain an Incident. Promote this card to Duty Officer."
      elseif captainName == "Rebner" then
        return "Person", "Gain a Weapon > Ship. Promote this card to Duty Officer."
      elseif captainName == "Soval" then
        return "Person", "Log the top card of the Bot deck. Gain 1 Research or 1 Military (whichever is lower). Send an Away Team to a neutral Location. Promote this card to Duty Officer."
      elseif captainName == "Freeman" then
        return "Person", "Log the top card of the Bot deck. Gain 1 Research or 1 Military (whichever is lower). If the Bot has 4 or more Research, gain Lower Decker or Anomaly or Doctor, including from the Junk. If the Bot has 4 or more Military, send an Away team to a neutral Location. Promote this card to Duty Officer."
      elseif captainName == "Pike" then
        return "Person", "If there is no Starfleet in the Bot Discard, take a Research Focus or Influence Focus > Starfleet or Augment > Ship; otherwise send an Away Team to a neutral Location. Promote this card to Duty Officer."
      elseif captainName == "Riker" then
        return "Person", "Discard the top 3 cards of the Bot deck. If one of the discarded cards is Incident, return it; otherwise gain a Cargo. Promote this card to Duty Officer."
      end

    else
      if captainName == "Burnham" then
        return "Person", "Discard the top 2 cards of Bot deck. Gain 1 Research / Influence (whichever is lower). Send an Away Team to a neutral Location."
      elseif captainName == "Koloth" then
        return "Person", "Log the top card of Bot deck. Gain a Cargo. If able, return a Ship from Bot Discard pile to the top of the Bot deck. Otherwise, take a Ship."
      elseif captainName == "Picard" then
        return "Person", "Log the top card of the Bot deck. Gain 1 Research / Influence (whichever is lower). Send an Away Team to a neutral Location."
      elseif captainName == "Sela" then
        return "Person", "Log the top card of the Bot deck. Discard the top 3 cards of the Bot deck. If able, gain a Shady > Vulcan. Otherwise, gain 2 Military."
      elseif captainName == "Shran" then
        return "Person", "Log the top card of the Bot deck. Gain 1 Influence. Gain 1 Military. Take a Ship / Ally."
      elseif captainName == "Sisko" then
        return "Person", "Discard the top 3 cards of the Bot deck. Gain 1 Influence / Military (whichever is lower). Gain a Ship / Influence Focus."
      elseif captainName == "Archer" then
        return "Person", "Manually Resolve a Directive from the Bot Discard pile if able, otherwise gain 1 Glory. Dismiss Duty Officer."
      elseif captainName == "Georgiou" then
        return "Person", "Log the top card of the Bot deck. Send an Away Team to a neutral Location."
      elseif captainName == "Kirk" then
        return "Person", "Discard the top card of the Bot deck. Gain a Vulcan > Any Species excluding Human > Person or Cargo or Ship or Ally."
      elseif captainName == "Khan" then
        return "Person", "Put an Augment from Bot Discard pile on top of the Bot deck, if able. Dismiss Duty Officer."
      elseif captainName == "Rebner" then
        return "Person", "If the top card of the Bot deck is a Helmet, discard it and send an Away team to a neutral Location. Otherwise, log it, gain 1 Military, and gain a Communication > Scientist > Ally or Ship, including from the Junk."
      elseif captainName == "Soval" then
        return "Person", "If Ship is in Bot Discard, put it on top of the Bot deck. Gain a Research Focus > Military Focus > Influence Focus > Ship and dismiss Duty Officer."
      elseif captainName == "Freeman" then
        return "Person", "If able to do both, log a controlled Location and remove 2 Away Teams to take top Encounter, then log this card. Otherwise gain 1 Research or 1 Military, whichever is lower, and discard the top card of the Bot deck."
      elseif captainName == "Pike" then
        return "Person", "Junk the most valuable card in the Market (ignoring any with tokens). If Bot has 6 or more Influence, gain an Influence Focus or Ship or Ally and dismiss Duty Officer; otherwise gain 2 Influence."
      elseif captainName == "Riker" then
        return "Person", "Take an Incident. Manually resolve a Ship from the Bot Discard pile if able, otherwise take a Ship and dismiss Duty Officer."
      end
    end
  end

  if cardObj.hasTag("suit_directive") then

    if not hasDuty then
      if captainName == "Burnham" then
        return "Directive", "Discard the top 2 cards of the Bot deck. Gain 2 Influence. Remove 1 Glory from the stardate card."
      elseif captainName == "Koloth" then
        return "Directive", "Discard the top 3 cards of the Bot deck. Gain 1 Military. Take an Incident. Send an Away Team to a neutral Location."
      elseif captainName == "Picard" then
        return "Directive", "If able, gain a Klingon. Otherwise, gain a Ship / Ally and take an Incident. Gain 1 Research / Influence (whichever is lower). Send an Away Team to a neutral Location."
      elseif captainName == "Sela" then
        return "Directive", "Discard the top 3 cards of the Bot deck. Gain 2 Research / Influence / Military (whichever is lower)."
      elseif captainName == "Shran" then
        return "Directive", "Gain a Business > Cargo. Send an Away Team to a neutral Location. If Bot has 5+ Influence, gain 1 Glory and take an Incident."
      elseif captainName == "Sisko" then
        return "Directive", "Discard the top 3 cards of the Bot deck. If able, log a Person from Bot Discard pile to send an Away Team to a neutral Location. Otherwise, gain 1 Influence / Military (whichever is lower) and gain a Person."
      elseif captainName == "Archer" then
        return "Directive", "Discard the top card of the Bot deck. Gain a NX-01 if able, otherwise twice: gain 1 Research or 1 Influence or 1 Military, whichever is lower. Promote a Person with NX-01 from the Bot Discard pile to Duty Officer, if able."
      elseif captainName == "Georgiou" then
        return "Directive", "Gain a Ship or Ally and take an Incident. Send an Away Team to a neutral Location."
      elseif captainName == "Kirk" then
        return "Directive", "Gain a Ship or Ally and take an Incident. Send an Away Team to a neutral Location."
      elseif captainName == "Khan" then
        return "Directive", "Junk the most valuable card in the Market (ignoring any with tokens). Gain an Ally or Ship from the Junk."
      elseif captainName == "Rebner" then
        return "Directive", "Junk the most valuable card in the Market (ignoring any with tokens). Discard the top 3 cards of the Bot deck. If able, promote a Person from Bot Discard pile to Duty Officer. Otherwise, send an Away Team to a neutral Location."
      elseif captainName == "Soval" then
        return "Directive", "Gain a Research Focus > Scientist or Telepath > Ally and gain an Incident."
      elseif captainName == "Freeman" then
        return "Directive", "Take a Lower Decker if able; otherwise gain a Ship or Ally and take an Incident. Send an Away Team to a neutral Location."
      elseif captainName == "Pike" then
        return "Directive", "Discard the top 2 cards of the Bot deck. Resolve a Ship from the Bot Discard, if able; otherwise take an Incident and send an Away Team to a neutral Location."
      elseif captainName == "Riker" then
        return "Directive", "Gain 1 Research. If this card has a Skill icon, gain 2 (additional) Research, otherwise take an Incident and a Ship or Ally or Person. Send an Away Team to a neutral Location."
      end

    else
      if captainName == "Burnham" then
        return "Directive", "If able to do both, log a controlled Location and remove an Away Team to gain top Encounter. Otherwise, discard the top 2 cards of the Bot deck and gain the card in the Market with the most Dilithium > most Glory."
      elseif captainName == "Koloth" then
        return "Directive", "If able to do both, log a Ship and remove an Away Team to take top Encounter, then log this card and log Duty Officer. Otherwise, gain 1 Glory, 1 Military, and a Person."
      elseif captainName == "Picard" then
        return "Directive", "If able to do both, log a controlled Location and remove 2 Away Teams to take top Encounter then log this card. Otherwise, gain a Research Focus > Alien > Cargo / Ally."
      elseif captainName == "Sela" then
        return "Directive", "If able, remove 2 Away Teams to gain top Encounter, then log this card and log Duty Officer. Otherwise, gain a Shady > Attack > Cargo / Ship."
      elseif captainName == "Shran" then
        return "Directive", "If able to do both, log a controlled Location and remove 2 Away Teams to take top Encounter, then log this card. Otherwise gain a Cargo / Ship."
      elseif captainName == "Sisko" then
        return "Directive", "If able to do both, log a controlled Location (not a Starbase) and remove 2 Away Teams to take top Encounter and log this card. Otherwise, send an Away Team to a neutral Location, gain 1 Influence, and dismiss Duty Officer."
      elseif captainName == "Archer" then
        return "Directive", "If able to do both, log a controlled Location and remove 2 Away Teams to take top Encounter, then log this card. Otherwise, gain NX-01 > Ally or Ship. If a Ship was gained, dismiss Duty Officer, otherwise send Away Team to a neutral Location."
      elseif captainName == "Georgiou" then
        return "Directive", "If able to do both, log a controlled Location and remove 2 Away Teams to take top Encounter then log this card. Otherwise, gain a Research Focus or Military Focus > Anomaly > Cargo."
      elseif captainName == "Kirk" then
        return "Directive", "If able to do both, log a controlled Location and remove 2 Away Teams to take top Encounter, then log this card. Otherwise, discard the top card of the Supplement deck."
      elseif captainName == "Khan" then
        return "Directive", "Junk the most valuable card in the Market (ignoring any with tokens). Gain a Person or Cargo or Ally, including from the Junk."
      elseif captainName == "Rebner" then
        return "Directive", "Junk the most valuable card in the Market (ignoring any with tokens). Discard the top 2 cards of the Bot deck. If a Helmet is in Bot Discard pile, gain a Cargo or Ship. Otherwise, send an Away team to a neutral Location and gain 1 Military."
      elseif captainName == "Soval" then
        return "Directive", "Gain 1 Research. Gain 1 Influence or 1 Military (whichever is lower). If Duty Officer is Vulcan, discard the top 2 cards of the Bot deck; otherwise gain 1 Glory."
      elseif captainName == "Freeman" then
        return "Directive", "If able to do both, log a controlled Location and remove 2 Away Teams to take top Encounter, then log this card. Otherwise gain 1 Research or 1 Military, whichever is lower, and discard the top card of the Bot deck."
      elseif captainName == "Pike" then
        return "Directive", "If able to do both, log a controlled Location and remove 2 Away Teams to take top Encounter, then log this card. Otherwise gain 1 Research and gain a Research Skill or Research Focus, or Influence Skill or Influence Focus, or Military Skill or Military Focus."
      elseif captainName == "Riker" then
        return "Directive", "If able to do both, log a controlled Location and remove 2 Away Teams to take top Encounter, then log this card. Otherwise, gain 1 Research or 1 Military (whichever is lower), and discard the top 2 cards of the Bot deck."
        end
    end
  end

  if cardObj.hasTag("suit_encounter") then

    if not hasDuty then
      if captainName == "Burnham" then
        return "Encounter", "Log the top 2 cards of the Bot deck. Take a Person."
      elseif captainName == "Koloth" then
        return "Encounter", "Gain a Person / Ally. Send an Away Team to a neutral Location. Log this card."
      elseif captainName == "Picard" then
        return "Encounter", "Log the top 2 cards of the Bot deck. Take a Ship. Log this card."
      elseif captainName == "Sela" then
        return "Encounter", "Log the top card of the Bot deck. Gain a Person and promote it to Duty Officer."
      elseif captainName == "Shran" then
        return "Encounter", "Discard the top 2 cards of the Bot deck. Gain a Person. Gain a Cargo. Log this card."
      elseif captainName == "Sisko" then
        return "Encounter", "Discard the top 3 cards of the Bot deck. Take an Influence Focus > Person. Log this card."
      elseif captainName == "Archer" then
        return "Encounter", "Discard the top card of the Supplement deck. Log this card."
      elseif captainName == "Georgiou" then
        return "Encounter", "Log the top 2 cards of the Bot deck. Take a Ship. Log this card."
      elseif captainName == "Kirk" then
        return "Encounter", "Log the top card of the Bot deck. Gain the card in the Market with the most Glory."
      elseif captainName == "Khan" then
        return "Encounter", "Manually resolve the top card of the Supplement deck."
      elseif captainName == "Rebner" then
        return "Encounter", "Discard the top 2 cards of the Bot deck. Gain a Military Focus > Attack > Weapon > Ship. Gain 1 Glory. Log this card."
      elseif captainName == "Soval" then
        return "Encounter", "Gain 1 Research. Discard the top card of the Supplement deck."
      elseif captainName == "Freeman" then
        return "Encounter", "Gain 2 Glory and log this card."
      elseif captainName == "Pike" then
        return "Encounter", "Discard the top 3 cards of the Bot deck. Take a Time Travel > Doctor > Research Focus or Influence Focus or Military Focus > Person. Discard the top card of the Supplement deck. Log this card."
      elseif captainName == "Riker" then
        return "Encounter", "Discard the entire Bot deck. Gain 2 Glory. Log this card."
      end

    else
      if captainName == "Burnham" then
        return "Encounter", "Gain 1 Research. Gain 1 Influence. Gain a Scientist > Anomaly > Ship. Log this card."
      elseif captainName == "Koloth" then
        return "Encounter", "Gain 1 Influence / Military (whichever is higher). Gain a Ship. Deploy the gained Ship; it engages."
      elseif captainName == "Picard" then
        return "Encounter", "Gain 1 Research / Influence (whichever is higher). Take a Klingon > Ally > Ship. Log this card."
      elseif captainName == "Sela" then
        return "Encounter", "Gain 2 Glory. Send an Away Team to a neutral Location. Send an Away Team to a neutral Location. Log Duty Officer. Log this card."
      elseif captainName == "Shran" then
        return "Encounter", "Gain 1 Glory. Gain 1 Military. Take a Ship > Ally. Log this card."
      elseif captainName == "Sisko" then
        return "Encounter", "Discard the top card of the Bot deck. Gain 1 Military. Gain 1 Influence. Take a Ship / Ally."
      elseif captainName == "Archer" then
        return "Encounter", "Resolve the top card of the Supplement deck. Log this card."
      elseif captainName == "Georgiou" then
        return "Encounter", "Gain 1 Research or 1 Military (whichever is higher). Take a Vulcan > Ally > Ship. Log this card."
      elseif captainName == "Kirk" then
        return "Encounter", "Gain 1 Research. Gain 1 Influence. Gain 1 Military. Gain 1 Glory. Log this card."
      elseif captainName == "Khan" then
        return "Encounter", "If 8 or more traits are marked, gain the highest value card of the top 3 Encounters and destroy the other two, then log the gained card and this card. Otherwise, manually resolve the top card of the Supplement deck."
      elseif captainName == "Rebner" then
        return "Encounter", "Gain 1 Glory. Gain an Engineer or Communication or Scientist > Person, including from the Junk. Log this card."
      elseif captainName == "Soval" then
        return "Encounter", "Gain 1 Research. Gain 1 Influence. Manually resolve the top card of the Supplement deck. Log this card."
      elseif captainName == "Freeman" then
        return "Encounter", "Take a Lower Decker or Orion or Anomaly or Doctor or Security or Ops, if able, and log this card; otherwise log the top 2 cards of the Bot deck."
      elseif captainName == "Pike" then
        return "Encounter", "Log the top card of the Bot deck. Gain 1 Military. Gain 1 Influence. Take an Ally. Resolve the top card of the Supplement deck. Log this card."
      elseif captainName == "Riker" then
        return "Encounter", "Gain 1 Glory. Discard the entire Bot deck. Resolve the top card of the Supplement deck. Return an Incident from the Bot Discard pile, if able. Log this card."
      end
    end
  end

  if cardObj.hasTag("suit_location") then

    if not hasDuty then
      if captainName == "Burnham" then
        return "Location", "Discard the top 2 cards of the Bot deck. Gain 1 Military. Gain 1 Research / Influence (whichever is lower)."
      elseif captainName == "Koloth" then
        return "Location", "Log the top card of the Bot deck. Discard the top 2 cards of the Bot deck. If a Ship is in Bot Discard pile, gain 1 Glory."
      elseif captainName == "Picard" then
        return "Location", "Log the top card of the Bot deck. Discard the top 3 cards of the Bot deck."
      elseif captainName == "Sela" then
        return "Location", "Log the top card of the Bot deck. Gain a Person and promote it to Duty Officer."
      elseif captainName == "Shran" then
        return "Location", "Log the top card of the Bot deck. Discard the top 2 cards of the Bot deck."
      elseif captainName == "Sisko" then
        return "Location", "Log the top card of the Bot deck. Discard the top 3 cards of the Bot deck. Gain 1 Military. If able, return a Ship from Bot Discard pile to top of the Bot deck."
      elseif captainName == "Archer" then
        return "Location", "Discard the top 2 cards of the Bot deck. Gain a Person. Gain 3 Glory from the supply (** Drag Glory Tokens out of Central Glory Bag and place to your Player Area Glory Counter Bag)."
      elseif captainName == "Georgiou" then
        return "Location", "Discard the top card of the Bot deck. Return an Incident from Bot Discard pile if able, otherwise gain 1 Glory."
      elseif captainName == "Kirk" then
        return "Location", "Log the top card of the Bot deck. Gain 1 Research or 1 Influence or 1 Military (whichever is lower). Send an Away team to a neutral Location."
      elseif captainName == "Khan" then
        return "Location", "Discard the top 2 cards of the Bot deck. Gain a Ship."
      elseif captainName == "Rebner" then
        return "Location", "If able, gain an Engineer or Communication or Scientist. Otherwise, gain a Weapon or Attack > Person from the Junk."
      elseif captainName == "Soval" then
        return "Location", "Discard the top 3 cards of the Bot deck. Gain 1 Glory."
      elseif captainName == "Freeman" then
        return "Location", "Gain 1 Influence. Discard the top card of the Bot deck. Return an Incident from the Bot Discard pile if able; otherwise gain a Person."
      elseif captainName == "Pike" then
        return "Location", "Discard the top 2 cards of the Bot deck. Gain 1 Glory. If this card is a Starbase, send an Away Team to a neutral Location."
      elseif captainName == "Riker" then
        return "Location", "Gain 1 Influence. Send an Away Team to a neutral Location."
      end

    else
      if captainName == "Burnham" then
        return "Location", "Log the top 2 cards of the Bot deck. Gain 1 Research. Dismiss Duty Officer."
      elseif captainName == "Koloth" then
        return "Location", "Dismiss Duty Officer. Gain 1 Glory. Resolve the top card of the Bot deck."
      elseif captainName == "Picard" then
        return "Location", "Log the top 2 cards of the Bot deck. Gain 1 Research. Log Duty Officer."
      elseif captainName == "Sela" then
        return "Location", string.format("If able, gain a Shady. Otherwise, dismiss Duty Officer, gain a Person / Cargo / Ally, and [%s]you discard a card.[-]", attackColor)
      elseif captainName == "Shran" then
        return "Location", "Gain 1 Military. Gain 1 Glory. Log Duty Officer."
      elseif captainName == "Sisko" then
        return "Location", "Log the top card of the Bot deck. Discard the top 3 cards of the Bot deck. Gain 1 Influence. Log Duty Officer."
      elseif captainName == "Archer" then
        return "Location", "Discard the top card of the Supplement deck. Log the top 2 cards of the Bot deck. Gain 1 Glory (using bot Glory counter), and another 2 Glory (** Drag Glory Tokens out of Central Glory Bag and place to your Player Area Glory Counter Bag)."
      elseif captainName == "Georgiou" then
        return "Location", "Log the top 2 cards of the Bot deck. Gain 1 Research. Log Duty Officer."
      elseif captainName == "Kirk" then
        return "Location", "Gain 1 Research. Gain 1 Influence. Gain 1 Military. Take an Incident. If able, deploy a Ship from Bot Discard pile; it explores. Otherwise, send an Away Team to a neutral Location. Log Duty Officer."
      elseif captainName == "Khan" then
        return "Location", "Discard the top card of the Supplement deck. Log Duty Officer."
      elseif captainName == "Rebner" then
        return "Location", "If a Helmet is in Bot Discard pile, gain 1 Military and discard the top card of the Supplement deck. Otherwise, dismiss Duty Officer, then manually resolve the top card of the Bot deck."
      elseif captainName == "Soval" then
        return "Location", "Gain 1 Influence. Gain a Research Focus > Starfleet > Cargo. Log Duty Officer."
      elseif captainName == "Freeman" then
        return "Location", "Discard the top 2 cards of the Bot deck. Gain 1 Influence. Log the top card of the Bot deck. If the Duty Officer is Lower Decker, dismiss them, otherwise log them."
      elseif captainName == "Pike" then
        return "Location", "Discard the top 3 cards of the Bot deck. Gain 1 Influence. If Duty Officer is Time Travel, dismiss it; otherwise log it."
      elseif captainName == "Riker" then
        return "Location", "Gain 1 Influence. Discard the top card of the Supplement deck. Log the Duty Officer."
      end
    end
  end
  return "No Operative Icon Found", "No Action Text Found"
end