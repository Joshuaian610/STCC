      elseif cardObj.hasTag("trait_ally") then
        return "Ally", "Discard the top card of the Bot deck. If this card is a Location taken during the Control Step, gain an Incident, and spend 1 Dilithium, if able. If this card is a Person, gain 1 Glory [b]from the supply[/b] (** Drag Glory Token from Central Bag, drop into Bot Glory Counter bag)."
      elseif cardObj.hasTag("trait_location") then
        return "Location", "Discard the top card of the Bot deck. If this card is a Location taken during the Control Step, gain an Incident, and spend 1 Dilithium, if able. If this card is a Person, gain 1 Glory [b]from the supply[/b] (** Drag Glory Token from Central Bag, drop into Bot Glory Counter bag)."
      end

    elseif not khanInExile then
      if cardObj.hasTag("trait_mindcontrol") then
        return "Mind Control", string.format("[%s]You dismiss a Duty Officer, if able,[-] otherwise gain 2 Glory. Manually continue resolution.", attackColor)
      elseif cardObj.hasTag("trait_augment") then
        return "Augment", "Send an Away Team to a neutral [b]unmarked[/b] > Augment or Scientist > Location. If this card is a Person, take an Incident and take a Person; otherwise discard the top card of the Supplement deck."
      elseif cardObj.hasTag("trait_ops") then
        return "Ops", "Send an Away Team to a neutral [b]unmarked[/b] > Augment or Scientist > Location. If this card is a Person, take an Incident and take a Person; otherwise discard the top card of the Supplement deck."
      elseif cardObj.hasTag("trait_creature") then
        return "Creature", "Return an Incident from Bot Discard pile, if able. Send 2 Away Teams to a neutral Location, ignoring any opponent Ship. Log this card."
      elseif cardObj.hasTag("trait_scientist") then
        return "Scientist", "Return an Incident from Bot Discard pile, if able. Send 2 Away Teams to a neutral Location, ignoring any opponent Ship. Log this card."
      elseif cardObj.hasTag("trait_attack") then
        return "Attack", string.format("Mark a trait (First Unmarked Trait in Top to Bottom, Left to Right order). [%s]You take an Incident[-] from Bot Discard pile, if able. Otherwise, [%s]you find any card, and log the found card.[-] If this card is [i]Revenge Is A Dish Best Served Cold[/i], [%s]you log this card[-]; otherwise the bot logs this card.", attackColor, attackColor, attackColor)
      end
    end

  elseif captainName == "Kirk" then
    if cardObj.hasTag("trait_timetravel") then
      return "Time Travel", "Gain 2 Research or 2 Influence or 2 Military (whichever is lower). Manually resolve the top card of the Bot deck. Log this card."
    elseif cardObj.hasTag("trait_klingon") then
      return "Klingon", "Gain 1 Military. If this card is a Ship, deploy it; it engages. If this card is a Person, promote it to Duty Officer. If able, resolve a Directive from Bot Discard pile. Otherwise, send an Away Team to a neutral Location."
    elseif cardObj.hasTag("trait_attack") then
      return "Attack", string.format("If able, log a deployed Ship to send 2 Away Teams to a neutral Location and [%s]you discard a card.[-] Otherwise, discard the top 2 cards of the Bot deck and [%s]you dismiss a Duty Officer and take an Incident.[-] If this card is a Person, promote it to Duty Officer.", attackColor, attackColor)
    elseif cardObj.hasTag("trait_engineer") then
      return "Engineer", "Discard the top 2 cards of the Bot deck. If able, resolve a Ship in Bot Discard pile. Otherwise, discard the top card of the Supplement deck. If this card is a Person, promote it to Duty Officer."
    elseif cardObj.hasTag("trait_scientist") then
      return "Scientist", "Log the top card of the Bot deck. Gain 1 Research or 1 Influence or 1 Military (whichever is lower). Gain 1 Research or 1 Influence or 1 Military (whichever is lower) again. If this card is a Person, and the Bot has no Duty Officer, promote it to Duty Officer. Otherwise, send an Away Team to a neutral Location."
    elseif cardObj.hasTag("trait_vulcan") then
      return "Vulcan", "Log the top card of the Bot deck. Gain 1 Research or 1 Influence or 1 Military (whichever is lower). Gain 1 Research or 1 Influence or 1 Military (whichever is lower) again. If this card is a Person, and the Bot has no Duty Officer, promote it to Duty Officer. Otherwise, send an Away Team to a neutral Location."
    end

  elseif captainName == "Rebner" then
    if cardObj.hasTag("trait_helmet") then
      return "Helmet", "If this card is [i]Big Enough Helmet[/i], take top Encounter and log this card. Otherwise, gain the most valuable card in the Market and discard the top 2 cards of the Bot deck."
    elseif cardObj.hasTag("trait_weapon") then
      return "Weapon", string.format("If Bot has 6+ Military, log this card and [%s]you take an Incident.[-] Otherwise, gain 1 Military and send an Away team to a neutral Location.", attackColor)
    elseif cardObj.hasTag("trait_attack") then
      return "Attack", string.format("If able to do both, log a Weapon from Bot Discard pile, and [%s]you log a Ship either from your hand, Discard pile, or in play.[-] Otherwise, [%s]you discard a card.[-] If this card is a Ship, deploy it; it engages. If this card is a Person, promote it to Duty Officer.", attackColor, attackColor)
    elseif cardObj.hasTag("trait_engineer") then
      return "Engineer", "Junk the most valuable card in the Market (ignoring any with tokens). Discard the top card of the Supplement deck. Gain 1 Military. If this card is a Person, promote it to Duty Officer."
    elseif cardObj.hasTag("trait_scientist") then
      return "Scientist", "Gain 1 Military. If this card is a Ship, deploy this Ship; it explores. Otherwise, log the top card of the Bot deck, gain 1 Glory, and if able, gain a Military > Cargo, including from the Junk."
    elseif cardObj.hasTag("trait_communication") then
