-- handles Market & Player setup functionality


-- MARKET SETUP OPTION AND SETUP BUTTONS
function initButtonSetupGame(buttonObj)
  buttonObj.clearButtons()
  buttonObj.createButton({
    click_function = "setupMarketAndLocations",
    function_owner = self,
    label          = "",
    position       = { 0, 1.01, 0.00 },
    width          = 835,
    height         = 440,
    scale          = { 2.3, 2.3, 2.3 },
    color          = { 1, 1, 1, .3 },
    hover_color    = { 1, 1, 1, .6 },
    tooltip        = "First select desired Market & Promo options, then, click this button to prepare selected market decks / locations and display player area Captain Selection UI.\n\n(Tip: If playing a 5YM and need to take Reinforcements, do so manually before using Setup Game button!)",
  })
end


function initButtonEnablePromo(buttonObj)
  buttonObj.setGMNotes("disabled")
  buttonObj.clearButtons()
  buttonObj.createButton({
    click_function = "initButtonDisablePromo",
    function_owner = self,
    label          = "",
    position       = { 3.40, 1.01, 0.0 },
    width          = 350,
    height         = 350,
    font_size      = 300,
    font_color     = { 49/255, 76/255, 95/255, 1 },
    scale          = { 2.3, 2.3, 2.3 },
    color          = { 1, 1, 1, 1 },
    hover_color    = { 1, 1, 1, .6 },
    tooltip        = "Click and check this button to include promotional cards during game setup.",
  })
end

