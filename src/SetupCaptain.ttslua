-- handles captain and captain asset setup functionality



function initButtonEnableBasic(buttonObj)
  buttonObj.clearButtons()
  buttonObj.createButton({
    click_function = "enableButtonBasic",
    function_owner = self,
    label          = "",
    position       = { 3.40, 0.36, 0.0 },
    width          = 350,
    height         = 350,
    font_size      = 300,
    font_color     = { 49/255, 76/255, 95/255, 1 },
    scale          = { 2.3, 2.3, 2.3 },
    color          = { 1, 1, 1, 1 },
    hover_color    = { 1, 1, 1, .6 },
    tooltip        = "Click and check this button to use the Basic side of the Captain Board.",
  })
end


function initButtonDisableBasic(buttonObj)
  buttonObj.clearButtons()
  buttonObj.createButton({
    click_function = "nullFunc",
    function_owner = self,
    label          = "✔",
    position       = { 3.40, 0.36, 0.0 },
    width          = 350,
    height         = 350,
    font_size      = 300,
    font_color     = { 49/255, 76/255, 95/255, 1 },
    scale          = { 2.3, 2.3, 2.3 },
    color          = { 1, 1, 1, 1 },
    hover_color    = { 1, 1, 1, .6 },
    tooltip        = "Basic Side of Captain Board will be used to setup Captain. Click Advanced checkbox to use Advanced instead.",
  })
end


function initButtonEnableAdvanced(buttonObj)
  buttonObj.clearButtons()
  buttonObj.createButton({
    click_function = "enableButtonAdvanced",
    function_owner = self,
    label          = "",
    position       = { 3.40, 0.36, 0.0 },
    width          = 350,
    height         = 350,
    font_size      = 300,
    font_color     = { 49/255, 76/255, 95/255, 1 },
    scale          = { 2.3, 2.3, 2.3 },
    color          = { 1, 1, 1, 1 },
    hover_color    = { 1, 1, 1, .6 },
    tooltip        = "Click and check this button to use the Advanced side of the Captain Board.",
  })
end


function initButtonDisableAdvanced(buttonObj)
  buttonObj.clearButtons()
  buttonObj.createButton({
    click_function = "nullFunc",
    function_owner = self,
    label          = "✔",
    position       = { 3.40, 0.36, 0.0 },
    width          = 350,
    height         = 350,
    font_size      = 300,
    font_color     = { 49/255, 76/255, 95/255, 1 },
    scale          = { 2.3, 2.3, 2.3 },
    color          = { 1, 1, 1, 1 },
    hover_color    = { 1, 1, 1, .6 },
    tooltip        = "Advanced Side of Captain Board will be used to setup Captain. Click Basic checkbox to use Basic instead.",
  })
end


function initButtonCaptainSelect(buttonObj)
  buttonObj.clearButtons()
  local buttonName = buttonObj.getName()
  local splitName = {}
  for str in string.gmatch(buttonName,  "%S+") do
    table.insert(splitName, str)
  end
  local captainName = nil
  if #splitName > 0 then
    captainName = splitName[3]
  end
  local tooltip = nil
  if captainName ~= nil and captainName ~= "Khan"then
    tooltip = "Select a Captain Board Side (Basic or Advanced), then, click to setup player area for Captain " .. captainName .. "."
  elseif captainName ~= nil and captainName == "Khan" then
    tooltip = "Click to setup player area for Captain " .. captainName .. ".\n\n(Will ignore checked Basic/Advanced selection)."
  end
  if buttonObj.getName() == "Setup Random Basic" then
    tooltip = "Click to setup player area for a Random Captain, using Basic Captain Board side.\n\n(Will ignore checked Basic/Advanced selection)"
  elseif buttonObj.getName() == "Setup Random Advanced" then
    tooltip = "Click to setup player area for a Random Captain, using Advanced Captain Board side.\n\n(Will ignore checked Basic/Advanced selection)"
  end
  if buttonObj.getName() == "Setup Random Basic OR Advanced" then
    tooltip = "Click to setup player area for a Random Captain, randomly using either side of Captain Board if Khan not randomly selected.\n\n(Will ignore checked Basic/Advanced selection)"
  end
  if buttonObj.getName():find("Setup For Solo") then
    initButtonSoloVS(buttonObj)
  else
    buttonObj.createButton({
      click_function = "setupCaptain",
      function_owner = self,
      label          = "",
      position       = { 0, 0.36, 0.02 },
      rotation       = { 0, 180, 0 },
      width          = 600,
      height         = 450,
      scale          = { 2.3, 2.3, 2.3 },
      color          = { 1, 1, 1, .0 },
      hover_color    = { 1, 1, 1, .4 },
      tooltip        = tooltip,
    })
  end
end


function initButtonPullActionToken(buttonObj)
  buttonObj.clearButtons()
  buttonObj.createButton({
    click_function = "pullActionToken",
    function_owner = self,
    label          = "",
    position       = { 0, 0.36, -0.01 },
    width          = 480,
    height         = 480,
    scale          = { 2.1, 2.1, 2.1 },
    color          = { 1, 1, 1, .3 },
    hover_color    = { 1, 1, 1, .6 },
    tooltip        = "Click to summon an extra action token. The summoned action token will be destroyed on Add Resource (End Turn) button click.",
  })
end



function nullFunc()
  -- handle a click that should not change anything
  return
end


function enableButtonBasic(buttonObj)
  local playerColor = buttonObj.getName():find("Blue") and "Blue" or "Red"
  buttonObj.setGMNotes("enabled")
  initButtonDisableBasic(buttonObj)

  local otherButton = getObjectbyName("Button Use Advanced " .. playerColor)
  otherButton.setGMNotes("disabled")
  initButtonEnableAdvanced(otherButton)
end


function enableButtonAdvanced(buttonObj)
  local playerColor = buttonObj.getName():find("Blue") and "Blue" or "Red"
  -- need to first check if solo is currently enabled for playerColor
  if getObjectbyName("Setup For Solo " .. playerColor).getGMNotes() == "enabled" then
    broadcastToAll("Solo mode will always use Basic side of Bot Captain Board.", "Orange")
    return
  end

  buttonObj.setGMNotes("enabled")
  initButtonDisableAdvanced(buttonObj)

  local otherButton = getObjectbyName("Button Use Basic " .. playerColor)
  otherButton.setGMNotes("disabled")
  initButtonEnableBasic(otherButton)
end


-- wrapper to handle entirety of captain area setup, call by call
function setupCaptain(button, _, _)
  -- get buttonName, captainName, playerColor, otherPlayerColor, isBot
  local buttonName = button.getName()
  local playerColor = button.getGMNotes()
  local otherPlayerColor = playerColor == "Blue" and "Red" or "Blue"
  local isBot = false
  if getObjectbyName("Setup For Solo " .. playerColor) ~= nil then
    if getObjectbyName("Setup For Solo " .. playerColor).getGMNotes() == "enabled" then isBot = true end
  end
  local captainName = nil

  -- check isBot. if so, ensure bot difficulty button for playerColor is selected
  local botDiffSelected = false -- boolean of if a bot difficulty has been selected
  local selectedBotDifficulty = "None" -- string of the selected difficulty
  if isBot then
    botDiffSelected, selectedBotDifficulty = checkBotDiff(playerColor)
    if not botDiffSelected then
      broadcastToAll("Please make sure to select solo bot difficulty before selecting Captain!", "Orange")
      return
    end
  end

  -- handle random captain select buttons
  local selectedCaptainDifficulty = getSelectedCaptainDifficulty(playerColor)
  if button.getName():find("Setup Random") then
    -- if button == random basic, randomly select a non khan basic captain
    if buttonName == "Setup Random Basic" then
      captainName = setupRandomBasic(playerColor)
      selectedCaptainDifficulty = "Basic"
    end

    -- if button == random advanced, randomly select an advanced captain
    if buttonName == "Setup Random Advanced" then
      captainName = setupRandomAdvanced(playerColor)
      selectedCaptainDifficulty = "Advanced"
    end

    -- if button == random either, randomly select captain
    if buttonName == "Setup Random Basic OR Advanced" then
      captainName, selectedCaptainDifficulty = setupRandomEither(playerColor)
      if isBot then
        selectedCaptainDifficulty = "Basic"
      end
    end

  -- handle explicit captain select buttons
  elseif button.getName():find("Button Select") then
    captainName = setupExplicitCaptain(buttonName)
  end

  -- force "Basic" if isBot
  if isBot then
    selectedCaptainDifficulty = "Basic"
  end

  -- broadcast captain selection
  local playerStr = getPlayerStr(playerColor)
  local broadcastStr = string.format("%s has selected %s Side Captain %s.", playerStr, selectedCaptainDifficulty, captainName)
  broadcastToAll(broadcastStr, "White")

  -- destruct other player's button to select corresponding captain
  if getObjectbyNameAndNotes("Button Select " .. captainName, otherPlayerColor) ~= nil then
    getObjectbyNameAndNotes("Button Select " .. captainName, otherPlayerColor).destruct()
  end

  -- destruct all captain select, solo VS, and solo difficulty buttons for playerColor
  destructCaptainSelectUIButtons(playerColor)

  -- if isBot, destruct all solo VS and solo difficulty buttons for otherPlayerColor
  if isBot then destructSoloDiffButtons(otherPlayerColor) end

  -- if bot, setup bot stuff (stardate etc)
  if isBot then
    setupInitialSoloStardate(selectedBotDifficulty)
  end

  -- -- pull selected captain board, card
  placeSelectedCaptainBoard(captainName, selectedCaptainDifficulty, playerColor, isBot)


  -- if not khan, pull tracker cubes (check isBot to use bot or non bot positioning)
  -- if khan, pull & place trait trackers & remove tracker cubes
  pullFocusAssets(captainName, playerColor, selectedCaptainDifficulty, isBot)

  -- if they exist, place captain's draw, reserves, and development decks
  -- if isBot, create & name supplement deck instead of reserves/development
  placeCaptainDecks(captainName, playerColor, isBot)

  -- place captain card
  placeCaptainCard(captainName, playerColor, isBot)

  -- place nonstandard cards/decks 
  ---- checkisBot to perform deploy card actions before placing to top of deck ie: sisko
  -- deployeds
  ---- if ship, place deployed figurine, color/add tag to highlight
  ---- if isBot, figurine to space dock instead of card
  -- controlled locations & ships
  setupCaptainDeployed(captainName, playerColor, isBot)
  -- statuses
  setupCaptainStatus(captainName, playerColor, isBot)
  -- incidents
  setupCaptainIncident(captainName)
  -- discards
  setupCaptainDiscard(captainName, playerColor, isBot)

  -- remove away teams per captain count, place special ATs if needed (pike, archer)
  setupAwayTeams(captainName, playerColor, isBot)

  -- if isBot, place & scale bot traits, suits cards
  -- and also flip player area UI elements for bot
  if isBot then
    setupBotInstructionCards(captainName, playerColor)
    flipBotUI(playerColor)
  end

  -- if not isBot, set dil/lat/glory counters to 1 each, init captain board goal buttons (will also need check onSpawn and probably a whole require page lol)
  if not isBot then
    setInitialPlayerCounters(playerColor)
    -- init captain board goal buttons 
  end

  -- display on screen XML UI per selected captain
  displayPlayerControlXML(captainName, playerColor)

  -- **** check if last playerarea to be set up, if so, perform final game setup
  local isLastCaptain = checkIfLastCaptainToSetup(playerColor)
  Wait.time(function()

    if isLastCaptain then finalizeCaptainSetup() end

  end, 1.0)
end


function checkBotDiff(playerColor)
  -- this function handles the check if there is a selected bot difficulty in the case of a solo setup
  -- returns boolean of if a difficulty is selected, and a string of which difficulty has been selected
  local botDiffSelected = false
  local selectedBotDifficulty = "None"
  for _, object in pairs(getObjects()) do
    if object.getName():find("Button Solo") and object.getName():find(playerColor) and
    object.getGMNotes() == "enabled" then
      botDiffSelected = true
      local splitName = {}
      for str in string.gmatch(object.getName(),  "%S+") do
        table.insert(splitName, str)
      end
      selectedBotDifficulty = splitName[3]
    end
  end
  return botDiffSelected, selectedBotDifficulty
end


function getSelectedCaptainDifficulty(playerColor)
  -- checks player area to determine if basic or advanced is checked
  local selectedCaptainDifficulty = "Advanced"
  if getObjectbyName("Button Use Basic " .. playerColor).getGMNotes() == "enabled" then
    selectedCaptainDifficulty = "Basic"
  end
  return selectedCaptainDifficulty
end


-- these functions handle the click of a random captain button, returns captainName
function setupRandomBasic(playerColor)
  local checkZone = getObjectbyNameAndNotes("Zone Captain Card", playerColor)
  local captainPool = {}
  for _, zoneObj in pairs(checkZone.getObjects()) do
    if zoneObj.getName():find("Button Select") and zoneObj.getName() ~= "Button Select Khan" then
      table.insert(captainPool, zoneObj)
    end
  end
  captainButton = captainPool[math.random(1, #captainPool)]
  local buttonName = captainButton.getName()
  local splitName = {}
  for str in string.gmatch(buttonName,  "%S+") do
    table.insert(splitName, str)
  end
  local captainName = nil
  if #splitName > 0 then
    captainName = splitName[3]
  end
  return captainName
end

function setupRandomAdvanced(playerColor)
  local checkZone = getObjectbyNameAndNotes("Zone Captain Card", playerColor)
  local captainPool = {}
  for _, zoneObj in pairs(checkZone.getObjects()) do
    if zoneObj.getName():find("Button Select") then
      table.insert(captainPool, zoneObj)
    end
  end
  captainButton = captainPool[math.random(1, #captainPool)]
  local buttonName = captainButton.getName()
  local splitName = {}
  for str in string.gmatch(buttonName,  "%S+") do
    table.insert(splitName, str)
  end
  local captainName = nil
  if #splitName > 0 then
    captainName = splitName[3]
  end
  return captainName
end

function setupRandomEither(playerColor)
  local boardSides = {"Basic", "Advanced"}
  local selectedCaptainDifficulty = boardSides[math.random(1, #boardSides)]
  local checkZone = getObjectbyNameAndNotes("Zone Captain Card", playerColor)
  local captainPool = {}
  for _, zoneObj in pairs(checkZone.getObjects()) do
    if zoneObj.getName():find("Button Select") and
    not (selectedCaptainDifficulty == "Basic" and zoneObj.getName() == "Button Select Khan") then
      table.insert(captainPool, zoneObj)
    end
  end
  captainButton = captainPool[math.random(1, #captainPool)]
  local buttonName = captainButton.getName()
  local splitName = {}
  for str in string.gmatch(buttonName,  "%S+") do
    table.insert(splitName, str)
  end
  local captainName = nil
  if #splitName > 0 then
    captainName = splitName[3]
  end
  return captainName, selectedCaptainDifficulty
end


function setupExplicitCaptain(buttonName)
  -- handles the click and return of captainName of an non random captain select button
  local splitName = {}
  for str in string.gmatch(buttonName,  "%S+") do
    table.insert(splitName, str)
  end
  local captainName = nil
  if #splitName > 0 then
    captainName = splitName[3]
  end
  return captainName
end


function destructSoloDiffButtons(playerColor)
  -- broken into it's own function to be able to destruct these buttons for either side (ie: one side confirming as bot, destruct other side to prevent 2 bots)
  for _, object in pairs(getObjects()) do
    if object.getName() == "Setup For Solo " .. playerColor then object.destruct() end
    if object.getName():find("Button Solo") and object.getName():find(playerColor) then object.destruct() end
  end
end


function destructCaptainSelectUIButtons(playerColor)
  -- this handles the destruct of the captain select buttons, solo difficulty buttons, and solo VS button to make room for incoming captain assets
  for _, object in pairs(getObjects()) do
    if object.hasTag("button_faction_setup") and object.getGMNotes() == playerColor then object.destruct() end
    destructSoloDiffButtons(playerColor)
    if (object.getName():find("Button Use Advanced") or object.getName():find("Button Use Basic")) and object.getName():find(playerColor) then object.destruct() end
  end
end


function setupInitialSoloStardate(selectedBotDifficulty)
  -- handles initial setup of stardate area & glory stuff

  -- show stardate counter
    showStardateGloryCounter(selectedBotDifficulty)

    -- place selected difficulty stardate deck to pad
    local deckStardate = selectedBotDifficulty ~= "Cadet" and getObjectbyName("Solo vs. " .. selectedBotDifficulty .. " Bot Stardate Deck") or
                                                              getObjectbyName("Solo Cadet Practice Deck")
    local rotDeckStardate = { 0.00, 180.00, 0.00 }
    local posDeckStardate = { -12.50, 1.25, 0.00 }
    deckStardate.setRotation(rotDeckStardate)
    deckStardate.setPosition(posDeckStardate)

    -- refresh glory to pull starting glory & initialize counter
    Wait.time(function() -- wait to allow deck to settle to pad

      refreshGlory()

    end, 0.5)
    -- mark stardate card pad with bot difficulty, accessed and used after last stardate card goes away
    getObjectbyName("Pad Stardate").setGMNotes(selectedBotDifficulty)
end


function placeSelectedCaptainBoard(captainName, selectedCaptainDifficulty, playerColor, isBot)

  -- handles pull and placement of main captain board on setup

  -- check isBot, place to rotation
  local captainBoard  = getObjectbyName(captainName == "Khan" and "Khan Crew Board" or
                        string.format("%s Crew Board %s", captainName, selectedCaptainDifficulty))

  local rotCaptainBoard = playerColor == "Blue" and { 0.00, 270.00, 0.00 }  or { 0.00, 90.00, 0.00 }
  if isBot then rotCaptainBoard = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 } end
  local posCaptainBoard = playerColor == "Blue" and { -42.15, 0.95, 16.00 } or { 42.15, 0.95, -16.00 }
  captainBoard.setRotation(rotCaptainBoard)
  captainBoard.setPosition(posCaptainBoard)

  -- lock board, tint to playerColor
  captainBoard.setLock(true)
  captainBoard.setColorTint(playerColor)
end


