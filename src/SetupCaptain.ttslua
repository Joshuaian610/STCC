function placeCaptainDecks(captainName, playerColor, isBot)
  -- handles placement of selected captain's draw deck, reserves, and development if they exist

  -- draw deck will always exist
  local rotDrawDeck = playerColor == "Blue" and { 0.00, 270.00, 180.00 } or { 0.00, 90.00, 180.00 }
  if isBot then rotDrawDeck = playerColor == "Blue" and { 0.00, 90.00, 180.00 } or { 0.00, 270.00, 180.00 } end
  local posDrawDeck = playerColor == "Blue" and { -44.50, 1.25, 7.00 } or { 44.50, 1.25, -7.00 }
  local drawDeck = getObjectbyName(captainName .. " Draw Deck")
  if drawDeck ~= nil then
    drawDeck.setLock(false)
    drawDeck.setRotation(rotDrawDeck)
    drawDeck.setPosition(posDrawDeck)
    Wait.time(function()

      drawDeck.shuffle()

    end, 0.50)
  end

  -- create "supplement" deck out of reserves/development decks if bot
  -- otherwise, simply get and place decks to position
  if not isBot then
    local rotReserveDeck = playerColor == "Blue" and { 0.00, 0.00, 180.00 } or { 0.00, 180.00, 180.00 }
    local rotDevelopmentDeck = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 }
    local posDecks = playerColor == "Blue" and { -24.00, 1.25, 20.00 } or { 24.00, 1.25, -20.00 }
    local developmentDeck = getObjectbyName(captainName .. " Development")
    if developmentDeck ~= nil then
      developmentDeck.setLock(false)
      developmentDeck.setRotation(rotDevelopmentDeck)
      developmentDeck.setPosition(posDecks)
      posDecks.y = 1.50
    end
    local reserveDeck = getObjectbyName(captainName .. " Reserves")
    if reserveDeck ~= nil then
      reserveDeck.setLock(false)
      reserveDeck.setRotation(rotReserveDeck)
      reserveDeck.setPosition(posDecks)
      Wait.time(function()

        reserveDeck.shuffle()

      end, 0.50)
    end

  elseif isBot then
    local rotDecks = playerColor == "Blue" and { 0.00, 90.00, 180.00 } or { 0.00, 270.00, 180.00 }
    local posDecks = playerColor == "Blue" and { -24.00, 1.25, 20.00 } or { 24.00, 1.25, -20.00 }
    local developmentDeck = getObjectbyName(captainName .. " Development")
    if developmentDeck ~= nil then
      developmentDeck.setLock(false)
      developmentDeck.shuffle()
      developmentDeck.setRotation(rotDecks)
      developmentDeck.setPosition(posDecks)
      posDecks.y = 1.50
    end
    Wait.time(function()

      local reserveDeck = getObjectbyName(captainName .. " Reserves")
      if reserveDeck ~= nil then
        reserveDeck.setLock(false)
        reserveDeck.shuffle()
        reserveDeck.setRotation(rotDecks)
        reserveDeck.setPosition(posDecks)
      end

    end, 0.5)
    Wait.time(function()

      developmentDeck.setName(captainName .. " Supplement Deck")

      -- if khan bot, place Genesis Device to bottom of Supplement Deck
      if captainName == "Khan" then
        developmentDeck.shuffle()
        for _, deckObj in pairs(developmentDeck.getObjects()) do
          if deckObj.name == "Genesis Device" then
            local card = developmentDeck.takeObject({ guid = deckObj.guid })
            local posDeck = developmentDeck.getPosition()
            posDeck.y = - 2

            Wait.frames(function()
              card.setPosition(posDeck)
              developmentDeck.putObject(card)
            end)

          end
        end
      end

    end, 1)
  end
end


function placeCaptainCard(captainName, playerColor, isBot)
  -- handles placement of captain card
  local rotCaptainCard = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 }
  if isBot then
    rotCaptainCard = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 }
  end
  local posCaptainCard = playerColor == "Blue" and { -38.50, 1.25, 7.00 } or { 38.50, 1.25, -7.00 }
  local captainNames = {
    ["Burnham"]  = "Michael Burnham",
    ["Koloth"]   = "Koloth, The Dahar Master",
    ["Picard"]   = "Jean-Luc Picard",
    ["Sela"]     = "Sela",
    ["Shran"]    = "Thy'lek Shran",
    ["Sisko"]    = "Benjamin Sisko",
    ["Archer"]   = "Jonathan Archer",
    ["Georgiou"] = "Phillipa Georgiou",
    ["Khan"]     = "Khan Noonien Singh",
    ["Kirk"]     = "James T. Kirk",
    ["Rebner"]   = "Rebner",
    ["Soval"]    = "Soval",
    ["Freeman"]  = "Carol Freeman",
    ["Pike"]     = "Christopher Pike",
    ["Riker"]    = "William T. Riker",
  }
  local captainCard = getObjectbyName(captainNames[captainName])
  if captainCard ~= nil then
    captainCard.setLock(false)
    captainCard.setRotation(rotCaptainCard)
    captainCard.setPosition(posCaptainCard)
  end
end


function setupCaptainDeployed(captainName, playerColor, isBot)
  -- will handle set up and deployment of initial ships & controlled locations

  -- ships will need placement of initial ship figure, highlight, color tint
  local rotDeployedCard = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 }
  if isBot then rotDeployedCard = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 } end
  local rotDeployedFigure = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 }
  if isBot then rotDeployedFigure = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 } end
  local posShipCard = playerColor == "Blue" and { -38.50, 1.25, 2.51 } or { 38.50, 1.25, -2.51 }
  local posShipFigure = playerColor == "Blue" and { -37.00, 1.50, 2.51 } or { 37.00, 1.50, -2.51 }
  local deployedShipNames = {
    ["Burnham"]  = "U.S.S. Discovery-A",
    ["Koloth"]   = "I.K.S. Gr'oth",
    ["Picard"]   = "U.S.S. Enterprise-D",
    ["Sela"]     = "I.R.W. Goraxus",
    ["Shran"]    = "Kumari",
    ["Archer"]   = "NX-01 Enterprise",
    ["Georgiou"] = "U.S.S. Shenzhou",
    ["Soval"]    = "Ti'Mur",
    ["Freeman"]  = "U.S.S. Cerritos",
    ["Riker"]    = "U.S.S. Titan",
    ["Sisko"]    = "Deep Space 9",
    ["Kirk"]     = "U.S.S. Enterprise (Refit)",
  }
  local deployedLocationNames = {
    ["Khan"]  = { "Ceti Alpha V", "Ceti Alpha VI" },
    ["Pike"]  = "Starbase One",
    ["Sisko"] = "Bajor",
    ["Kirk"]  = "Starfleet Headquarters"
  }
  local posDeployedLocations = playerColor == "Blue" and
                               { { -30.00, 1.25, 2.51 }, { -30.00, 1.25, -1.41 } } or
                               { { 30.00, 1.25, -2.51 }, { 30.00, 1.25, 1.41 } }

  -- handle non solo deployments
  if not isBot then
    -- ship only captains (most)
    if captainName == "Burnham" or captainName == "Koloth" or captainName == "Picard" or captainName == "Sela" or
       captainName == "Shran" or captainName == "Archer" or captainName == "Georgiou" or captainName == "Soval" or
       captainName == "Freeman" or captainName == "Riker" then
      local deployedShipCard = getObjectbyNameAndType(deployedShipNames[captainName], "Card")
      local deployedShipFigure = getObjectbyNameAndType(deployedShipNames[captainName], "Tileset")

      if deployedShipCard ~= nil then
        deployedShipCard.setLock(false)
        deployedShipCard.setRotation(rotDeployedCard)
        deployedShipCard.setPosition(posShipCard)
      end

      if deployedShipFigure ~= nil then
        deployedShipFigure.setLock(false)
        deployedShipFigure.setRotation(rotDeployedFigure)
        deployedShipFigure.setPosition(posShipFigure, false, true)

        -- highlight, tint (cloaked ships should be highlighted purple)
        if deployedShipCard.hasTag("trait_cloak") then
          deployedShipFigure.highlightOn("Purple")
        else
          deployedShipFigure.highlightOn(playerColor)
        end
        deployedShipFigure.setColorTint(playerColor)
      end

    -- controlled location only captains (khan, pike)
    elseif captainName == "Khan" or captainName == "Pike" then
      if captainName == "Pike" then
        local locationCard = getObjectbyName(deployedLocationNames["Pike"])
        if locationCard then
          locationCard.setLock(false)
          locationCard.setRotation(rotDeployedCard)
          locationCard.setPosition(posDeployedLocations[1])
        end

      elseif captainName == "Khan" then
        for i, locationName in ipairs(deployedLocationNames["Khan"]) do
          local locationCard = getObjectbyName(locationName)
          if locationCard then
            locationCard.setLock(false)
            locationCard.setRotation(rotDeployedCard)
            locationCard.setPosition(posDeployedLocations[i])
          end
        end
      end

    -- both type captains (sisko, kirk)
    elseif captainName == "Sisko" or captainName == "Kirk" then
      local deployedShipCard = getObjectbyNameAndType(deployedShipNames[captainName], "Card")
      local deployedShipFigure = getObjectbyNameAndType(deployedShipNames[captainName], "Tileset")
      local locationCard = getObjectbyName(deployedLocationNames[captainName])

      if deployedShipCard ~= nil then
        deployedShipCard.setLock(false)
        deployedShipCard.setRotation(rotDeployedCard)
        deployedShipCard.setPosition(posShipCard)
      end

      if deployedShipFigure ~= nil then
        deployedShipFigure.setLock(false)
        deployedShipFigure.setRotation(rotDeployedFigure)
        deployedShipFigure.setPosition(posShipFigure, false, true)

        -- highlight, tint (ship won't be cloaked)
        deployedShipFigure.highlightOn(playerColor)
        deployedShipFigure.setColorTint(playerColor)
      end

      if locationCard then
        locationCard.setLock(false)
        locationCard.setRotation(rotDeployedCard)
        locationCard.setPosition(posDeployedLocations[1])
      end
    end

  -- if isBot, need to handle deployment to top draw deck accordingly (ie: sisko or kirk deploying both)
  elseif isBot then
    -- if khan, do khan specific stuff
    if captainName == "Khan" then
      -- return ceti alphas to bag
      local bagUnusedObjs = getObjectbyName("Unused Object Bag")
      for _, object in pairs(getObjects()) do
        if object.getName():find("Ceti Alpha V") then
          bagUnusedObjs.putObject(object)
        end
      end

    -- otherwise if not khan, do the non khan stuff
    elseif captainName ~= "Khan" then
      local rotFacedown = playerColor == "Blue" and { 0.00, 90.00, 180.00 } or { 0.00, 270.00, 180.00 }
      local posDeck = playerColor == "Blue" and { -44.50, 1.50, 7.00 } or { 44.50, 1.50, -7.00 }
      local spaceDock = getObjectbyNameAndNotes("Space Dock", playerColor)
      local deployedShipCard = getObjectbyNameAndType(deployedShipNames[captainName], "Card")
      local deployedShipFigure = getObjectbyNameAndType(deployedShipNames[captainName], "Tileset")
      local locationCard = getObjectbyName(deployedLocationNames[captainName])

      -- handle cases where its a single card location or ship
      if captainName ~= "Sisko" and captainName ~= "Kirk" then

        Wait.time(function()
          if deployedShipCard ~= nil then
            deployedShipCard.setLock(false)
            deployedShipCard.setRotation(rotFacedown)
            deployedShipCard.setPosition(posDeck)
          end

          -- deployed ship needs to go to space dock
          if deployedShipFigure ~= nil then
            deployedShipFigure.setLock(false)
            spaceDock.putObject(deployedShipFigure)
          end

          if locationCard then
            locationCard.setLock(false)
            locationCard.setRotation(rotFacedown)
            locationCard.setPosition(posDeck)
          end

        end, 0.5)

      -- in cases of both, need to combine & shuffle before placing to top of deck
      elseif captainName == "Sisko" or captainName == "Kirk" then
        -- place next to draw deck, allow settle, shuffle, place
        local posStage = playerColor == "Blue" and { -44.50, 1.25, 2.80 } or { 44.50, 1.25, -2.80 }
        local deckCheckZone = getObjectbyNameAndNotes("Zone In Play", playerColor)

        if deployedShipCard ~= nil then
          deployedShipCard.setLock(false)
          deployedShipCard.setRotation(rotFacedown)
          deployedShipCard.setPosition(posStage)
        end

        -- deployed ship needs to go to space dock
         if deployedShipFigure ~= nil then
          deployedShipFigure.setLock(false)
          spaceDock.putObject(deployedShipFigure)
        end

        if locationCard then
          locationCard.setLock(false)
          locationCard.setRotation(rotFacedown)
          locationCard.setPosition(posStage)
        end

        Wait.time(function()

          local shuffleDeck = nil
          for _, zoneObj in pairs(deckCheckZone.getObjects()) do
            if zoneObj.type == "Deck" and #zoneObj.getObjects() == 2 then
              shuffleDeck = zoneObj
              break
            end
          end
          if shuffleDeck ~= nil then
            shuffleDeck.shuffle()
            shuffleDeck.setRotation(rotFacedown)
            shuffleDeck.setPosition(posDeck)
          end

        end, 0.5)

      end
    end
  end
end


function setupCaptainStatus(captainName, playerColor, isBot)
  -- will handle setup of initial captain status cards, if they exist

  if captainName == "Burnham" or captainName == "Archer" or
  captainName == "Soval" or captainName == "Pike" then
    local statusNames = {
      ["Burnham"] = "Inert Dilithium",
      ["Archer"]  = "Earth",
      ["Soval"]   = "Vulcan Science Directorate",
      ["Pike"]    = "Improbable, Unstoppable, Sensational",
    }
    local rotStatus = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 }
    if isBot then
      rotStatus = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 }
    end
    local posStatus = playerColor == "Blue" and { -30.00, 1.25, 10.11 } or { 30.00, 1.25, -10.11 }
    local statusCard = getObjectbyName(statusNames[captainName])

    if statusCard ~= nil then
      statusCard.setLock(false)
      statusCard.setRotation(rotStatus)
      statusCard.setPosition(posStatus)
    end
  end
end


function setupCaptainIncident(captainName)
  -- will handle setup of initial captain incident cards, if they exist

  if captainName == "Burnham" or captainName == "Khan" or captainName == "Freeman" then
    local incidentNames = {
      ["Burnham"] = "Subspace Phenomenon",
      ["Khan"]    = "Two Dimensional Thinking",
      ["Freeman"] = "Red Alert",
    }
    local rotIncidentDeck = { 0.00, 180.00, 180.00 }
    local posIncidentDeck = { 12.50, 1.25, 10.00 }
    local incidentCard = getObjectbyName(incidentNames[captainName])

    -- place card to deck, brief wait, then shuffle
    if incidentCard ~= nil then
      incidentCard.setLock(false)
      incidentCard.setRotation(rotIncidentDeck)
      incidentCard.setPosition(posIncidentDeck)

      Wait.time(function()

        local incidentDeck = nil
        local checkZone = getObjectbyName("Zone Incident")
        for _, zoneObj in pairs(checkZone.getObjects()) do
          if zoneObj.type == "Deck" then
            zoneObj.shuffle()
          end
        end

      end, 0.5)
    end
  end
end


function setupCaptainDiscard(captainName, playerColor, isBot)
  -- will handle setup of initial captain incident card or deck, if they exist

  if captainName == "Sela" or captainName == "Archer" or
  captainName == "Pike" or captainName == "Riker" then
    local discardNames = {
      ["Sela"]   = "Sela Discard",
      ["Archer"] = "Analyze",
      ["Pike"]   = "Pike Discard",
      ["Riker"]  = "Riker Discard",
    }
    local rotDiscard = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 }
    if isBot then
      rotDiscard = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 }
    end
    local posDiscard = playerColor == "Blue" and { -44.49, 1.25, -21.00 } or { 44.49, 1.25, 21.00 }
    local discardObj = getObjectbyName(discardNames[captainName])

    if discardObj then
      discardObj.setLock(false)
      discardObj.setRotation(rotDiscard)
      discardObj.setPosition(posDiscard)
    end
  end
end


function setupAwayTeams(captainName, playerColor, isBot)
  -- handles setup of away teams per captain

  local bagUnusedObjs = getObjectbyName("Unused Object Bag")
  local awayTeamStack = getObjectbyName("Away Teams " .. playerColor)
  if awayTeamStack ~= nil then
    -- if archer or pike, pull & place special away teams
    if captainName == "Archer" then
      -- need to set 4 to an aside position (rotation handled at end)
      local posAside = playerColor == "Blue" and { -30.00, 2.10, 27.75 } or { 30.00, 2.10, -27.75 }
      for i = 1, 4 do
        local awayTeam = awayTeamStack.takeObject()
        awayTeam.setPosition(posAside)
      end

    elseif captainName == "Pike" and not isBot then
      -- need to place 1 to starbase one (rotation handled at end)
      local posLocation = playerColor == "Blue" and { -28.45, 1.75, 2.47 } or { 28.45, 1.75, -2.47 }
      local awayTeam = awayTeamStack.takeObject()
      awayTeam.setPosition(posLocation)
    end

    -- then, pull correct count of away teams to unused object bag per captain
    local removeATCount =  {
      ["Burnham"]  = 1,
      ["Koloth"]   = 0,
      ["Picard"]   = 1,
      ["Sela"]     = 2,
      ["Shran"]    = 1,
      ["Sisko"]    = 0,
      ["Archer"]   = 0,
      ["Georgiou"] = 1,
      ["Khan"]     = 2,
      ["Kirk"]     = 1,
      ["Rebner"]   = 0,
      ["Soval"]    = 2,
      ["Freeman"]  = 1,
      ["Pike"]     = isBot and 2 or 1,
      ["Riker"]    = 2,
    }
    local removeCount = removeATCount[captainName]

    if removeCount > 0 then
      for _ = 1, removeCount do
        local removeAT = awayTeamStack.takeObject()
        bagUnusedObjs.putObject(removeAT)
      end
    end

    -- ensure all away teams are rotated properly per solo or not
    local rotAT = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 }
    if isBot then
      rotAT = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 }
    end
    for _, object in pairs(getObjects()) do
      if object.getName():find("Away Team") and object.getName():find(playerColor) then
        object.setRotation(rotAT)
      end
    end
  end
end


function checkIfLastCaptainToSetup(playerColor)
  -- will handle the check to see if the current playerColor is the last captain to be set up
  -- if last captain, all otherPlayerColor "Button Select " .. captainName buttons should be destructed by now,
  -- and any/all of them will have been destructed at once, so a check for any 3 is a check for all
  local isLastCaptain = false
  local otherPlayerColor = playerColor == "Blue" and "Red" or "Blue"
  if getObjectbyNameAndNotes("Button Select Kirk", otherPlayerColor) == nil and
     getObjectbyNameAndNotes("Button Select Freeman", otherPlayerColor) == nil and
     getObjectbyNameAndNotes("Button Select Picard", otherPlayerColor) == nil then
    isLastCaptain = true
  end

  return isLastCaptain
end


function setupBotInstructionCards(captainName, playerColor)
  -- handles placement of bot instruction cards, traits & suits no duty side up
  local deckTraits5YM = getObjectbyName("Traits / 5 Year Mission Deck")
  local deckSuits = getObjectbyName("Suits Deck")
  local rotCard = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 }
  local posTraitsCard = playerColor == "Blue" and { 20.00, 1.25, 3.00 } or { -20.00, 1.25, -3.00 }
  local posSuitsCard = playerColor == "Blue" and { 20.00, 1.25, 9.00 } or { -20.00, 1.25, -9.00 }
  local cardScale = { 3.00, 1.00, 3.00 }

  if captainName ~= "Khan" then
    -- usual setup - traits & suits no duty
    for _, deckObj in pairs(deckTraits5YM.getObjects()) do
      if deckObj.name == "Traits / 5YM " .. captainName then
        local traitCard = deckTraits5YM.takeObject({ guid = deckObj.guid })
        traitCard.setRotation(rotCard)
        traitCard.setScale(cardScale)
        traitCard.setPosition(posTraitsCard)
      end
    end
    for _, deckObj in pairs(deckSuits.getObjects()) do
      if deckObj.name == "Suits " .. captainName then
        local suitCard = deckSuits.takeObject({ guid = deckObj.guid })
        suitCard.setRotation(rotCard)
        suitCard.setScale(cardScale)
        suitCard.setPosition(posSuitsCard)
      end
    end

  elseif captainName == "Khan" then
    -- special setup - regular traits to bottom, suits on top, to suits pos, khan in exile to traits
    for _, deckObj in pairs(deckTraits5YM.getObjects()) do
      if deckObj.name == "Traits / 5YM " .. captainName then
        local traitCard = deckTraits5YM.takeObject({ guid = deckObj.guid })
        traitCard.setRotation(rotCard)
        traitCard.setScale(cardScale)
        traitCard.setPosition(posSuitsCard)
      end
    end
    posSuitsCard.y = 1.50
    Wait.frames(function()

      for _, deckObj in pairs(deckSuits.getObjects()) do
        if deckObj.name == "Suits " .. captainName then
          local suitCard = deckSuits.takeObject({ guid = deckObj.guid })
          suitCard.setRotation(rotCard)
          suitCard.setScale(cardScale)
          suitCard.setPosition(posSuitsCard)
        end
      end
      for _, deckObj in pairs(deckTraits5YM.getObjects()) do
        if deckObj.name == "Khan In Exile Traits" then
          local traitCard = deckTraits5YM.takeObject({ guid = deckObj.guid })
          traitCard.setRotation(rotCard)
          traitCard.setScale(cardScale)
          traitCard.setPosition(posTraitsCard)
        end
      end

    end)
  end
end


function flipBotUI(playerColor)
  -- if isBot, handles flip of player area UI elements for playerColor

  -- card/deck pads (to properly face snap points)
  local pads = {
    getObjectbyNameAndNotes("Pad Draw Deck", playerColor),
    getObjectbyNameAndNotes("Pad Played", playerColor),
    getObjectbyNameAndNotes("Pad Discard", playerColor),
    getObjectbyNameAndNotes("Pad Captain", playerColor),
    getObjectbyNameAndNotes("Pad Deploy Ship", playerColor),
    getObjectbyNameAndNotes("Pad Deploy Location", playerColor),
    getObjectbyNameAndNotes("Pad Duty Officer", playerColor),
  }
  for i = 1, 7 do
    pads[i].setRotation(playerColor == "Blue" and { 0.00, 180.00, 180.00 } or { 0.00, 180.00, 0.00 })
    if playerColor == "Blue" then
      local pos = pads[i].getPosition()
      pos.y = 0.95
      pads[i].setPosition(pos)
    end
  end

  -- beam bags, captain's log, control NZ location buttons, space dock
  local rotBotBeamBags = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 }
  for _, object in pairs(getObjects()) do
    if object.getName() == "Beamed Cards" and object.getGMNotes() == playerColor then
      -- bots never beam to ship or location
      object.destruct()
    end
    if object.getName() == "Captain's Log" and object.getGMNotes() == playerColor then
      object.setRotation(rotBotBeamBags)
    end
    if object.getName():find("Button Control Location") and object.getGMNotes() == playerColor then
      object.setRotation(rotBotBeamBags)
    end
    if object.getName():find("Space Dock") and object.getGMNotes() == playerColor then
      object.setRotation(rotBotBeamBags)
    end
  end

  -- destruct report etc buttons, action tokens, +action button for bot
  local destructButtons = {
    getObjectbyNameAndNotes("Button Report Resupply", playerColor),
    getObjectbyNameAndNotes("Button Report Cleanup", playerColor),
    getObjectbyNameAndNotes("Button Discard Hand", playerColor),
    getObjectbyNameAndNotes("Button Report Skills", playerColor),
    getObjectbyNameAndNotes("Button Report Suits", playerColor),
    getObjectbyNameAndNotes("Button Report Traits Species", playerColor),
    getObjectbyNameAndNotes("Button Report Traits Regular", playerColor),
    getObjectbyNameAndNotes("Button Report Traits Other", playerColor),
    getObjectbyNameAndNotes("Button Pull Action Token", playerColor),
  }
  for i = 1, #destructButtons do destructButtons[i].destruct() end
  for _, object in pairs(getObjects()) do
    if object.getName() == "Action Token" and object.getGMNotes() == playerColor then
      object.destruct()
    end
  end

  -- move / flip counters (dil, lat, glory, gloryBag)
  local resourceCounterObjs = {
    getObjectbyNameAndNotes("Dilithium Counter " .. playerColor, playerColor),
    getObjectbyNameAndNotes("Latinum Counter " .. playerColor, playerColor),
    getObjectbyNameAndNotes("Glory Counter " .. playerColor, playerColor),
    getObjectbyNameAndNotes("Glory Token Bag", playerColor),
  }
  local rotResourceCounters = {
    playerColor == "Blue" and "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 },
    playerColor == "Blue" and { 0.00, 0.00, 0.00 } or { 0.00, 180.00, 0.00 },
    playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 },
    playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 },
  }
  local posResourceCounters = {
    playerColor == "Blue" and { -24.45, 0.79, 9.28 }  or { 24.45, 0.79, -9.28 },
    playerColor == "Blue" and { -24.45, 0.96, 10.52 } or { 24.45, 0.96, -10.52 },
    playerColor == "Blue" and { -24.45, 0.85, 14.00 } or { 24.45, 0.85, -14.00 },
    playerColor == "Blue" and { -24.45, 0.85, 14.00 } or { 24.45, 0.85, -14.00 },
  }
  for i = 1, 4 do
    local counterObj = resourceCounterObjs[i]
    local rotObj = rotResourceCounters[i]
    local posObj = posResourceCounters[i]
    counterObj.setRotation(rotObj)
    counterObj.setPosition(posObj)
  end

  -- skill counters
  local skillCounterObjs = {
    getObjectbyName("Research Counter " .. playerColor),
    getObjectbyName("Influence Counter " .. playerColor),
    getObjectbyName("Military Counter " .. playerColor)
  }
  local rotSkillCounter = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 }
  for i = 1, 3 do
    skillCounterObjs[i].setRotation(rotSkillCounter)
    local pos = skillCounterObjs[i].getPosition()
    pos.x = playerColor == "Blue" and -36.15 or 36.15
    if i == 1 then
      pos.z = playerColor == "Blue" and 10.00 or -10.00
    elseif i == 3 then
      pos.z = playerColor == "Blue" and 16.00 or -16.00
    end
    skillCounterObjs[i].setPosition(pos)
  end

  -- bot draw deck refresh button
  local buttonDeckRefresh = getObjectbyName("Button Refresh Draw Deck " .. playerColor)
  local rotButtonDeckRefresh = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 }
  buttonDeckRefresh.setRotation(rotButtonDeckRefresh)
end


function displayPlayerControlXML(captainName, playerColor)
  -- handles the initial on screen XML player control panel setup

  local dilithiumVal = getObjectbyName("Dilithium Counter " .. playerColor).getVar("val")
  local latinumVal = getObjectbyName("Latinum Counter " .. playerColor).getVar("val")
  local gloryVal = getObjectbyName("Glory Counter " .. playerColor).getVar("val")

  if captainName == "Burnham" or captainName == "Picard" or captainName == "Sisko" or
     captainName == "Archer" or captainName == "Georgiou" or captainName == "Kirk" or
     captainName == "Freeman" or captainName == "Pike" or captainName == "Riker" then
    UI.setAttribute(playerColor == "Blue" and "blue_starfleet_panel" or "red_starfleet_panel", "active", "true")
    UI.setAttribute(playerColor == "Blue" and "blue_hum_glory" or "red_hum_glory", "text", gloryVal)
    UI.setAttribute(playerColor == "Blue" and "blue_hum_latinum" or "red_hum_latinum", "text", latinumVal)
    UI.setAttribute(playerColor == "Blue" and "blue_hum_dilithium" or "red_hum_dilithium", "text", dilithiumVal)

  elseif captainName == "Shran" then
    UI.setAttribute(playerColor == "Blue" and "blue_andorian_panel" or "red_andorian_panel", "active", "true")
    UI.setAttribute(playerColor == "Blue" and "blue_and_glory" or "red_and_glory", "text", gloryVal)
    UI.setAttribute(playerColor == "Blue" and "blue_and_latinum" or "red_and_latinum", "text", latinumVal)
    UI.setAttribute(playerColor == "Blue" and "blue_and_dilithium" or "red_and_dilithium", "text", dilithiumVal)

  elseif captainName == "Sela" then
    UI.setAttribute(playerColor == "Blue" and "blue_romulan_panel" or "red_romulan_panel", "active", "true")
    UI.setAttribute(playerColor == "Blue" and "blue_rom_glory" or "red_rom_glory", "text", gloryVal)
    UI.setAttribute(playerColor == "Blue" and "blue_rom_latinum" or "red_rom_latinum", "text", latinumVal)
    UI.setAttribute(playerColor == "Blue" and "blue_rom_dilithium" or "red_rom_dilithium", "text", dilithiumVal)

  elseif captainName == "Koloth" then
    UI.setAttribute(playerColor == "Blue" and "blue_klingon_panel" or "red_klingon_panel", "active", "true")
    UI.setAttribute(playerColor == "Blue" and "blue_kli_glory" or "red_kli_glory", "text", gloryVal)
    UI.setAttribute(playerColor == "Blue" and "blue_kli_latinum" or "red_kli_latinum", "text", latinumVal)
    UI.setAttribute(playerColor == "Blue" and "blue_kli_dilithium" or "red_kli_dilithium", "text", dilithiumVal)

  elseif captainName == "Khan" then
    UI.setAttribute(playerColor == "Blue" and "blue_khan_panel" or "red_khan_panel", "active", "true")
    UI.setAttribute(playerColor == "Blue" and "blue_kha_glory" or "red_kha_glory", "text", gloryVal)
    UI.setAttribute(playerColor == "Blue" and "blue_kha_latinum" or "red_kha_latinum", "text", latinumVal)
    UI.setAttribute(playerColor == "Blue" and "blue_kha_dilithium" or "red_kha_dilithium", "text", dilithiumVal)

  elseif captainName == "Rebner" then
    UI.setAttribute(playerColor == "Blue" and "blue_pakled_panel" or "red_pakled_panel", "active", "true")
    UI.setAttribute(playerColor == "Blue" and "blue_pak_glory" or "red_pak_glory", "text", gloryVal)
    UI.setAttribute(playerColor == "Blue" and "blue_pak_latinum" or "red_pak_latinum", "text", latinumVal)
    UI.setAttribute(playerColor == "Blue" and "blue_pak_dilithium" or "red_pak_dilithium", "text", dilithiumVal)

  elseif captainName == "Soval" then
    UI.setAttribute(playerColor == "Blue" and "blue_vulcan_panel" or "red_vulcan_panel", "active", "true")
    UI.setAttribute(playerColor == "Blue" and "blue_vul_glory" or "red_vul_glory", "text", gloryVal)
    UI.setAttribute(playerColor == "Blue" and "blue_vul_latinum" or "red_vul_latinum", "text", latinumVal)
    UI.setAttribute(playerColor == "Blue" and "blue_vul_dilithium" or "red_vul_dilithium", "text", dilithiumVal)
  end

  UI.show(playerColor == "Blue" and "ui_hide_blue" or "ui_hide_red")
end


function setInitialPlayerCounters(playerColor)
  -- handles the initial set of player resources to 1
  local resourceCounterObjs = {
    getObjectbyNameAndNotes("Dilithium Counter " .. playerColor, playerColor),
    getObjectbyNameAndNotes("Latinum Counter " .. playerColor, playerColor),
    getObjectbyNameAndNotes("Glory Counter " .. playerColor, playerColor),
  }
  for i = 1, 3 do
    resourceCounterObjs[i].call('set_val', 1)
  end
end


function finalizeCaptainSetup()
  -- will handle final cleanup steps required after both sides confirmed

  -- remove unselected captain cleanup_targets, destruct side panels
  local bagUnusedObjs = getObjectbyName("Unused Object Bag")
  local checkZones = {
    getObjectbyName("Zone Captain Select Left"),
    getObjectbyName("Zone Captain Select Right"),
  }
  local panels = {
    getObjectbyName("Side Panel Left"),
    getObjectbyName("Side Panel Right"),
  }
  for i = 1, 2 do
    for _, zoneObj in pairs(checkZones[i].getObjects()) do
      if zoneObj == panels[i] then
        zoneObj.destruct()
      elseif zoneObj.hasTag("cleanup_target") then
        bagUnusedObjs.putObject(zoneObj)
      end
    end
  end

  local soloInGame = checkisBot()
  -- randomize first player, will overwrite to human color if soloInGame
  local sides = { "Blue", "Red" }
  local firstPlayerColor = sides[math.random(1, 2)]

  -- if NOT isBot in game:
  if not soloInGame then

    -- if more than 1 seated player, enable turns and set to first turn owner
    local seatedPlayers = getSeatedPlayers()
    if #seatedPlayers > 1 then
      Turns.enable = true
      Turns.turn_color = firstPlayerColor
    end

    -- junk pad GMNotes will always be playerColor of current turn holder, set initial
    getObjectbyName("Pad Junk").setGMNotes(firstPlayerColor)

    -- broadcast
    local playerStr = getPlayerStr(firstPlayerColor)
    local broadcastStr = playerStr .. " will be First Player!"
    broadcastToAll(broadcastStr, "White")

    -- check for stardate card, will be empty by now if 2p, perform 2p actions:
    ---- pull 2p stardate deck if empty, do initial refresh glory
    ---- return conspiracy/reinforce solo cards
    local deckFound = false
    local checkZone = getObjectbyName("Zone Stardate")
    for _, object in pairs(checkZone.getObjects()) do
      if object.tag == "Deck" then
        deckFound = true
      end
    end
    if not deckFound then
      local deck2p = getObjectbyName("2-Player Stardate Deck")
      local posDeck2p = { -12.50, 1.50, 0.00 }
      deck2p.setPositionSmooth(posDeck2p, false, true)
      showStardateGloryCounter("twoPlayer")
      Wait.time(function()

        refreshGlory()

      end, 1.0)
    end

  -- if IS isBot in game:
  elseif soloInGame then

    -- place button most value, button next bot action
    local bagUnusedObjects = getObjectbyName("Unused Object Bag")
    local botColor = checkPlayerColorIsBot("Blue") and "Blue" or "Red"
    local rotButtonMVP = { 0.00, 180.00, 0.00 }
    local posButtonMVP = { 6.80, 0.75, -2.00 }
    local rotButtonNextAction = botColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 }
    local posButtonNextAction = botColor == "Blue" and { 25.75, 0.75, -6.06 } or { -25.75, 0.75, 6.06 }

    local buttonMVP = getObjectFromBagbyName("Button Most Value", bagUnusedObjects, rotButtonMVP, posButtonMVP, false)
    local buttonNext = getObjectFromBagbyName("Button Next Bot Action", bagUnusedObjects, rotButtonNextAction, posButtonNextAction, false)

    Wait.frames(function()
      buttonMVP.setLock(true)
      buttonNext.setLock(true)
      buttonMVP.interactable = false
      buttonNext.interactable = false
    end)

    -- display bot control on screen XML UI
    UI.setAttribute("bot_controls", "active", "true")
    UI.setAttribute('end_player_turn', 'active', 'true')
    UI.setAttribute('bot_discard', 'active', 'true')
    UI.setAttribute('bot_discard_x3', 'active', 'true')
    UI.setAttribute('bot_log', 'active', 'true')
    UI.setAttribute('bot_incident', 'active', 'true')

    -- first player will always be human player
    firstPlayerColor = botColor == "Blue" and "Red" or "Blue"
  end

  -- in EITHER case:
  -- place first player marker to first player's position
  local tokenFirstPlayer = getObjectbyName("First Player")
  local rotToken = firstPlayerColor == "Blue" and { 0.00, 180.00, 0.00 } or { 0.00, 0.00, 0.00 }
  local posToken = firstPlayerColor == "Blue" and { -46.00, 1.95, 28.00 } or { 46.00, 1.95, -28.00 }

  tokenFirstPlayer.setRotation(rotToken)
  tokenFirstPlayer.setPositionSmooth(posToken, false, true)

  -- clean up non selected stardate decks, any other required cleanup for top table panel
  Wait.time(function()

    -- clean up stardate & solo instruction decks
    local topCheckZone = getObjectbyName("Zone Stardate Select")
    for _, zoneObj in pairs(topCheckZone.getObjects()) do
      if zoneObj.getName():find("Stardate") and zoneObj.type == "Deck" or
      zoneObj.getName() == "Solo Cadet Practice Deck" or
      zoneObj.getName() == "Traits / 5 Year Mission Deck" or zoneObj.getName() == "Suits Deck" then
        bagUnusedObjs.putObject(zoneObj)
      end
    end

    -- center bag
    local posBag = bagUnusedObjs.getPosition()
    posBag.x = 0.00
    bagUnusedObjs.setPositionSmooth(posBag)

    -- clean up or position remaining cards or decks
    local cardSC1 = getObjectbyName("Conspiracy")
    local cardSC2 = getObjectbyName("Time Is Running Out")
    local cardReinforce = getObjectbyName("Reinforce")
    local deckSCRewards = getObjectbyName("Rewards Second Contact Deck")
    local posCardSC1 = soloInGame and { 5.28, 1.71, 27.50 } or { 0.00, 2.00, 27.50 }
    local posCardSC2 = soloInGame and { 9.85, 1.71, 27.50 } or { 0.00, 2.25, 27.50 }
    local posCardReinforce = soloInGame and { 14.31, 1.71, 27.53 } or { 0.00, 2.50, 27.50 }
    local posDeckSCRewards = { -5.45, 1.76, 27.58 }

    Wait.time(function()

      if cardSC1 ~= nil then cardSC1.setPositionSmooth(posCardSC1, false, true) end
      if cardSC2 ~= nil then cardSC2.setPositionSmooth(posCardSC2, false, true) end
      if cardReinforce ~= nil then cardReinforce.setPositionSmooth(posCardReinforce, false, true) end
      if deckSCRewards ~= nil then deckSCRewards.setPositionSmooth(posDeckSCRewards, false, true) end

    end, 1.5)

  end, 1.5)
end


function pullActionToken(buttonObj, clickerColor, altClick)
  animateButton(buttonObj)
  local posDrop = buttonObj.getPosition()
  local playerColor = buttonObj.getGMNotes()
  local rotToken = playerColor == "Blue" and {0.00, 120.00, 0.00} or { 0.00, 300.00, 180.00 }
  local bagTokens = getObjectbyNameAndNotes("Action Token Bag", playerColor)
  posDrop.y = 6.00
  local token = bagTokens.takeObject({ rotation= rotToken })
  token.setPosition(posDrop)
  token.addTag("destruct_on_end_turn")
  local playerStr = getPlayerStr(playerColor)
  local broadcastStr = string.format("%s has generated +1 Extra Action Token.", playerStr)
  broadcastToAll(broadcastStr, "White")
end