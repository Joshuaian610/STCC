function getPlayNoAction(cardObj, opIndex)
  -- handles detection and return of report text of actionless play operations
  local cardName = cardObj.getName()
  local attackColor = Color.fromString("Red"):toHex()
  local index = "playNoAction" .. tostring(opIndex)

  local playNoActionText = {
    -- base game encounter play actions
    ["Boltzmann Brain"] = {
      ["playNoAction1"] = "Draw a card. You may return an Incident.",
    },
