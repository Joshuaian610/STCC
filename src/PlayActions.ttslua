function getSupport(cardObj, opIndex)
  -- handles detection and return of report text of support operations
  local cardName = cardObj.getName()
  local index = "playSupport" .. tostring(opIndex)

  log("found cardName: " .. cardName)
  log("found index: " .. index)

  local supportText = {
    ["Ensign Boimler"] = {
      ["playSupport1"] = "After you junk or promote a Person, duplicate a play operation of that card.",
    },
    ["Ensign Mariner"] = {
      ["playSupport1"] = "After you exhaust a Duty Officer, refresh it and you may send an Away Team to a Location where you have a Ship.",
    },
    ["Jennifer Sh'reyan"] = {
      ["playSupport1"] = "After gaining a Person, draw a card and you may send an Away Team to a controlled Location.",
    },
    ["Ma'ah"] = {
      ["playSupport1"] = "After putting a Klingon into play, gain a Ship. Then, either spend an action and discard an Incident OR take an Incident.",
    },
    ["Nova Fleet"] = {
      ["playSupport1"] = "When you junk a card from the Market, gain it to your hand instead. If your opponent has a Lower Decker in play, take an Incident.",
    },
    ["Brad Boimler, Lt. JG"] = {
      ["playSupport1"] = "After promoting a Person, duplicate a play operation of that card.",
    },
    ["William Boimler, Lt. JG"] = {
      ["playSupport1"] = "After exhausting your Captain, discard a card to scan 1 of Cargo. If the gained card is Beverage, draw it.",
    },
    ["Bradward Boimler"] = {
      ["playSupport1"] = "After promoting a Person, duplicate a play operation of that card.",
    },
    ["Beckett Mariner"] = {
      ["playSupport1"] = "After putting an Ally into play, gain 1 Latinum and send an Away Team to a Location where you have a Ship.",
    },
    ["Samanthan Rutherford"] = {
      ["playSupport1"] = "After exhausting a Ship, refresh it and you may beam this card to it. If you have another Synthetic in play, gain 1 Glory.",
    },
    ["D'Vana Tendi"] = {
      ["playSupport1"] = "After promoting a Lower Decker, gain 2 Research or Influence or Military and you may promote this card to Duty Officer.",
    },
    ["T'Lyn"] = {
      ["playSupport1"] = "After logging a card, either gain 2 Dilithium OR draw a card from your Discard pile. Then, you may either free play a Lower Decker OR promote a Lower Decker to Duty Officer from your hand or the Staging Area (can be this card).",
    },
    ["Drones of Cube 90182"] = {
      ["playSupport1"] = "After putting a Borg into play, spend 1 Dilithium to draw a card and gain 2 Research.",
      ["playSupport2"] = "After assimilating a card, gain 1 Borg Collective and draw 2 cards.",
    },
  }
  return supportText[cardName][index]

end