-- contains code related to card right click context menu functionality

-- Play (Action) - (tag: 'playAction') will first check for available action token, then detect slot to place in staging, then place available action token, show in hand
-- Play (No Action) - (tag: 'playNoAction') will detect slot to place in staging, show in hand

-- Deploy - (tag: 'deployAction' OR 'deployNoAction') will detect slot to place in ship/location (cargo will deploy right to left in ships, encounters same for locations) show in hand, or, zone In Play

-- Activation - (tag: 'playActivation'), only show when in DO (person), captain (captain), or deploy zones (ships, cargo, encounters, locations)
-- Reaction - (tag: 'playReaction'), only show when in DO or deploy zones
-- suffix either tag with Action if requires action (ie: playActivationAction)

-- Support - tag: 'playSupport' show only in hand

-- tagless:
-- Make Duty Officer - in hand or in staging and Person
-- Dismiss - only for people in zone duty officer, same as discard
-- Return - (tag: 'marketCard' or 'suit_incident') show return at all times
-- Log (any card any play zone) (no broadcast, broadcast will happen on log?) show log at all times
-- Discard (any card show in hand) -- broadcast

-- all suit cards all the time:
-- Return (if marketCard)
-- Log

-- handzone items:
-- playAction, 2, 3
-- playNoAction, 2, 3
-- deployAction, 2, 3
-- deployNoAction, 2, 3
-- playSupport
-- promote DO
-- Discard
-- Return
-- Log

-- staging zone items:
-- if Wesley crusher is DO:
-- playActivation, 2, 3
-- playActionActivation, 2, 3
-- playReaction, 2, 3
-- Make DO (if person)
-- Discard
-- Return
-- Log

-- deploy zone items (if ship, cargo, location, directive, or encounter):
-- playActivation, 2, 3
-- playActionActivation, 2, 3
-- playReaction, 2, 3
-- Dismiss
-- Return
-- Log

-- DO zone items (if person):
-- playActivation, 2, 3
-- playActionActivation, 2, 3
-- playReaction, 2, 3
-- Dismiss
-- Return
-- Log

function checkContextActions(cardObj)
  -- handles call from Global onObjectSpawn,  creating correct right click context menu options for cards

  -- need to check if card is in a relevent zone
  local cardInZone = false
  for _, zone in pairs(cardObj.getZones()) do
    if zone.getName() == "Handzone" or zone.getName() == "Zone In Play" or
       zone.getName() == "Zone Deploy Ship" or zone.getName() == "Zone Deploy Location" or
       zone.getName() == "Zone Duty Officer" or zone.getName() == "Zone Captain" then
      loadContextActions(zone, cardObj)
      cardInZone = true
      break
    end
  end

  if not cardInZone then
    loadDefaultContextActions(cardObj)
  end
end



function loadDefaultContextActions(cardObj)
  -- handles cases where no play action menu items are required
  -- is the generic "default" context menu options given to a card on spawn if not in a relevant zone
  -- default 2 actions: Return (if marketCard tagged), Log
  if cardObj == nil then return end

  cardObj.clearContextMenu()

  if not cardObj.hasTag("suit_captain") and cardObj.type == "Card" then
    if cardObj.hasTag("marketCard") or cardObj.hasTag("suit_incident") or cardObj.hasTag("suit_encounter") then
      cardObj.addContextMenuItem("Return Card", returnMarketCardViaContext)
    end
    cardObj.addContextMenuItem("Log Card", logCardViaContext)
  end
end


function reloadStagingPerson(cardObj)
  -- handles reload of person cards in staging for when wesley crusher is promoted/dismissed as DO

  local stagingZone
  local cardZones = cardObj.getZones()
  for _, zone in pairs(cardZones) do
    if zone.getName() == "Zone In Play" then
      stagingZone = zone
    end
  end
  if stagingZone == nil then return end

  loadContextActions(stagingZone, cardObj)
end


function loadContextActions(zone, cardObj)
  -- determines correct set of, and order of context menu actions by card, as determined by it's current relevent zone (or lack of)
  -- will be called on zone enter/leave for any card

  if cardObj == nil then return end
  if zone.getName() ~= "Handzone" and zone.getName() ~= "Zone In Play" and
     zone.getName() ~= "Zone Deploy Ship" and zone.getName() ~= "Zone Deploy Location" and
     zone.getName() ~= "Zone Duty Officer" and zone.getName() ~= "Zone Captain" then
    return
  end
  if cardObj.type ~= "Card" then return end

  local playerColor = zone.getGMNotes()
  local isBot = checkPlayerColorIsBot(playerColor)

  -- waits for a 1 second after call to ensure card remains in triggering zone
  Wait.time(function()

    local cardStillInZone = false
    for _, zoneObj in pairs(zone.getObjects()) do
      if zoneObj == cardObj then
        cardStillInZone = true
        break
      end
    end
    if not cardStillInZone then loadDefaultContextActions(cardObj) end

    cardObj.clearContextMenu()

    -- load handzone actions
    if zone.getName() == "Handzone" then
      if cardObj.hasTag("playAction") then
        cardObj.addContextMenuItem("Play (Action)", playAction)
      end
      if cardObj.hasTag("playAction2") then
        cardObj.addContextMenuItem("Play 2nd (Action)", playAction2)
      end
      if cardObj.hasTag("playAction3") then
        cardObj.addContextMenuItem("Play 3rd (Action)", playAction3)
      end

      if cardObj.hasTag("playNoAction") then
        cardObj.addContextMenuItem("Play (No Action)", playNoAction)
      end
      if cardObj.hasTag("playNoAction2") then
        cardObj.addContextMenuItem("Play 2nd ( No Action)", playNoAction2)
      end
      if cardObj.hasTag("playNoAction3") then
        cardObj.addContextMenuItem("Play 3rd (No Action)", playNoAction3)
      end

      if cardObj.hasTag("deployAction") then
        if cardObj.hasTag("suit_location") then
          cardObj.addContextMenuItem("Control (Action)", deployAction)
        else
          cardObj.addContextMenuItem("Deploy (Action)", deployAction)
        end
      end
      if cardObj.hasTag("deployAction2") then
        if cardObj.hasTag("suit_location") then
          cardObj.addContextMenuItem("2nd Control (Action)", deployAction2)
        else
          cardObj.addContextMenuItem("2nd Deploy (Action)", deployAction2)
        end
      end
      if cardObj.hasTag("deployAction3") then
        if cardObj.hasTag("suit_location") then
          cardObj.addContextMenuItem("3rd Control (Action)", deployAction3)
        else
          cardObj.addContextMenuItem("3rd Deploy (Action)", deployAction3)
        end
      end

      if cardObj.hasTag("deployNoAction") then
        if cardObj.hasTag("suit_location") then
          cardObj.addContextMenuItem("Control (No Action)", deployNoAction)
        else
          cardObj.addContextMenuItem("Deploy (No Action)", deployNoAction)
        end
      end
      if cardObj.hasTag("deployNoAction2") then
        if cardObj.hasTag("suit_location") then
          cardObj.addContextMenuItem("2nd Control (No Action)", deployNoAction2)
        else
          cardObj.addContextMenuItem("2nd Deploy (No Action)", deployNoAction2)
        end
      end
      if cardObj.hasTag("deployNoAction3") then
        if cardObj.hasTag("suit_location") then
          cardObj.addContextMenuItem("3rd Control (No Action)", deployNoAction3)
        else
          cardObj.addContextMenuItem("3rd Deploy (No Action)", deployNoAction3)
        end
      end

      if cardObj.hasTag("playSupport") then
        cardObj.addContextMenuItem("Support", playSupport)
      end

      if cardObj.hasTag("playSupport2") then
        cardObj.addContextMenuItem("Support", playSupport2)
      end

      if ((cardObj.hasTag("suit_person") or cardObj.getName() == "The Riker Maneuver")) and
         cardObj.getName() ~= "Miles O'Brien" and cardObj.getName() ~= "Ensign Boimler" and
         cardObj.getName() ~= "Ensign Mariner" and cardObj.getName() ~= "Christine Chapel" then
        cardObj.addContextMenuItem("Promote Duty Officer", promoteDO)
      end

      cardObj.addContextMenuItem("Discard Card", discardViaContext)

      if cardObj.hasTag("marketCard") or cardObj.hasTag("suit_incident") or cardObj.hasTag("suit_encounter") then
       cardObj.addContextMenuItem("Return Card", returnMarketCardViaContext)
      end

      cardObj.addContextMenuItem("Log Card", logCardViaContext)
    end

    -- load staging actions
    if zone.getName() == "Zone In Play" then

      -- need check for Wesley Crusher in DO slot to see if activations/reactions should be added to menus
      local playerColor = zone.getGMNotes()
      local wesCheckZone = getObjectbyNameAndNotes("Zone Duty Officer", playerColor)
      local wesFound = false
      for _, zoneObj in pairs(wesCheckZone.getObjects()) do
        if zoneObj.getName() == "Wesley Crusher" then wesFound = true break end
      end

      if wesFound and cardObj.hasTag("suit_person") then
        if cardObj.hasTag("playActivationAction") then
          cardObj.addContextMenuItem("Activate (Action)", playActivationAction)
        end
        if cardObj.hasTag("playActivationAction2") then
          cardObj.addContextMenuItem("2nd Activate (Action)", playActivationAction2)
        end
        if cardObj.hasTag("playActivationAction3") then
          cardObj.addContextMenuItem("3rd Activate (Action)", playActivationAction3)
        end

        if cardObj.hasTag("playActivation") then
          cardObj.addContextMenuItem("Activate", playActivation)
        end
        if cardObj.hasTag("playActivation2") then
          cardObj.addContextMenuItem("2nd Activate", playActivation2)
        end
        if cardObj.hasTag("playActivation3") then
          cardObj.addContextMenuItem("3rd Activate", playActivation3)
        end

        if cardObj.hasTag("playReaction") then
          cardObj.addContextMenuItem("Reaction", playReaction)
        end

        if cardObj.hasTag("playReaction2") then
          cardObj.addContextMenuItem("2nd Reaction", playReaction2)
        end

        if cardObj.hasTag("playReaction3") then
          cardObj.addContextMenuItem("3rd Reaction", playReaction3)
        end
      end

      if ((cardObj.hasTag("suit_person") or cardObj.getName() == "The Riker Maneuver")) and
         cardObj.getName() ~= "Miles O'Brien" and cardObj.getName() ~= "Ensign Boimler" and
         cardObj.getName() ~= "Ensign Mariner" and cardObj.getName() ~= "Christine Chapel" then
        cardObj.addContextMenuItem("Promote Duty Officer", promoteDO)
      end

      if cardObj.hasTag("deployAction") and not isBot then
        if cardObj.hasTag("suit_location") then
          cardObj.addContextMenuItem("Control (Action)", deployAction)
        else
          cardObj.addContextMenuItem("Deploy (Action)", deployAction)
        end
      end
      if cardObj.hasTag("deployAction2") and not isBot then
        if cardObj.hasTag("suit_location") then
          cardObj.addContextMenuItem("2nd Control (Action)", deployAction2)
        else
          cardObj.addContextMenuItem("2nd Deploy (Action)", deployAction2)
        end
      end
      if cardObj.hasTag("deployAction3") and not isBot then
        if cardObj.hasTag("suit_location") then
          cardObj.addContextMenuItem("3rd Control (Action)", deployAction3)
        else
          cardObj.addContextMenuItem("3rd Deploy (Action)", deployAction3)
        end
      end

      if cardObj.hasTag("deployNoAction") and not isBot then
        if cardObj.hasTag("suit_location") then
          cardObj.addContextMenuItem("Control (No Action)", deployNoAction)
        else
          cardObj.addContextMenuItem("Deploy (No Action)", deployNoAction)
        end
      end
      if cardObj.hasTag("deployNoAction2") and not isBot then
        if cardObj.hasTag("suit_location") then
          cardObj.addContextMenuItem("2nd Control (No Action)", deployNoAction2)
        else
          cardObj.addContextMenuItem("2nd Deploy (No Action)", deployNoAction2)
        end
      end
      if cardObj.hasTag("deployNoAction3") and not isBot then
        if cardObj.hasTag("suit_location") then
          cardObj.addContextMenuItem("3rd Control (No Action)", deployNoAction3)
        else
          cardObj.addContextMenuItem("3rd Deploy (No Action)", deployNoAction3)
        end
      end

      if isBot and not cardObj.hasTag("suit_location") and
         (cardObj.hasTag("deployAction") or cardObj.hasTag("deployAction2") or cardObj.hasTag("deployAction3") or
         cardObj.hasTag("deployNoAction1") or cardObj.hasTag("deployNoAction2") or cardObj.hasTag("deployNoAction3")) then
        cardObj.addContextMenuItem("Deploy Card", deployNoAction)
      end

      cardObj.addContextMenuItem("Discard Card", discardViaContext)

      if cardObj.hasTag("marketCard") or cardObj.hasTag("suit_incident") or cardObj.hasTag("suit_encounter") then
        cardObj.addContextMenuItem("Return Card", returnMarketCardViaContext)
      end

      cardObj.addContextMenuItem("Log Card", logCardViaContext)
    end

    -- load deploy zone actions
    if (zone.getName() == "Zone Deploy Ship" or zone.getName() == "Zone Deploy Location") and
        not cardObj.hasTag("suit_person") and not cardObj.hasTag("suit_captain") then

      if cardObj.hasTag("playActivationAction") then
        cardObj.addContextMenuItem("Activate (Action)", playActivationAction)
      end
      if cardObj.hasTag("playActivationAction2") then
        cardObj.addContextMenuItem("2nd Activate (Action)", playActivationAction2)
      end
      if cardObj.hasTag("playActivationAction3") then
        cardObj.addContextMenuItem("3rd Activate (Action)", playActivationAction3)
      end

      if cardObj.hasTag("playActivation") then
        cardObj.addContextMenuItem("Activate", playActivation)
      end
      if cardObj.hasTag("playActivation2") then
        cardObj.addContextMenuItem("2nd Activate", playActivation2)
      end
      if cardObj.hasTag("playActivation3") then
        cardObj.addContextMenuItem("3rd Activate", playActivation3)
      end

      if cardObj.hasTag("playReaction") then
        cardObj.addContextMenuItem("Reaction", playReaction)
      end

      if cardObj.hasTag("playReaction2") then
        cardObj.addContextMenuItem("2nd Reaction", playReaction2)
      end

      if cardObj.hasTag("playReaction3") then
        cardObj.addContextMenuItem("3rd Reaction", playReaction3)
      end

      cardObj.addContextMenuItem("Dismiss Card", dismissViaContext)

      if cardObj.hasTag("marketCard") or cardObj.hasTag("suit_incident") or cardObj.hasTag("suit_encounter") then
        cardObj.addContextMenuItem("Return Card", returnMarketCardViaContext)
      end

      cardObj.addContextMenuItem("Log Card", logCardViaContext)

      -- add SNW actions
      if cardObj.hasTag("suit_location") then
        local playerColor = zone.getGMNotes()
        local captainName = getCaptainName(playerColor)
        if captainName == "None" then return end

        if captainName == "Picard" or captainName == "Sisko" or captainName == "Burnham" or captainName == "Georgiou" or
          captainName == "Kirk" or captainName == "Archer" or captainName == "Pike" or captainName == "Riker" or captainName == "Freeman" then
            cardObj.addContextMenuItem("Strange New World", runStrangeNewWorlds)
        end
      end
    end

    -- load duty officer zone actions
    if zone.getName() == "Zone Duty Officer" and cardObj.hasTag("suit_person") then
      if cardObj.hasTag("playActivationAction") then
        cardObj.addContextMenuItem("Activate (Action)", playActivationAction)
      end
      if cardObj.hasTag("playActivationAction2") then
        cardObj.addContextMenuItem("2nd Activate (Action)", playActivationAction2)
      end
      if cardObj.hasTag("playActivationAction3") then
        cardObj.addContextMenuItem("3rd Activate (Action)", playActivationAction3)
      end

      if cardObj.hasTag("playActivation") then
        cardObj.addContextMenuItem("Activate", playActivation)
      end
      if cardObj.hasTag("playActivation2") then
        cardObj.addContextMenuItem("2nd Activate", playActivation2)
      end
      if cardObj.hasTag("playActivation3") then
        cardObj.addContextMenuItem("3rd Activate", playActivation3)
      end

      if cardObj.hasTag("playReaction") then
        cardObj.addContextMenuItem("Reaction", playReaction)
      end

      if cardObj.hasTag("playReaction2") then
        cardObj.addContextMenuItem("2nd Reaction", playReaction2)
      end

      if cardObj.hasTag("playReaction3") then
        cardObj.addContextMenuItem("3rd Reaction", playReaction3)
      end

      cardObj.addContextMenuItem("Dismiss Card", dismissViaContext)

      if cardObj.hasTag("marketCard") or cardObj.hasTag("suit_incident") or cardObj.hasTag("suit_encounter") then
        cardObj.addContextMenuItem("Return Card", returnMarketCardViaContext)
      end

      cardObj.addContextMenuItem("Log Card", logCardViaContext)
    end

    -- load captain zone actions
    if zone.getName() == "Zone Captain" then
      if cardObj.hasTag("playActivationAction") then
        cardObj.addContextMenuItem("Activate (Action)", playActivationAction)
      end
      if cardObj.hasTag("playActivationAction2") then
        cardObj.addContextMenuItem("2nd Activate (Action)", playActivationAction2)
      end
      if cardObj.hasTag("playActivationAction3") then
        cardObj.addContextMenuItem("3rd Activate (Action)", playActivationAction3)
      end

      if cardObj.hasTag("playActivation") then
        cardObj.addContextMenuItem("Activate", playActivation)
      end
      if cardObj.hasTag("playActivation2") then
        cardObj.addContextMenuItem("2nd Activate", playActivation2)
      end
      if cardObj.hasTag("playActivation3") then
        cardObj.addContextMenuItem("3rd Activate", playActivation3)
      end

      if cardObj.hasTag("playReaction") then
        cardObj.addContextMenuItem("Reaction", playReaction)
      end

      if cardObj.hasTag("playReaction2") then
        cardObj.addContextMenuItem("2nd Reaction", playReaction2)
      end

      if cardObj.hasTag("playReaction3") then
        cardObj.addContextMenuItem("3rd Reaction", playReaction3)
      end
    end

  end, 1)

end


function returnMarketCardViaContext(_, _, cardObj)
  -- handles the return of a market card, same as old pads, via right click context menu

  local playerColor = getActualPlayerColor(cardObj)
  if playerColor ~= "Blue" and playerColor ~= "Red" then return end

  local cardSuit = (cardObj.hasTag("suit_encounter") and "Encounter") or
                   (cardObj.hasTag("suit_person") and "Person") or
                   (cardObj.hasTag("suit_cargo") and "Cargo") or
                   (cardObj.hasTag("suit_ship") and "Ship") or
                   (cardObj.hasTag("suit_ally") and "Ally") or
                   (cardObj.hasTag("suit_incident") and "Incident")
  local suitColors = {
    ["Encounter"] = "CDACB7",
    ["Person"]    = "BFA42C",
    ["Cargo"]     = "4173B4",
    ["Ship"]      = "C8C8C8",
    ["Ally"]      = "CD28C3",
    ["Incident"]  = "9F110F"
  }
  local suitColor = suitColors[cardSuit] or "FFFFFF"

  local deckCheckZone = getObjectbyName("Zone Market " .. cardSuit)
  if cardSuit == "Encounter" then
    deckCheckZone = getObjectbyName("Zone Encounter")
  end
  if cardSuit == "Incident" then
    deckCheckZone = getObjectbyName("Zone Incident")
  end
  local cardOrDeckFound = false
  for _, zoneObj in pairs(deckCheckZone.getObjects()) do
    if zoneObj.type == "Deck" then
      cardOrDeckFound = true
      local posDeck = zoneObj.getPosition()
      posDeck.y = -1.00
      local rotCard = zoneObj.getRotation()
      cardObj.setRotation(rotCard)
      cardObj.setPosition(posDeck)
      zoneObj.putObject(cardObj)
      break
    end
    if zoneObj.type == "Card" then
      cardOrDeckFound = true
      local posDeck = zoneObj.getPosition()
      posDeck.y = 2.00
      zoneObj.setPositionSmooth(posDeck, false, true)
      local rotCard = zoneObj.getRotation()
      cardObj.setRotation(rotCard)
      posDeck.y = 1.00
      Wait.frames(function() cardObj.setPosition(posDeck) end)
      break
    end
  end

  -- if returning to empty market, simply place facedown to appropriate pad
  if not cardOrDeckFound then
    local rotEmpty = cardSuit == "Encounter" and { 0.00, 270.00, 180.00 } or { 0.00, 180.00, 180.00 }
    local posEmpty = {
      ["Encounter"] = { -12.50, 1.00, 19.25 },
      ["Person"]    = { -7.50, 1.00, 14.00 },
      ["Cargo"]     = { -2.50, 1.00, 14.00 },
      ["Ship"]      = { 2.50, 1.00, 14.00 },
      ["Ally"]      = { 7.50, 1.00, 14.00 },
      ["Incident"]  = { 12.50, 1.00, 10.00 },
    }
    cardObj.setRotation(rotEmpty)
    cardObj.setPosition(posEmpty[cardSuit])
  end

  -- broadcast
  local playerStr = getPlayerStr(playerColor)
  local broadcastStr = string.format("%s has returned %s[b][%s]%s[-][/b] to the Market.", playerStr, cardSuit == "Encounter" and "an " or "", suitColor, cardSuit == "Encounter" and "Encounter" or cardObj.getName())
  broadcastToAll(broadcastStr, "White")

  -- rename deck
  Wait.time(function()

    for _, zoneObj in pairs(deckCheckZone.getObjects()) do
      if zoneObj.type == "Deck" then
        zoneObj.setName(cardSuit .. (cardSuit == "Cargo" and "" or "s") .. " Deck")
      end
    end

  end, 1)
end


function logCardViaContext(_, _, cardObj)
  -- handles the "log" action of a card

  local playerColor = getActualPlayerColor(cardObj)

  if playerColor ~= "Blue" and playerColor ~= "Red" then return end

  local bagLog = getObjectbyNameAndNotes("Captain's Log", playerColor)
  bagLog.putObject(cardObj)

  if cardObj.hasTag("suit_location") then
      local followupStr = string.format("[%s]Reminder[-] - if there are any Beamed cards at %s, right click the bottom Beam Bag button to dismiss all.", Color.fromString(playerColor):toHex(), cardObj.getName())

      Wait.time(function()

        broadcastToAll(followupStr, "White")

      end, 2)
    end
end


function getActualPlayerColor(cardObj)
  -- this will determine the true playerColor of a cardObj by querying it's zone's gm notes
  local cardZones = cardObj.getZones()
  local actualPlayerColor
  for _, zone in pairs(cardZones) do
    if zone.getGMNotes() == "Blue" or zone.getGMNotes() == "Red" then
      actualPlayerColor = zone.getGMNotes()
    end
  end
  return actualPlayerColor
end


function refreshCard(playerColor, _, cardObj)
  -- handles the refresh right click context menu actions (should not show for bot ever)
  local rotRefresh = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 }
  cardObj.setRotationSmooth(rotRefresh, false, true)
  cardObj.clearContextMenu()
  local zones = cardObj.getZones()
  for _, zone in pairs(zones) do
    if zone.getName() == "Handzone" or zone.getName() == "Zone In Play" or
       zone.getName() == "Zone Deploy Ship" or zone.getName() == "Zone Deploy Location" or
       zone.getName() == "Zone Duty Officer" or zone.getName() == "Zone Captain" then
      loadContextActions(zone, cardObj)
      break
    end
  end
end


function placeStagingCard(actionRequired, opType, cardObj, opIndex)
  -- context menu helper that determines the next available staging slot, places card
  -- actionRequired parameter is boolean. true will first check for and place an available extra action token, then action token
  -- false will ignore action tokens

  -- in case of bot owning card, get actual playerColor
  local playerColor = getActualPlayerColor(cardObj)
  if playerColor ~= "Blue" and playerColor ~= "Red" then return end

  -- need to check for action token if actionRequired == true, broadcast unable to perform report if required and not found
  local actionToken
  if actionRequired then
    local checkZone = getObjectbyNameAndNotes("Zone Action Tokens", playerColor)

    -- check for and use extra action tokens first, then if not found, a regular action token
    for _, zoneObj in pairs(checkZone.getObjects()) do
      if zoneObj.getName() == "Extra Action Token" then
        actionToken = zoneObj
        break
      end
    end
    if actionToken == nil then
      for _, zoneObj in pairs(checkZone.getObjects()) do
        if zoneObj.getName() == "Action Token" then
          actionToken = zoneObj
          break
        end
      end
    end
    if actionToken == nil then
      -- broadcast unable to perform action
      local playerStr = getPlayerStr(playerColor)
      local broadcastStr = string.format("%s has no Action Tokens remaining, is unable to perform Operation.", playerStr)
      broadcastToAll(broadcastStr, "White")
      return
    end
  end

  local posStagingCard = playerColor == "Blue" and {
    { -44.50, 0.96, 2.80 },
    { -44.50, 0.96, -1.07 },
    { -44.50, 0.96, -4.99 },
    { -44.50, 0.96, -8.90 },
    { -44.50, 0.96, -12.82 },
    { -44.50, 0.96, -16.74 },
  } or {
    { 44.50, 0.96, -2.80 },
    { 44.50, 0.96, 1.07 },
    { 44.50, 0.96, 4.99 },
    { 44.50, 0.96, 8.90 },
    { 44.50, 0.96, 12.82 },
    { 44.50, 0.96, 16.74 },
  }

  -- determine next available free slot in staging
  local stagingZone = getObjectbyNameAndNotes("Zone In Play", playerColor)
  local slotTolerance = 0.50
  local firstAvailableSlot = nil

  for slotNum, slotPos in ipairs(posStagingCard) do
    local slotOccupied = false

    for _, zoneObj in pairs(stagingZone.getObjects()) do
      if zoneObj.type == "Card" then
        local cardZ = zoneObj.getPosition().z

        if math.abs(cardZ - slotPos[3]) <= slotTolerance then
          slotOccupied = true
          break
        end
      end
    end

    if not slotOccupied then
      firstAvailableSlot = slotNum
      break
    end
  end
  if firstAvailableSlot == nil then
    local playerStr = getPlayerStr(playerColor)
    local broadcastStr = string.format("%s: Staging area full, Manually Resolve action.", playerStr)
    broadcastToAll(broadcastStr, "White")
    return
  end

  local rotCardPlacement = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 }
  local posCardPlacement = posStagingCard[firstAvailableSlot]

  cardObj.setRotation(rotCardPlacement)
  cardObj.setPosition(posCardPlacement)

  -- if required, place found action token
  if actionRequired then
    local rotToken = playerColor == "Blue" and { 0.00, 120.00, 0.00 } or { 0.00, 300.00, 0.00 }

    -- not a world position, each index is relational to cardObj
    local posToken = playerColor == "Blue" and { -1.44, 0.29, -1.04 } or { 1.44, 0.29, 1.04 }

    local tokenPos = {
      posCardPlacement[1] + posToken[1],
      posCardPlacement[2] + posToken[2],
      posCardPlacement[3] + posToken[3],
    }

    actionToken.setRotation(rotToken)
    actionToken.setPositionSmooth(tokenPos, false, true)
  end

  -- broadcast
  local playerStr = getPlayerStr(playerColor)
  if opType ~= "Support" then
    local actionText = actionRequired == true and getPlayAction(cardObj, opIndex) or getPlayNoAction(cardObj, opIndex)
    local broadcastStr = actionRequired == true and string.format("%s has spent an Action to perform %s Play Operation%s", playerStr, cardObj.getName(), actionText ~= nil and ": " .. actionText or ".") or
                                                    string.format("%s performs %s Actionless Play Operation%s", playerStr, cardObj.getName(), actionText ~= nil and ": " .. actionText or ".")
    broadcastToAll(broadcastStr, "White")
  elseif opType == "Support" then
    local actionText = getSupport(cardObj, opIndex)
    local broadcastStr = string.format("%s performs %s Support Operation%s", playerStr, cardObj.getName(), actionText ~= nil and ": " .. actionText or ".")

    broadcastToAll(broadcastStr, "White")
  end
end


function placeDeployCard(actionRequired, cardObj, opIndex)
  -- context menu helper that determines the next available deploy slot, places card
  -- locations deploy L-R on location pad
  -- encounters deploy R-L on location pad
  -- ships deploy L-R on ship pad
  -- cargo & directives deploy R-L on ship pad
  -- action parameter is boolean. true will first check for and place an available extra action token, then action token
  -- false will ignore action tokens

  local playerColor = getActualPlayerColor(cardObj)
  local isBot = checkPlayerColorIsBot(playerColor)

  -- first need to check for action token if action == true, broadcast unable to perform report if required and not found
  local actionToken
  if actionRequired then
    local checkZone = getObjectbyNameAndNotes("Zone Action Tokens", playerColor)

    -- check for and use extra action tokens first, then if not found, a regular action token
    for _, zoneObj in pairs(checkZone.getObjects()) do
      if zoneObj.getName() == "Extra Action Token" then
        actionToken = zoneObj
        break
      end
    end
    if actionToken == nil then
      for _, zoneObj in pairs(checkZone.getObjects()) do
        if zoneObj.getName() == "Action Token" then
          actionToken = zoneObj
          break
        end
      end
    end
    if actionToken == nil then
      -- broadcast unable to perform action
      local playerStr = getPlayerStr(playerColor)
      local broadcastStr = string.format("%s has no Action Tokens remaining, is unable to perform Operation.", playerStr)
      broadcastToAll(broadcastStr, "White")
      return
    end
  end

  local posLocationCard = playerColor == "Blue" and {
    { -30.00, 0.96, 2.46 },
    { -30.00, 0.96, -1.46 },
    { -30.00, 0.96, -5.38 },
    { -30.00, 0.96, -9.30 },
    { -30.00, 0.96, -13.20 },
    { -30.00, 0.96, -17.12 },
    { -30.00, 0.96, -21.04 },
  } or {
    { 30.00, 0.96, -2.46 },
    { 30.00, 0.96, 1.46 },
    { 30.00, 0.96, 5.38 },
    { 30.00, 0.96, 9.30 },
    { 30.00, 0.96, 13.20 },
    { 30.00, 0.96, 17.12 },
    { 30.00, 0.96, 21.04 },
  }

  local posShipCard = playerColor == "Blue" and {
    { -38.50, 0.96, 2.46 },
    { -38.50, 0.96, -1.46 },
    { -38.50, 0.96, -5.38 },
    { -38.50, 0.96, -9.30 },
    { -38.50, 0.96, -13.20 },
    { -38.50, 0.96, -17.12 },
    { -38.50, 0.96, -21.04 },
  } or {
    { 38.50, 0.96, -2.46 },
    { 38.50, 0.96, 1.46 },
    { 38.50, 0.96, 5.38 },
    { 38.50, 0.96, 9.30 },
    { 38.50, 0.96, 13.20 },
    { 38.50, 0.96, 17.12 },
    { 38.50, 0.96, 21.04 },
  }

  local cardPositions
  local deployZone
  local reverseSlots = false

  if cardObj.hasTag("suit_location") then
    cardPositions = posLocationCard
    deployZone = getObjectbyNameAndNotes("Zone Deploy Location", playerColor)
  elseif (cardObj.hasTag("suit_encounter") or cardObj.hasTag("suit_ally")) and
          cardObj.getName() ~= "Gomtuu" then
    cardPositions = posLocationCard
    deployZone = getObjectbyNameAndNotes("Zone Deploy Location", playerColor)
    reverseSlots = true
  elseif cardObj.hasTag("suit_ship") or cardObj.getName() == "Gomtuu" then
    cardPositions = posShipCard
    deployZone = getObjectbyNameAndNotes("Zone Deploy Ship", playerColor)
  elseif cardObj.hasTag("suit_cargo") or cardObj.hasTag("suit_directive") then
    cardPositions = posShipCard
    deployZone = getObjectbyNameAndNotes("Zone Deploy Ship", playerColor)
    reverseSlots = true
  else
    return
  end

  -- determine next available free slot in deploy area
  local slotTolerance = 0.50
  local firstAvailableSlot = nil

  if reverseSlots then
    for slotNum = #cardPositions, 1, -1 do
      local slotPos = cardPositions[slotNum]
      local slotOccupied = false

      for _, zoneObj in pairs(deployZone.getObjects()) do
        if zoneObj.type == "Card" then
          local cardZ = zoneObj.getPosition().z

          if math.abs(cardZ - slotPos[3]) <= slotTolerance then
            slotOccupied = true
            break
          end
        end
      end

      if not slotOccupied then
        firstAvailableSlot = slotNum
        break
      end
    end
  else
    for slotNum, slotPos in ipairs(cardPositions) do
      local slotOccupied = false

      for _, zoneObj in pairs(deployZone.getObjects()) do
        if zoneObj.type == "Card" then
          local cardZ = zoneObj.getPosition().z

          if math.abs(cardZ - slotPos[3]) <= slotTolerance then
            slotOccupied = true
            break
          end
        end
      end

      if not slotOccupied then
        firstAvailableSlot = slotNum
        break
      end
    end
  end

  if firstAvailableSlot == nil then
    local playerStr = getPlayerStr(playerColor)
    local broadcastStr = string.format("%s: Deploy area full, Manually Resolve action.", playerStr)
    broadcastToAll(broadcastStr, "White")
    return
  end

  local rotCardPlacement = playerColor == "Blue" and { 0.00, 270.00, 0.00 } or { 0.00, 90.00, 0.00 }
  if isBot then rotCardPlacement = playerColor == "Blue" and { 0.00, 90.00, 0.00 } or { 0.00, 270.00, 0.00 } end
  local posCardPlacement = cardPositions[firstAvailableSlot]

  cardObj.setRotation(rotCardPlacement)
  cardObj.setPosition(posCardPlacement)

  if actionRequired then
    local rotToken = playerColor == "Blue" and { 0.00, 120.00, 0.00 } or { 0.00, 300.00, 0.00 }

    -- not a world position, each index is relational to cardObj
    local posToken = playerColor == "Blue" and { -1.44, 0.29, -1.04 } or { 1.44, 0.29, 1.04 }

    local tokenPos = {
      posCardPlacement[1] + posToken[1],
      posCardPlacement[2] + posToken[2],
      posCardPlacement[3] + posToken[3],
    }

    actionToken.setRotation(rotToken)
    actionToken.setPositionSmooth(tokenPos, false, true)
  end

  -- broadcast
  local playerStr = getPlayerStr(playerColor)
  local opType = cardObj.hasTag("suit_location") and "Control" or "Deploy"
  local broadcastStr
  if isBot then
    broadcastStr = string.format("%s performs %s %s Operation.", playerStr, cardObj.getName(), opType)
    broadcastToAll(broadcastStr, "White")
    return
  end

  local actionText = (actionRequired == true) and getDeployAction(cardObj, opIndex) or getDeployNoAction(cardObj, opIndex)
  broadcastStr = actionRequired == true and string.format("%s has spent an Action to perform %s %s Operation%s", playerStr, cardObj.getName(), opType, actionText ~= nil and ": " .. actionText or ".") or
                                                  string.format("%s performs %s Actionless %s Operation%s", playerStr, cardObj.getName(), opType, actionText ~= nil and ": " .. actionText or ".")
  local controlText
  if cardObj.hasTag("suit_location") then
    controlText = getControlText(cardObj.getName())
  end
  if controlText ~= nil and not checkPlayerColorIsBot(playerColor) then
    Wait.time(function()

      local controlStr = string.format("Location Control Effect: %s", controlText)
      broadcastToAll(controlStr, "White")

    end, 1)
  end
end


function exhaustCardAction(actionRequired, playerColor, cardObj, opType, opIndex)
  -- handles the exhaust action of a card object

  local actionToken
  if actionRequired then
    local checkZone = getObjectbyNameAndNotes("Zone Action Tokens", playerColor)

    -- check for and use extra action tokens first, then if not found, a regular action token
    for _, zoneObj in pairs(checkZone.getObjects()) do
      if zoneObj.getName() == "Extra Action Token" then
        actionToken = zoneObj
        break
      end
    end
    if actionToken == nil then
      for _, zoneObj in pairs(checkZone.getObjects()) do
        if zoneObj.getName() == "Action Token" then
          actionToken = zoneObj
          break
        end
      end
    end
    if actionToken == nil then
      -- broadcast unable to perform action
      local playerStr = getPlayerStr(playerColor)
      local broadcastStr = string.format("%s has no Action Tokens remaining, is unable to perform Operation.", playerStr)
      broadcastToAll(broadcastStr, "White")
      return
    end
  end

  local rotInitial = cardObj.getRotation()
  local rotExhausted = rotInitial

  if not cardObj.hasTag("currentDutyOfficer") then
    rotExhausted = playerColor == "Blue" and { 0.00, 315.00, 0.00 } or { 38.50, 0.96, -2.51 }
  elseif cardObj.hasTag("currentDutyOfficer") then
    rotExhausted = playerColor == "Blue" and { 0.00, 225.00, 0.00 } or { 0.00, 45.00, 0.00 }
  end

  cardObj.setRotationSmooth(rotExhausted, false, true)

  -- handle the removal of any activation/reaction etc actions
  -- leave dismiss, log, return (will need refresh on end turn refresh)
  cardObj.clearContextMenu()

  if not cardObj.hasTag("suit_captain") then
    cardObj.addContextMenuItem("Refresh Card", refreshCard)

    cardObj.addContextMenuItem("Dismiss Card", dismissViaContext)

    if cardObj.hasTag("marketCard") or cardObj.hasTag("suit_incident") or cardObj.hasTag("suit_encounter") then
      cardObj.addContextMenuItem("Return Card", returnMarketCardViaContext)
    end

    cardObj.addContextMenuItem("Log Card", logCardViaContext)
  end

  -- place action token if required
  if actionRequired then
    local rotToken = playerColor == "Blue" and { 0.00, 120.00, 0.00 } or { 0.00, 300.00, 0.00 }

    -- not a world position, each index is relational to cardObj
    local posToken = playerColor == "Blue" and { -1.44, 0.29, -1.04 } or { 1.44, 0.29, 1.04 }

    local posCard = cardObj.getPosition()
    local tokenPos = {
      posCard[1] + posToken[1],
      posCard[2] + posToken[2],
      posCard[3] + posToken[3],
    }

    actionToken.setRotation(rotToken)
    actionToken.setPositionSmooth(tokenPos, false, true)
  end

  local playerStr = getPlayerStr(playerColor)

  if opType ~= "Reaction" then
    local actionText = actionRequired == true and getActivationAction(cardObj, opIndex) or getActivation(cardObj, opIndex)
    local broadcastStr = actionRequired == true and string.format("%s spends an Action to perform %s Activation Operation%s", playerStr, cardObj.getName(), actionText ~= nil and ": " .. actionText or ".") or
                                                    string.format("%s performs %s Activation Operation%s", playerStr, cardObj.getName(), actionText ~= nil and ": " .. actionText or ".")
    broadcastToAll(broadcastStr, "White")

  elseif opType == "Reaction" then
    local actionText = getReaction(cardObj, opIndex)
    local broadcastStr = string.format("%s performs %s Reaction Operation%s", playerStr, cardObj.getName(), actionText ~= nil and ": " .. actionText or ".")

    broadcastToAll(broadcastStr, "White")
  end
end


function playAction(_, _, cardObj)
  -- handles the broadcast report of selected card's play requiring an action

  placeStagingCard(true, "Play", cardObj, 1)

end


function playAction2(_, _, cardObj)
  -- handles the broadcast report of selected card's second play requiring an action

  placeStagingCard(true, "Play", cardObj, 2)

end


function playAction3(_, _, cardObj)
