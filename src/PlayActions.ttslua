function getDeployAction(cardObj, opIndex)
  -- handles detection and return of report text of actionless deploy operations
  local cardName = cardObj.getName()
  local attackColor = Color.fromString("Red"):toHex()
  local index = "deployAction" .. tostring(opIndex)

  local deployActionText = {

    -- base game cargo
    ["Cloaking Device"] = {
      ["deployAction1"] = "Refresh up to 3 of your Ship. Draw 2 cards. Junk a card from the Market. Deploy this card.",
    },
    ["Forced Singularity"] = {
      ["deployAction1"] = "You may discard a card to find an Engineer or Ops. Junk a card from the Market. Spend 2 Dilithium to deploy this card.",
    },
    ["Horta"] = {
      ["deployAction1"] = "Junk a card from the Market. You may log an Attack to enlist a Development. Deploy this card.",
    },

    -- base game ship
    ["Bird-of-Prey"] = {
      ["deployAction1"] = "Deploy this ship. You may discard a card to send an Away Team to a Location, ignoring any opponent Ship. If the discarded card is Imperial, gain 1 Glory.",
    },
    ["D'Kyr Cruiser"] = {
      ["deployAction1"] = "Deploy and warp this ship. You may discard a card to gain 1 Research.",
      ["deployAction2"] = "Deploy and warp this ship. You may send an Away Team to this ship's Location.",
    },
    ["K't'inga Battlecruiser"] = {
      ["deployAction1"] = "Deploy this ship. You may send an Away Team to a Location.",
    },
    ["Kazon Raider"] = {
      ["deployAction1"] = string.format("[%s](Attack)[-] Deploy this ship. Force your opponent to discard a card. You may discard a card to gain 1 Latinum.", attackColor),
    },
    ["Pakled Freighter"] = {
      ["deployAction1"] = "Deploy this ship. You may gain a Cargo from the Junk. If the gained card is Weapon or Anomaly, gain 1 Military.",
    },
    ["Son'a Battlecruiser"] = {
      ["deployAction1"] = string.format("[%s](Attack)[-] Deploy this ship. Steal 1 Dilithium.", attackColor),
      ["deployAction2"] = string.format("[%s](Attack)[-] Deploy this ship. Steal 2 Dilithium. Force your opponent to discard a card.", attackColor),
    },
    ["U.S.S. Enterprise-C"] = {
      ["deployAction1"] = "Deploy this ship. Up to twice: beam a card here OR warp this ship. Exhaust this ship.",
    },
    ["U.S.S. Pasteur"] = {
      ["deployAction1"] = "Deploy this ship. You may free play a Communication or Doctor.",
    },
    ["U.S.S. Reliant"] = {
      ["deployAction1"] = "Deploy and warp this ship.",
    },
    ["Voth Research Vessel"] = {
      ["deployAction1"] = "Discard a card to deploy and warp this ship.",
    },
    ["Xindi-Reptilian Battleship"] = {
      ["deployAction1"] = "Deploy this ship. You may gain a Cargo. If the gained card is Weapon, beam it here and gain 1 Glory.",
      ["deployAction2"] = "Deploy this ship. Gain 1 Glory per Time Travel you have in play (max 3).",
    },

    -- 2nd contact cargo
    ["Gift Box"] = {
      ["deployAction1"] = "Deploy this card. You may discard a card to gain a Cargo.",
    },

    -- 2nd contact ship
    ["R.I.S. Talvath"] = {
      ["deployAction1"] = "Deploy this ship. You may warp this ship.",
    },

    -- TBG cargo
    ["Augmentation Plague"] = {
      ["deployAction1"] = "Spend 3 Dilithium and 1 Latinum to deploy this card. Gain 2 Military. If your Captain is Klingon take an Incident to draw 3 cards.",
    },
    ["Borg Spatial Trajector"] = {
