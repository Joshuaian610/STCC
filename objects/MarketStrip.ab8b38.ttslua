function stardate_location_wipe()
    -- perform stardate location wipe
    -- will need to check all NZs for tokens present, don't wipe those
    local checkzones_top    = {getObjectFromGUID("eaec24"), getObjectFromGUID("817308")}
    local checkzones_middle = {getObjectFromGUID("3c477c"), getObjectFromGUID("a0256f")}
    local checkzones_bottom = {getObjectFromGUID("ba30f9"), getObjectFromGUID("758ef4")}
    local zone_loc_top      = getObjectFromGUID("65beaa")
    local zone_loc_middle   = getObjectFromGUID("429b74")
    local zone_loc_bottom   = getObjectFromGUID("8e265f")
    local pos_top           = {0.00, 1.50, -7.00}
    local pos_middle        = {0.00, 1.50, -14.00}
    local pos_bottom        = {0.00, 1.50, -21.00}
    local zone_new_locs     = getObjectFromGUID("97d9f0")
    for i = 1, 3 do
        if i == 1 then
            wait_timer = 0
        elseif i == 2 then
            wait_timer = .5
        elseif i == 3 then
            wait_timer = 1
        end
        Wait.time(function()
        local checkzones    = nil
        local zone_loc      = nil
        local position      = nil
        local need_replace  = true
        if i == 1 then
            checkzones      = checkzones_top
            zone_loc        = zone_loc_top
            position        = pos_top
        elseif i == 2 then
            checkzones      = checkzones_middle
            zone_loc        = zone_loc_middle
            position        = pos_middle
        elseif i == 3 then
            checkzones      = checkzones_bottom
            zone_loc        = zone_loc_bottom
            position        = pos_bottom
        end
        for j = 1, 2 do
            for _, object in pairs(checkzones[j].getObjects()) do
                if object.hasTag('snap_ship') or object.hasTag('away_blue') or object.hasTag('away_red') then
                    need_replace = false
                end
            end
        end
        if need_replace then
            local outgoing_card_name = nil
            local replace_card_name  = nil
            local replacement_found  = false
            -- discard outgoing_card
            for _, object in pairs(zone_loc.getObjects()) do
                if object.tag == "Card" then
                    object.setRotation({0.00, 180.00, 0.00})
                    object.setPositionSmooth({-12.50, 1.50, 12.00}, false, false)
                    outgoing_card_name = object.getName()
                end
            end
            -- replace if possible
            for _, object in pairs(zone_new_locs.getObjects()) do
                if object.tag == "Deck" then
                    local replace_card = object.takeObject()
                    replace_card.setRotation({0.00, 180.00, 0.00})
                    replace_card.setPositionSmooth(position, false, false)
                    replace_card_name = replace_card.getName()
                    replacement_found = true
                    break
                elseif object.tag == "Card" then
                    local replace_card = object
                    replace_card.setRotation({0.00, 180.00, 0.00})
                    replace_card.setPositionSmooth(position, false, false)
                    replace_card_name = replace_card.getName()
                    replacement_found = true
                    break
                end
            end
            if replacement_found then
                broadcastToAll("[" .. Color.fromString("Green"):toHex() .. "]Location[-]: " ..outgoing_card_name .. " has been discarded via [" .. Color.fromString("Yellow"):toHex() .. "]Stardate Card[-], and replaced with " .. replace_card_name .. ".", "White")
            else
                broadcastToAll("[" .. Color.fromString("Green"):toHex() .. "]Location[-]: " ..outgoing_card_name .. " has been discarded via [" .. Color.fromString("Yellow"):toHex() .. "]Stardate Card[-], there was no replacement Location.", "White")
            end
        end
        end, wait_timer)
    end
end -- end stardate_location_wipe()

function stardate_market_wipe()
    -- perform stardate market wipe
    local card_zones = {
        getObjectFromGUID("7d6590"),
        getObjectFromGUID("ac4301"),
        getObjectFromGUID("489f00"),
        getObjectFromGUID("2edc6f"),
    }
    local deck_zones = {
        getObjectFromGUID("99a16f"),
        getObjectFromGUID("4eadea"),
        getObjectFromGUID("1a337a"),
        getObjectFromGUID("68e891"),
    }
    -- will need to junk and replace on all 4 simultaneously,
    for i = 1, 4 do
        for _, object in pairs(card_zones[i].getObjects()) do
            if object.tag == "Card" then
                object.setRotation({0.00, 180.00, 0.00})
                object.setPositionSmooth({-12.50, 1.50, 12.00})
            end
            if string.find(object.getName(), "Token") then
                object.destruct()
            end
        end
        local position = {-7.50, 1.50, 6.00}
        if i == 2 then
            position   = {-2.50, 1.50, 6.00}
        elseif i == 3 then
            position   = {2.50, 1.50, 6.00}
        elseif i == 4 then
            position = {7.50, 1.50, 6.00}
        end
        for _, object in pairs(deck_zones[i].getObjects()) do
            local replacement = nil
            if object.tag == "Deck" then
                replacement = object.takeObject()
                replacement.setRotation({0.00, 180.00, 0.00})
                replacement.setPositionSmooth(position, false, false)
                break
            elseif object.tag == "Card" then
                replacement = object
                replacement.setRotation({0.00, 180.00, 0.00})
                replacement.setPositionSmooth(position, false, false)
                break
            end
        end
    end
    broadcastToAll("The Market has been Wiped according to the [" .. Color.fromString("Yellow"):toHex() .. "]Stardate Card[-]. ", "White")
end -- end stardate_market_wipe()


