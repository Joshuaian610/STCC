end -- close_ui_blue()
function close_ui_red()
    UI.hide("red_andorian_panel")
    UI.hide("red_klingon_panel")
    UI.hide("red_romulan_panel")
    UI.hide("red_starfleet_panel")
    UI.hide("ui_hide_red")
    UI.hide("ui_show_red")
    UI.hide("bot_controls")
end -- close_ui_red()


function hide_ui_blue()
    UI.hide("blue_andorian_panel")
    UI.hide("blue_klingon_panel")
    UI.hide("blue_romulan_panel")
    UI.hide("blue_starfleet_panel")
    UI.hide("ui_hide_blue")
    UI.hide("bot_controls")
    UI.setAttribute("ui_show_blue", "active", "True")
end -- end hide_ui_blue()
function hide_ui_red()
    UI.hide("red_andorian_panel")
    UI.hide("red_klingon_panel")
    UI.hide("red_romulan_panel")
    UI.hide("red_starfleet_panel")
    UI.hide("ui_hide_red")
    UI.hide("bot_controls")
    UI.setAttribute("ui_show_red", "active", "True")
end -- end hide_ui_red()


function show_ui_blue()
    local captain_zone           = getObjectFromGUID("75465f")
    local captain_pad            = getObjectFromGUID("997491")
    for _, object in pairs(captain_zone.getObjects()) do
        if string.find(object.getName(), "Crew Board") and object ~= captain_pad then
            captain_card_name    = object.getName()
        end
    end
    local captain_name           = nil
    local split_name             = {}
    if captain_card_name        ~= nil then
        for str in string.gmatch(captain_card_name,  "%S+") do
            table.insert(split_name, str)
        end
    end
    captain_name = split_name[1]
    if captain_name == "Burnham" or captain_name == "Picard" or captain_name == "Sisko" then
        UI.setAttribute("blue_starfleet_panel", "active", "true")
    elseif captain_name == "Shran" then
        UI.setAttribute("blue_andorian_panel", "active", "true")
    elseif captain_name == "Sela" then
        UI.setAttribute("blue_romulan_panel", "active", "true")
    elseif captain_name == "Koloth" then
        UI.setAttribute("blue_klingon_panel", "active", "true")
    end
    UI.hide("ui_show_blue")
    UI.show("ui_hide_blue")
    if getObjectFromGUID("1a78a6").getGMNotes() == "solo" then
        UI.show("bot_controls")
    end
end -- end show_ui_blue()
function show_ui_red()
    local captain_zone           = getObjectFromGUID("75c041")
    local captain_pad            = getObjectFromGUID("28a24b")
    for _, object in pairs(captain_zone.getObjects()) do
        if string.find(object.getName(), "Crew Board") and object ~= captain_pad then
            captain_card_name    = object.getName()
        end
    end
    local captain_name           = nil
    local split_name             = {}
    if captain_card_name        ~= nil then
        for str in string.gmatch(captain_card_name,  "%S+") do
            table.insert(split_name, str)
        end
    end
    captain_name = split_name[1]
    if captain_name == "Burnham" or captain_name == "Picard" or captain_name == "Sisko" then
        UI.setAttribute("red_starfleet_panel", "active", "true")
    elseif captain_name == "Shran" then
        UI.setAttribute("red_andorian_panel", "active", "true")
    elseif captain_name == "Sela" then
        UI.setAttribute("red_romulan_panel", "active", "true")
    elseif captain_name == "Koloth" then
        UI.setAttribute("red_klingon_panel", "active", "true")
    end
    UI.hide("ui_show_red")
    UI.show("ui_hide_red")
    if getObjectFromGUID("23bed4").getGMNotes() == "solo" then
        UI.show("bot_controls")
    end
end -- end show_ui_red()


function broadcast_playerturn()
    broadcastToAll("This button is currently inactive, it is simply a reminder that it is your turn. Use the 'Add Resource' buttons in the market row to place a resource and end your turn.", "Orange")
    return
end -- end broadcast_playerturn()


function discard_hand_blue()
    UI.hide('discard_hand_blue')
    Wait.time(function() UI.show('discard_hand_blue') end, 1)
    discard_hand({color="Blue"})
end -- end discard_hand_blue()

function discard_hand_red()
    UI.hide('discard_hand_red')
    Wait.time(function() UI.show('discard_hand_red') end, 1)
    discard_hand({color="Red"})
end -- end discard_hand_red()

function discard_hand(args)
    local color        = args.color
    local hand_objects = getObjectFromGUID(color == "Blue" and "73058e" or "72070a").getObjects()
    for i = 1, #hand_objects do
        hand_objects[i].setRotation(color == "Blue" and {0.00, 270.00, 0.00} or {0.00, 90.00, 0.00})
        hand_objects[i].setPosition(color == "Blue" and {-44.57, 1.50, -21.00} or {44.57, 1.50, 21.00}, false, false)
    end
end -- end discard_hand()

-- **** STARDATE CARD FUNCTIONS ****

function stardate_card_button_create(args)
    local card          = args.card
    local type          = args.type -- types: "Market Only", "Both", "Endgame", "Discard"
    local color         = args.color
    local button_color  = color == "Blue" and {31/255, 136/255, 255/255, .8} or {219/255, 26/255, 24/255, .8}
    local hover_color   = color == "Blue" and {31/255, 136/255, 255/255, .6} or {219/255, 26/255, 24/255, .6}
    local click_func    = nil
    local button_pos    = nil
    local button_width  = 920
    local button_height = nil
    local tooltip       = nil
    if type            == "Market Only" then
        click_func      = "button_stardate_market_wipe"
        button_pos      = {0.04, 0.25, -0.24}
        button_height   = 420
        tooltip         = "Click this button to perform Stardate Market Wipe, and discard this card."
    elseif type        == "Both" then
        click_func      = "button_stardate_both_wipe"
        button_pos      = {0.04, 0.25, -0.24}
        button_height   = 560
        tooltip         = "Click this button to perform Stardate Market and Location Wipe, and discard this card."
    elseif type        == "Endgame" then
        click_func      = "button_stardate_trigger_endgame"
        button_pos      = {0.04, 0.25, -0.24}
        button_height   = 260
        tooltip         = "Click this button to trigger End Of Game."
    elseif type        == "Discard" then
        click_func      = "button_stardate_discard"
        button_pos      = {0.04, 0.25, -0.24}
        button_height   = 560
        tooltip         = "Click this button to discard this Stardate Card."
    end
    if string.find(card.getName(), "Solo Cadet Practice") then
        button_pos = {0.04, 0.25, -0.34}
    end
    card.createButton({
        click_function  = click_func,
        function_owner  = self,
        label           = "",
        position        = button_pos,
        rotation        = {0, 180, 0},
        width           = button_width,
        height          = button_height,
        color           = button_color,
        hover_color     = hover_color,
        tooltip         = tooltip,
    })
end -- end stardate_card_button_create()


