function stardate_trigger_endgame()
    -- determine if it's currently 1P's turn or 2P's turn,
    -- to, determine how many rounds are left
    -- broadcast that end of game has been triggered, and how many rounds are left for who
    broadcastToAll("[" .. Color.fromString("Yellow"):toHex() .. "]Final Stardate Card and End of Game[-] have been triggered! Finish remaining rounds, and use the Calcuate Score button under Score Sheets when finished.", "White")
    -- deploy score sheets & buttons
    local bag = getObjectFromGUID("f6e30d")
    local blue_sheet  = bag.takeObject({guid="276508"})
    blue_sheet.interactable = false
    blue_sheet.setLock(true)
    blue_sheet.setRotation({0.00, 270.00, 0.00})
    blue_sheet.setPosition({-38.50, 1.70, -27.80}, false, false)
    local blue_button = bag.takeObject({guid="698936"})
    blue_button.interactable = false
    blue_button.setLock(true)
    blue_button.setRotation({0.00, 270.00, 0.00})
    blue_button.setPosition({-42.65, 1.70, -27.80}, false, false)
    local red_sheet   = bag.takeObject({guid="6931ee"})
    red_sheet.interactable = false
    red_sheet.setLock(true)
    red_sheet.setRotation({0.00, 90.00, 0.00})
    red_sheet.setPosition({38.50, 1.70, 27.80}, false, false)
    local red_button  = bag.takeObject({guid="3c8845"})
    red_button.interactable = false
    red_button.setLock(true)
    red_button.setRotation({0.00, 90.00, 0.00})
    red_button.setPosition({42.65, 1.70, 27.80}, false, false)
    local counter     = getObjectFromGUID("b7d51f")
    local counter_pos = counter.getPosition()
    counter_pos.y     = -2
    counter.setPosition(counter_pos)
    counter.flip()
end -- end stardate_trigger_endgame()



-- **** SOLO HELPER FUNCTIONS ****

function bot_deck_draw(args)
    local bot_color, _ = get_colors()
    local deal_count = args.deal_count
    local bot_deck = get_bot_deck()
    local deal_rotation = bot_color == "Blue" and {0, 90, 180} or {0, 270, 180}
    local deal_locations = bot_color == "Blue" and {
        {-44.50, 0.96, 2.80}, {-44.50, 0.96, -1.07}, {-44.50, 0.96, -4.98},
        {-44.50, 0.96, -8.90}, {-44.50, 0.96, -12.82},
    } or {
        {44.50, 0.96, -2.80}, {44.50, 0.96, 1.07}, {44.50, 0.96, 4.98},
        {44.50, 0.96, 8.90}, {44.50, 0.96, 12.82},
    }

    local deck_count = bot_deck and (bot_deck.tag == "Deck" and #bot_deck.getObjects() or 1) or 0
    local to_draw_now = math.min(deal_count, deck_count)

    -- Draw as many as possible from the current deck
    for i = 1, to_draw_now do
        local card
        if bot_deck.tag == "Deck" then
            card = bot_deck.takeObject({rotation = deal_rotation})
        else
            card = bot_deck
            bot_deck = nil
        end
        card.setPositionSmooth(deal_locations[i], false, false)
    end

    local remaining = deal_count - to_draw_now

    if remaining > 0 then
        -- Disable UI while refreshing
        UI.setAttribute("bot_controls", "active", "false")
        Wait.time(function()
            bot_deck_refresh(to_draw_now + 1, remaining, deal_rotation, deal_locations, deal_count)
        end, 0.5)
    else
        broadcastToAll("[" .. Color.fromString(bot_color):toHex() .. "]Bot[-] has dealt itself " .. deal_count .. " facedown cards.", "White")
    end
end



function bot_deck_discard()
    UI.hide('bot_discard')

    local function show_ui_delayed()
        Wait.time(function() UI.show('bot_discard') end, 1)
    end

    local bot_color, _    = get_colors()
    local discard_zone    = getObjectFromGUID(bot_color == "Blue" and "fbfe84" or "b72553")
    local discard_pad     = getObjectFromGUID(bot_color == "Blue" and "3accb4" or "34adac")
    local draw_zone       = getObjectFromGUID(bot_color == "Blue" and "58f8ce" or "5e07a8")
    local supplement_zone = getObjectFromGUID(bot_color == "Blue" and "30a2e2" or "b75338")
    local discard_card    = nil
    local draw_deck       = nil

    for _, obj in pairs(draw_zone.getObjects()) do
        if obj.tag == "Deck" then
            draw_deck = obj
            break
        end
        if obj.tag == "Card" then
            draw_deck = obj
            break
        end
    end

    if draw_deck then
        local deck_count = 0
        if draw_deck.tag == "Deck" then
            deck_count = #draw_deck.getObjects()
        else
            deck_count = 1
        end

        if deck_count > 1 then
            discard_card = draw_deck.takeObject()
        else
            for _, obj in pairs(draw_zone.getObjects()) do
                if obj.tag == "Card" then
                    discard_card = obj
                    break
                end
            end
        end

        if discard_card then
            discard_card.setRotation(bot_color == "Blue" and {0.00, 90.00, 0.00} or {0.00, 270.00, 0.00})
            discard_card.setPositionSmooth(bot_color == "Blue" and {-44.57, 1.50, -21.00} or {44.57, 1.50, 21.00}, false, false)
            broadcastToAll("[" .. Color.fromString(bot_color):toHex() .. "]Bot[-] has discarded a card off the top of its deck: " .. discard_card.getName(), "White")
        end

        show_ui_delayed()

    else
        discard_pad.call('refresh_draw_deck', {deal_count=0, alt_click=true})

        Wait.time(function()
        local supplement_deck = nil
        for _, obj in ipairs(supplement_zone.getObjects()) do
            if obj.tag == "Deck" then
                supplement_deck = obj
                break
            elseif obj.tag == "Card" then
                discard_card = obj
                break
            end
        end

        if supplement_deck then
            discard_card = supplement_deck.takeObject()
        elseif not discard_card then
            discard_card = get_bot_deck().takeObject()
        end

        if discard_card then
            discard_card.setRotation(bot_color == "Blue" and {0.00, 90.00, 0.00} or {0.00, 270.00, 0.00})
            discard_card.setPositionSmooth(bot_color == "Blue" and {-44.57, 1.50, -21.00} or {44.57, 1.50, 21.00}, false, false)
            broadcastToAll("[" .. Color.fromString(bot_color):toHex() .. "]Bot[-] has discarded a card off the top of its deck: " .. discard_card.getName(), "White")
        end

        show_ui_delayed()
        end, 0.5)
    end
end -- end bot_deck_discard()



function bot_discard_three()
    UI.hide('bot_discard_x3')

    local bot_color, _    = get_colors()
    local discard_zone    = getObjectFromGUID(bot_color == "Blue" and "fbfe84" or "b72553")
    local discard_pad     = getObjectFromGUID(bot_color == "Blue" and "3accb4" or "34adac")
    local draw_zone       = getObjectFromGUID(bot_color == "Blue" and "58f8ce" or "5e07a8")
    local supplement_zone = getObjectFromGUID(bot_color == "Blue" and "30a2e2" or "b75338")
    local discard_card    = nil
    local draw_deck       = nil

    local discard_count = 0

    local function show_ui_delayed()
        Wait.time(function()
        UI.show('bot_discard_x3')
        end, 1)
    end

    local function discard_single_card()
        local discard_card = nil
        for _, obj in pairs(draw_zone.getObjects()) do
            if obj.type == "Deck" then
                discard_card = obj.takeObject()
                break
            elseif obj.type == "Card" then
                discard_card = obj
                break
            end
        end
        if discard_card ~= nil then
            discard_card.setRotation(bot_color == "Blue" and {0.00, 90.00, 0.00} or {0.00, 270.00, 0.00})
            discard_card.setPositionSmooth(bot_color == "Blue" and {-44.57, 1.50, -21.00} or {44.57, 1.50, 21.00}, false, false)
            broadcastToAll("[" .. Color.fromString(bot_color):toHex() .. "]Bot[-] has discarded a card: " .. discard_card.getName(), "White")
        end
    end

    local function refresh_and_discard_from_supplemental(callback)
        Wait.time(function()
        local checkzone  = getObjectFromGUID(bot_color == "Blue" and "fbfe84" or "b72553")
        local draw_loc   = {44.50, 1.20, -7.00}
        local deck       = nil
        local deck_found = false
        local is_solo    = getObjectFromGUID(bot_color == "Blue" and "23bed4" or "1a78a6").getGMNotes() == "solo"
        local rotation   = is_solo and {0.00, 270.00, 180.00} or {0.00, 90.00, 180.00}

        for _, object in pairs(checkzone.getObjects()) do
            if object.tag == "Deck" or object.tag == "Card" then
                deck = object
                deck_found = true
                deck.setName('Draw Deck')
                deck.setRotationSmooth(rotation, false, false)
                Wait.time(function()
                deck.shuffle()
                deck.setPositionSmooth(draw_loc, false, false)
                end, 0.5)
            end
        end

        Wait.time(function()
        local supplement_deck = nil
        for _, obj in ipairs(supplement_zone.getObjects()) do
            if obj.type == "Deck" then
                supplement_deck = obj
                break
            elseif obj.type == "Card" then
                discard_card = obj
                break
            end
        end

        if supplement_deck then
            discard_card = supplement_deck.takeObject()
        elseif not discard_card then
            discard_card = get_bot_deck().takeObject()
        end

        if discard_card then
            discard_card.setRotation(bot_color == "Blue" and {0.00, 90.00, 0.00} or {0.00, 270.00, 0.00})
            discard_card.setPositionSmooth(bot_color == "Blue" and {-44.57, 1.50, -21.00} or {44.57, 1.50, 21.00}, false, false)
            broadcastToAll("[" .. Color.fromString(bot_color):toHex() .. "]Bot[-] has discarded a card from Supplemental Deck: " .. discard_card.getName(), "White")
        end

        discard_count = discard_count + 1
        if discard_count < 3 then
            Wait.time(discard_loop, 1)
        else
            show_ui_delayed()
        end
        end, 0.5)
        end, 1)
    end

    function discard_loop()
        local draw_deck_empty = true
        for _, obj in pairs(draw_zone.getObjects()) do
            if obj.type == "Deck" or obj.type == "Card" then
                draw_deck_empty = false
                break
            end
        end

        if draw_deck_empty then
            refresh_and_discard_from_supplemental()
        else
            discard_single_card()
            discard_count = discard_count + 1
            if discard_count < 3 then
                Wait.time(discard_loop, 1)
            else
                show_ui_delayed()
            end
        end
    end

    discard_loop()
end -- end bot_discard_three()


function bot_deck_log()
    UI.hide('bot_log')
    local bot_color, _    = get_colors()
    local bag_log         = getObjectFromGUID(bot_color == "Blue" and "973d0b" or "3f15f8")
    local discard_zone    = getObjectFromGUID(bot_color == "Blue" and "fbfe84" or "b72553")
    local discard_pad     = getObjectFromGUID(bot_color == "Blue" and "3accb4" or "34adac")
    local draw_zone       = getObjectFromGUID(bot_color == "Blue" and "58f8ce" or "5e07a8")
    local supplement_zone = getObjectFromGUID(bot_color == "Blue" and "30a2e2" or "b75338")
    local discard_card    = nil
    local draw_deck       = nil

    for _, obj in pairs(draw_zone.getObjects()) do
        if obj.tag == "Deck" or obj.tag == "Card" then
            draw_deck = obj
            break
        end
    end

    if draw_deck then
        local deck_count = (draw_deck.tag == "Deck") and #draw_deck.getObjects() or 1

        if deck_count > 1 then
            discard_card = draw_deck.takeObject()
        else
            for _, obj in pairs(draw_zone.getObjects()) do
                if obj.tag == "Card" then
                    discard_card = obj
                    break
                end
            end
        end

        if discard_card and discard_card.hasTag('suit_incident') then
            discard_card.setRotation({0.00, 180.00, 0.00})
            discard_card.setPositionSmooth({12.50, 1.50, 4.00}, false, false)
            broadcastToAll("[" .. Color.fromString(bot_color):toHex() .. "]Bot[-] deck top card is an [" .. Color.fromString("Red"):toHex() .. "]Incident[-] - bot has returned [" .. Color.fromString("Red"):toHex() .. "]Incident: [-] " .. discard_card.getName() .. " instead of logging it.", "White")
            Wait.time(function() UI.show('bot_log') end, 1)
            return nil
        end

        if discard_card then
            broadcastToAll("[" .. Color.fromString(bot_color):toHex() .. "]Bot[-] Bot has logged a card off the top of its deck: " .. discard_card.getName(), "White")
            bag_log.putObject(discard_card)
        end

        Wait.time(function() UI.show('bot_log') end, 1)
    else
        discard_pad.call('refresh_draw_deck', {deal_count=0, alt_click=true})

        Wait.time(function()
        local supplement_deck = nil
        for _, obj in ipairs(supplement_zone.getObjects()) do
            if obj.tag == "Deck" then
                supplement_deck = obj
                break
            elseif obj.tag == "Card" then
                discard_card = obj
                break
            end
        end

        if supplement_deck then
            discard_card = supplement_deck.takeObject()
        elseif not discard_card then
            discard_card = get_bot_deck().takeObject()
        end

        if discard_card and discard_card.hasTag('suit_incident') then
            discard_card.setRotation({0.00, 180.00, 0.00})
            discard_card.setPositionSmooth({12.50, 1.50, 4.00}, false, false)
            broadcastToAll("[" .. Color.fromString(bot_color):toHex() .. "]Bot[-] deck top card is an [" .. Color.fromString("Red") .. "]Incident[-] - bot has returned [" .. Color.fromString("Red") .. "]Incident[-]: " .. discard_card.getName() .. " instead of logging it.", "White")
            Wait.time(function() UI.show('bot_log') end, 1)
            return
        end

        if discard_card then
            broadcastToAll("[" .. Color.fromString(bot_color):toHex() .. "]Bot[-] has logged a card off the top of its deck: " .. discard_card.getName(), "White")
            bag_log.putObject(discard_card)
        end

        Wait.time(function() UI.show('bot_log') end, 1)
        end, 0.5)
    end
end -- end bot_deck_log()



function bot_deck_refresh(next_slot, remaining_deal_count, deal_rotation, deal_locations, deal_count)
    local bot_color, _ = get_colors()
    local discard_pad = getObjectFromGUID(bot_color == "Blue" and "3accb4" or "34adac")
    discard_pad.call('refresh_draw_deck', {deal_count=remaining_deal_count, alt_click=true})

    Wait.time(function()
    local supplement_zone = getObjectFromGUID(bot_color == "Blue" and "30a2e2" or "b75338")
    local supplement_deck = nil

    if supplement_zone then
        for _, obj in ipairs(supplement_zone.getObjects()) do
            if obj.tag == "Deck" or obj.tag == "Card" then
                supplement_deck = obj
                break
            end
        end
    end

    if supplement_deck then
        local card
        if supplement_deck.tag == "Deck" then
            card = supplement_deck.takeObject({rotation = deal_rotation})
        else
            card = supplement_deck
        end
        card.setPositionSmooth(deal_locations[next_slot], false, false)
        next_slot = next_slot + 1
        remaining_deal_count = remaining_deal_count - 1
    end
    end, 0.5)

    Wait.time(function()
    local bot_deck = get_bot_deck()

    if bot_deck then
        if bot_deck.tag == "Card" then
            bot_deck.setRotation(deal_rotation)
            bot_deck.setPositionSmooth(deal_locations[next_slot], false, false)
            remaining_deal_count = remaining_deal_count - 1
            next_slot = next_slot + 1
        elseif bot_deck.tag == "Deck" then
            local deck_count = #bot_deck.getObjects()
            local to_draw = math.min(deck_count, remaining_deal_count)
            for i = 0, to_draw - 1 do
                local card = bot_deck.takeObject({rotation = deal_rotation})
                card.setPositionSmooth(deal_locations[next_slot + i], false, false)
            end
            next_slot = next_slot + to_draw
            remaining_deal_count = remaining_deal_count - to_draw
        end

        if remaining_deal_count > 0 then
            Wait.time(function()
            bot_deck_refresh(next_slot, remaining_deal_count, deal_rotation, deal_locations, deal_count)
            end, 0.5)
        else
            broadcastToAll("[" .. Color.fromString(bot_color):toHex() .. "]Bot[-] has finished dealing " .. deal_count .. " facedown cards.", "White")
            UI.setAttribute("bot_controls", "active", "true")
        end
    else
        broadcastToAll("[" .. Color.fromString(bot_color):toHex() .. "]Bot[-] attempted to refresh its deck, but the refreshed draw deck is empty.", "White")
        UI.setAttribute("bot_controls", "active", "true")
    end
    end, 1)
end




function bot_gain_glory()
    local bot_color, _ = get_colors()
    local counter      = getObjectFromGUID(bot_color == "Blue" and "d96ce2" or "9a5066")
    counter.call('increase')
end -- end bot_gain_glory()


function bot_take_incident()
    UI.hide('bot_incident')
    local bot_color, _ = get_colors()
    local incident_zone = getObjectFromGUID("13c103")
    local deal_rotation = bot_color == "Blue" and {0.00, 90.00, 180.00} or {0.00, 270.00, 180.00}
    local deal_position = bot_color == "Blue" and {-44.50, 1.50, 7.00} or {44.50, 1.50, -7.00}
    for _, object in pairs(incident_zone.getObjects()) do
        if object.tag == "Deck" then
            broadcastToAll("[" .. Color.fromString(bot_color):toHex() .. "]Bot[-] has taken an [" .. Color.fromString("Red"):toHex() .. "]Incident[-].", "White")
            local incident = object.takeObject()
            incident.setRotation(deal_rotation)
            incident.setPositionSmooth(deal_position)
            Wait.time(function() UI.show('bot_incident') end, 1)
            return
        end
        if object.tag == "Card" then
            broadcastToAll("[" .. Color.fromString(bot_color):toHex() .. "]Bot[-] is taking last Incident - Burn has been triggered! Game over.", "Red")
            local incident = object
            incident.setRotation(deal_rotation)
            incident.setPositionSmooth(deal_position)
            Wait.time(function() UI.show('bot_incident') end, 1)
            return
        end
    end
    Wait.time(function() UI.show('bot_incident') end, 1)
end



function check_if_duty_officer()
    local bot_color, human_color = get_colors()
    local check_zone = getObjectFromGUID(bot_color == "Blue" and "a9ca57" or "818a7e")
    for _, object in pairs(check_zone.getObjects()) do
        if object.hasTag('suit_person') then
            return true
        end
    end
    return false
end -- end check_if_duty_officer()


function get_bot_deck()
    local bot_color, human_color = get_colors()
    local bot_deck               = nil
    local check_zone             = getObjectFromGUID(bot_color == "Blue" and "58f8ce" or "5e07a8")
    for _, object in pairs(check_zone.getObjects()) do
        if object.tag == "Deck" or object.tag == "Card" then
            bot_deck = object
        end
    end
    return bot_deck
end -- end get_bot_deck()


function get_captain_name()
    local bot_color, human_color = get_colors()
    local captain_check_zone     = getObjectFromGUID(bot_color == "Blue" and "75465f" or "75c041")
    local captain_card_name      = nil
    for _, object in pairs(captain_check_zone.getObjects()) do
        if string.find(object.getName(), "Crew Board Basic") then
            captain_card_name    = object.getName()
        end
    end
    local captain_name           = nil
    local split_name             = {}
    for str in string.gmatch(captain_card_name,  "%S+") do
        table.insert(split_name, str)
    end
    return split_name[1]
end -- end get_captain_name()


function get_colors()
    local bot_color   = nil
    local human_color = nil
    if getObjectFromGUID("23bed4").getGMNotes() == "solo" then
        bot_color   = "Blue"
        human_color = "Red"
    end
    if getObjectFromGUID("1a78a6").getGMNotes() == "solo" then
        bot_color   = "Red"
        human_color = "Blue"
    end
    return bot_color, human_color
end -- end get_bot_color()


function get_mvp(args)
    local token_ignore = args.token_ignore
    local type         = args.type -- "Bot", "Human"
    local cards        = args.cards
end -- end get_mvp()
