function onLoad()
    local create_buttons = false
    local zones          = {getObjectFromGUID("75465f"), getObjectFromGUID("75c041")}
    for i = 1, 2 do
        for _, object in pairs(zones[i].getObjects()) do
            if object   == self then create_buttons = true end
        end
    end
    local is_solo        = false
    for _, object in pairs(getObjectFromGUID("75465f").getObjects()) do
        if (object  == self and getObjectFromGUID("23bed4").getGMNotes() == "solo") or
        (object  == self and getObjectFromGUID("1a78a6").getGMNotes() == "solo") then
            is_solo = true
        end
    end
    if create_buttons and not is_solo then
        if self.hasTag('mission_1_completed') then
            create_completed_mission_button_1()
            self.UI.show('completed_mission_1')
        else
            create_uncompleted_mission_button_1()
        end
        if self.hasTag('mission_2_completed') then
            create_completed_mission_button_2()
            self.UI.show('completed_mission_2')
        else
            create_uncompleted_mission_button_2()
        end
        if self.hasTag('mission_3_completed') then
            create_completed_mission_button_3()
            self.UI.show('completed_mission_3')
        else
            create_uncompleted_mission_button_3()
        end
    end
end -- end onLoad()


function get_color()
    local color     = nil
    local h_color   = nil
    local s_color   = nil
    for _, object in pairs(getObjectFromGUID("75465f").getObjects()) do
        if object  == self then
            color   = {31/255, 136/255, 255/255, .7}
            h_color = {31/255, 136/255, 255/255, .5}
            s_color = "Blue"
        end
    end
    for _, object in pairs(getObjectFromGUID("75c041").getObjects()) do
        if object  == self then
            color   = {219/255, 26/255, 24/255, .7}
            h_color = {219/255, 26/255, 24/255, .5}
            s_color = "Red"
        end
    end
    return color, h_color, s_color
end -- end get_color()



function refresh_buttons(button)
    self.clearButtons()
    Wait.time(function()

    if self.hasTag('mission_1_completed') then
        create_completed_mission_button_1()
        if button == 1 then
            self.UI.show('completed_mission_1')
        end
    else
        create_uncompleted_mission_button_1()
        self.UI.hide('completed_mission_1')
    end

    if self.hasTag('mission_2_completed') then
        create_completed_mission_button_2()
        if button == 2 then
            self.UI.show('completed_mission_2')
        end
    else
        create_uncompleted_mission_button_2()
        self.UI.hide('completed_mission_2')
    end

    if self.hasTag('mission_3_completed') then
        create_completed_mission_button_3()
        if button == 3 then
            self.UI.show('completed_mission_3')
        end
    else
        create_uncompleted_mission_button_3()
        self.UI.hide('completed_mission_3')
    end

    end, .1)
end -- end refresh_buttons()


function create_uncompleted_mission_button_1()
    local color, h_color, _ = get_color()
    self.createButton({
        click_function = "check_mission_complete_1",
        function_owner = self,
        label          = "",
        position       = {0.575, 0.00, -0.772},
        rotation       = {0, 0, 180},
        width          = 640,
        height         = 160,
        scale          = {.5, .5, .5},
        color          = color,
        hover_color    = h_color,
        tooltip        = "Take your reward, then click this button to mark this Captain Goal as Completed.",
    })
end -- end create_uncompleted_mission_button_1()


function create_completed_mission_button_1()
    self.createButton({
        click_function = "uncheck_mission_complete_1",
        function_owner = self,
        label          = "",
        position       = {0.575, 0.00, -0.772},
        rotation       = {0, 0, 180},
        width          = 640,
        height         = 160,
        scale          = {.5, .5, .5},
        color          = {0, 0, 0, .8},
        hover_color    = {0, 0, 0, .6},
        tooltip        = "Take your reward, then click this button to mark this Captain Goal as Uncompleted.",
    })
end -- end create_completed_mission_button_1()


