function check_mission_complete_1()
    self.addTag('mission_1_completed')
    refresh_buttons(1)
    broadcast_goal("adv_1", "Completed")
end -- end check_mission_complete_1()


function uncheck_mission_complete_1()
    self.removeTag('mission_1_completed')
    refresh_buttons(1)
    broadcast_goal("adv_1", "Uncompleted")
end -- end uncheck_mission_complete_1()

function check_mission_complete_2()
    self.addTag('mission_2_completed')
    refresh_buttons(2)
    broadcast_goal("adv_2", "Completed")
end -- end check_mission_complete_2()


function uncheck_mission_complete_2()
    self.removeTag('mission_2_completed')
    refresh_buttons(2)
    broadcast_goal("adv_2", "Uncompleted")
end -- end uncheck_mission_complete_2()

function check_mission_complete_3()
    self.addTag('mission_3_completed')
    refresh_buttons(3)
    broadcast_goal("adv_3", "Completed")
end -- end check_mission_complete_3()


function uncheck_mission_complete_3()
    self.removeTag('mission_3_completed')
    broadcast_goal("adv_3", "Uncompleted")
    refresh_buttons(3)
end -- end uncheck_mission_complete_3()


function broadcast_goal(goal, type) -- goal: "adv_1", "adv_2", "adv_3", type: "Completed", "Uncompleted"
    local captain         = "Sisko"
    local goal_name_adv_1 = "A Call To Arms"
    local goal_name_adv_2 = "Bajor's Application To The Federation"
    local goal_name_adv_3 = "Contacting The Dominion"
    local goal_name       = nil
    if goal              == "adv_1" then
        goal_name         = goal_name_adv_1
    elseif goal          == "adv_2" then
        goal_name         = goal_name_adv_2
    elseif goal          == "adv_3" then
        goal_name         = goal_name_adv_3
    end
    local _, _, s_color   = get_color()
    if s_color ~= nil then
        if Player[s_color].steam_name ~= nil then
            broadcastToAll("[" .. Color.fromString(s_color):toHex() .. "]" .. Player[s_color].steam_name .. "[-] marked Captain " .. captain .. " Goal; " .. goal_name .. ": " .. type, "White")
        else
            broadcastToAll("[" .. Color.fromString(s_color):toHex() .. "]" .. s_color .. " Player[-] has marked Captain " .. captain .. " Goal; " .. goal_name .. ": " .. type, "White")
        end
    end
end -- end broadcast_completed_goal()
