color = "Red"

function onLoad()
    create_button()
end -- end onLoad()


function create_button()
    getObjectFromGUID("9e4a12").createButton({
        click_function = "refresh_draw_deck_btn",
        function_owner = self,
        label          = "",
        position       = {0, 0.11, -0.01},
        width          = 950,
        height         = 480,
        scale          = {2.1, 2.1, 2.1},
        color          = {1, 1, 1, .3},
        hover_color    = {1, 1, 1, .6},
        tooltip        = "Shuffle discard pile, refresh draw deck.\n\nLeft clicking this button will automatically draw back up to hand size, including automatic Enlisting.\n\nRight clicking will simply refresh the discard pile into a draw deck, without drawing back up to Hand Size (Good for cases where you're cycling the deck while drawing 1 to a few cards during your turn, Enlist manually in this case).",
    })
end -- end create_button()


function get_max_hand()
    -- check captain zones for Burnham
    local max_hand_size          = 5
    local duty_zone              = getObjectFromGUID("818a7e")
    local ship_zones             = {"5103b2", "77d0cb"}
    for i = 1, 2 do
        for _, object in pairs(getObjectFromGUID(ship_zones[i]).getObjects()) do
            if object.getName() == "Guardian Of Forever" then
                max_hand_size    = max_hand_size + 1
            end
        end
    end
    for _, object in pairs(duty_zone.getObjects()) do
        if object.type          == "Card" and object.getName() == "Inert Dilithium" then
            max_hand_size        = max_hand_size + 1
        end
    end
    -- check duty officer zone for hand size increasing duty officer cards in play
    for _, object in pairs(duty_zone.getObjects()) do
        if object.type           == "Card" and
        (object.getName()        == "Arne Darvin" or object.getName() == "T'Pel" or object.getName() == "Talok" or object.getName() == "Joret Dal") then
            max_hand_size         = max_hand_size + 1
        end
        if object.type           == "Card" and object.getName() == "Garak" then
            max_hand_size         = max_hand_size + 2
        end
        if object.type           == "Card" and object.getName() == "Doctor Kovich" then
            local kovich_count = 0
            local counters = {getObjectFromGUID("c5021e"), getObjectFromGUID("f3c9be"), getObjectFromGUID("5564b6")}
            for i = 1, 3 do
                if counters[i].getVar('val') > 4 then
                    kovich_count = kovich_count + 1
                end
            end
            max_hand_size        = max_hand_size + kovich_count
        end
    end    
    return max_hand_size
end -- get_max_hand()


function refresh_draw_deck_btn(_, _, alt_click)
    local max_hand_size = get_max_hand()
    refresh_draw_deck({deal_count=max_hand_size, alt_click=alt_click})
end -- end refresh_draw_deck_btn()


function refresh_draw_deck(args)
    local deal_count = args.deal_count
    local alt_click  = args.alt_click
    local button     = getObjectFromGUID(color == "Blue" and "1a88d8" or "9e4a12")
    local position   = button.getPosition()
    position.y       = position.y - 1
    button.setPosition(position)
    Wait.time(function()
    position.y   = position.y + 1
    button.setPosition(position)
    end, 5)

    local checkzone  = getObjectFromGUID(color == "Blue" and "fbfe84" or "b72553")
    local draw_loc   = {44.50, 1.20, -7.00}
    local deck       = nil
    local deck_found = false
    local is_solo    = getObjectFromGUID(color == "Blue" and "23bed4" or "1a78a6").getGMNotes() == "solo"
    local rotation   = is_solo and {0.00, 270.00, 180.00} or {0.00, 90.00, 180.00}

    for _, object in pairs(checkzone.getObjects()) do
        if object.tag == "Deck" or object.tag == "Card" then
            deck = object
            deck_found = true
            deck.setName('Draw Deck')
            deck.setRotationSmooth(rotation, false, false)
            Wait.time(function()
            deck.shuffle()
            deck.setPositionSmooth(draw_loc, false, false)
            end, 0.5)
        end
    end

    if alt_click == true or is_solo or deck == nil then
        return
    end

    Wait.time(function()
    local max_hand_size = get_max_hand()
    local current_hand  = Player[color].getHandObjects()
    local hand_count    = #current_hand
    local remaining_to_deal = math.max(0, max_hand_size - hand_count)
    if remaining_to_deal <= 0 then return end

    local reserves_zone = getObjectFromGUID(color == "Blue" and "dc94e0" or "61d439")
    local dev_zone      = getObjectFromGUID(color == "Blue" and "30a2e2" or "b75338")
    local hand_zone     = getObjectFromGUID(color == "Blue" and "73058e" or "72070a")

    local name = Player[color].steam_name or color .. " Player"

    -- Always enlist 1 from Reserves if available, else Development
    local reserve_found = false
    for _, obj in pairs(reserves_zone.getObjects()) do
        if obj.tag == "Deck" then
            local card = obj.takeObject()
            card.setRotation({0, color == "Blue" and 270 or 90, 0})
            card.setPositionSmooth(hand_zone.getPosition())
            broadcastToAll("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-] has cycled their deck, and Enlists a Reserve.", "White")
            Wait.time(function()
            broadcastToColor("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-]: Enlisted Reserve Card: " .. card.getName(), color, "White")
            end, 0.5)
            remaining_to_deal = remaining_to_deal - 1
            reserve_found = true
            break
        elseif obj.tag == "Card" then
            obj.setRotation({0, color == "Blue" and 270 or 90, 0})
            obj.setPositionSmooth(hand_zone.getPosition())
            broadcastToAll("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-] has cycled their deck, and Enlists a Reserve.", "White")
            Wait.time(function()
            broadcastToColor("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-]: Enlisted Reserve Card: " .. obj.getName(), color, "White")
            end, 0.5)
            remaining_to_deal = remaining_to_deal - 1
            reserve_found = true
            break
        end
    end

    if not reserve_found then
        for _, obj in pairs(dev_zone.getObjects()) do
            if obj.tag == "Deck" then
                obj.Container.search(color)
                broadcastToAll("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-] has cycled their deck, and may Enlist a Development.", "White")
                Wait.time(function()
                broadcastToColor("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-]: Pull selected Development Card from deck, remember to pay Development cost, and add Development Card to hand.", color, "White")
                end, 1)
                Wait.time(function()
                broadcastToColor("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-]: Afterwards, manually draw " .. remaining_to_deal .. " more cards, up to your hand size of " .. max_hand_size .. ".", color, "White")
                end, 2)
                return
            elseif obj.tag == "Card" then
                broadcastToAll("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-] has cycled their deck, and may Enlist their last Development.", "White")
                Wait.time(function()
                broadcastToColor("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-]: Pull selected Development Card from deck, remember to pay Development cost, and add Development Card to hand.", color, "White")
                end, 1)
                Wait.time(function()
                broadcastToColor("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-]: Afterwards, manually draw " .. remaining_to_deal .. " more cards, up to your hand size of " .. max_hand_size .. ".", color, "White")
                end, 2)
                return
            end
        end
    end


    if remaining_to_deal <= 0 then return end

    -- Attempt to deal from refreshed deck
    local deck_count = 0
    if deck.tag == "Deck" then
        deck_count = #deck.getObjects()
    elseif deck.tag == "Card" then
        deck_count = 1
    end

    if deck_count > 0 then
        local to_deal = math.min(remaining_to_deal, deck_count)
        deck.deal(to_deal, color)
        remaining_to_deal = remaining_to_deal - to_deal
    end

    if remaining_to_deal <= 0 then return end

    -- Recursive fallback to Reserves or Development
    local function continue_drawing()
        if remaining_to_deal <= 0 then return end

        for _, obj in pairs(reserves_zone.getObjects()) do
            if obj.tag == "Deck" and #obj.getObjects() > 0 then
                local card = obj.takeObject()
                card.setRotation({0, color == "Blue" and 270 or 90, 0})
                card.setPositionSmooth(hand_zone.getPosition())
                broadcastToColor("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-]: Draw deck is empty! Enlisted Reserve Card: " .. obj.getName(), color, "White")
                remaining_to_deal = remaining_to_deal - 1
                Wait.time(continue_drawing, 0.25)
                return
            elseif obj.tag == "Card" then
                obj.setRotation({0, color == "Blue" and 270 or 90, 0})
                obj.setPositionSmooth(hand_zone.getPosition())
                broadcastToColor("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-]: Draw deck is empty! Enlisted Reserve Card: " .. obj.getName(), color, "White")
                remaining_to_deal = remaining_to_deal - 1
                Wait.time(continue_drawing, 0.25)
                return
            end
        end

        -- No more reserves — handle Development zone
        for _, obj in pairs(dev_zone.getObjects()) do
            if obj.tag == "Deck" then
                obj.Container.search(color)
                broadcastToAll("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-] may Enlist a Development.", "White")
                Wait.time(function()
                broadcastToColor("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-]: Pull selected Development Card from deck, remember to pay Development cost, and add Development Card to hand.", color, "White")
                end, 1)
                Wait.time(function()
                broadcastToColor("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-]: Afterwards, manually draw " .. (remaining_to_deal - 1) .. " more cards, up to your hand size of " .. max_hand_size .. ".", color, "White")
                end, 2)
                return
            elseif obj.tag == "Card" then
                broadcastToAll("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-] may Enlist their last Development.", "White")
                Wait.time(function()
                broadcastToColor("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-]: Pull selected Development Card from deck, remember to pay Development cost, and add Development Card to hand.", color, "White")
                end, 1)
                Wait.time(function()
                broadcastToColor("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-]: Afterwards, manually draw " .. (remaining_to_deal - 1) .. " more cards, up to your hand size of " .. max_hand_size .. ".", color, "White")
                end, 2)
                return
            end
        end

        -- Still nothing? Broadcast error.
        broadcastToColor("[" .. Color.fromString(color):toHex() .. "]" .. name .. "[-]: No more cards to draw from Reserves or Developments!", color, "Orange")
    end

    Wait.time(continue_drawing, 0.5)
    end, 1)
end
